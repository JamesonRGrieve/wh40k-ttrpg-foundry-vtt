{{!--
    A grenade's rider (#135, #622): its area, test, duration and effect, read from the
    grenade's own `system.rider` through `grenade-throw-view.ts`. Shared by the throw card
    (a grenade that deals no damage) and the damage card (one that does, whose rider
    follows its damage onto everyone the blast caught).

    Hash params:
        rider       — required, a GrenadeChoice {areaLabel, testLabel, affectsLabel, durationLabel, shiftLabel, effectLabel, effect}
        canResolve  — optional, offer Resolve Rider (#623): roll each caught creature's test and apply the condition
        rollId      — optional, the damage card's stored roll (a grenade that deals damage); a throw card carries its area in flags
--}}
{{!-- Row labels never shrink or wrap; a long value wraps right-aligned beside them. --}}
<div data-grenade-rider>
    <ul class="tw-list-none tw-p-0 tw-m-0 tw-flex tw-flex-col tw-gap-1 tw-text-[0.85rem] tw-mb-3">
        {{#if rider.areaLabel}}
            <li class="tw-flex tw-items-start tw-justify-between tw-gap-3">
                <span class="tw-shrink-0 tw-whitespace-nowrap tw-text-[#9a9a8a]" data-grenade-row-label>{{localize "WH40K.GrenadeRider.Area"}}</span>
                <span class="tw-font-bold tw-tabular-nums tw-text-[#e8e4d9]">{{rider.areaLabel}}</span>
            </li>
        {{/if}}
        <li class="tw-flex tw-items-start tw-justify-between tw-gap-3">
            <span class="tw-shrink-0 tw-whitespace-nowrap tw-text-[#9a9a8a]" data-grenade-row-label>{{localize "WH40K.GrenadeRider.Test"}}</span>
            <span class="tw-font-bold tw-tabular-nums tw-text-[color:var(--wh40k-card-gold)]" data-grenade-test>{{rider.testLabel}}</span>
        </li>
        {{#if rider.affectsLabel}}
            <li class="tw-flex tw-items-start tw-justify-between tw-gap-3">
                <span class="tw-shrink-0 tw-whitespace-nowrap tw-text-[#9a9a8a]" data-grenade-row-label>{{localize "WH40K.GrenadeRider.Affects"}}</span>
                <span class="tw-font-bold tw-text-[#e8e4d9]" data-grenade-affects>{{rider.affectsLabel}}</span>
            </li>
        {{/if}}
        {{#if rider.durationLabel}}
            <li class="tw-flex tw-items-start tw-justify-between tw-gap-3">
                <span class="tw-shrink-0 tw-whitespace-nowrap tw-text-[#9a9a8a]" data-grenade-row-label>{{localize "WH40K.GrenadeRider.Duration"}}</span>
                <span class="tw-min-w-0 tw-font-bold tw-text-right tw-text-[#e8e4d9]">{{rider.durationLabel}}</span>
            </li>
        {{/if}}
    </ul>
    <div class="tw-p-2 tw-rounded-sm tw-border tw-border-[rgba(201,162,39,0.3)] tw-bg-[rgba(0,0,0,0.25)]">
        <div class="tw-text-[0.7rem] tw-uppercase tw-tracking-[0.08em] tw-text-[#9a9a8a] tw-mb-1">{{rider.effectLabel}}</div>
        <div class="tw-text-[0.85rem] tw-text-[#e8e4d9]" data-grenade-effect>{{rider.effect}}</div>
        {{#if rider.shiftLabel}}
            <div class="tw-mt-1 tw-text-[0.8rem] tw-text-[#e8e4d9]">{{rider.shiftLabel}}</div>
        {{/if}}
    </div>
    {{#if canResolve}}
        <button type="button" class="roll-control__resolve-rider tw-mt-3 tw-w-full tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-px-3 tw-py-2 tw-bg-[rgba(201,162,39,0.12)] tw-border tw-border-gold tw-rounded-md tw-text-[color:var(--wh40k-card-gold)] tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-cursor-pointer tw-whitespace-nowrap hover:tw-bg-[rgba(201,162,39,0.22)] hover:tw-shadow-[0_0_12px_rgba(201,162,39,0.35)] disabled:tw-opacity-50 disabled:tw-cursor-default"
                {{#if rollId}}data-roll-id="{{rollId}}"{{/if}} data-grenade-resolve>
            <i class="fas fa-dice-d20" aria-hidden="true"></i>
            <span>{{localize "WH40K.GrenadeRider.ResolveButton"}}</span>
        </button>
    {{/if}}
</div>
