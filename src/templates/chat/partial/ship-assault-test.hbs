{{!--
    One rolled test of an RT ship assault action (ramming, boarding, Hit and Run).

    Renders the full target derivation through `modifier-breakdown.hbs` — base
    (source) ± every hoverable modifier (source) = target — then the roll and
    its degrees of success / failure with the line's degrees formula.

    Hash params:
        test — AssaultTestView {title, baseLabel, baseTarget, modifierSources,
               target, roll, success, dos, dof, degreesFormula}
--}}
<section data-wh40k-hook="ship-assault-test" class="tw-mb-2 tw-p-2 tw-rounded-sm tw-border tw-border-[var(--wh40k-border-color)] tw-bg-[rgba(0,0,0,0.18)]">
    <div class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-[var(--wh40k-card-muted)] tw-mb-1">{{test.title}}</div>
    {{!-- Every ship card that renders this test draws a dark panel (data-wh40k-surface="dark"),
          so its TARGET takes the sheet accent, as ship-action-roll-chat's does, not the
          parchment chat accent, which is a deep tone made for a light card (#698). --}}
    {{> systems/wh40k-rpg/templates/chat/partial/modifier-breakdown.hbs accentRole="accent"
        baseTarget=test.baseTarget
        baseLabel=test.baseLabel
        modifierSources=test.modifierSources
        modifiedTarget=test.target}}
    <div class="tw-flex tw-justify-between tw-items-center tw-text-[0.9rem]">
        <span class="tw-text-[var(--wh40k-card-muted)] tw-font-medium">{{localize "WH40K.Voidcraft.Assault.Rolled" roll=test.roll}}</span>
        {{#if test.success}}
            <span class="tw-font-bold tw-text-[var(--wh40k-success-secondary)]">{{localize "WH40K.Voidcraft.Assault.Success" dos=test.dos}}</span>
        {{else}}
            <span class="tw-font-bold tw-text-[var(--wh40k-danger-secondary)]">{{localize "WH40K.Voidcraft.Assault.Failure" dof=test.dof}}</span>
        {{/if}}
    </div>
    {{> systems/wh40k-rpg/templates/chat/partial/result-formula.hbs resultFormula=test.degreesFormula}}
</section>
