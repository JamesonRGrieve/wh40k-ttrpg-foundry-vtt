{{!-- A hit on a vehicle (content#28): the rows that say how it struck and what it did —
      facing, location, armour after Penetration, the trait force field, Structural
      Integrity, Critical damage and the trait that halves it, and the chart rows.
      Each number hovers to its parts. `html` is chart text from the line's pack. --}}
<div class="tw-my-2 tw-flex tw-flex-col tw-gap-1 tw-rounded-md tw-border tw-border-[var(--wh40k-border-color)] tw-bg-[var(--wh40k-panel-bg-translucent)] tw-px-3 tw-py-2" data-vehicle-rows>
    {{#each rows as |row|}}
        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-py-1 tw-text-[0.85rem] {{#unless @last}}tw-border-b tw-border-[var(--wh40k-border-color)]{{/unless}}" data-vehicle-row="{{row.hook}}">
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-2{{#if row.tooltip}} tw-cursor-help{{/if}}"{{#if row.tooltip}} data-wh40k-tooltip="modifier" data-wh40k-tooltip-data="{{row.tooltip}}"{{/if}}>
                <span class="tw-min-w-0 tw-font-semibold tw-text-[var(--wh40k-card-muted)]" data-vehicle-row-label>{{row.label}}</span>
                <span class="tw-shrink-0 tw-text-right tw-tabular-nums tw-font-bold tw-text-[var(--wh40k-card-text)]" data-vehicle-row-value>{{row.value}}</span>
            </div>
            {{#if row.note}}<div class="tw-text-[0.72rem] tw-leading-snug tw-text-[var(--wh40k-card-muted)] tw-opacity-90" data-vehicle-row-note>{{row.note}}</div>{{/if}}
            {{#if row.html}}<div class="tw-text-[0.78rem] tw-leading-snug tw-text-[var(--wh40k-card-text)] [&_p]:tw-m-0" data-vehicle-row-chart>{{{row.html}}}</div>{{/if}}
            {{!-- Damage Control (#678): the commander may re-roll this Righteous Fury roll once. --}}
            {{#if row.control}}
                <button type="button" class="roll-control__damage-control tw-mt-1 tw-self-start tw-max-w-full tw-min-w-0 tw-inline-flex tw-items-center tw-gap-1 tw-rounded-md tw-border tw-border-[var(--wh40k-border-color)] tw-bg-[var(--wh40k-panel-bg-translucent)] tw-px-2 tw-py-1 tw-text-[0.75rem] tw-font-semibold tw-text-[var(--wh40k-card-text)] tw-cursor-pointer hover:tw-border-[var(--wh40k-card-gold)] disabled:tw-cursor-not-allowed disabled:tw-opacity-50" data-damage-control="{{row.control}}">
                    <span class="material-icons tw-text-[0.9rem]" aria-hidden="true">replay</span>
                    <span>{{localize "WH40K.Vehicle.Damage.DamageControlReroll"}}</span>
                </button>
            {{/if}}
        </div>
    {{/each}}
</div>
