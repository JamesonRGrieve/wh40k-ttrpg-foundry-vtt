{{!--
    Modifier breakdown — Base + each active modifier + Target row.
    Used inside the body of action-roll and psychic-action chat cards.

    Renders the full target formula: base (source) ± every modifier (source) =
    target. When `modifierSources` is supplied (the provenance-bearing component
    list built at commit) each row is hoverable to its source via the shared
    wh40k-tooltip "modifier" type; otherwise it falls back to the legacy
    label→value map in `activeModifiers`.

    Text colours come from `--wh40k-card-text` / `--wh40k-card-muted`. On a
    light card they are unset and the rows take the card's own colour; a dark
    card declares `data-wh40k-surface="dark"` on its root, which re-points them
    to light values (tailwind/design-tokens.js), so the rows stay legible on both.

    Hash params:
        baseTarget        — required, the base value before modifiers
        activeModifiers   — required, object/map of label → numeric delta (fallback)
        modifiedTarget    — required, the final target number after modifiers
        modifierSources   — optional, [{label, value, source, tooltipData}] components
        modifierCapFired  — optional, true when the ±60 cap clamped the raw total
        rawModifierTotal  — optional, the un-capped modifier sum (for the cap row)
        modifierTotal     — optional, the capped modifier sum (for the cap row)
        baseLabel         — optional, default "Base"
        accentRole        — optional theme role for the Target value: default `chatAccent` (the
                            parchment message); a dark card passes `accent`
        baseTooltipData   — optional, a "modifier" tooltip payload making the base row hoverable to its source
        targetLabel       — optional, default "Target"
--}}
<div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]{{#if baseTooltipData}} tw-cursor-help{{/if}}"{{#if baseTooltipData}} data-wh40k-tooltip="modifier" data-wh40k-tooltip-data="{{baseTooltipData}}"{{/if}}>
    <span class="tw-min-w-0 tw-text-[var(--wh40k-card-muted)] tw-font-medium" data-breakdown-label>{{#if baseLabel}}{{baseLabel}}{{else}}{{localize "WH40K.CharacteristicSetup.Base"}}{{/if}}</span>
    <span class="tw-ml-2 tw-shrink-0 tw-whitespace-nowrap tw-tabular-nums tw-font-semibold tw-text-[var(--wh40k-card-text)]" data-breakdown-value>{{baseTarget}}</span>
</div>

{{#if modifierSources.length}}
    {{#each modifierSources as |component|}}
        <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem] tw-pl-3 tw-border-l-2 tw-border-l-[var(--wh40k-border-color)] tw-ml-1 tw-cursor-help" data-wh40k-tooltip="modifier" data-wh40k-tooltip-data="{{component.tooltipData}}">
            <span class="tw-min-w-0 tw-text-[var(--wh40k-card-muted)] tw-font-medium" data-breakdown-label>{{component.label}}</span>
            <span data-breakdown-value class="tw-ml-2 tw-shrink-0 tw-font-semibold tw-whitespace-nowrap tw-tabular-nums {{#if (gt component.value 0)}}tw-text-[var(--wh40k-success-secondary)]{{else if (lt component.value 0)}}wh40k-roll-card__value--negative tw-text-[var(--wh40k-danger-secondary)]{{else}}tw-text-[var(--wh40k-card-text)]{{/if}}">
                {{#if (gt component.value 0)}}+{{/if}}{{component.value}}
            </span>
        </div>
    {{/each}}
{{else}}
    {{#each activeModifiers}}
        <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem] tw-pl-3 tw-border-l-2 tw-border-l-[var(--wh40k-border-color)] tw-ml-1">
            <span class="tw-min-w-0 tw-text-[var(--wh40k-card-muted)] tw-font-medium" data-breakdown-label>{{@key}}</span>
            <span data-breakdown-value class="tw-ml-2 tw-shrink-0 tw-whitespace-nowrap tw-tabular-nums tw-font-semibold {{#if (gt this 0)}}tw-text-[var(--wh40k-success-secondary)]{{else if (lt this 0)}}wh40k-roll-card__value--negative tw-text-[var(--wh40k-danger-secondary)]{{else}}tw-text-[var(--wh40k-card-text)]{{/if}}">
                {{#if (gt this 0)}}+{{/if}}{{this}}
            </span>
        </div>
    {{/each}}
{{/if}}

{{#if modifierCapFired}}
    <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.8rem] tw-pl-3 tw-border-l-2 tw-border-l-[var(--wh40k-danger-secondary)] tw-ml-1 tw-italic tw-text-[var(--wh40k-danger-secondary)]" data-tooltip="{{localize "WH40K.Roll.ModifierCap.Tooltip"}}">
        <span>{{localize "WH40K.Roll.ModifierCap.Label"}}</span>
        <span class="tw-font-semibold">{{localize "WH40K.Roll.ModifierCap.Value" raw=rawModifierTotal capped=modifierTotal}}</span>
    </div>
{{/if}}

{{#with (breakdownRawTarget baseTarget modifierSources activeModifiers) as |rawTarget|}}
    {{#if (and (lt rawTarget 0) (lt rawTarget ../modifiedTarget))}}
        <div class="tw-py-1 tw-text-[0.8rem] tw-pl-3 tw-border-l-2 tw-border-l-[var(--wh40k-danger-secondary)] tw-ml-1 tw-italic tw-text-[var(--wh40k-danger-secondary)]" data-breakdown-row="floor">{{localize "WH40K.Roll.TargetFloor" sum=rawTarget}}</div>
    {{/if}}
{{/with}}

<div class="tw-flex tw-justify-between tw-items-center tw-px-3 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-accent-overlay)] tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-md">
    <span class="tw-min-w-0 tw-text-[var(--wh40k-card-muted)] tw-font-semibold tw-uppercase tw-tracking-[0.05em]" data-breakdown-label>{{#if targetLabel}}{{targetLabel}}{{else}}{{localize "WH40K.Roll.TargetLabel"}}{{/if}}</span>
    <span class="tw-ml-2 tw-shrink-0 tw-whitespace-nowrap tw-tabular-nums tw-text-[1.2rem] tw-font-bold {{themeClassFor (defaultVal accentRole 'chatAccent')}}" data-breakdown-value>{{modifiedTarget}}</span>
</div>
