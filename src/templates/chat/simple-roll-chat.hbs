{{!-- Rogue Trader Roll Card - Modern Design --}}
{{#with rollData}}
{{#> systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs
    overline=sheetName
    title=name
    subtitle=(or testedSkill type)
    playerRolledBadge=isManualRoll
    bgClass="tw-bg-[var(--wh40k-panel-bg-solid)]"
    gameSystem=../gameSystem}}
            {{!-- Modifiers Breakdown --}}
            {{> systems/wh40k-rpg/templates/chat/partial/modifier-breakdown.hbs baseTarget=baseTarget baseLabel=baseLabel activeModifiers=activeModifiers modifierSources=modifierSources modifiedTarget=modifiedTarget modifierCapFired=modifierCapFired rawModifierTotal=rawModifierTotal modifierTotal=modifierTotal}}

            {{!-- Target-only display (no roll entered) --}}
            {{#if isTargetOnly}}
                <div class="tw-text-center tw-px-3 tw-py-2 tw-my-2 tw-bg-[rgba(201,162,39,0.08)] tw-border tw-border-dashed tw-border-[rgba(201,162,39,0.3)] tw-rounded-md tw-text-[0.8rem] tw-italic tw-text-[var(--wh40k-text-muted)]">
                    {{localize "WH40K.Chat.Roll.AwaitingPhysicalRoll"}}
                </div>
            {{else}}
            {{!-- Result Display --}}
            {{#if success}}
                {{> systems/wh40k-rpg/templates/chat/partial/result-callout.hbs
                    variant="success"
                    label="Success"
                    value=roll.total
                    glowClass="tw-shadow-[0_0_20px_rgba(45,138,78,0.4),inset_0_0_30px_rgba(45,138,78,0.1)]"}}
                <div class="tw-flex tw-justify-center tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-mt-2 tw-px-4 tw-py-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md">
                    <span class="tw-text-[1.5rem] tw-font-bold tw-text-success" data-wh40k-hook="degrees-count">{{#if printedDegrees}}{{printedDegrees.dos}}{{else}}{{dos}}{{/if}}</span>
                    <span class="tw-text-[0.8rem] tw-uppercase tw-tracking-[0.1em] tw-opacity-80">{{localize "WH40K.Roll.DegreesOfSuccess"}}</span>
                </div>
            {{else}}
                {{> systems/wh40k-rpg/templates/chat/partial/result-callout.hbs
                    variant="danger"
                    label="Failure"
                    value=roll.total
                    glowClass="tw-shadow-[0_0_20px_rgba(168,50,50,0.4),inset_0_0_30px_rgba(168,50,50,0.1)]"}}
                <div class="tw-flex tw-justify-center tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-mt-2 tw-px-4 tw-py-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md">
                    <span class="tw-text-[1.5rem] tw-font-bold tw-text-failure" data-wh40k-hook="degrees-count">{{#if printedDegrees}}{{printedDegrees.dof}}{{else}}{{dof}}{{/if}}</span>
                    <span class="tw-text-[0.8rem] tw-uppercase tw-tracking-[0.1em] tw-opacity-80">{{localize "WH40K.Roll.DegreesOfFailure"}}</span>
                </div>
            {{/if}}
            {{> systems/wh40k-rpg/templates/chat/partial/result-formula.hbs}}

            {{/if}}{{!-- end isTargetOnly else --}}

            {{!-- Effects the resolved test produced (a skill-use readout, an evasion
                  scored against its attack, #414) — the same rows the action card shows. --}}
            {{#each @root.effectOutput as |effect|}}
                <div class="tw-flex tw-items-start tw-gap-[var(--wh40k-space-sm)] tw-py-1.5 tw-text-[0.85rem]" data-roll-effect>
                    <span class="tw-font-semibold tw-text-[color:var(--wh40k-card-gold)] tw-shrink-0">{{effect.name}}</span>
                    <span class="tw-text-[var(--wh40k-card-text)] tw-opacity-90">{{effect.effect}}</span>
                </div>
            {{/each}}

            {{!-- Counter Attack (#603): a successful Parry lets the parrying character
                  strike back at the opponent with the weapon that parried, at the
                  talent's modifier — offered only when a reaction hook grants it. --}}
            {{#if @root.counterAttack}}
                <button
                    type="button"
                    class="roll-control__counter-attack tw-w-full tw-h-auto tw-min-h-0 tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-px-3 tw-py-2 tw-mt-2 tw-bg-[var(--wh40k-wounds-bg)] tw-border tw-border-[var(--wh40k-wounds-border)] tw-rounded-md tw-text-[var(--wh40k-wounds-secondary)] tw-text-[0.8rem] tw-leading-tight tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-cursor-pointer disabled:tw-opacity-40 disabled:tw-cursor-not-allowed"
                    data-actor-uuid="{{@root.counterAttack.actorUuid}}"
                    data-attacker-uuid="{{@root.counterAttack.attackerUuid}}"
                    data-weapon-id="{{@root.counterAttack.weaponId}}"
                    data-modifier="{{@root.counterAttack.attackModifier}}"
                    data-source="{{@root.counterAttack.sourceName}}"
                    data-limit="{{@root.counterAttack.limit}}"
                    title="{{localize 'WH40K.Evasion.CounterAttackTooltip' source=@root.counterAttack.sourceName modifier=@root.counterAttack.attackModifier}}"
                >
                    <i class="fas fa-reply tw-text-[0.8rem]" aria-hidden="true"></i>
                    {{!-- The attacker's name can be long at chat width: the label wraps inside the button (#603). --}}
                    <span class="tw-min-w-0 tw-text-center tw-break-words">{{localize "WH40K.Evasion.CounterAttack" attacker=@root.counterAttack.attackerName}}</span>
                </button>
            {{else if @root.counterAttackSpent}}
                {{!-- The Parry would have earned it, but the per-round hook is spent:
                      say so rather than leave the control silently out. --}}
                <p class="tw-m-0 tw-mt-2 tw-text-[0.8rem] tw-italic tw-text-[var(--wh40k-card-muted)]" data-counter-attack-spent>
                    {{localize "WH40K.Evasion.CounterAttackSpentNote" source=@root.counterAttackSpent}}
                </p>
            {{/if}}

            {{!-- Extended Test ladder (#59) --}}
            {{#if extendedTest}}
                {{> systems/wh40k-rpg/templates/chat/partial/extended-test-progress.hbs extendedTest=extendedTest}}
            {{/if}}

            {{!-- Re-roll + Fate controls. One button per available re-roll variant
                 (talent/trait re-rolls + global Spend Fate, from rerollOptions),
                 plus the Fate +1-DoS control. Shown for a resolved, auto-rolled
                 test that has at least one re-roll variant — so non-fate / spent-out
                 / target-only / manual rolls get no dead button. --}}
            {{#unless isTargetOnly}}
            {{#unless isManualRoll}}
            {{#if @root.rerollOptions.length}}
            <div class="tw-flex tw-flex-wrap tw-gap-1.5 tw-px-4 tw-py-2.5 tw-mt-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-t tw-border-[var(--wh40k-border-color)]">
                {{#if success}}{{#if @root.sourceFatePoints}}
                <button class="roll-control__fate-add-dos tw-flex-1 {{chatActionButton 'powers' 'sm'}}" data-roll-id="{{@root.id}}">
                    <span class="material-icons tw-text-[14px]">add_circle</span>
                    <span>{{localize "WH40K.FateAddDoS"}}</span>
                </button>
                {{/if}}{{/if}}
                {{> systems/wh40k-rpg/templates/chat/partial/reroll-controls.hbs rerollOptions=@root.rerollOptions rollId=@root.id}}
            </div>
            {{/if}}
            {{/unless}}
            {{/unless}}

        {{!-- Hidden dice data for Foundry --}}
        {{#unless isManualRoll}}
        <div class="tw-hidden">
            <div class="tw-hidden">{{{render}}}</div>
        </div>
        {{/unless}}
{{/systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs}}
{{/with}}
