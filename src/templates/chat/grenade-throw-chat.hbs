{{!-- Grenade throw chat card (#135): the thrown grenade's rider, read from its own data. --}}
{{!-- data-wh40k-system anchors per-system Tailwind variants on the card. --}}
<div class="wh40k-rpg tw-p-4 tw-rounded-md tw-border tw-bg-[rgba(15,12,8,0.85)] tw-border-[rgba(201,162,39,0.35)] dh2:tw-border-bronze"
     data-wh40k-system="{{gameSystem}}" data-grenade-card>
    <div class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
        <i class="fas fa-bomb tw-text-[1.1rem] tw-text-gold" aria-hidden="true"></i>
        <div class="tw-font-display tw-uppercase tw-tracking-[0.12em] tw-text-[0.95rem] tw-text-gold">
            {{localize "WH40K.GrenadeRider.ChatTitle"}}
        </div>
    </div>
    <div class="tw-text-[0.95rem] tw-mb-3 tw-text-[#e8e4d9]">
        <strong class="tw-text-gold">{{name}}</strong>
    </div>

    <ul class="tw-list-none tw-p-0 tw-m-0 tw-flex tw-flex-col tw-gap-1 tw-text-[0.85rem] tw-mb-3">
        {{#if areaLabel}}
            <li class="tw-flex tw-justify-between tw-gap-3">
                <span class="tw-text-[#9a9a8a]">{{localize "WH40K.GrenadeRider.Area"}}</span>
                <span class="tw-font-bold tw-tabular-nums tw-text-[#e8e4d9]">{{areaLabel}}</span>
            </li>
        {{/if}}
        {{#if damage}}
            <li class="tw-flex tw-justify-between tw-gap-3">
                <span class="tw-text-[#9a9a8a]">{{localize "WH40K.GrenadeRider.Damage"}}</span>
                <span class="tw-font-bold tw-tabular-nums tw-text-[#e8e4d9]">{{damage}}</span>
            </li>
        {{/if}}
        <li class="tw-flex tw-justify-between tw-gap-3">
            <span class="tw-text-[#9a9a8a]">{{localize "WH40K.GrenadeRider.Test"}}</span>
            <span class="tw-font-bold tw-tabular-nums tw-text-gold">{{testLabel}}</span>
        </li>
        {{#if durationLabel}}
            <li class="tw-flex tw-justify-between tw-gap-3">
                <span class="tw-text-[#9a9a8a]">{{localize "WH40K.GrenadeRider.Duration"}}</span>
                <span class="tw-font-bold tw-text-right tw-text-[#e8e4d9]">{{durationLabel}}</span>
            </li>
        {{/if}}
    </ul>

    {{#if qualities.length}}
        <div class="tw-flex tw-flex-wrap tw-gap-1 tw-mb-3">
            {{#each qualities}}
                <span class="tw-text-[0.7rem] tw-px-1.5 tw-py-0.5 tw-rounded-sm tw-border tw-border-[rgba(201,162,39,0.35)] tw-text-[#c4871d] dh2:tw-text-bronze">{{this}}</span>
            {{/each}}
        </div>
    {{/if}}

    <div class="tw-p-2 tw-rounded-sm tw-border tw-border-[rgba(201,162,39,0.3)] tw-bg-[rgba(0,0,0,0.25)]">
        <div class="tw-text-[0.7rem] tw-uppercase tw-tracking-[0.08em] tw-text-[#9a9a8a] tw-mb-1">{{effectLabel}}</div>
        <div class="tw-text-[0.85rem] tw-text-[#e8e4d9]" data-grenade-effect>{{effect}}</div>
        {{#if shiftLabel}}
            <div class="tw-mt-1 tw-text-[0.8rem] tw-text-[#e8e4d9]">{{shiftLabel}}</div>
        {{/if}}
    </div>
</div>
