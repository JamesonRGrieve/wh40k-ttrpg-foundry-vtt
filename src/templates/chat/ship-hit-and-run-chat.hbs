{{!-- Rogue Trader Hit and Run chat card (#188 — RT Core p.218). --}}
{{!-- Approach Pilot test → opposed raid Command tests → chosen Critical Hit + Hull damage. --}}
<div data-wh40k-hook="ship-har-card" data-wh40k-surface="dark" class="wh40k-rpg tw-p-4 tw-rounded-md tw-border-2 {{themeClassFor 'border'}} tw-bg-[rgba(8,16,28,0.9)] tw-text-[#e8e4d9]"
     data-wh40k-system="{{gameSystem}}">
    <header class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
        <i class="fas fa-user-ninja tw-text-[1.1rem] tw-text-violet-300"></i>
        <div class="tw-font-display tw-uppercase tw-tracking-[0.12em] tw-text-[0.95rem] tw-text-violet-200">
            {{localize "WH40K.Voidcraft.HitAndRun.ChatTitle"}}
        </div>
    </header>

    <div class="tw-text-[0.95rem] tw-mb-3">
        <strong class="tw-text-violet-200">{{attackerName}}</strong>
        <span class="tw-mx-1 tw-text-violet-400">→</span>
        <strong class="tw-text-violet-200">{{defenderName}}</strong>
    </div>

    {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-test.hbs test=approach.test}}
    {{#unless approach.test.success}}
        {{#if approach.shotDown}}
            <p class="tw-m-0 tw-text-[0.85rem] tw-font-semibold tw-text-rose-400">{{localize "WH40K.Voidcraft.HitAndRun.ShotDownExplain"}}</p>
        {{else}}
            <p class="tw-m-0 tw-text-[0.85rem] tw-text-violet-300">{{localize "WH40K.Voidcraft.HitAndRun.TurnedBackExplain"}}</p>
        {{/if}}
    {{/unless}}

    {{#if command}}
        {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-test.hbs test=command.attackerTest}}
        {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-test.hbs test=command.defenderTest}}
        {{#if command.success}}
            <p class="tw-m-0 tw-mb-2 tw-text-[0.9rem] tw-font-semibold tw-text-emerald-300">{{localize (pluralKey "WH40K.Voidcraft.HitAndRun.RaidSucceeds" command.netDoS) degrees=command.netDoS}}</p>
        {{else}}
            <p class="tw-m-0 tw-text-[0.85rem] tw-text-violet-300">{{localize "WH40K.Voidcraft.HitAndRun.RaidRepelled"}}</p>
        {{/if}}
    {{/if}}

    {{#if critPicks}}
        <div class="tw-mb-2 tw-p-2 tw-rounded-sm tw-border tw-border-violet-500/40 tw-text-[0.85rem]">
            <div>{{localize "WH40K.Voidcraft.HitAndRun.CritPicks" first=critPicks.[0] second=critPicks.[1]}}</div>
            {{#if chosenCrit}}
                <div class="tw-font-semibold tw-text-violet-200">{{localize "WH40K.Voidcraft.HitAndRun.CritChosen" roll=chosenCrit}}</div>
            {{/if}}
        </div>
    {{/if}}

    {{#if hull}}
        {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-damage.hbs damage=hull}}
    {{/if}}

    {{#if unapplied}}
        <p class="tw-m-0 tw-mt-2 tw-text-[0.8rem] tw-italic tw-text-amber-200">{{localize "WH40K.Voidcraft.Assault.NotApplied"}}</p>
    {{/if}}
</div>
