{{! Rogue Trader Damage Roll Card - Rich Hit-by-Hit Display }}
{{#> systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs
    overline=(localize "WH40K.Chat.Damage.Overline")
    title=weaponName
    borderClass="tw-border-[var(--wh40k-card-border)]"
    gameSystem=gameSystem}}
            {{#if psychicEffect}}
                <div class="tw-relative tw-h-3 tw-my-2.5 tw-opacity-50 tw-bg-transparent before:tw-content-['⬥'] before:tw-absolute before:tw-left-1/2 before:tw-top-1/2 before:tw-translate-x-[-50%] before:tw-translate-y-[-50%] before:tw-text-[var(--wh40k-card-gold)] before:tw-text-[10px] after:tw-content-[''] after:tw-absolute after:tw-top-1/2 after:tw-left-[10%] after:tw-right-[10%] after:tw-h-px after:tw-bg-[linear-gradient(90deg,transparent_0%,var(--wh40k-card-gold)_30%,transparent_48%,transparent_52%,var(--wh40k-card-gold)_70%,transparent_100%)]"></div>
                <div class="tw-px-3 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-2 tw-border-[var(--wh40k-card-gold)] tw-rounded-[0_4px_4px_0] tw-text-[0.85rem] tw-leading-[1.5] tw-max-h-[150px] tw-overflow-y-auto">{{{psychicEffect}}}</div>
            {{/if}}

            {{#each hits as |hit|}}
                <div class="tw-my-3 tw-p-2.5 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-md">
                    <div class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
                        <span class="tw-w-6 tw-h-6 tw-flex tw-items-center tw-justify-center tw-bg-[var(--wh40k-card-gold)] tw-text-[var(--color-bg-primary)] tw-font-bold tw-text-[0.8rem] tw-rounded-full tw-border {{themeClassFor 'border'}}">{{inc @index}}</span>
                        <span class="tw-text-[0.85rem] tw-uppercase tw-tracking-[0.05em] tw-text-[var(--wh40k-card-text)]">{{hitLocationLabel hit.location}}</span>
                        {{!-- A burst's extra hits can land on different enemies (#513), so
                              each hit names its own target. Hidden for a single-target
                              attack, where repeating one name on every row is just noise. --}}
                        {{#if hit.targetName}}
                        <span class="tw-ml-auto tw-text-[0.75rem] tw-text-[var(--wh40k-card-muted)] tw-truncate tw-max-w-[12rem]" data-hit-target>{{hit.targetName}}</span>
                        {{/if}}
                    </div>

                    {{!-- Damage resolved at attack time (#608): which range band, table
                          result or borrowed weapon this hit's profile came from. --}}
                    {{#if hit.profileLabel}}
                    <div class="tw-flex tw-justify-between tw-items-center tw-gap-2 tw-py-1 tw-text-[0.9rem] tw-cursor-help" data-damage-profile="{{hit.profile.provenance.kind}}" data-wh40k-tooltip="modifier" data-wh40k-tooltip-data="{{hit.profileTooltip}}">
                        <span class="tw-text-[var(--wh40k-card-muted)] tw-font-medium tw-shrink-0">{{localize "WH40K.Chat.Damage.Profile"}}</span>
                        <span class="tw-font-semibold tw-text-[var(--wh40k-card-text)] tw-text-right">{{hit.profileLabel}}</span>
                    </div>
                    {{/if}}
                    <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]">
                        <span class="tw-text-[var(--wh40k-card-muted)] tw-font-medium">{{localize "WH40K.Chat.Damage.Formula"}}</span>
                        <span class="tw-font-semibold tw-text-[var(--wh40k-card-text)]">{{hit.damageRoll.formula}}</span>
                    </div>
                    <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]">
                        <span class="tw-text-[var(--wh40k-card-muted)] tw-font-medium">{{localize "WH40K.Chat.Damage.BaseDamage"}}</span>
                        <span class="tw-font-semibold tw-text-[var(--wh40k-card-text)]">{{hit.damageRoll.result}}</span>
                    </div>
                    {{#each modifiers}}
                        <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem] tw-pl-3 tw-border-l-2 tw-border-[var(--wh40k-border-color)] tw-ml-1">
                            <span class="tw-text-[var(--wh40k-card-muted)] tw-font-medium">{{@key}}</span>
                            <span class="tw-font-semibold tw-text-[var(--wh40k-card-text)]">{{this}}</span>
                        </div>
                    {{/each}}

                    {{! Damage Display }}
                    {{> systems/wh40k-rpg/templates/chat/partial/wounds-callout.hbs
                        labelKey="WH40K.Weapon.Damage"
                        badge=(hitLocationLabel hit.location)
                        value=hit.totalDamage
                        caption=hit.damageType
                        valueShadowClass="tw-shadow-[0_0_10px_rgba(139,0,0,0.5)]"
                        captionColorClass="tw-text-[color:var(--wh40k-card-muted)]"}}

                    {{! Penetration }}
                    <div class="tw-flex tw-justify-between tw-items-center tw-px-3.5 tw-py-2.5 tw-my-2 tw-bg-[var(--wh40k-warning-bg)] tw-border-l-[3px] tw-border-[var(--wh40k-warning-primary)] tw-rounded-[0_4px_4px_0]">
                        <span class="tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[var(--wh40k-warning-secondary)]">{{localize "WH40K.Combat.Penetration"}}</span>
                        <span class="tw-text-[1.1rem] tw-font-bold tw-text-[var(--wh40k-card-text)]">{{hit.totalPenetration}}</span>
                    </div>

                    {{! Fatigue the hit adds, with its source (a grapple's Damage Opponent, #665) }}
                    {{#if (gt hit.totalFatigue 0)}}
                    <div class="tw-flex tw-justify-between tw-items-center tw-gap-2 tw-px-3.5 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-[3px] tw-border-[var(--wh40k-border-color)] tw-rounded-[0_4px_4px_0]" data-damage-fatigue>
                        <span class="tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[var(--wh40k-card-muted)]">
                            {{localize "WH40K.Chat.Damage.Fatigue"}}
                            {{#if hit.fatigueSource}}<span class="tw-block tw-text-[0.7rem] tw-normal-case tw-opacity-80" data-damage-fatigue-source>{{hit.fatigueSource}}</span>{{/if}}
                        </span>
                        <span class="tw-shrink-0 tw-tabular-nums tw-text-[1.1rem] tw-font-bold tw-text-[var(--wh40k-card-text)]" data-damage-fatigue-value>{{signedNumber hit.totalFatigue}}</span>
                    </div>
                    {{/if}}

                    {{! Effective damage vs target — auto-calculated from the target's armour + TB (#247) }}
                    {{#if hit.hasEffective}}
                    {{!-- The label column shrinks and wraps; the value never does, so a
                          two- or three-digit Effective value stays on one line (#615). --}}
                    <div class="tw-flex tw-justify-between tw-items-center tw-gap-2 tw-px-3.5 tw-py-2.5 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-[3px] tw-border-[var(--wh40k-card-gold)] tw-rounded-[0_4px_4px_0]" data-damage-effective>
                        <span class="tw-min-w-0 tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[var(--wh40k-card-muted)]">
                            {{#if @root.targetName}}{{localize "WH40K.Chat.Damage.EffectiveVs" target=@root.targetName}}{{else}}{{localize "WH40K.Chat.Damage.Effective"}}{{/if}}
                            <span class="tw-block tw-text-[0.7rem] tw-normal-case tw-opacity-80">{{localize "WH40K.Chat.Damage.AfterArmour" armour=hit.effectiveArmour toughness=hit.effectiveTb}}</span>
                            {{#if hit.armourIgnored}}
                                <span class="tw-block tw-text-[0.7rem] tw-normal-case tw-text-[var(--wh40k-warning-secondary)] tw-cursor-help" data-armour-ignored data-tooltip="{{localize 'WH40K.Chat.Damage.ArmourIgnoredWarpWeaponTooltip'}}">{{localize "WH40K.Chat.Damage.ArmourIgnoredWarpWeapon"}}</span>
                            {{/if}}
                        </span>
                        {{#if hit.effectiveAbsorbed}}
                        <span class="tw-shrink-0 tw-whitespace-nowrap tw-text-[0.95rem] tw-font-bold tw-text-[var(--wh40k-card-muted)]" title="{{localize 'WH40K.Chat.Damage.AbsorbedTooltip'}}">{{localize "WH40K.Chat.Damage.Absorbed"}}</span>
                        {{else}}
                        <span class="tw-shrink-0 tw-whitespace-nowrap tw-tabular-nums tw-text-[1.3rem] tw-font-bold tw-text-[var(--wh40k-card-gold)]" data-damage-effective-value>{{hit.effectiveDamage}}</span>
                        {{/if}}
                    </div>
                    {{/if}}

                    {{! Effects }}
                    {{#each hit.effects as |effect|}}
                        <div class="tw-flex tw-items-start tw-gap-2 tw-py-1.5 tw-text-[0.85rem]">
                            <span class="tw-font-semibold tw-text-[var(--wh40k-card-gold)] tw-shrink-0">{{effect.name}}</span>
                            <span class="tw-text-[var(--wh40k-card-text)] tw-opacity-90">{{effect.effect}}</span>
                        </div>
                    {{/each}}

                    {{! Righteous Fury }}
                    {{! Each trigger rolls its critical level (fury.roll) and looks up its effect. }}
                    {{#each hit.righteousFury as |fury|}}
                        <div class="tw-my-2 tw-p-3 tw-bg-[var(--wh40k-fate-bg)] tw-border-2 tw-border-[var(--wh40k-card-gold)] tw-rounded-md tw-text-center tw-animate-[fury-glow_1.5s_ease-in-out_infinite_alternate]" data-righteous-fury>
                            <div class="tw-font-display tw-text-base tw-font-bold tw-text-[var(--wh40k-card-gold)] tw-uppercase tw-tracking-[0.15em] tw-shadow-[0_0_10px_rgba(255,215,0,0.5)]">⚡ {{localize "WH40K.RighteousFury.Triggered"}} ⚡</div>
                            <div class="tw-text-[0.85rem] tw-text-[var(--wh40k-card-text)] tw-mt-2 tw-leading-[1.4]">{{localize "WH40K.RighteousFury.CriticalLevel"}} {{fury.roll.total}}{{#if fury.effect}}: {{fury.effect}}{{/if}}</div>
                        </div>
                    {{/each}}

                    {{! Replace Damage Die With DoS (#129 — DH2 core L10398-10414) }}
                    {{#if @root.canReplaceDie}}
                        {{#if (gt hit.dos 0)}}
                            <div class="tw-flex tw-gap-1.5 tw-px-4 tw-py-2 tw-mt-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-t tw-border-[var(--wh40k-border-color)]">
                                <button
                                    class="roll-control__replace-damage-die tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-px-3 tw-py-2 tw-bg-amber-500/20 tw-border tw-border-[var(--wh40k-card-gold)] tw-rounded-md tw-text-[var(--wh40k-card-gold)] tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-cursor-pointer tw-whitespace-nowrap tw-transition-all hover:tw-bg-amber-500/30 hover:tw-shadow-[0_0_12px_rgba(255,191,0,0.4)] hover:-tw-translate-y-px active:tw-translate-y-0"
                                    data-action="replaceDamageDieWithDoS"
                                    data-roll-id="{{@root.rollId}}"
                                    data-hit-index="{{@index}}"
                                    data-dos="{{hit.dos}}"
                                    title="{{localize 'WH40K.Chat.Damage.DamageDieTooltip' dos=hit.dos}}"
                                >
                                    <span class="material-icons">cached</span>
                                    <span>{{localize "WH40K.DamageDieReplacement.ButtonLabel"}} ({{hit.dos}})</span>
                                </button>
                            </div>
                        {{/if}}
                    {{/if}}

                    {{! Assign Damage — auto-applied (#248) hides the manual button. An area hit
                        (#599) carries its own creature; every other hit goes to the card's target. }}
                    {{#if (or hit.targetUuid @root.targetActor)}}
                        {{#if @root.autoApplied}}
                        <div class="tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-px-4 tw-py-2.5 tw-mt-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-t tw-border-[var(--wh40k-border-color)] tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[var(--wh40k-card-muted)]">
                            <span class="material-icons tw-text-[var(--wh40k-card-gold)]">check_circle</span>
                            <span>{{localize "WH40K.Chat.Damage.AppliedAutomatically"}}</span>
                        </div>
                        {{else}}
                        <div class="tw-flex tw-gap-1.5 tw-px-4 tw-py-2.5 tw-mt-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-t tw-border-[var(--wh40k-border-color)]">
                            <button
                                class="roll-control__assign-damage tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-px-3 tw-py-2 tw-bg-[var(--wh40k-wounds-bg)] tw-border tw-border-[var(--wh40k-wounds-border)] tw-rounded-md tw-text-[var(--wh40k-wounds-secondary)] tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-cursor-pointer tw-whitespace-nowrap tw-transition-all hover:tw-bg-[rgba(139,0,0,0.2)] hover:tw-border-[var(--wh40k-wounds-primary)] hover:tw-shadow-[0_0_12px_rgba(139,0,0,0.4)] hover:-tw-translate-y-px active:tw-translate-y-0"
                                data-location="{{hit.location}}"
                                data-total-damage="{{hit.totalDamage}}"
                                data-total-penetration="{{hit.totalPenetration}}"
                                data-total-fatigue="{{hit.totalFatigue}}"
                                data-target-uuid="{{#if hit.targetUuid}}{{hit.targetUuid}}{{else}}{{@root.targetActor.uuid}}{{/if}}"
                                data-damage-type="{{hit.damageType}}"
                                data-is-explosive="{{hit.isExplosive}}"
                                data-armour-ignored="{{hit.armourIgnored}}"
                            >
                                <span class="material-icons">api</span>
                                <span>{{localize "WH40K.Combat.AssignDamage"}}</span>
                            </button>
                        </div>
                        {{/if}}
                    {{/if}}
                </div>
            {{/each}}

            {{!-- A grenade's rider (#622): a grenade that deals damage throws, scatters and
                  rolls its damage like any weapon, and its rider then applies to everyone
                  the blast struck — listed here after the damage it follows. --}}
            {{#if damageRider}}
                <div class="tw-my-3 tw-p-3 tw-rounded-md tw-border tw-border-[rgba(201,162,39,0.35)] tw-bg-[rgba(15,12,8,0.9)]" data-damage-rider data-wh40k-surface="dark">
                    <div class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
                        <i class="fas fa-bomb tw-text-[color:var(--wh40k-card-gold)]" aria-hidden="true"></i>
                        <span class="tw-font-display tw-uppercase tw-tracking-[0.12em] tw-text-[0.85rem] tw-text-[color:var(--wh40k-card-gold)]">{{localize "WH40K.GrenadeRider.FollowsDamage"}}</span>
                    </div>
                    {{#if damageRider.struck.length}}
                        <div class="tw-text-[0.8rem] tw-text-[#9a9a8a] tw-mb-2" data-damage-rider-struck>
                            {{localize "WH40K.GrenadeRider.Struck"}}: <span class="tw-text-[#e8e4d9]">{{join damageRider.struck ", "}}</span>
                        </div>
                    {{/if}}
                    {{> systems/wh40k-rpg/templates/chat/partial/grenade-rider-summary.hbs rider=damageRider.rider canResolve=damageRider.canResolve rollId=rollId}}
                </div>
            {{/if}}
{{/systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs}}
