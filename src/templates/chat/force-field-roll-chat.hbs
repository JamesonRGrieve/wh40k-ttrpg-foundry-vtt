{{! Rogue Trader Force Field Roll Card - Modern Design }}
{{#> systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs
    overline=actor.name
    title=forceField.name
    subtitle=(localize "WH40K.Chat.ForceField.Activation")
    playerRolledBadge=isManualRoll
    bgClass="tw-bg-[var(--wh40k-panel-bg-solid)]"
    gameSystem=gameSystem}}
            {{#if isTargetOnly}}
                <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]">
                    <span class="tw-text-[color:var(--wh40k-text-muted)] tw-font-medium">{{localize "WH40K.Chat.ForceField.ProtectionRating"}}</span>
                    <span class="tw-font-semibold tw-text-[color:var(--wh40k-text-dark)]">{{protectionRating}}</span>
                </div>
                <div class="tw-text-center tw-px-3 tw-py-2 tw-my-2 tw-bg-[rgba(201,162,39,0.08)] tw-border tw-border-dashed tw-border-[rgba(201,162,39,0.3)] tw-rounded-md tw-text-[0.8rem] tw-italic tw-text-[color:var(--wh40k-text-muted)]">
                    {{localize "WH40K.Chat.Roll.AwaitingPhysicalRoll"}}
                </div>
            {{else}}
                {{! The full resolution (#645): the d100 against the protection rating, and the overload band it was checked against. }}
                <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]" data-wh40k-hook="force-field-formula">
                    <span class="tw-text-[color:var(--wh40k-text-muted)] tw-font-medium">{{localize "WH40K.Chat.ForceField.ProtectionRoll"}}</span>
                    <span class="tw-font-semibold tw-text-[color:var(--wh40k-text-dark)]">{{localize "WH40K.Chat.ForceField.ProtectionFormula" roll=roll.total rating=protectionRating}}</span>
                </div>
                <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]" data-wh40k-hook="force-field-overload-band">
                    <span class="tw-text-[color:var(--wh40k-text-muted)] tw-font-medium">{{localize "WH40K.Chat.ForceField.OverloadCheck"}}</span>
                    <span class="tw-font-semibold tw-text-[color:var(--wh40k-text-dark)]">{{localize "WH40K.Chat.ForceField.OverloadBand" roll=roll.total min=overloadMin max=overloadRating}}</span>
                </div>
                {{#if overload}}
                    {{!-- Warning tokens, so the alarm reads on the parchment message on either theme
                          (a fixed #ffd700 on the fate wash measured 1.2:1, #698). --}}
                    <div class="tw-my-2 tw-p-3 tw-bg-[var(--wh40k-warning-bg)] tw-border-2 tw-border-[var(--wh40k-warning-secondary)] tw-rounded-md tw-text-center" data-force-field-overload>
                        <div class="tw-font-display tw-text-[1rem] tw-font-bold tw-text-[var(--wh40k-warning-secondary)] tw-uppercase tw-tracking-[0.15em]">⚠ {{localize "WH40K.Chat.ForceField.Overload"}} ⚠</div>
                        <div class="tw-text-[0.85rem] tw-text-[color:var(--wh40k-text-dark)] tw-mt-2 tw-leading-[1.4]">{{localize "WH40K.Chat.ForceField.OverloadDetail"}}</div>
                    </div>
                {{/if}}

                {{#if success}}
                    {{> systems/wh40k-rpg/templates/chat/partial/result-callout.hbs
                        variant="success"
                        label=(localize "WH40K.Chat.ForceField.FieldActivated")
                        value=roll.total
                        valueShadowClass="tw-[text-shadow:0_2px_8px_var(--wh40k-shadow-medium)]"}}
                    <div class="tw-px-3 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-2 tw-border-l-[color:var(--wh40k-gold)] tw-border-l-gold bc:tw-border-l-crimson-light dh1:tw-border-l-gold-raw-l5 dh2:tw-border-l-gold-raw dw:tw-border-l-accent-combat ow:tw-border-l-brass-l20 rt:tw-border-l-void-l20 im:tw-border-l-failure tw-rounded-r tw-text-[0.85rem] tw-leading-[1.5] tw-max-h-[150px] tw-overflow-y-auto [&_p]:tw-m-0 [&_p]:tw-mb-2 [&_p:last-child]:tw-mb-0">
                        <p>{{localize "WH40K.Chat.ForceField.Activated"}}</p>
                    </div>
                {{else}}
                    {{> systems/wh40k-rpg/templates/chat/partial/result-callout.hbs
                        variant="danger"
                        label=(localize "WH40K.Chat.ForceField.FieldFailed")
                        value=roll.total
                        valueShadowClass="tw-[text-shadow:0_2px_8px_var(--wh40k-shadow-medium)]"}}
                    <div class="tw-px-3 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-2 tw-border-l-[color:var(--wh40k-gold)] tw-rounded-r tw-text-[0.85rem] tw-leading-[1.5] tw-max-h-[150px] tw-overflow-y-auto [&_p]:tw-m-0 [&_p]:tw-mb-2 [&_p:last-child]:tw-mb-0">
                        <p>{{localize "WH40K.Chat.ForceField.Failed"}}</p>
                    </div>
                {{/if}}

                {{#if forceField.system.description.value}}
                    <div class="tw-h-px tw-bg-[linear-gradient(90deg,transparent_0%,var(--wh40k-gold)_20%,var(--wh40k-gold)_80%,transparent_100%)] tw-my-2.5 tw-opacity-50"></div>
                    {{!-- The rules text prints whole (#701): a 150px cap with an inner scrollbar cut it off mid-sentence in the chat log. --}}
                    <div class="tw-px-3 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-2 tw-border-l-[color:var(--wh40k-gold)] tw-rounded-r tw-text-[0.85rem] tw-leading-[1.5] [&_p]:tw-m-0 [&_p]:tw-mb-2 [&_p:last-child]:tw-mb-0" data-wh40k-hook="force-field-description">{{{forceField.system.description.value}}}</div>
                {{/if}}
            {{/if}}{{! end isTargetOnly else }}
{{/systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs}}