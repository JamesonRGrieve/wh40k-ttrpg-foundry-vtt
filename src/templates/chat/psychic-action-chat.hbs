{{!-- Rogue Trader Psychic Action Card - Modern Design --}}
{{#> systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs
    overline=label
    title=rollData.name
    subtitle=rollData.action
    subtitle2=rollData.effectString}}
            {{#with rollData}}
                {{> systems/wh40k-rpg/templates/chat/partial/modifier-breakdown.hbs baseTarget=baseTarget activeModifiers=activeModifiers modifierSources=modifierSources modifiedTarget=modifiedTarget modifierCapFired=modifierCapFired rawModifierTotal=rawModifierTotal modifierTotal=modifierTotal}}

                {{> systems/wh40k-rpg/templates/chat/partial/card-target-row.hbs target=targetActor}}

                {{!-- Effects --}}
                {{#each @root.effectOutput as |effect|}}
                    <div class="tw-flex tw-items-start tw-gap-[var(--wh40k-space-sm)] tw-py-1.5 tw-text-[0.85rem]">
                        <span class="tw-font-semibold tw-text-[color:var(--wh40k-card-gold)] tw-shrink-0">{{effect.name}}</span>
                        <span class="tw-text-[var(--wh40k-card-text)] tw-opacity-90">{{effect.effect}}</span>
                    </div>
                {{/each}}

                {{!-- Opposed Roll --}}
                {{#if isOpposed}}
                    <div class="tw-flex tw-justify-between tw-items-center tw-py-1 tw-text-[0.9rem]">
                        <span class="tw-text-[var(--wh40k-card-muted)] tw-font-medium">{{localize "WH40K.Chat.Roll.Opposed"}} {{opposedChar}}</span>
                        <span class="tw-font-semibold tw-text-[var(--wh40k-card-text)]">{{opposedRoll.total}} {{localize "WH40K.Common.Versus"}} {{opposedTarget}} {{#if opposedSuccess}}({{opposedDos}} {{localize "WH40K.Chat.Roll.DoS"}}){{/if}}</span>
                    </div>
                {{/if}}

                {{!-- Degrees & Result --}}
                {{#if success}}
                    <div class="tw-flex tw-justify-center tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-mt-2 tw-px-4 tw-py-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md">
                        <span class="tw-text-[1.5rem] tw-font-bold tw-text-[var(--wh40k-success-secondary)]" data-wh40k-hook="degrees-count">{{#if printedDegrees}}{{printedDegrees.dos}}{{else}}{{dos}}{{/if}}</span>
                        <span class="tw-text-[0.8rem] tw-uppercase tw-tracking-[0.1em] tw-opacity-80">{{localize "WH40K.Roll.DegreesOfSuccess"}}</span>
                    </div>
                    {{> systems/wh40k-rpg/templates/chat/partial/result-callout.hbs
                        variant="success"
                        label=(localize "WH40K.Psychic.PowerManifested")
                        value=roll.total}}
                {{else}}
                    <div class="tw-flex tw-justify-center tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-mt-2 tw-px-4 tw-py-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md">
                        <span class="tw-text-[1.5rem] tw-font-bold tw-text-[var(--wh40k-danger-secondary)]" data-wh40k-hook="degrees-count">{{#if printedDegrees}}{{printedDegrees.dof}}{{else}}{{dof}}{{/if}}</span>
                        <span class="tw-text-[0.8rem] tw-uppercase tw-tracking-[0.1em] tw-opacity-80">{{localize "WH40K.Roll.DegreesOfFailure"}}</span>
                    </div>
                    {{> systems/wh40k-rpg/templates/chat/partial/result-callout.hbs
                        variant="danger"
                        label=(localize "WH40K.Psychic.PowerFailed")
                        value=roll.total}}
                {{/if}}
                {{> systems/wh40k-rpg/templates/chat/partial/result-formula.hbs}}

                {{!-- Controls: wrap onto a second line in the 300px chat log instead of clipping the last button (buttons size to their label). --}}
                <div data-wh40k-hook="psychic-card-controls" class="tw-flex tw-flex-wrap tw-gap-1.5 [&>button]:tw-flex-auto tw-px-2 tw-py-2.5 tw-mt-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-t tw-border-[var(--wh40k-border-color)]">
                    {{#if success}}
                        <button class="roll-control__hide-control tw-flex-1 {{chatActionButton 'wounds'}}" data-toggle="{{@root.id}}">
                            <span class="material-icons tw-text-[16px]">bolt</span>
                            <span>{{localize "WH40K.Tabs.Effect"}}</span>
                        </button>
                    {{else}}
                        <button class="tw-flex-1 {{chatActionButton 'inert'}}">
                            <span class="material-icons tw-text-[16px]">bolt</span>
                            <span>{{localize "WH40K.Tabs.Effect"}}</span>
                        </button>
                    {{/if}}
                    {{#if success}}
                        <button class="roll-control__fate-add-dos tw-flex-1 {{chatActionButton 'powers'}}" data-roll-id="{{@root.id}}">
                            <span class="material-icons tw-text-[16px]">add_circle</span>
                            <span>{{localize "WH40K.FateAddDoS"}}</span>
                        </button>
                    {{/if}}
                    {{> systems/wh40k-rpg/templates/chat/partial/reroll-controls.hbs rerollOptions=@root.rerollOptions rollId=@root.id}}
                </div>
            {{/with}}

            {{!-- Collapsible Effect --}}
            {{#if rollData.success}}
                <div id="{{@root.id}}" class="tw-mt-2" hidden>
                    <div class="tw-relative tw-h-3 tw-my-2.5 tw-opacity-50 [&::before]:tw-content-['⬥'] [&::before]:tw-absolute [&::before]:tw-left-1/2 [&::before]:tw-top-1/2 [&::before]:-tw-translate-x-1/2 [&::before]:-tw-translate-y-1/2 [&::before]:tw-text-[color:var(--wh40k-card-gold)] [&::before]:tw-text-[10px] [&::after]:tw-content-[''] [&::after]:tw-absolute [&::after]:tw-top-1/2 [&::after]:tw-left-[10%] [&::after]:tw-right-[10%] [&::after]:tw-h-px [&::after]:tw-bg-[linear-gradient(90deg,transparent_0%,var(--wh40k-card-gold)_30%,transparent_48%,transparent_52%,var(--wh40k-card-gold)_70%,transparent_100%)]"></div>
                    <div class="tw-px-3 tw-py-2 tw-my-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-l-2 tw-border-l-gold tw-rounded-r tw-text-[0.85rem] tw-leading-relaxed tw-max-h-[150px] tw-overflow-y-auto">{{{psychicEffect}}}</div>
                </div>
            {{/if}}
{{/systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs}}
