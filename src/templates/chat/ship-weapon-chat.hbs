{{!--
    Rogue Trader ship weapon card (#184 — RT Core 1.4 errata, Chapter VIII).

    Always shows the Weapon Component's firing profile. When a shot was fired
    at a target ship (the voidcraft sheet's Fire dialog), it also prints the
    full derivation, each term hoverable to its rule:
      • the gunner's Ballistic Skill Test — base ± ship actions ± range ± GM = target, the roll and its degrees;
      • the hits — 1 + degrees (lance: per 3), capped at Strength, minus the target's void shields;
      • the Hull Integrity damage — each hit's roll, minus Armour (a lance ignores it), plus a critical's automatic point;
      • any Critical Hit roll, and the target's vitals before and after.
    A combined macrobattery salvo (RT Core p.221) prints each battery's own test
    and hits, then the pooled hits with the shields' discards by battery, one
    damage total against Armour, and at most one Critical Hit.

    Context:
      weapon        — {name, img, typeLabel, locationLabel, strength, damage, crit, range}
      gameSystem    — the firing ship's line, for per-system variants
      attackerName / defenderName
      fired         — a shot was resolved (false/absent on a profile-only card)
      test          — AssaultTestView of the clicked weapon
      salvo         — {title, batteries [{test, hits}]} | null
      hits, damage  — AssaultDamageView | null (a salvo's hits are the pooled ones)
      missed, allShielded, critical, salvoCriticalLimit, crippledCriticals [string], vitalsTitle, vitals [{label, before, after}], applied, unapplied
--}}
<div data-wh40k-hook="ship-weapon-card" class="wh40k-rpg wh40k-ship-weapon-card tw-p-4 tw-rounded-md tw-border-2 {{themeClassFor 'border'}} tw-bg-[rgba(8,16,28,0.92)] tw-text-[#ece8de] tw-font-ui"
     data-wh40k-system="{{gameSystem}}">
    <header class="tw-flex tw-items-center tw-gap-3 tw-mb-2">
        {{#if weapon.img}}<img class="tw-w-10 tw-h-10 tw-flex-none tw-rounded-sm tw-border-0" src="{{weapon.img}}" alt="{{weapon.name}}" />{{/if}}
        <div class="tw-flex tw-flex-col tw-min-w-0">
            <span class="tw-font-display tw-uppercase tw-tracking-[0.1em] tw-text-[1rem] tw-text-amber-200">{{weapon.name}}</span>
            <span class="tw-text-[0.8rem] tw-uppercase tw-tracking-wide tw-text-amber-100">{{weapon.typeLabel}} &bull; {{weapon.locationLabel}}</span>
        </div>
    </header>

    {{#if defenderName}}
        <div class="tw-text-[0.95rem] tw-mb-2">
            <strong class="tw-text-amber-200">{{attackerName}}</strong>
            <span class="tw-mx-1 tw-text-amber-400" aria-hidden="true">→</span>
            <strong class="tw-text-amber-200" data-wh40k-hook="ship-weapon-target">{{defenderName}}</strong>
        </div>
    {{/if}}

    {{!-- 2 × 2 so the labels never break mid-word in the narrow chat sidebar. Each value sets its own
         colour: the chat log's message styles would otherwise darken an inherited one. --}}
    <dl class="tw-grid tw-grid-cols-2 tw-gap-x-3 tw-gap-y-1 tw-m-0 tw-mb-2 tw-p-2 tw-rounded-sm tw-border tw-border-[rgba(251,191,36,0.3)] tw-bg-[rgba(0,0,0,0.25)] tw-text-[0.85rem]">
        <div class="tw-flex tw-justify-between tw-gap-2">
            <dt class="tw-m-0 tw-text-[0.7rem] tw-uppercase tw-tracking-wide tw-text-amber-200">{{localize "WH40K.Voidcraft.Combat.Strength"}}</dt>
            <dd class="tw-m-0 tw-font-semibold tw-tabular-nums tw-text-[#ece8de]">{{weapon.strength}}</dd>
        </div>
        <div class="tw-flex tw-justify-between tw-gap-2">
            <dt class="tw-m-0 tw-text-[0.7rem] tw-uppercase tw-tracking-wide tw-text-amber-200">{{localize "WH40K.Voidcraft.Combat.DamageLabel"}}</dt>
            <dd class="tw-m-0 tw-font-semibold tw-tabular-nums tw-text-[#ece8de]">{{weapon.damage}}</dd>
        </div>
        <div class="tw-flex tw-justify-between tw-gap-2">
            <dt class="tw-m-0 tw-text-[0.7rem] tw-uppercase tw-tracking-wide tw-text-amber-200">{{localize "WH40K.Voidcraft.Combat.CritLabel"}}</dt>
            <dd class="tw-m-0 tw-font-semibold tw-tabular-nums tw-text-[#ece8de]">{{weapon.crit}}</dd>
        </div>
        <div class="tw-flex tw-justify-between tw-gap-2">
            <dt class="tw-m-0 tw-text-[0.7rem] tw-uppercase tw-tracking-wide tw-text-amber-200">{{localize "WH40K.Voidcraft.Combat.RangeLabel"}}</dt>
            <dd class="tw-m-0 tw-font-semibold tw-tabular-nums tw-text-[#ece8de]">{{weapon.range}}</dd>
        </div>
    </dl>

    {{#if fired}}
        {{#if salvo}}
            <p data-wh40k-hook="ship-weapon-salvo" class="tw-m-0 tw-mb-2 tw-text-[0.85rem] tw-font-semibold tw-text-amber-200">{{salvo.title}}</p>
            {{#each salvo.batteries as |battery|}}
                {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-test.hbs test=battery.test}}
                {{#if battery.hits}}
                    {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-damage.hbs damage=battery.hits}}
                {{/if}}
            {{/each}}
        {{else}}
            {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-test.hbs test=test}}
        {{/if}}

        {{#if missed}}
            <p class="tw-m-0 tw-mb-2 tw-text-[0.85rem] tw-text-amber-100">{{localize "WH40K.Voidcraft.Fire.Missed" ship=defenderName}}</p>
        {{/if}}
        {{#if hits}}
            {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-damage.hbs damage=hits}}
        {{/if}}
        {{#if allShielded}}
            <p class="tw-m-0 tw-mb-2 tw-text-[0.85rem] tw-text-amber-100">{{localize "WH40K.Voidcraft.Fire.AllShielded" ship=defenderName}}</p>
        {{/if}}
        {{#if damage}}
            {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-damage.hbs damage=damage}}
        {{/if}}
        {{#if critical}}
            <p data-wh40k-hook="ship-weapon-critical" class="tw-m-0 tw-mb-2 tw-px-2 tw-py-1 tw-rounded-sm tw-border tw-border-[rgba(248,113,113,0.6)] tw-bg-[rgba(127,29,29,0.35)] tw-text-[0.9rem] tw-font-semibold tw-text-red-100">
                <i class="fas fa-burst" aria-hidden="true"></i> {{critical}}
                {{#if salvoCriticalLimit}}<span class="tw-block tw-text-[0.8rem] tw-font-normal">{{localize "WH40K.Voidcraft.Fire.SalvoCriticalLimit"}}</span>{{/if}}
            </p>
        {{/if}}
        {{#each crippledCriticals as |line|}}
            {{!-- A Crippled target's Critical Hit from damage past its Armour (RT Core "Crippled Ships", #187). --}}
            <p data-wh40k-hook="ship-weapon-crippled-critical" class="tw-m-0 tw-mb-2 tw-px-2 tw-py-1 tw-rounded-sm tw-border tw-border-[rgba(251,191,36,0.6)] tw-bg-[rgba(120,53,15,0.4)] tw-text-[0.9rem] tw-font-semibold tw-text-amber-100">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{line}}
            </p>
        {{/each}}

        <table data-wh40k-hook="ship-weapon-vitals" class="tw-w-full tw-m-0 tw-border-collapse tw-text-[0.85rem]">
            <caption class="tw-text-left tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200 tw-pb-1">{{vitalsTitle}}</caption>
            <thead>
                <tr class="tw-text-[0.7rem] tw-uppercase tw-tracking-wide tw-text-amber-100">
                    <th scope="col" class="tw-text-left tw-font-semibold tw-py-0.5"></th>
                    <th scope="col" class="tw-text-right tw-font-semibold tw-py-0.5 tw-whitespace-nowrap">{{localize "WH40K.Voidcraft.Fire.Vitals.Before"}}</th>
                    {{#if applied}}<th scope="col" class="tw-text-right tw-font-semibold tw-py-0.5 tw-pl-2 tw-whitespace-nowrap">{{localize "WH40K.Voidcraft.Fire.Vitals.After"}}</th>{{/if}}
                </tr>
            </thead>
            <tbody>
                {{#each vitals as |row|}}
                    <tr class="tw-border-0 tw-border-t tw-border-solid tw-border-[rgba(251,191,36,0.2)]">
                        <th scope="row" class="tw-text-left tw-font-medium tw-py-0.5 tw-break-normal tw-text-[#ece8de]">{{row.label}}</th>
                        <td class="tw-text-right tw-tabular-nums tw-py-0.5 tw-whitespace-nowrap tw-text-[#ece8de]">{{row.before}}</td>
                        {{#if ../applied}}<td class="tw-text-right tw-tabular-nums tw-py-0.5 tw-pl-2 tw-whitespace-nowrap tw-font-semibold tw-text-amber-200">{{row.after}}</td>{{/if}}
                    </tr>
                {{/each}}
            </tbody>
        </table>

        {{#if unapplied}}
            <p class="tw-m-0 tw-mt-2 tw-text-[0.8rem] tw-italic tw-text-amber-200">{{localize "WH40K.Voidcraft.Fire.NotApplied"}}</p>
        {{/if}}
    {{/if}}
</div>
