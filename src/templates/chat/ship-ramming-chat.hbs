{{!-- Rogue Trader Ramming chat card (#188). --}}
{{!-- The Hard (−20) Pilot + Manoeuvrability test, then both ships' collision damage (void shields ignored). --}}
<div data-wh40k-hook="ship-ramming-card" data-wh40k-surface="dark" class="wh40k-rpg tw-p-4 tw-rounded-md tw-border-2 {{themeClassFor 'border'}} tw-bg-[rgba(8,16,28,0.9)] tw-text-[#e8e4d9]"
     data-wh40k-system="{{gameSystem}}">
    <header class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
        <i class="fas fa-meteor tw-text-[1.1rem] tw-text-amber-300"></i>
        <div class="tw-font-display tw-uppercase tw-tracking-[0.12em] tw-text-[0.95rem] tw-text-amber-200">
            {{localize "WH40K.Voidcraft.Ramming.ChatTitle"}}
        </div>
    </header>

    <div class="tw-text-[0.95rem] tw-mb-3">
        <strong class="tw-text-amber-200">{{attackerName}}</strong>
        <span class="tw-mx-1 tw-text-amber-400">→</span>
        <strong class="tw-text-amber-200">{{defenderName}}</strong>
    </div>

    {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-test.hbs test=test}}

    {{#if defenderDamage}}
        {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-damage.hbs damage=defenderDamage}}
        {{> systems/wh40k-rpg/templates/chat/partial/ship-assault-damage.hbs damage=attackerDamage}}
    {{else}}
        <p class="tw-m-0 tw-text-[0.85rem] tw-text-amber-100">{{localize "WH40K.Voidcraft.Ramming.MissExplain"}}</p>
    {{/if}}

    {{#if unapplied}}
        <p class="tw-m-0 tw-mt-2 tw-text-[0.8rem] tw-italic tw-text-amber-200">{{localize "WH40K.Voidcraft.Assault.NotApplied"}}</p>
    {{/if}}
</div>
