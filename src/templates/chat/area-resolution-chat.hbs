{{!-- Area attack resolution (#599): who the template caught, each creature's
      avoidance test (base ± provenance = target, roll) or plain hit, and the Roll
      Damage that rolls one hit per creature hit. A weapon that deals no damage
      (smoke, stun, #601) lists who it caught for its qualities and rolls nothing. --}}
{{#> systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs
    overline=(localize "WH40K.AreaAttack.ResultsTitle")
    title=weaponName}}
    {{> systems/wh40k-rpg/templates/chat/partial/area-attack-summary.hbs summary=summary results=results}}
    {{!-- Those aboard a vehicle that shelters its crew are out of the area (content#28). --}}
    {{#if sheltered.length}}
        <ul class="tw-m-0 tw-mt-2 tw-flex tw-flex-col tw-gap-1 tw-list-none tw-px-4 tw-py-2 tw-text-[0.8rem] tw-text-[var(--wh40k-card-muted)]" data-area-sheltered>
            {{#each sheltered as |line|}}
                <li class="tw-flex tw-items-center tw-gap-1.5"><i class="fas fa-shield-halved" aria-hidden="true"></i><span>{{line}}</span></li>
            {{/each}}
        </ul>
    {{/if}}
    {{#if anyHit}}
        <div class="tw-flex tw-flex-col tw-gap-1.5 tw-px-4 tw-py-2.5 tw-mt-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border-t tw-border-[var(--wh40k-border-color)]">
            {{#if noDamage}}
            {{> systems/wh40k-rpg/templates/chat/partial/no-damage-note.hbs}}
            {{else}}
            <button class="roll-control__roll-damage tw-flex-none tw-w-full {{chatActionButton 'wounds'}}" data-roll-id="{{rollId}}">
                <span class="material-icons tw-text-[16px]" aria-hidden="true">bolt</span>
                <span>{{localize "WH40K.Weapon.RollDamage"}}</span>
            </button>
            {{/if}}
        </div>
    {{/if}}
{{/systems/wh40k-rpg/templates/chat/partial/roll-card-shell.hbs}}
