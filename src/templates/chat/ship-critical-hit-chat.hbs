{{! Rogue Trader Ship Critical Hit Chart Result Card (issue #187) }}
{{#> systems/wh40k-rpg/templates/chat/partial/chat-card-shell.hbs
    cardClass="wh40k-ship-crit-card"
    outerExtraClass="tw-overflow-hidden tw-rounded-md tw-font-ui"
    image=image
    imageAlt=resultName
    title=resultName
    subtitle=(localize "WH40K.Voidcraft.Critical.ChatSubtitle")
    badges=(array
        (object class="tw-bg-[rgba(192,57,43,0.2)] tw-text-[#c0392b] tw-border tw-border-[rgba(192,57,43,0.35)]" icon="fa-dice-d6" label=rollLabel)
    )
    footerLabel=actorName
    footerIcon="fa-rocket"
    gameSystem=gameSystem
}}
    {{!-- The drawn Table 8-12 result's rules text, as the compendium table authors it (HTML). --}}
    <div class="tw-px-2 tw-py-2 tw-mb-2 tw-bg-[rgba(254,245,231,0.5)] tw-border-l-[3px] tw-border-l-[var(--wh40k-accent-red)] tw-rounded-md tw-leading-relaxed [&_p]:tw-m-0">
        {{{resultText}}}
    </div>

    <div class="tw-flex tw-flex-col tw-gap-1 tw-p-1.5 tw-bg-black/[0.03] tw-rounded-md tw-text-[13px]">
        <div class="tw-flex tw-items-baseline tw-gap-2">
            <span class="tw-font-semibold {{themeClassFor 'chatAccent'}}">
                <i class="fas fa-skull-crossbones"></i>
                {{localize "WH40K.Voidcraft.Critical.StatusApplied"}}
            </span>
            <span>{{statusLabel}}</span>
        </div>
        <div class="tw-text-[12px] tw-text-[#5a5a5a]">
            {{localize "WH40K.Voidcraft.Critical.PersistsUntilRepaired"}}
        </div>
        {{#if destroyedLabel}}
            {{!-- A result the table marks as destroying the ship (RT Core Table 8-12, #187). --}}
            <div data-wh40k-hook="ship-critical-destroyed" class="tw-font-bold tw-text-[#c0392b]">
                <i class="fas fa-explosion"></i> {{destroyedLabel}}
            </div>
        {{/if}}
    </div>
{{/systems/wh40k-rpg/templates/chat/partial/chat-card-shell.hbs}}
