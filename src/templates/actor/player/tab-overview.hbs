{{!-- Acolyte Sheet Overview Tab - Ultra-Dense Dashboard --}}
{{!-- At-a-glance view of all critical information --}}
<section class="tab {{#if tab.active}}active{{/if}} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    
    {{!-- Layout (#15): a TWO-column dashboard that packs like masonry. Every panel
         is its own item in a CSS multi-column flow (`columns: 22rem 2` — two
         columns, one on a narrow sheet), so panels stack under each other with no
         gaps. A row grid left a hole under the shorter column whenever a line
         added panels below it (OW Regiment / Craftsmanship sat a full row down).
         Reading order: Vitals → Active Effects → Resources → Favourites →
         Progression → the line's own panels, filling column 1 then column 2.
         The COLUMN wrappers are `display: contents` so their panels join the flow
         individually. Subtlety lives in its own full-width section (#317). --}}
    <div class="tw-p-2 tw-h-full tw-overflow-y-auto tw-overflow-x-hidden tw-border-t-2 tw-border-t-gold bc:tw-border-t-crimson-light dh1:tw-border-t-gold-raw-l5 dh2:tw-border-t-gold-raw dw:tw-border-t-accent-combat ow:tw-border-t-brass-l20 rt:tw-border-t-gold im:tw-border-t-failure">
    <div class="tw-columns-[22rem_2] tw-gap-2 [&>*]:tw-mb-2 [&>*]:tw-break-inside-avoid [&>[data-overview-column]>*]:tw-mb-2 [&>[data-overview-column]>*]:tw-break-inside-avoid" data-overview-masonry>

        {{!-- COLUMN 1: Vitals → Active Effects → Resources --}}
        <div class="tw-contents" data-overview-column>
            {{> systems/wh40k-rpg/templates/actor/panel/overview-vitals-panel.hbs}}

            {{> systems/wh40k-rpg/templates/actor/panel/overview-active-effects-panel.hbs}}

            {{#unless isNPC}}
            {{!-- Resources — PC-only; sits under Active Effects in col 1 (#15). Each line
                 shows its own acquisition currency + the throne-gelt baseline
                 (`resourceRows`, derived from WH40K.currencies). DH2 keeps its
                 ruleset-gated trio: in RAW mode Influence is a Statistics
                 characteristic, so it (and Throne Gelt) drop out and the grid collapses.
                 Fixed column counts keep the steppers side by side (#236). --}}
            {{#> systems/wh40k-rpg/templates/actor/partial/dashboard-zone title=(localize "WH40K.Resources.Title") icon="fa-coins" zoneClass="tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-color-gold)]" contentClass="tw-p-2 tw-flex-1 tw-w-full"}}
                    {{#if isDH2}}
                    <div class="tw-grid {{#if isRaw}}tw-grid-cols-1{{else if hideThroneGelt}}tw-grid-cols-2{{else}}tw-grid-cols-3{{/if}} tw-gap-2 tw-w-full">
                        {{#unless isRaw}}
                        {{#> systems/wh40k-rpg/templates/actor/partial/resource-stepper.hbs
                            label=(localize "WH40K.Currency.Influence") tooltip=(localize "WH40K.Resources.InfluenceTooltip")
                            field="system.influence" value=system.influence max=100}}
                                {{#if isHomebrew}}
                                {{!-- Issue #13 follow-up: Influence is not solely an economy stat
                                     (it gates social manipulation, audiences, Requisition tests).
                                     In Homebrew mode Influence lives here rather than Statistics,
                                     so surface a roll button that reuses the same `roll` action
                                     dispatch as the RAW characteristic row (rollType=characteristic,
                                     rollTarget=influence → actor.rollCharacteristic('influence')). --}}
                                <button type="button"
                                    class="tw-inline-flex tw-items-center tw-justify-center tw-p-0 tw-m-0 tw-bg-[var(--wh40k-btn-bg)] tw-border tw-border-solid tw-border-[var(--color-border-secondary)] tw-rounded-[6px] tw-text-[var(--color-text-primary)] tw-font-bold tw-cursor-pointer tw-w-7 tw-h-7 tw-text-base tw-select-none tw-whitespace-nowrap tw-ml-1"
                                    data-action="roll"
                                    data-roll-type="characteristic"
                                    data-roll-target="influence"
                                    data-characteristic="influence"
                                    data-tooltip="{{localize 'WH40K.CharacteristicSetup.RollInfluence'}}"
                                    aria-label="{{localize 'WH40K.CharacteristicSetup.RollInfluence'}}">
                                    <i class="fas fa-dice-d10"></i>
                                </button>
                                {{/if}}
                        {{/systems/wh40k-rpg/templates/actor/partial/resource-stepper.hbs}}
                        {{/unless}}
                        {{> systems/wh40k-rpg/templates/actor/partial/resource-stepper.hbs
                            label=(localize "WH40K.Currency.Requisition") tooltip=(localize "WH40K.Resources.RequisitionTooltip")
                            field="system.requisition" value=system.requisition}}
                        {{#unless hideThroneGelt}}
                        {{> systems/wh40k-rpg/templates/actor/partial/resource-stepper.hbs
                            label=(localize "WH40K.Currency.ThroneGelt") tooltip=(localize "WH40K.Resources.ThroneGeltTooltip")
                            field="system.throneGelt" value=system.throneGelt}}
                        {{/unless}}
                    </div>
                    {{else}}
                    <div class="tw-grid {{#if (eq resourceRows.length 1)}}tw-grid-cols-1{{else}}tw-grid-cols-2{{/if}} tw-gap-2 tw-w-full">
                        {{#each resourceRows}}
                        {{> systems/wh40k-rpg/templates/actor/partial/resource-stepper.hbs label=(localize labelKey) field=field value=value}}
                        {{/each}}
                    </div>
                    {{/if}}
            {{/systems/wh40k-rpg/templates/actor/partial/dashboard-zone}}
            {{/unless}}

            {{!-- Party Overview (DH2-only: Subtlety shared pool) --}}
            {{#if isDH2}}
            <section class="tw-flex tw-flex-col tw-overflow-hidden tw-bg-[var(--color-bg-secondary)] tw-rounded-[6px] tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-color-gold)]">
                <div class="tw-flex tw-items-center tw-gap-1.5 tw-py-1.5 tw-px-2.5 tw-bg-[linear-gradient(90deg,rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.12)_0%,var(--color-bg-tertiary)_100%)] tw-text-xs tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)] [&>i]:tw-text-[color:var(--wh40k-color-gold)]">
                    <i class="fas fa-users"></i>
                    <span>{{localize "WH40K.PartyOverview.Header"}}</span>
                </div>
                <div class="tw-p-2">
                    {{> systems/wh40k-rpg/templates/actor/panel/subtlety-panel.hbs}}
                </div>
            </section>
            {{/if}}
        </div>

        {{!-- COLUMN 2: Favourite Skills → Favourite Talents → Progression --}}
        <div class="tw-contents" data-overview-column>
            {{!-- Favourite Skills --}}
            {{#> systems/wh40k-rpg/templates/actor/partial/dashboard-zone title=(localize "WH40K.Favourites.Skills") icon="fa-star" zoneClass="tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-accent-green-bright)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-accent-green-bright)]"}}
                    <div class="tw-flex tw-flex-col tw-gap-[3px]" data-favourite-list="skills">
                        {{#if favoriteSkills}}
                            {{#each favoriteSkills as |skill|}}
                            <div class="tw-flex tw-items-center tw-gap-[6px] tw-px-1.5 tw-py-[3px] tw-bg-[var(--color-bg-option)] tw-rounded-[var(--wh40k-radius-md)]" data-tooltip
                                 draggable="true"
                                 data-favourite-key="{{skill.key}}"
                                 aria-label="{{skill.label}}: {{skill.current}}"
                                 data-wh40k-tooltip="skill"
                                 data-wh40k-tooltip-data="{{skill.tooltipData}}">
                                <i class="fas fa-grip-vertical tw-text-[0.7rem] tw-text-[color:var(--color-text-tertiary)] tw-cursor-grab active:tw-cursor-grabbing" title="{{localize 'WH40K.Common.DragToReorder'}}"></i>
                                <span class="tw-text-[0.75rem] tw-font-semibold tw-text-[color:var(--color-text-secondary)] tw-flex-1">{{skill.label}}</span>
                                <span class="tw-text-[0.85rem] tw-font-bold tw-font-alt tw-text-[color:var(--color-text-primary)] tw-min-w-[28px] tw-text-right">{{skill.current}}</span>
                                <button type="button"
                                        class="tw-w-[20px] tw-h-[20px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)]"
                                        data-action="roll"
                                        data-roll-type="skill"
                                        data-roll-target="{{skill.key}}"
                                        title="{{localize 'WH40K.Roll.Roll'}} {{skill.label}}">
                                    <i class="fas fa-dice"></i>
                                </button>
                            </div>
                            {{/each}}
                        {{else}}
                            <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-px-4 tw-py-6 tw-gap-[var(--wh40k-space-xs)] tw-text-[color:var(--color-text-tertiary)] tw-text-center tw-min-h-[120px]">
                                <i class="far fa-star"></i>
                                <p>{{localize "WH40K.Favourites.NoSkills"}}</p>
                                <p class="tw-text-[0.7rem] tw-italic tw-opacity-80">{{localize "WH40K.Favourites.StarSkillsHint"}}</p>
                            </div>
                        {{/if}}
                    </div>
            {{/systems/wh40k-rpg/templates/actor/partial/dashboard-zone}}

            {{!-- Favourite Talents --}}
            {{#> systems/wh40k-rpg/templates/actor/partial/dashboard-zone title=(localize "WH40K.Favourites.Talents") icon="fa-star-half-alt" zoneClass="tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-accent-talents)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-accent-talents)]"}}
                    <div class="tw-flex tw-flex-col tw-gap-[3px]" data-favourite-list="talents">
                        {{#if favoriteTalents}}
                            {{#each favoriteTalents as |talent|}}
                            <div class="tw-flex tw-items-center tw-gap-[6px] tw-px-1.5 tw-py-[3px] tw-bg-[var(--color-bg-option)] tw-rounded-[var(--wh40k-radius-md)]" data-tooltip
                                 draggable="true"
                                 data-favourite-key="{{talent.id}}"
                                 title="{{talent.name}}{{#if talent.specialization}} ({{talent.specialization}}){{/if}}">
                                <i class="fas fa-grip-vertical tw-text-[0.7rem] tw-text-[color:var(--color-text-tertiary)] tw-cursor-grab active:tw-cursor-grabbing" title="{{localize 'WH40K.Common.DragToReorder'}}"></i>
                                <img class="tw-w-[20px] tw-h-[20px] tw-rounded-[3px] tw-object-cover tw-shrink-0" src="{{talent.img}}" alt="{{talent.name}}" />
                                <span class="tw-text-[0.75rem] tw-font-semibold tw-text-[color:var(--color-text-secondary)] tw-flex-1 tw-flex tw-items-center tw-gap-[var(--wh40k-space-xs)]">
                                    {{talent.fullName}}
                                    {{#if talent.system.tier}}
                                    <span class="tw-text-[0.6rem] tw-font-bold tw-px-1 tw-py-[1px] tw-bg-[rgb(from_var(--wh40k-accent-talents)_r_g_b_/_0.15)] tw-border tw-border-solid tw-border-[rgb(from_var(--wh40k-accent-talents)_r_g_b_/_0.4)] tw-rounded-[3px] tw-text-[color:var(--wh40k-accent-talents)]">T{{talent.system.tier}}</span>
                                    {{/if}}
                                </span>
                                <button type="button"
                                        class="tw-w-[20px] tw-h-[20px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)]"
                                        data-action="itemEdit"
                                        data-item-id="{{talent.id}}"
                                        title="{{localize 'WH40K.View'}} {{talent.name}}">
                                    <i class="fas fa-info-circle"></i>
                                </button>
                            </div>
                            {{/each}}
                        {{else}}
                            <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-px-4 tw-py-6 tw-gap-[var(--wh40k-space-xs)] tw-text-[color:var(--color-text-tertiary)] tw-text-center tw-min-h-[120px]">
                                <i class="far fa-star"></i>
                                <p>{{localize "WH40K.Favourites.NoTalents"}}</p>
                                <p class="tw-text-[0.7rem] tw-italic tw-opacity-80">{{localize "WH40K.Favourites.StarTalentsHint"}}</p>
                            </div>
                        {{/if}}
                    </div>
            {{/systems/wh40k-rpg/templates/actor/partial/dashboard-zone}}

            {{#unless isNPC}}
            {{!-- Progression (XP) — PC-only — kept inline due to SVG ring + action-button header --}}
            <div class="tw-flex tw-flex-col tw-overflow-hidden tw-bg-[var(--color-bg-secondary)] tw-rounded-[6px] tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-color-gold)]">
                <div class="tw-flex tw-items-center tw-gap-1.5 tw-py-1.5 tw-px-2.5 tw-bg-[linear-gradient(90deg,rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.12)_0%,var(--color-bg-tertiary)_100%)] tw-text-xs tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)] [&>i]:tw-text-[color:var(--wh40k-color-gold)]">
                    <div class="tw-relative tw-w-[20px] tw-h-[20px] tw-shrink-0"data-tooltip="{{#if system.experience.total}}{{localize 'WH40K.Experience.PercentSpent' percent=(floor (multiply (divide system.experience.used system.experience.total) 100)) used=system.experience.used total=system.experience.total}}{{else}}{{localize 'WH40K.Experience.PercentSpent' percent=0 used=system.experience.used total=system.experience.total}}{{/if}}">
                        <svg viewBox="0 0 100 100" class="tw-w-full tw-h-full">
                            <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(120, 46, 34, 0.2)" stroke-width="12"/>
                            <circle cx="50" cy="50" r="45" fill="none" stroke="#c08020" stroke-width="12" stroke-linecap="round"
                                    stroke-dasharray="282.74"
                                    stroke-dashoffset="{{multiply (subtract 1 (divide system.experience.used system.experience.total)) 282.74}}"
                                    transform="rotate(-90 50 50)"/>
                        </svg>
                    </div>
                    <span>{{localize "WH40K.Experience.ProgressionRank" rank=system.rank}}</span>
                    <div class="tw-flex tw-gap-1 tw-ml-auto">
                        {{#if isGM}}
                        <button type="button" class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-[var(--wh40k-space-xs)] tw-px-2 tw-py-1 tw-bg-[var(--color-bg-option)] tw-border tw-border-solid tw-border-[var(--color-border-secondary)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.7rem] tw-font-semibold tw-cursor-pointer tw-text-[color:var(--color-text-secondary)]" data-action="customXP" title="{{localize 'WH40K.VitalEditBody.AddXP'}}">
                            <i class="fas fa-plus"></i> {{localize "WH40K.VitalEditBody.AddXP"}}
                        </button>
                        {{/if}}
                        <button type="button" class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-[var(--wh40k-space-xs)] tw-px-2 tw-py-1 tw-bg-[var(--color-bg-option)] tw-border tw-border-solid tw-border-[var(--color-border-secondary)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.7rem] tw-font-semibold tw-cursor-pointer tw-text-[color:var(--color-text-secondary)]" data-action="openAdvancement" title="{{localize 'WH40K.Experience.BuyAdvancements'}}">
                            <i class="fa-solid fa-arrow-up-big-small"></i> {{localize "WH40K.Experience.Advance"}}
                        </button>
                    </div>
                </div>
                <div class="tw-p-2 tw-flex-1 tw-flex tw-flex-col tw-gap-1">
                    <div class="tw-grid tw-grid-cols-2 tw-gap-2">
                        <span class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.03em] tw-text-[var(--color-text-secondary)]">{{localize "WH40K.Experience.Header"}}</span>
                        <span class="tw-text-[0.85rem] tw-font-bold tw-font-alt tw-text-[color:var(--color-text-primary)]">{{system.experience.available}}/{{system.experience.total}}</span>
                    </div>
                    {{!-- Itemised XP purchases (#XP-visibility) — every advance that contributes to Spent,
                         with its cost; the costs sum to {{system.experience.used}}. --}}
                    <div class="tw-mt-1 tw-pt-1">
                        <div class="tw-text-[0.65rem] tw-font-semibold tw-uppercase tw-tracking-[0.04em] tw-text-[var(--color-text-tertiary)] tw-mb-1">{{localize "WH40K.Experience.PurchasesTitle"}}</div>
                        {{#if system.experience.purchases.length}}
                        <ul class="tw-list-none tw-m-0 tw-p-0 tw-flex tw-flex-col tw-gap-[2px]">
                            {{#each system.experience.purchases}}
                            <li class="tw-flex tw-items-center tw-gap-1.5 tw-text-[0.72rem]">
                                <span class="tw-font-bold tw-uppercase tw-tracking-[0.03em] tw-px-[4px] tw-py-px tw-rounded-[3px] tw-shrink-0 tw-text-[0.58rem] tw-bg-[rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.16)] tw-text-[color:var(--color-text-secondary)]">{{#if (eq category "characteristic")}}{{localize "WH40K.Experience.CatCharacteristic"}}{{else if (eq category "skill")}}{{localize "WH40K.Experience.CatSkill"}}{{else if (eq category "talent")}}{{localize "WH40K.Experience.CatTalent"}}{{else if (eq category "psychicPower")}}{{localize "WH40K.Experience.CatPsychicPower"}}{{else if (eq category "psyRating")}}{{localize "WH40K.Experience.CatPsyRating"}}{{/if}}</span>
                                <span class="tw-flex-1 tw-truncate tw-text-[color:var(--color-text-primary)]">{{#if (eq category "psyRating")}}{{localize "WH40K.Experience.PsyRating"}} {{name}}{{else}}{{name}}{{/if}}</span>
                                <span class="tw-font-bold tw-font-alt tw-shrink-0 {{#if cost}}tw-text-[color:var(--wh40k-color-gold)]{{else}}tw-text-[var(--color-text-tertiary)] tw-opacity-70{{/if}}">{{cost}}</span>
                            </li>
                            {{/each}}
                        </ul>
                        {{else}}
                        <p class="tw-text-[0.7rem] tw-italic tw-text-[var(--color-text-tertiary)] tw-m-0">{{localize "WH40K.Experience.NoPurchases"}}</p>
                        {{/if}}
                    </div>
                </div>
            </div>
            {{/unless}}
            {{#if isNPC}}
            {{!-- NPC summary panel in the progression slot --}}
            <div class="tw-flex tw-flex-col tw-overflow-hidden tw-bg-[var(--color-bg-secondary)] tw-rounded-[6px] tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-color-gold)]">
                <div class="tw-flex tw-items-center tw-gap-1.5 tw-py-1.5 tw-px-2.5 tw-bg-[linear-gradient(90deg,rgb(from_var(--wh40k-color-gold)_r_g_b_/_0.12)_0%,var(--color-bg-tertiary)_100%)] tw-text-xs tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)] [&>i]:tw-text-[color:var(--wh40k-color-gold)]">
                    <i class="fa-solid fa-skull"></i>
                    <span>{{localize "WH40K.NPC.ThreatSummary" tier=threatTier.label}}</span>
                </div>
                <div class="tw-p-2 tw-flex-1 tw-flex tw-flex-col tw-gap-1">
                    <div class="tw-grid tw-grid-cols-2 tw-gap-2">
                        <span class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.03em] tw-text-[var(--color-text-secondary)]">{{localize "WH40K.NPC.ThreatLevel"}}</span>
                        <span class="tw-text-[0.85rem] tw-font-bold tw-font-alt tw-text-[color:var(--color-text-primary)]" style="color: {{threatTier.color}};">{{source.threatLevel}}/30</span>
                    </div>
                    <div class="tw-grid tw-grid-cols-2 tw-gap-2">
                        <span class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.03em] tw-text-[var(--color-text-secondary)]">{{localize "WH40K.NPC.TypeAndRole"}}</span>
                        <span class="tw-text-[0.85rem] tw-font-bold tw-font-alt tw-text-[color:var(--color-text-primary)]">{{source.type}} / {{source.role}}</span>
                    </div>
                    {{#if horde.enabled}}
                    <div class="tw-grid tw-grid-cols-2 tw-gap-2">
                        <span class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.03em] tw-text-[var(--color-text-secondary)]">{{localize "WH40K.NPC.Horde.Magnitude"}}</span>
                        <span class="tw-text-[0.85rem] tw-font-bold tw-font-alt tw-text-[color:var(--color-text-primary)]">{{horde.magnitude}}/{{horde.magnitudeMax}}</span>
                    </div>
                    {{/if}}
                </div>
            </div>
            {{/if}}

        </div>

        {{!-- Per-game-system overview panels (batch-1 + batch-2 integration).
             BC psychic strength (#178), DW Astartes implants (#167),
             OW Regiment Creation (#151). Each gates on its system flag
             so the include is no-op on the other six systems.
             Batch-2 additions: BC Ritual (#179), Gifts (#180), Supplements
             (#181), Daemon Prince (#182); DW Distinctions (#171), Special
             Ammo (#172). --}}
        {{#if isBC}}
            {{> systems/wh40k-rpg/templates/actor/panel/bc-psychic-panel.hbs psychicPanel=psychicPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/bc-ritual-panel.hbs ritualPanel=ritualPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/bc-gifts-panel.hbs giftsPanel=giftsPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/bc-supplements-panel.hbs supplementsPanel=supplementsPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/bc-daemon-prince-panel.hbs daemonPrincePanel=daemonPrincePanel}}
        {{/if}}
        {{#if isDW}}
            {{> systems/wh40k-rpg/templates/actor/panel/dw-astartes-panel.hbs astartesPanel=astartesPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/dw-distinction-panel.hbs distinctionPanel=distinctionPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/dw-ammo-panel.hbs ammoPanel=ammoPanel}}
        {{/if}}
        {{#if isOW}}
            {{> systems/wh40k-rpg/templates/actor/panel/ow-regiment-panel.hbs regimentPanel=regimentPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/ow-craftsmanship-panel.hbs craftsmanshipPanel=craftsmanshipPanel}}
            {{> systems/wh40k-rpg/templates/actor/panel/ow-drawback-panel.hbs drawbackPanel=drawbackPanel}}
        {{/if}}

        {{!-- ══ Relocated from the former Status tab (#263) ══
             The Status tab was redundant with Overview (wounds / fatigue /
             corruption / insanity / experience / fate already shown above;
             movement moved to Combat in #266). These panels were Status-only,
             so they move here to avoid silent data loss. Each keeps its
             original system / state gate; the context vars (alignmentPanel,
             cohesionPanel, …) come from the shared CharacterSheet context. --}}

        {{!-- Possession (#82) — only when the possession track is engaged. --}}
        {{#if (neq system.possession.state 'none')}}
            {{> systems/wh40k-rpg/templates/actor/panel/possession-panel.hbs}}
        {{/if}}

        {{!-- BC Alignment / Infamy (#173) — Black-Crusade-only. --}}
        {{#if isBC}}
            {{> systems/wh40k-rpg/templates/actor/panel/bc-alignment-panel.hbs alignmentPanel=alignmentPanel}}
        {{/if}}

        {{!-- DW engine panels (#162-165, #168-170) — Deathwatch-only. --}}
        {{#if isDW}}
            {{> systems/wh40k-rpg/templates/actor/panel/dw-cohesion-panel.hbs cohesionPanel=cohesionPanel}}
