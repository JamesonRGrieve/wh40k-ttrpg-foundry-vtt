{{!-- Craft Crew Tab (terracraft / aircraft / watercraft). Craft crew is the
     required complement + notes; crew quality is the embarked operators' own
     skills, not a ship-scale rating.

     Shared panel + field-row partials, design tokens only (#502). --}}
<section class="tab {{#if tab.active}}active{{/if}} {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="tw-flex tw-flex-col tw-gap-4">

        {{!-- Crew Stats --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-users" label=(localize "WH40K.Vehicle.CrewInformation") bodyClass="tw-p-4"}}
            <div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 tw-gap-4 tw-max-w-[40rem] {{themeClassFor 'border'}}">
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Vehicle.CrewRequired") name="system.crew.required" value=crew.required type="number" min="0" dataDtype="Number"}}
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Vehicle.Passengers") name="system.passengers" value=craftStats.passengers type="number" min="0" dataDtype="Number"}}
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Vehicle.CrewNotes") name="system.crew.notes" value=crew.notes type="textarea" rows="3" rowClass="sm:tw-col-span-2"}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

        {{!-- Who is actually aboard (#508). Capacity above says how many fit; this
             says who is in them. Occupancy is stored on the passenger, so this
             roster is a scan rather than a list held on the vehicle — see
             rules/vehicle-occupancy.ts for why that direction was chosen. --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-user-group" label=(localize "WH40K.Vehicle.Occupants") bodyClass="tw-p-4"}}
            {{#if crew.occupants.length}}
                <ul class="tw-flex tw-flex-col tw-gap-2 tw-m-0 tw-p-0 tw-list-none tw-max-w-[40rem]">
                    {{#each crew.occupants as |occupant|}}
                    <li class="tw-flex tw-items-center tw-gap-3 tw-p-2 tw-rounded-[var(--wh40k-radius-md)] tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-solid tw-border-[var(--wh40k-border-light)]">
                        <img src="{{occupant.img}}" alt="" class="tw-w-8 tw-h-8 tw-rounded-full tw-object-cover tw-border tw-border-solid tw-border-[var(--wh40k-border-light)]" />
                        <a class="tw-flex-1 tw-text-[0.85rem] tw-font-semibold tw-text-[color:var(--wh40k-text-primary)] tw-no-underline" data-action="openOccupant" data-uuid="{{occupant.uuid}}">{{occupant.name}}</a>
                        <span class="tw-text-[0.7rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-px-2 tw-py-0.5 tw-rounded-[3px] tw-bg-[var(--wh40k-panel-bg-translucent)] tw-text-[color:var(--wh40k-text-secondary)]">{{occupant.role}}</span>
                    </li>
                    {{/each}}
                </ul>
            {{else}}
                <p class="tw-m-0 tw-text-[0.8rem] tw-italic tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Vehicle.NoOccupants"}}</p>
            {{/if}}
            {{#if crew.unfilled}}
            <p class="tw-mt-3 tw-mb-0 tw-text-[0.75rem] tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-accent-combat)]">
                <i class="fas fa-triangle-exclamation"></i>
                {{localize "WH40K.Vehicle.UnfilledCrew" count=crew.unfilled}}
            </p>
            {{/if}}
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    </div>
</section>
