{{!-- Craft Components & Upgrades Tab (terracraft / aircraft / watercraft).
     Shared panel partial, design tokens only (#502). --}}
<section class="tab {{#if tab.active}}active{{/if}} {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="tw-flex tw-flex-col tw-gap-4">

        {{!-- Components/Upgrades List --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-cog" label=(localize "WH40K.Vehicle.ComponentsAndUpgrades") bodyClass="tw-p-4"}}
            <div class="tw-flex tw-flex-col tw-gap-3">
                {{#each components}}
                <div class="tw-px-3 tw-py-3 tw-bg-[var(--wh40k-bg-input)] tw-border tw-border-[var(--wh40k-border-color-light)] {{themeClassFor 'border'}} tw-rounded-md" data-item-id="{{this._id}}">
                    {{!-- No on/off checkbox (#701): a vehicle upgrade has no "active" field, so ticking one wrote
                         nothing and the box never stayed checked. --}}
                    <div class="tw-font-bold tw-mb-1" data-wh40k-hook="craft-component-name">{{this.name}}</div>
                    {{!-- `system.description` is the structured {value, chat, summary} record. --}}
                    {{#if this.system.description.value}}
                    <div class="tw-text-[0.85rem] tw-text-[color:var(--wh40k-text-medium)] tw-mt-2" data-wh40k-hook="craft-component-description">
                        {{{this.system.description.value}}}
                    </div>
                    {{/if}}
                </div>
                {{/each}}

                {{#unless components.length}}
                <div class="tw-py-8 tw-text-center tw-text-[color:var(--wh40k-text-medium)] tw-italic">{{localize "WH40K.Vehicle.NoComponents"}}</div>
                {{/unless}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    </div>
</section>
