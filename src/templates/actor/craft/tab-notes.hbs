{{!-- Craft Notes Tab (terracraft / aircraft / watercraft).
     Shared panel + field-row partials, design tokens only (#502). --}}
<section class="tab {{#if tab.active}}active{{/if}} {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="tw-flex tw-flex-col tw-gap-4">

        {{!-- Special Rules — standard ProseMirror path; a bare `editor-content`
              div never mounts an editor (CLAUDE.md gotcha #5). --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-scroll" label=(localize "WH40K.Vehicle.SpecialRules") bodyClass="tw-p-4"}}
            {{#if inEditMode}}
            {{editor system.specialRules target="system.specialRules" button=true editable=editable engine="prosemirror"}}
            {{else}}
            <div class="editor-content">{{{system.specialRules}}}</div>
            {{/if}}
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

        {{!-- Source Reference — structured per-line provenance, the same block
              items carry. The single free-text row this replaced bound
              `system.source`, which is a schema object, so it rendered and wrote
              back `[object Object]`. --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-book" label=(localize "WH40K.Vehicle.Source") bodyClass="tw-p-4"}}
            <div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 tw-gap-4 tw-max-w-[40rem] {{themeClassFor 'border'}}">
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Source.Book") name="system.source.book" value=system.source.book placeholder=(localize "WH40K.Vehicle.SourcePlaceholder")}}
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Source.Page") name="system.source.page" value=system.source.page}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    </div>
</section>
