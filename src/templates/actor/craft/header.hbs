{{!-- Craft Sheet Header — sidebar-friendly vertical layout (#557).
     Portrait, name, locomotion, quick stats stacked vertically to match
     the character sheet sidebar pattern. --}}
<div class="tw-flex tw-flex-col tw-items-center tw-gap-3 tw-p-3">
    {{!-- Portrait --}}
    <div class="tw-w-full tw-max-w-[160px] tw-aspect-square tw-rounded-lg tw-overflow-hidden tw-border-2 tw-border-solid tw-border-[var(--wh40k-border-color)] tw-bg-black/30">
        <img src="{{actor.img}}" alt="{{actor.name}}" class="tw-w-full tw-h-full tw-object-cover" data-action="editImage" />
    </div>

    {{!-- Name --}}
    <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'WH40K.Vehicle.Name'}}"
           class="tw-w-full tw-text-center tw-text-[1.1rem] tw-font-display tw-font-bold tw-bg-transparent tw-border-0 tw-border-b tw-border-b-[var(--wh40k-border-color-light)] tw-text-[color:var(--wh40k-gold)] tw-pb-1 focus:tw-outline-none focus:tw-border-b-gold" />

    {{!-- Locomotion --}}
    <div class="tw-w-full tw-flex tw-flex-col tw-gap-1">
        <label class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Vehicle.Locomotion"}}</label>
        <select name="system.locomotion" class="tw-w-full tw-bg-[var(--wh40k-bg-input)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-text-[color:var(--color-text-primary)] tw-px-2 tw-py-1 tw-rounded-sm tw-text-[0.8rem] focus:tw-border-gold focus:tw-outline-none">
            <optgroup label="{{localize "WH40K.Vehicle.LocomotionGroup.Land"}}">
                <option value="wheeled" {{#if (eq system.locomotion "wheeled")}}selected{{/if}}>{{localize "WH40K.Vehicle.LocomotionType.Wheeled"}}</option>
                <option value="tracked" {{#if (eq system.locomotion "tracked")}}selected{{/if}}>{{localize "WH40K.Vehicle.LocomotionType.Tracked"}}</option>
                <option value="walker" {{#if (eq system.locomotion "walker")}}selected{{/if}}>{{localize "WH40K.Vehicle.LocomotionType.Walker"}}</option>
                <option value="hover" {{#if (eq system.locomotion "hover")}}selected{{/if}}>{{localize "WH40K.Vehicle.LocomotionType.Hover"}}</option>
            </optgroup>
            <optgroup label="{{localize "WH40K.Vehicle.LocomotionGroup.Air"}}">
                <option value="flyer" {{#if (eq system.locomotion "flyer")}}selected{{/if}}>{{localize "WH40K.Vehicle.LocomotionType.Flyer"}}</option>
                <option value="skimmer" {{#if (eq system.locomotion "skimmer")}}selected{{/if}}>{{localize "WH40K.Vehicle.LocomotionType.Skimmer"}}</option>
            </optgroup>
        </select>
    </div>

    {{!-- Quick Stats --}}
    <div class="tw-w-full tw-flex tw-flex-col tw-gap-2 tw-mt-1">
        <div class="tw-flex tw-items-center tw-justify-between tw-px-1">
            <span class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Vehicle.Integrity"}}</span>
            <span class="tw-font-bold tw-tabular-nums tw-text-[color:var(--color-text-primary)]">
                <input type="number" name="system.integrity.value" value="{{source.integrity.value}}" min="0" class="tw-w-8 tw-text-center tw-bg-transparent tw-border-0 tw-font-bold tw-text-[color:var(--color-text-primary)] focus:tw-outline-none" />
                / {{source.integrity.max}}
            </span>
        </div>
        <div class="tw-flex tw-items-center tw-justify-between tw-px-1">
            <span class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Vehicle.ArmourFront"}}</span>
            <input type="number" name="system.armour.front.value" value="{{source.armour.front.value}}" min="0" class="tw-w-8 tw-text-center tw-bg-transparent tw-border-0 tw-font-bold tw-text-[color:var(--color-text-primary)] focus:tw-outline-none" />
        </div>
        <div class="tw-flex tw-items-center tw-justify-between tw-px-1">
            <span class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Vehicle.Size"}}</span>
            <input type="number" name="system.size" value="{{source.size}}" min="1" max="10" class="tw-w-8 tw-text-center tw-bg-transparent tw-border-0 tw-font-bold tw-text-[color:var(--color-text-primary)] focus:tw-outline-none" />
        </div>
    </div>
</div>
