{{!-- Craft Combat Tab (terracraft / aircraft / watercraft).
     Shared panel + field-row partials, design tokens only (#502). --}}
<section class="tab {{#if tab.active}}active{{/if}} {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="tw-flex tw-flex-col tw-gap-4">

        {{!-- Creature profile — animate craft only (daemon-engines / walkers / Dreadnoughts). --}}
        {{#if characteristics}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-dharmachakra" label=(localize "WH40K.Characteristics") bodyClass="tw-p-4"}}
            <div class="tw-grid tw-grid-cols-3 sm:tw-grid-cols-5 lg:tw-grid-cols-9 tw-gap-2">
                {{#each characteristics}}
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-1 tw-bg-[var(--wh40k-bg-input)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-md tw-p-2">
                    <button type="button" class="tw-text-[0.75rem] tw-uppercase tw-text-[color:var(--wh40k-text-medium)] hover:tw-text-[color:var(--wh40k-gold)] {{themeClassFor 'accent'}} tw-bg-transparent tw-border-0 tw-cursor-pointer" data-action="rollCharacteristic" data-characteristic="{{@key}}" title="{{this.label}}">{{this.short}}</button>
                    <input type="number" name="system.characteristics.{{@key}}.base" value="{{this.base}}" data-dtype="Number" class="tw-w-full tw-text-center tw-bg-transparent tw-border-0 tw-text-[1.1rem] tw-font-bold tw-text-[color:var(--color-text-primary)]" />
                    <span class="tw-text-[0.7rem] tw-text-[color:var(--wh40k-text-medium)]">{{localize "WH40K.Skills.Bonus"}} {{this.bonus}}</span>
                </div>
                {{/each}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

        {{#if profileAbilities.length}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-scroll" label=(localize "WH40K.Abilities") bodyClass="tw-p-4"}}
            <div class="tw-flex tw-flex-wrap tw-gap-2">
                {{#each profileAbilities}}
                <span class="tw-px-3 tw-py-1 tw-bg-[var(--wh40k-bg-input)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-md tw-text-[0.85rem] tw-cursor-pointer hover:tw-text-[color:var(--wh40k-gold)] {{themeClassFor 'accent'}}" data-action="itemEdit" data-item-id="{{this._id}}">{{this.name}}</span>
                {{/each}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}
        {{/if}}
        {{/if}}

        {{!-- Directional Armour --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-shield-alt" label=(localize "WH40K.Vehicle.Armour") bodyClass="tw-p-4"}}
            <div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-3 tw-gap-4 tw-max-w-[36rem]">
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Vehicle.ArmourFront") name="system.armour.front.value" value=craftStats.armour.front type="number" min="0" dataDtype="Number"}}
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Vehicle.ArmourSide") name="system.armour.side.value" value=craftStats.armour.side type="number" min="0" dataDtype="Number"}}
                {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Vehicle.ArmourRear") name="system.armour.rear.value" value=craftStats.armour.rear type="number" min="0" dataDtype="Number"}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

        {{!-- Weapons List --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-crosshairs" label=(localize "WH40K.Vehicle.Weapons") bodyClass="tw-p-4"}}
            <div class="tw-flex tw-flex-col tw-gap-2">
                {{#each weapons}}
                <div class="tw-flex tw-justify-between tw-items-center tw-px-3 tw-py-3 tw-bg-[var(--wh40k-bg-input)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-md tw-transition-all" data-item-id="{{this._id}}">
                    <div class="tw-font-bold tw-cursor-pointer hover:tw-text-[color:var(--wh40k-gold)] {{themeClassFor 'accent'}}" data-action="rollWeapon" data-item-id="{{this._id}}">
                        {{this.name}}
                    </div>
                    <div class="tw-flex tw-gap-4 tw-text-[0.85rem] tw-text-[color:var(--wh40k-text-medium)]">
                        <span>{{this.system.damage}}</span>
                        <span>{{this.system.range}}m</span>
                    </div>
                </div>
                {{else}}
                <div class="tw-py-8 tw-text-center tw-text-[color:var(--wh40k-text-medium)] tw-italic">{{localize "WH40K.Vehicle.NoWeapons"}}</div>
                {{/each}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

        {{!-- Traits --}}
        {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-bolt" label=(localize "WH40K.Vehicle.Traits") bodyClass="tw-p-4"}}
            <div class="tw-flex tw-flex-col tw-gap-3">
                {{#each vehicleTraits}}
                <div class="tw-px-3 tw-py-3 tw-bg-[var(--wh40k-bg-input)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-md">
                    <strong class="tw-text-[color:var(--wh40k-gold)] {{themeClassFor 'accent'}}">{{this.name}}</strong>
                    {{#if this.system.description}}
                    <p class="tw-mt-2 tw-text-[0.85rem] tw-text-[color:var(--wh40k-text-medium)]">{{{this.system.description}}}</p>
                    {{/if}}
                </div>
                {{else}}
                <div class="tw-py-8 tw-text-center tw-text-[color:var(--wh40k-text-medium)] tw-italic">{{localize "WH40K.Vehicle.NoTraits"}}</div>
                {{/each}}
            </div>
        {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    </div>
</section>
