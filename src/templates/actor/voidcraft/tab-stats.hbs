{{!-- Voidcraft Stats Tab — built on the shared panel + field-row partials (the
     same dark-theme chrome as the craft/vehicle overview). It used to carry its
     own light-parchment rows (`tw-bg-white/60` with dark-gold labels), which
     rendered as grey bars with ~2:1 label contrast on the dark sheet. --}}
<section class="tab {{#if tab.active}}active{{/if}} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-crosshairs" label=(localize "WH40K.Voidcraft.Combat.Header") bodyClass="tw-p-4 tw-flex tw-flex-col tw-gap-3"}}
        <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-2">
            <button type="button" class="tw-inline-flex tw-items-center tw-gap-1.5 tw-px-3 tw-py-1.5 tw-rounded-md tw-border tw-border-solid tw-border-[#2a4a6a] tw-bg-[linear-gradient(180deg,#4a6b8a_0%,#3a5a7a_100%)] tw-text-white tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-cursor-pointer" data-action="rollInitiative" title="{{localize 'WH40K.Voidcraft.Combat.RollInitiative'}}">
                <span class="material-icons tw-text-[1.1em]">radar</span>
                <span>{{localize "WH40K.Voidcraft.Combat.Initiative"}}</span>
                <span class="tw-ml-1 tw-px-1.5 tw-rounded-sm tw-bg-black/25 tw-tabular-nums" title="{{localize 'WH40K.Voidcraft.Combat.DetectionBonus'}}">+{{system.detectionBonus}}</span>
            </button>
            {{!-- Critical Hit roll (issue #187) — Battlefleet Koronus 1d5 chart --}}
            <button type="button" class="tw-inline-flex tw-items-center tw-gap-1.5 tw-px-3 tw-py-1.5 tw-rounded-md tw-border tw-border-solid tw-border-[#8b1f15] tw-bg-[linear-gradient(180deg,#c0392b_0%,#992d22_100%)] tw-text-white tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-cursor-pointer" data-action="rollShipCriticalHit" title="{{localize 'WH40K.Voidcraft.Critical.RollTooltip'}}">
                <i class="fas fa-dice-d6"></i>
                <span>{{localize "WH40K.Voidcraft.Critical.Roll"}}</span>
            </button>
        </div>
        <div class="tw-grid tw-grid-cols-2 lg:tw-grid-cols-3 tw-gap-3">
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Combat.Speed") name="system.speed" value=source.speed type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Combat.Manoeuvrability") name="system.manoeuvrability" value=source.manoeuvrability type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Combat.Detection") name="system.detection" value=source.detection type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Combat.Armour") name="system.armour" value=source.armour type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Combat.VoidShields") name="system.voidShields" value=source.voidShields type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Combat.TurretRating") name="system.turretRating" value=source.turretRating type="number" dataDtype="Number"}}
        </div>
    {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-bolt" label=(localize "WH40K.Voidcraft.Resources.Header") bodyClass="tw-p-4 tw-flex tw-flex-col tw-gap-3"}}
        {{!-- Power / Space status: available vs (used / total); red when short. --}}
        <div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 tw-gap-2">
            <div class="tw-flex tw-items-center tw-gap-1.5 tw-px-3 tw-py-2 tw-rounded-md tw-border tw-border-solid {{#if system.hasPowerShortage}}tw-bg-[rgba(180,40,40,0.15)] tw-border-[rgba(220,80,80,0.45)]{{else}}tw-bg-[rgba(60,140,80,0.12)] tw-border-[rgba(90,160,44,0.4)]{{/if}}">
                <span class="material-icons tw-text-[1.3em] {{#if system.hasPowerShortage}}tw-text-crimson-l40{{else}}tw-text-success-l20{{/if}}">bolt</span>
                <span class="tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-wide tw-text-[color:var(--color-text-primary)]">{{localize "WH40K.Voidcraft.Resources.Power"}}</span>
                <span class="tw-ml-auto tw-text-[1.2em] tw-font-bold tw-tabular-nums {{#if system.hasPowerShortage}}tw-text-crimson-l40{{else}}tw-text-success-l20{{/if}}">{{system.power.available}}</span>
                <span class="tw-text-[0.75rem] tw-tabular-nums tw-text-[color:var(--wh40k-text-muted)]">({{system.power.used}} / {{system.power.total}})</span>
            </div>
            <div class="tw-flex tw-items-center tw-gap-1.5 tw-px-3 tw-py-2 tw-rounded-md tw-border tw-border-solid {{#if system.hasSpaceShortage}}tw-bg-[rgba(180,40,40,0.15)] tw-border-[rgba(220,80,80,0.45)]{{else}}tw-bg-[rgba(60,140,80,0.12)] tw-border-[rgba(90,160,44,0.4)]{{/if}}">
                <span class="material-icons tw-text-[1.3em] {{#if system.hasSpaceShortage}}tw-text-crimson-l40{{else}}tw-text-success-l20{{/if}}">warehouse</span>
                <span class="tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-wide tw-text-[color:var(--color-text-primary)]">{{localize "WH40K.Voidcraft.Resources.Space"}}</span>
                <span class="tw-ml-auto tw-text-[1.2em] tw-font-bold tw-tabular-nums {{#if system.hasSpaceShortage}}tw-text-crimson-l40{{else}}tw-text-success-l20{{/if}}">{{system.space.available}}</span>
                <span class="tw-text-[0.75rem] tw-tabular-nums tw-text-[color:var(--wh40k-text-muted)]">({{system.space.used}} / {{system.space.total}})</span>
            </div>
        </div>
        <div class="tw-grid tw-grid-cols-2 lg:tw-grid-cols-3 tw-gap-3">
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Resources.SpaceTotal") name="system.space.total" value=source.space.total type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Resources.SpaceUsed") name="system.space.used" value=source.space.used type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Resources.PowerTotal") name="system.power.total" value=source.power.total type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Resources.PowerUsed") name="system.power.used" value=source.power.used type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Resources.ShipPoints") name="system.shipPoints" value=source.shipPoints type="number" dataDtype="Number"}}
        </div>
    {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-crosshairs" label=(localize "WH40K.Voidcraft.WeaponCapacity.Header") bodyClass="tw-p-4"}}
        <div class="tw-grid tw-grid-cols-2 lg:tw-grid-cols-5 tw-gap-3">
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.WeaponCapacity.Prow") name="system.weaponCapacity.prow" value=source.weaponCapacity.prow type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.WeaponCapacity.Dorsal") name="system.weaponCapacity.dorsal" value=source.weaponCapacity.dorsal type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.WeaponCapacity.Port") name="system.weaponCapacity.port" value=source.weaponCapacity.port type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.WeaponCapacity.Starboard") name="system.weaponCapacity.starboard" value=source.weaponCapacity.starboard type="number" dataDtype="Number"}}
            {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.WeaponCapacity.Keel") name="system.weaponCapacity.keel" value=source.weaponCapacity.keel type="number" dataDtype="Number"}}
        </div>
    {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}

    {{#> systems/wh40k-rpg/templates/actor/partial/panel.hbs icon="fa-ruler-combined" label=(localize "WH40K.Voidcraft.Physical.Header") bodyClass="tw-p-4"}}
        {{> systems/wh40k-rpg/templates/shared/field-row.hbs label=(localize "WH40K.Voidcraft.Physical.Dimensions") name="system.dimensions" value=source.dimensions}}
    {{/systems/wh40k-rpg/templates/actor/partial/panel.hbs}}
</section>
