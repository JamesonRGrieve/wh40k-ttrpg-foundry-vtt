{{!--
    Ship-action modifiers in effect (#186): what a rolled Lock on Target, Aid
    the Machine Spirit, Flank Speed, Come to New Heading or Evasive Manoeuvres
    left on the ship, until it lapses. Renders nothing when none is live.

    Hash params:
        modifiers — [{name, target, value}] (target and value already localized / signed)
--}}
{{#if modifiers.length}}
    <div class="wh40k-panel" data-wh40k-hook="ship-action-modifiers">
        <h1 class="wh40k-panel-header tw-text-gold {{themeClassFor 'accent'}}">{{localize "WH40K.Voidcraft.ShipAction.InEffect"}}</h1>
        <ul class="tw-flex tw-flex-col tw-gap-1.5 tw-list-none tw-p-2 tw-m-0">
            {{#each modifiers as |modifier|}}
                <li class="tw-flex tw-items-center tw-gap-2 tw-px-2.5 tw-py-1.5 tw-rounded-md tw-border tw-border-[var(--wh40k-border-color-light)] tw-bg-[var(--wh40k-panel-bg)]">
                    <div class="tw-flex tw-flex-col tw-flex-1 tw-min-w-0">
                        <span class="tw-font-semibold tw-text-[0.95em] tw-text-[color:var(--wh40k-text-dark)] tw-uppercase tw-tracking-wide">{{modifier.name}}</span>
                        <span class="tw-text-[0.75em] tw-text-[color:var(--wh40k-text-muted)]">{{modifier.target}}</span>
                    </div>
                    <span class="tw-font-bold tw-tabular-nums tw-text-[1.05em] tw-text-[color:var(--wh40k-text-dark)]">{{modifier.value}}</span>
                </li>
            {{/each}}
        </ul>
    </div>
{{/if}}
