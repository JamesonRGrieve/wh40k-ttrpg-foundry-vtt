{{! Voidcraft Sheet Header — sidebar column (portrait, name, hull identity,
    quick stats stacked), matching the character and craft sheet sidebars.
    Composes the shared `header-base` partial in its default sidebar variant. }}

{{#> systems/wh40k-rpg/templates/actor/partial/header-base.hbs
    cardClass="wh40k-ship-header"
    innerClass="tw-flex tw-flex-col tw-items-stretch tw-gap-3"}}
    {{> systems/wh40k-rpg/templates/actor/partial/actor-identity.hbs nameLabelKey="WH40K.Voidcraft.Name"}}

    <div class="tw-flex tw-flex-col tw-gap-2">
        <label class="tw-flex tw-flex-col tw-gap-0.5">
            <span class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Voidcraft.HullType"}}</span>
            <input class="tw-w-full tw-border-0 tw-border-b tw-border-solid tw-border-b-[var(--wh40k-border-color-light)] tw-bg-transparent tw-px-1 tw-py-0.5 tw-text-[0.85rem] tw-text-[color:var(--color-text-primary)] focus:tw-border-b-gold focus:tw-outline-none" name="system.hullType" type="text" value="{{source.hullType}}" />
        </label>
        <label class="tw-flex tw-flex-col tw-gap-0.5">
            <span class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Voidcraft.HullClass"}}</span>
            <input class="tw-w-full tw-border-0 tw-border-b tw-border-solid tw-border-b-[var(--wh40k-border-color-light)] tw-bg-transparent tw-px-1 tw-py-0.5 tw-text-[0.85rem] tw-text-[color:var(--color-text-primary)] focus:tw-border-b-gold focus:tw-outline-none" name="system.hullClass" type="text" value="{{source.hullClass}}" />
        </label>
    </div>

    <div class="tw-flex tw-flex-col tw-gap-1.5 tw-border-0 tw-border-l-2 tw-border-solid tw-pl-2 tw-border-l-gold bc:tw-border-l-crimson-light dh1:tw-border-l-gold-raw-l5 dh2:tw-border-l-gold-raw dw:tw-border-l-accent-combat ow:tw-border-l-brass-l20 rt:tw-border-l-gold im:tw-border-l-failure">
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Build.Stat.HullIntegrity")
            boxClass="wh40k-hull-box"
            valueName="system.hullIntegrity.value"
            value=source.hullIntegrity.value
            maxName="system.hullIntegrity.max"
            max=source.hullIntegrity.max}}
        {{!-- RT ship condition (#187): Crippled at 0 Hull Integrity; destroyed only by a Critical Hit result. --}}
        {{#if shipCondition.destroyed}}
            <div data-wh40k-hook="ship-condition-destroyed" class="tw-flex tw-flex-col tw-gap-0.5 tw-rounded-md tw-border tw-border-solid tw-border-[rgba(248,113,113,0.6)] tw-bg-[rgba(127,29,29,0.45)] tw-px-2 tw-py-1 tw-text-red-100">
                <span class="tw-text-[0.8rem] tw-font-bold tw-uppercase tw-tracking-wide"><i class="fas fa-explosion" aria-hidden="true"></i> {{localize "WH40K.Voidcraft.Crippled.Destroyed"}}</span>
                <span class="tw-text-[0.7rem] tw-leading-snug">{{localize "WH40K.Voidcraft.Crippled.DestroyedHint"}}</span>
            </div>
        {{else if shipCondition.crippled}}
            <div data-wh40k-hook="ship-condition-crippled" class="tw-flex tw-flex-col tw-gap-0.5 tw-rounded-md tw-border tw-border-solid tw-border-[rgba(251,191,36,0.6)] tw-bg-[rgba(120,53,15,0.45)] tw-px-2 tw-py-1 tw-text-amber-100">
                <span class="tw-text-[0.8rem] tw-font-bold tw-uppercase tw-tracking-wide"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{localize "WH40K.Voidcraft.Crippled.Status"}}</span>
                <span class="tw-text-[0.7rem] tw-leading-snug">{{localize "WH40K.Voidcraft.Crippled.StatusHint"}}</span>
            </div>
        {{/if}}
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Build.Stat.Morale")
            boxClass="wh40k-morale-box"
            readonly=true
            valueName="system.crew.morale.value"
            value=source.crew.morale.value
            maxName="system.crew.morale.max"
            max=source.crew.morale.max}}
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Crew.Population")
            boxClass="wh40k-pop-box"
            singleClass="wh40k-stat-single"
            readonly=true
            valueName="system.crew.population"
            value=source.crew.population}}
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Build.Stat.CrewRating")
            boxClass="wh40k-crew-box"
            singleClass="wh40k-stat-single"
            readonly=true
            valueName="system.crew.crewRating"
            value=source.crew.crewRating}}
    </div>
{{/systems/wh40k-rpg/templates/actor/partial/header-base.hbs}}
