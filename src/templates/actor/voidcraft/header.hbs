{{! Voidcraft Sheet Header — sidebar column (portrait, name, hull identity,
    quick stats stacked), matching the character and craft sheet sidebars.
    Composes the shared `header-base` partial in its default sidebar variant. }}

{{#> systems/wh40k-rpg/templates/actor/partial/header-base.hbs
    cardClass="wh40k-ship-header"
    innerClass="tw-flex tw-flex-col tw-items-stretch tw-gap-3"}}
    {{!-- No inline "Ship Name" label: it took half the sidebar, so a ship name such as
         "Vagabond-class Merchant Trader" showed only "Vagabond". The label is the
         placeholder instead, and the name is fitted like the craft sidebar's (#630). --}}
    {{> systems/wh40k-rpg/templates/actor/partial/actor-identity.hbs fitName=true placeholderKey="WH40K.Voidcraft.Name"}}

    <div class="tw-flex tw-flex-col tw-gap-2">
        {{!-- Hull type (#647): an id from WH40K.hullTypes that ship components match
             against, so it is a select over them in edit mode and its label otherwise.
             The pencil enters edit mode (BaseActorSheet's toggleEditMode). --}}
        <div class="tw-flex tw-flex-col tw-gap-0.5" data-wh40k-hook="voidcraft-hull-type">
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-2">
                <label for="{{actor.id}}-hull-type" class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Voidcraft.HullType"}}</label>
                {{#if editable}}
                {{#if inEditMode}}
                {{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-lock-open" isActive=true titleKey="WH40K.Common.ExitEditMode" sizeClass="tw-w-[18px] tw-h-[18px]" iconClass="tw-text-[0.6rem]"}}
                {{else}}
                {{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-pen-to-square" titleKey="WH40K.Common.EnterEditMode" sizeClass="tw-w-[18px] tw-h-[18px]" iconClass="tw-text-[0.6rem]"}}
                {{/if}}
                {{/if}}
            </div>
            {{#if inEditMode}}
            <select id="{{actor.id}}-hull-type" name="system.hullType" class="tw-w-full tw-h-8 tw-py-0 tw-px-1 tw-leading-normal tw-text-[0.85rem] tw-bg-[var(--wh40k-input-bg)] tw-text-[color:var(--wh40k-text-dark)] tw-border tw-border-solid tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm">
                {{#each hullTypeOptions as |option|}}
                <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{#if option.labelKey}}{{localize option.labelKey}}{{else}}{{option.value}}{{/if}}</option>
                {{/each}}
            </select>
            {{else}}
            <span id="{{actor.id}}-hull-type" data-wh40k-hook="voidcraft-hull-type-label" class="tw-px-1 tw-py-0.5 tw-text-[0.85rem] tw-text-[color:var(--wh40k-text-dark)]">{{#if hullTypeLabel}}{{hullTypeLabel}}{{else}}{{localize "WH40K.Voidcraft.HullTypeUnset"}}{{/if}}</span>
            {{/if}}
        </div>
        {{!-- Hull Class follows Hull Type (#701): an input with a placeholder while editing, else its value or
             "Not set". It was an always-on borderless input, so an empty class read as a label with nothing after it. --}}
        <label class="tw-flex tw-flex-col tw-gap-0.5">
            <span class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Voidcraft.HullClass"}}</span>
            {{#if inEditMode}}
            <input class="tw-w-full tw-border-0 tw-border-b tw-border-solid tw-border-b-[var(--wh40k-border-color-light)] tw-bg-transparent tw-px-1 tw-py-0.5 tw-text-[0.85rem] tw-text-[color:var(--color-text-primary)] focus:tw-border-b-gold focus:tw-outline-none" name="system.hullClass" type="text" value="{{source.hullClass}}" placeholder="{{localize "WH40K.Voidcraft.HullClassPlaceholder"}}" />
            {{else}}
            <span data-wh40k-hook="voidcraft-hull-class-label" class="tw-px-1 tw-py-0.5 tw-text-[0.85rem] {{#if source.hullClass}}tw-text-[color:var(--color-text-primary)]{{else}}tw-italic tw-text-[color:var(--wh40k-text-muted)]{{/if}}">{{#if source.hullClass}}{{source.hullClass}}{{else}}{{localize "WH40K.Voidcraft.HullClassUnset"}}{{/if}}</span>
            {{/if}}
        </label>
    </div>

    <div class="tw-flex tw-flex-col tw-gap-1.5 tw-border-0 tw-border-l-2 tw-border-solid tw-pl-2 tw-border-l-gold bc:tw-border-l-crimson-light dh1:tw-border-l-gold-raw-l5 dh2:tw-border-l-gold-raw dw:tw-border-l-accent-combat ow:tw-border-l-brass-l20 rt:tw-border-l-void-l20 im:tw-border-l-failure">
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Build.Stat.HullIntegrity")
            boxClass="wh40k-hull-box"
            valueName="system.hullIntegrity.value"
            value=source.hullIntegrity.value
            maxName="system.hullIntegrity.max"
            max=source.hullIntegrity.max}}
        {{!-- RT ship condition (#187): Crippled at 0 Hull Integrity; destroyed only by a Critical Hit result.
             The callout is one line in the narrow sidebar (its paragraph was cut off by the
             scroll region); the rule text is its tooltip and stays in the DOM for screen readers. --}}
        {{#if shipCondition.destroyed}}
            <div data-wh40k-hook="ship-condition-destroyed" class="tw-cursor-help tw-rounded-md tw-border tw-border-solid tw-border-[rgba(248,113,113,0.6)] tw-bg-[rgba(127,29,29,0.45)] tw-px-2 tw-py-1 tw-text-red-100" data-tooltip="{{localize "WH40K.Voidcraft.Crippled.DestroyedHint"}}">
                <span class="tw-text-[0.8rem] tw-font-bold tw-uppercase tw-tracking-wide"><i class="fas fa-explosion" aria-hidden="true"></i> {{localize "WH40K.Voidcraft.Crippled.Destroyed"}}</span>
                <span class="tw-sr-only">{{localize "WH40K.Voidcraft.Crippled.DestroyedHint"}}</span>
            </div>
        {{else if shipCondition.crippled}}
            <div data-wh40k-hook="ship-condition-crippled" class="tw-cursor-help tw-rounded-md tw-border tw-border-solid tw-border-[rgba(251,191,36,0.6)] tw-bg-[rgba(120,53,15,0.45)] tw-px-2 tw-py-1 tw-text-amber-100" data-tooltip="{{localize "WH40K.Voidcraft.Crippled.StatusHint"}}">
                <span class="tw-text-[0.8rem] tw-font-bold tw-uppercase tw-tracking-wide"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{localize "WH40K.Voidcraft.Crippled.Status"}}</span>
                <span class="tw-sr-only">{{localize "WH40K.Voidcraft.Crippled.StatusHint"}}</span>
            </div>
        {{/if}}
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Build.Stat.Morale")
            boxClass="wh40k-morale-box"
            readonly=true
            valueName="system.crew.morale.value"
            value=source.crew.morale.value
            maxName="system.crew.morale.max"
            max=source.crew.morale.max}}
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Crew.Population")
            boxClass="wh40k-pop-box"
            singleClass="wh40k-stat-single"
            readonly=true
            valueName="system.crew.population"
            value=source.crew.population}}
        {{> systems/wh40k-rpg/templates/actor/partial/stat-box.hbs
            label=(localize "WH40K.Voidcraft.Build.Stat.CrewRating")
            boxClass="wh40k-crew-box"
            singleClass="wh40k-stat-single"
            readonly=true
            valueName="system.crew.crewRating"
            value=source.crew.crewRating}}
    </div>
{{/systems/wh40k-rpg/templates/actor/partial/header-base.hbs}}
