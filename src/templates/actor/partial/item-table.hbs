{{!--
    item-table.hbs — shared table chrome for the inventory / equipment / ship /
    vehicle "list of items with a per-row toolbar" pattern. Pairs with
    `item-table-row.hbs` for the row body.

    Block-partial usage:
        (#>) systems/wh40k-rpg/templates/actor/partial/item-table.hbs
            addAction="itemCreate"
            addType="weapon"
            addTitleKey="WH40K.Common.Add"
            headers=(array
                (object weight=2 labelKey="WH40K.Weapon.Name")
                (object labelKey="WH40K.Weapon.Class")
                (object labelKey="WH40K.Weapon.Type")
                (object labelKey="WH40K.Weapon.Equipped"))
            ... rows (each invoking item-table-row) ...
        (/) systems/wh40k-rpg/templates/actor/partial/item-table.hbs

    Hash arguments:
        tableClass    — extra classes appended to `wh40k-table--border`
                        (e.g. `wh40k-weapontable--border`). Not `rootClass`,
                        which inside a panel block is the panel's own class.
        headers       — array of column-header descriptors. Each entry is a
                        plain object with:
                          labelKey  — i18n key (preferred)
                          label     — literal string fallback
                          cellClass — class on the header cell (optional).
                          weight    — relative width of the column (default 1;
                                      the name column takes 2).
                          fit       — size the column to its content (a
                                      toolbar column) instead of a share.
                        The table is a grid with one column per header (#662);
                        the header row and each row are subgrids across it, so
                        a row must render exactly one cell per header: the name
                        cell (which also holds the edit cog), one per `cells`
                        entry, then the action toolbar.
                        The trailing add-action cell is rendered automatically
                        when `addAction` is set; do NOT include it in `headers`.
        addAction     — data-action name for the create button (e.g.
                        "itemCreate"). Omit to suppress the trailing cell.
        addType       — data-type value passed alongside addAction
                        (e.g. "weapon").
        addTitleKey   — i18n key for the add button's title attr / aria-label.
        addIconKey    — icon registry key for the create button
                        (default 'fa:plus-circle'). Use `iconSvg` syntax,
                        e.g. 'fa:plus'.

    Per-system theming: the table border + header background lift via inline
    `<system>:tw-*` variants so each game system gets a distinct visual tone.
--}}
<div class="tw-grid tw-grid-cols-[var(--wh40k-item-table-cols)] tw-rounded-md tw-overflow-hidden tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] dh2:tw-border-bronze rt:tw-border-amber-700 im:tw-border-crimson{{#if tableClass}} {{tableClass}}{{/if}}"
     style="--wh40k-item-table-cols: {{itemTableColumns headers addAction}}" data-table>
    <div class="tw-grid tw-grid-cols-subgrid tw-col-span-full tw-items-center tw-text-[0.7rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-muted)] dh2:tw-bg-bronze/10 rt:tw-bg-amber-700/10 im:tw-bg-crimson/10" data-table-header>
        {{#each headers as |header|}}
            <div class="tw-min-w-0 tw-px-1.5 tw-py-1{{#if header.cellClass}} {{header.cellClass}}{{/if}}">
                {{#if header.labelKey}}{{localize header.labelKey}}{{else}}{{header.label}}{{/if}}
            </div>
        {{/each}}
        {{#if addAction}}
            <div class="tw-px-1.5 tw-py-1 tw-text-right">
                <label class="tw-cursor-pointer hover:tw-opacity-100" data-action="{{addAction}}"{{#if addType}} data-type="{{addType}}"{{/if}}{{#if addTitleKey}} title="{{localize addTitleKey}}" aria-label="{{localize addTitleKey}}"{{/if}}>
                    <span class="tw-pt-[3px] tw-pl-[2px] tw-inline-grid tw-opacity-50">{{iconSvg (defaultVal addIconKey 'fa:plus-circle') class="tw-w-3.5 tw-h-3.5"}}</span>
                </label>
            </div>
        {{/if}}
    </div>
    {{> @partial-block}}
</div>
