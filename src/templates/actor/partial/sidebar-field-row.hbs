{{!-- The label sits above its control, which takes the row's full width. Side by
     side, a sidebar under 200px wide squeezed a number to ~40px between its label
     and its value label, and a text field wrapped under its label while the rows
     around it didn't, so the column read uneven. Stacked, every row reads the same
     and no value clips ("Home Wor", "Demeanou"). --}}
<div class="{{field.rowClass}} tw-flex tw-flex-col tw-w-full tw-min-w-0 tw-gap-0.5" data-sidebar-field="{{field.name}}">
    <span class="tw-text-[0.75rem] tw-font-bold tw-uppercase tw-text-[var(--wh40k-text-medium,#666)] tw-text-gold {{themeClassFor 'accent'}}" data-sidebar-field-label>
        {{#if field.icon}}<i class="{{field.icon}}"></i> {{/if}}{{field.label}}
    </span>
    <div class="tw-flex tw-w-full tw-min-w-0 tw-items-baseline tw-gap-2" data-sidebar-field-control>
    {{#if (eq field.type "select")}}
    <select
        class="tw-min-w-0 tw-flex-1 tw-border-0 tw-border-b tw-border-solid tw-border-[var(--wh40k-border-color,#4a3728)] tw-bg-transparent tw-px-1.5 tw-py-0.5 tw-text-[var(--wh40k-text-dark,#333)] focus:tw-border-[var(--wh40k-gold,var(--wh40k-color-gold))] focus:tw-outline-none focus:tw-shadow-[0_1px_0_var(--wh40k-gold,var(--wh40k-color-gold))]"
        name="{{field.name}}"
    >
        {{selectOptions field.options selected=field.value}}
    </select>
    {{else}}
    <input
        class="{{field.inputClass}} tw-min-w-0 tw-flex-1 tw-border-0 tw-border-b tw-border-solid tw-bg-transparent tw-px-1.5 tw-py-0.5 tw-text-[var(--wh40k-text-dark,#333)] focus:tw-outline-none"
        name="{{field.name}}"
        type="{{field.type}}"
        value="{{field.value}}"
        placeholder="{{field.placeholder}}"
        {{#if field.disabled}}disabled{{/if}}
        {{#if field.min}}min="{{field.min}}"{{/if}}
        {{#if field.max}}max="{{field.max}}"{{/if}}
        {{#if field.borderColor}}style="border-color: {{field.borderColor}};"{{else}}style="border-color: var(--wh40k-border-color,#4a3728);"{{/if}}
    />
    {{/if}}
    {{#if field.valueLabel}}
    <span class="{{field.valueClass}} tw-shrink-0 tw-max-w-[50%] tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-xs tw-text-[var(--wh40k-text-dark,#333)]" {{#if field.valueColor}}style="color: {{field.valueColor}};"{{/if}}>
        {{field.valueLabel}}
    </span>
    {{/if}}
    </div>
</div>
