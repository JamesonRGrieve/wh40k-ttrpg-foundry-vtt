<div class="{{concat 'wh40k-header__item-wrapper--' (cleanFieldName key)}} tw-p-2 tw-bg-[var(--wh40k-panel-bg)] tw-rounded-md tw-border tw-border-[var(--wh40k-border-color-light)] tw-m-[2px]">
    <span class="tw-font-semibold tw-text-[color:var(--wh40k-text-dark)] tw-uppercase tw-text-[0.8em] tw-tracking-[0.05em] tw-text-gold {{themeClassFor 'accent'}}">{{capitalize key}}</span>
    {{#if options}}
        <select class="{{concat 'player-' key}} tw-rounded-md tw-py-[6px] tw-px-2 tw-bg-[var(--wh40k-panel-bg-solid)] tw-border tw-border-[var(--wh40k-border-color-light)]" name="system.bio.{{key}}">
            <option value=""></option>
            {{selectOptions (arrayToObject options) selected=this.value}}
        </select>
    {{else}}
        <input class="tw-rounded-md tw-py-[6px] tw-px-2 tw-bg-[var(--wh40k-panel-bg-solid)] tw-border tw-border-[var(--wh40k-border-color-light)]" name="system.bio.{{key}}" type="text" value="{{this.value}}" />
    {{/if}}
</div>