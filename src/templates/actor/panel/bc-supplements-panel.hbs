{{!--
    Black Crusade Supplement Mechanics panel (#181).

    Surfaces the persisted Daemon Engine(X) rating the pure resolver in
    `src/module/rules/bc-supplement-mechanics.ts` consumes
    (daemonEngineRageBonus).

    Irradiated(X) ticks live on the target's effect state. The Quick and
    the Dead trait has no panel: its +2 Initiative is authored on the
    trait document and folds into Initiative through the item-modifier path.

    Context (built by the BC character sheet):

      supplementsPanel: {
        daemonEngineRating:  number               // sys.daemonEngineRating
        daemonEngineActive:  boolean              // rating > 0
        turnsSinceLastDamage: number              // ephemeral / dialog-scoped
        daemonEngineRageBonus: number             // daemonEngineRageBonus({rating, turnsSinceLastDamage})
      }

    Rendered only for BC actors; the include in tab-overview.hbs gates on
    `isBC`.
--}}
{{#> systems/wh40k-rpg/templates/actor/partial/system-card.hbs rootClass="wh40k-bc-supplements-panel" accentBorderClass="bc:tw-border-crimson" accentIconClass="bc:tw-text-crimson-l40" icon="fa-skull-crossbones" label=(localize "WH40K.BC.Supplements.PanelHeader") rootAttrs=(safeAttrs "data-bc-daemon-engine-rating" supplementsPanel.daemonEngineRating)}}

    {{!-- Daemon Engine(X) rating --}}
    <div class="tw-flex tw-flex-col tw-gap-1 tw-px-2 tw-py-1 tw-rounded tw-bg-[rgba(0,0,0,0.18)]">
        <div class="tw-flex tw-items-center tw-justify-between tw-gap-2">
            <label class="tw-text-[0.72rem] tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-muted)]"
                   for="bc-daemon-engine-rating">
                {{localize "WH40K.BC.Supplements.DaemonEngine.RatingLabel"}}
            </label>
            <input id="bc-daemon-engine-rating"
                   name="system.daemonEngineRating"
                   type="number"
                   min="0"
                   step="1"
                   value="{{supplementsPanel.daemonEngineRating}}"
                   data-wh40k-hook="bc-daemon-engine-rating-input" class="tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] tw-rounded tw-px-1 tw-py-0.5 tw-w-16 tw-text-right tw-tabular-nums tw-text-[0.78rem] tw-text-[color:var(--wh40k-text-bright)]" />
        </div>
        {{#if supplementsPanel.daemonEngineActive}}
            <div data-wh40k-hook="bc-daemon-engine-rage" class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)]"
                 data-rage-bonus="{{supplementsPanel.daemonEngineRageBonus}}">
                <span class="tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-muted)]">
                    {{localize "WH40K.BC.Supplements.DaemonEngine.RageBonusLabel"}}
                </span>
                <span class="tw-font-semibold tw-tabular-nums">
                    +{{supplementsPanel.daemonEngineRageBonus}}
                </span>
            </div>
        {{/if}}
    </div>
{{/systems/wh40k-rpg/templates/actor/partial/system-card.hbs}}
