{{!--
    Deathwatch Distinctions panel (#171).

    Lists the Battle-Brother's owned special-ability items — speciality
    abilities, Advanced Special Abilities, Distinctions and Marks of
    Distinction — with each one's category, required Renown rank, Renown
    reward and XP cost, then the merged grant of every borne Mark. Clicking
    an entry opens its item sheet (`itemEdit`).

    Context (built by CharacterSheet._prepareDwDistinctionPanel, DW only):

      distinctionPanel: {
        abilities: Array<{
          id:             string    // owned item id
          name:           string
          category:       string    // speciality | advanced | distinction | mark
          categoryLabel:  string    // localised
          renownRequired: string    // localised rank label; blank when none
          renownReward:   number
          cost:           number    // XP
          rankTooLow:     boolean   // bearer's Renown rank is below the requirement
        }>
        merged: {
          characteristicDelta: Array<{ key: string, value: number, displayValue: string }>
          traits:              string[]   // display names
        }
      }

    Rendered only for DW actors; the include in tab-overview.hbs gates on `isDW`.
--}}
<section class="wh40k-dw-distinction-panel tw-flex tw-flex-col tw-gap-2 tw-p-3 tw-rounded
                tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)]
                tw-bg-[color:var(--wh40k-panel-bg,rgba(0,0,0,0.18))]
                dw:tw-border-accent-combat">

    {{!-- Header --}}
    <header class="tw-flex tw-items-center tw-gap-1.5">
        <i class="fas fa-medal dw:tw-text-accent-combat-l30" aria-hidden="true"></i>
        <h3 class="tw-m-0 tw-text-[0.85rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-bright)]">
            {{localize "WH40K.DW.Distinction.Panel.Title"}}
        </h3>
    </header>

    {{!-- Special abilities --}}
    <ul class="tw-flex tw-flex-col tw-gap-1 tw-m-0 tw-p-0 tw-list-none">
        {{#each distinctionPanel.abilities}}
            <li>
                <button type="button"
                        data-wh40k-hook="dw-distinction-entry" class="tw-flex tw-w-full tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1.5 tw-rounded tw-cursor-pointer tw-border tw-border-solid tw-text-left tw-transition-colors tw-bg-[rgba(0,0,0,0.18)] tw-border-[color:var(--wh40k-border-color-light)] tw-text-[color:var(--wh40k-text-bright)] dw:tw-border-accent-combat {{#if this.rankTooLow}}tw-opacity-60{{/if}}"
                        data-action="itemEdit"
                        data-item-id="{{this.id}}"
                        data-category="{{this.category}}"
                        data-rank-too-low="{{#if this.rankTooLow}}true{{else}}false{{/if}}">
                    <span class="tw-flex tw-flex-col tw-gap-0.5 tw-min-w-0">
                        <span class="tw-text-[0.78rem] tw-font-semibold tw-truncate">{{this.name}}</span>
                        <span data-wh40k-hook="dw-distinction-category" class="tw-text-[0.65rem] tw-uppercase tw-tracking-[0.04em] tw-text-[color:var(--wh40k-text-muted)]">{{this.categoryLabel}}</span>
                    </span>
                    <span class="tw-flex tw-shrink-0 tw-items-center tw-gap-2 tw-text-[0.7rem] tw-text-[color:var(--wh40k-text-muted)]">
                        {{#if this.renownRequired}}
                            <span data-wh40k-hook="dw-distinction-rank" title="{{localize 'WH40K.DW.Renown.Required'}}">{{this.renownRequired}}</span>
                        {{/if}}
                        {{#if this.renownReward}}
                            <span data-wh40k-hook="dw-distinction-reward" title="{{localize 'WH40K.DW.Distinction.RenownReward'}}">+{{this.renownReward}}</span>
                        {{/if}}
                        {{#if this.cost}}
                            <span data-wh40k-hook="dw-distinction-cost" title="{{localize 'WH40K.SpecialAbility.Cost'}}">{{localize "WH40K.SpecialAbility.XpCost" cost=this.cost}}</span>
                        {{/if}}
                        {{#if this.rankTooLow}}
                            <span data-wh40k-hook="dw-distinction-locked" title="{{localize 'WH40K.DW.Distinction.RankLocked'}}">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                                <span class="tw-sr-only">{{localize "WH40K.DW.Distinction.RankLocked"}}</span>
                            </span>
                        {{/if}}
                    </span>
                </button>
            </li>
        {{else}}
            <li class="tw-m-0 tw-px-2 tw-py-1 tw-text-[0.72rem] tw-italic tw-text-[color:var(--wh40k-text-muted)]">
                {{localize "WH40K.DW.Distinction.List.Empty"}}
            </li>
        {{/each}}
    </ul>

    {{!-- Merged Mark grants --}}
    <section data-wh40k-hook="dw-distinction-merged" class="tw-flex tw-flex-col tw-gap-1 tw-mt-1 tw-px-2 tw-py-1.5 tw-rounded tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] tw-bg-[rgba(0,0,0,0.18)] dw:tw-border-accent-combat">
        <header class="tw-flex tw-items-center tw-gap-1.5">
            <i class="fas fa-balance-scale dw:tw-text-accent-combat-l30" aria-hidden="true"></i>
            <h4 class="tw-m-0 tw-text-[0.72rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-bright)]">
                {{localize "WH40K.DW.Distinction.Merged.Title"}}
            </h4>
        </header>

        <div class="tw-flex tw-flex-wrap tw-gap-1.5 tw-items-baseline">
            <span class="tw-text-[0.7rem] tw-uppercase tw-tracking-[0.04em] tw-text-[color:var(--wh40k-text-muted)]">
                {{localize "WH40K.DW.Distinction.Delta.Characteristics"}}:
            </span>
            {{#each distinctionPanel.merged.characteristicDelta}}
                <span data-wh40k-hook="dw-distinction-merged-char" class="tw-px-1.5 tw-py-0.5 tw-rounded tw-text-[0.7rem] tw-font-semibold tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] dw:tw-border-accent-combat">
                    {{this.key}} {{this.displayValue}}
                </span>
            {{else}}
                <span class="tw-text-[0.7rem] tw-italic tw-text-[color:var(--wh40k-text-muted)]">
                    {{localize "WH40K.DW.Distinction.Delta.None"}}
                </span>
            {{/each}}
        </div>

        <div class="tw-flex tw-flex-wrap tw-gap-1.5 tw-items-baseline">
            <span class="tw-text-[0.7rem] tw-uppercase tw-tracking-[0.04em] tw-text-[color:var(--wh40k-text-muted)]">
                {{localize "WH40K.DW.Distinction.Delta.Traits"}}:
            </span>
            {{#each distinctionPanel.merged.traits}}
                <span data-wh40k-hook="dw-distinction-merged-trait" class="tw-px-1.5 tw-py-0.5 tw-rounded tw-text-[0.7rem] tw-font-semibold tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] dw:tw-border-accent-combat">
                    {{this}}
                </span>
            {{else}}
                <span class="tw-text-[0.7rem] tw-italic tw-text-[color:var(--wh40k-text-muted)]">
                    {{localize "WH40K.DW.Distinction.Delta.None"}}
                </span>
            {{/each}}
        </div>
    </section>
</section>
