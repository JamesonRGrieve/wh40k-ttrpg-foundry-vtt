{{!-- Combat Tab Panel --}}
{{!-- Streamlined combat interface --}}

<div class="tw-flex tw-flex-col tw-gap-3 tw-p-3 tw-flex-1 tw-min-h-0" style="container-type: inline-size;">
    <div class="tw-flex tw-flex-col tw-gap-3 tw-w-full tw-flex-1 tw-min-h-0">
        {{!-- Row 1: Weapons (full width, top — primary combat interaction) --}}
            <div class="wh40k-panel tw-flex-1 tw-min-h-0" data-drop-zone="general" data-accepts="weapon">
                <div class="wh40k-panel-header tw-order-[-1] tw-shrink-0 tw-flex tw-items-center">
                    {{> systems/wh40k-rpg/templates/actor/partial/panel-header.hbs label=(localize "WH40K.Combat.Weapons") icon="fa-fist-raised"}}
                    {{#if handBudget}}
                    <span class="tw-ml-auto tw-shrink-0 tw-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-full tw-text-[0.65rem] tw-font-bold tw-uppercase tw-tracking-wide tw-border tw-border-solid {{#if handBudget.overCommitted}}tw-bg-[rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.12)] tw-text-[color:var(--wh40k-accent-combat)] tw-border-[rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.3)]{{else}}tw-bg-[rgba(0,0,0,0.06)] tw-text-[color:var(--wh40k-text-secondary)] tw-border-[rgba(0,0,0,0.15)]{{/if}}"
                          title="{{localize "WH40K.Combat.HandBudgetTooltip"}}">
                        <i class="fas fa-hand-paper tw-text-[0.7rem]"></i>
                        {{localize "WH40K.Combat.Hands"}} {{handBudget.remaining}}/{{handBudget.available}}
                    </span>
                    {{/if}}
                </div>
                <div class="wh40k-panel-body tw-flex-1 tw-min-h-0 tw-overflow-y-auto tw-overflow-x-hidden">
                    {{#if actor.items}}
                    <div class="tw-flex tw-flex-col">
                        <div class="tw-grid tw-grid-cols-content-auto-auto tw-gap-x-2 tw-px-2 tw-py-1 tw-bg-[rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.08)] tw-border-b-2 tw-border-b-[rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.2)] tw-text-[color:var(--wh40k-text-secondary)]">
                            <span class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide">Weapon</span>
                            <span class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-center tw-min-w-12">Dmg</span>
                            <span class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-center tw-min-w-12">Range</span>
                        </div>
                        {{#each actor.items as |item|}}
                        {{#if item.isWeapon}}
                        <div class="tw-group tw-relative tw-grid tw-grid-cols-content-auto-auto tw-gap-x-2 tw-items-center tw-px-2 tw-py-1 tw-cursor-pointer tw-border-b tw-border-b-[rgba(0,0,0,0.08)] tw-transition-[background] hover:tw-bg-[rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.04)] item-drag item-edit {{#if item.system.state.equipped}}tw-bg-[rgb(from_var(--wh40k-color-success)_r_g_b_/_0.08)]{{/if}}" data-item-id="{{item.id}}" data-item-type="weapon">
                            <span class="tw-flex tw-items-center tw-gap-1 tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-sm">
                                {{#if item.system.state.equipped}}<i class="fas fa-check-circle tw-text-[color:var(--wh40k-color-success)] tw-mr-[var(--wh40k-space-xs)] tw-text-[0.8em]"></i>{{/if}}
                                {{item.name}}
                            </span>
                            <span class="tw-text-sm tw-text-center tw-min-w-12">{{#if (or item.system.state.identified @root.isGM)}}{{item.system.damageLabel}}{{else}}{{localize "WH40K.Weapon.ConcealedStat"}}{{/if}}</span>
                            <span class="tw-text-sm tw-text-center tw-min-w-12">{{#if (or item.system.state.identified @root.isGM)}}{{item.system.rangeLabel}}{{else}}{{localize "WH40K.Weapon.ConcealedStat"}}{{/if}}</span>
                            <button type="button"
                                    class="tw-absolute tw-right-8 tw-top-1/2 -tw-translate-y-1/2 tw-w-5 tw-h-5 tw-p-0 tw-bg-[var(--wh40k-panel-bg-solid)] tw-border tw-border-solid tw-rounded tw-text-[0.7rem] tw-cursor-pointer tw-transition-colors {{#if item.system.state.equipped}}tw-border-[color:var(--wh40k-color-success)] tw-text-[color:var(--wh40k-color-success)]{{else}}tw-border-[color:var(--wh40k-border-medium)] tw-text-[color:var(--wh40k-text-muted)] hover:tw-text-[color:var(--wh40k-accent-combat)] hover:tw-border-[color:var(--wh40k-accent-combat)]{{/if}}"
                                    data-action="toggleEquip"
                                    data-item-id="{{item.id}}"
                                    title="{{#if item.system.state.equipped}}{{localize "WH40K.Weapon.HolsterWeapon"}}{{else}}{{localize "WH40K.Weapon.DrawWeapon"}}{{/if}}"
                                    aria-label="{{#if item.system.state.equipped}}{{localize "WH40K.Weapon.HolsterWeapon"}}{{else}}{{localize "WH40K.Weapon.DrawWeapon"}}{{/if}}">
                                <i class="fas {{#if item.system.state.equipped}}fa-box-archive{{else}}fa-hand-fist{{/if}}"></i>
                            </button>
                            <button type="button"
                                    class="tw-absolute tw-right-1 tw-top-1/2 -tw-translate-y-1/2 tw-w-5 tw-h-5 tw-p-0 tw-bg-[var(--wh40k-panel-bg-solid)] tw-border tw-border-solid tw-border-[var(--wh40k-border-medium)] tw-rounded tw-text-[0.7rem] tw-text-[color:var(--wh40k-text-muted)] tw-opacity-0 tw-pointer-events-none tw-cursor-pointer hover:tw-text-[color:var(--wh40k-accent-combat)] hover:tw-border-[color:var(--wh40k-accent-combat)] tw-group-hover:tw-opacity-100 tw-group-hover:tw-pointer-events-auto tw-focus:tw-opacity-100 tw-focus:tw-pointer-events-auto tw-transition-opacity"
                                    data-action="itemDelete"
                                    data-item-id="{{item.id}}"
                                    title="{{localize "WH40K.Common.Delete"}}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        {{/if}}
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
            </div>
        {{!-- Row 2: Armour (left) | Movement (right) — two-column sub-layout --}}
        <div class="tw-grid tw-grid-cols-2 tw-gap-3 tw-items-start">
            <div class="tw-flex tw-flex-col tw-gap-2">
                {{> systems/wh40k-rpg/templates/actor/partial/armour-zone.hbs armourDisplay=armourDisplay equippedGear=equippedGear compact=false}}
                {{#if hasForceField}}
                <div class="wh40k-panel tw-mt-[var(--wh40k-space-xs)]">
                    <div class="wh40k-panel-header">
                        {{> systems/wh40k-rpg/templates/actor/partial/panel-header.hbs label="Force Field" icon="fa-circle-notch"}}
                    </div>
                    <div class="wh40k-panel-body">
                        <div class="tw-flex tw-items-center tw-gap-[var(--wh40k-space-sm)]">
                            <span class="tw-font-semibold">{{forceField.name}}</span>
                            <span class="tw-text-[color:var(--color-text-secondary)] tw-text-[var(--wh40k-font-size-sm)]">({{forceField.system.protectionRating}})</span>
                            {{#if forceField.system.state.overloaded}}
                                <span class="tw-ml-auto tw-text-[var(--wh40k-font-size-xs)] tw-font-bold tw-uppercase tw-text-[color:var(--wh40k-accent-combat)]">OVERLOADED</span>
                            {{else}}
                                <span class="tw-ml-auto tw-text-[var(--wh40k-font-size-xs)] tw-font-bold tw-uppercase {{#if forceField.system.state.activated}}tw-text-[color:var(--wh40k-color-success)]{{else}}tw-text-[color:var(--wh40k-text-muted)]{{/if}}">
                                    {{#if forceField.system.state.activated}}ACTIVE{{else}}OFF{{/if}}
                                </span>
                            {{/if}}
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>
            <div class="tw-self-start [&_.wh40k-panel]:tw-mb-0">
                {{> systems/wh40k-rpg/templates/actor/panel/movement-panel-compact.hbs}}
            </div>
        </div>
        {{!-- Row 3: Vitals + Combat Actions --}}
        <div class="tw-grid tw-grid-cols-[minmax(0,2fr)_minmax(320px,1fr)] tw-gap-3 tw-items-start">
            <div class="tw-flex tw-flex-col tw-gap-3 tw-min-w-0">
                <div class="tw-flex tw-flex-col tw-gap-2">
                    <div class="wh40k-panel">
                        <div class="wh40k-panel-header">
                            {{> systems/wh40k-rpg/templates/actor/partial/panel-header.hbs label="Vitals" icon="fa-heartbeat"}}
                        </div>
                        <div class="wh40k-panel-body tw-flex tw-flex-col tw-gap-2 tw-bg-gradient-to-br tw-from-black/[0.02] tw-to-black/[0.05] tw-border tw-border-solid tw-border-black/10 tw-rounded-[var(--wh40k-radius-lg)] tw-shadow-[inset_0_1px_3px_rgba(0,0,0,0.05)] tw-p-2">
                            {{> systems/wh40k-rpg/templates/actor/panel/overview-vitals-panel.hbs showHeader=false}}
                            {{> systems/wh40k-rpg/templates/actor/panel/overview-active-effects-panel.hbs}}

                            {{#if isNPC}}
                            {{#unless npcFateHidden}}
                            <div class="tw-group tw-flex tw-flex-col tw-gap-[6px] tw-p-[var(--wh40k-space-sm)] tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-light)] tw-rounded-[6px] tw-transition-all tw-relative tw-overflow-hidden tw-min-w-0 tw-w-full hover:tw-border-[color:var(--vital-color,var(--wh40k-border-medium))] hover:tw-shadow-[0_2px_8px_rgba(0,0,0,0.08)]" style="--vital-color:var(--wh40k-accent-info);--vital-color-rgb:52,152,219">
                                <span class="tw-absolute tw-left-0 tw-top-0 tw-bottom-0 tw-w-[3px] tw-bg-[var(--vital-color,var(--wh40k-border-medium))] tw-transition-all tw-pointer-events-none group-hover:tw-w-[5px]" aria-hidden="true"></span>
                                <div class="tw-flex tw-items-center tw-justify-between tw-gap-[var(--wh40k-space-sm)] tw-w-full">
                                    <div class="sheet-control__hide-control tw-cursor-pointer tw-select-none tw-flex tw-items-center tw-gap-[var(--wh40k-space-xs)] tw-flex-1 tw-transition-colors tw-duration-200 tw-p-[var(--wh40k-space-xs)] tw-mx-[calc(-1*var(--wh40k-space-xs))] tw-mr-0 tw-rounded-[var(--wh40k-radius-md)]"
                                         data-toggle="combat_fate_details"
                                         title="Click to {{#if (isExpanded 'combat_fate_details' actor)}}collapse{{else}}expand{{/if}}">
                                        <div class="tw-flex tw-items-center tw-gap-[6px] tw-text-[0.65rem] tw-font-bold tw-uppercase tw-tracking-[0.08em] tw-text-[color:var(--vital-color,var(--wh40k-text-secondary))] tw-whitespace-nowrap [&>i]:tw-text-[0.75rem]">
                                            <i class="fas fa-star"></i>
                                            <span>FATE</span>
                                        </div>
                                        <i class="fas fa-chevron-down tw-text-xs tw-text-[var(--wh40k-text-muted)] tw-transition-[transform,color] tw-duration-200 tw-ml-auto tw-flex-shrink-0 {{#if (isExpanded 'combat_fate_details' actor)}}tw-rotate-180{{/if}}"></i>
                                    </div>
                                    <div class="tw-flex tw-gap-[var(--wh40k-space-xs)] tw-shrink-0">
                                        <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-gap-[var(--wh40k-space-xs)] tw-p-0 tw-m-0 tw-cursor-pointer tw-transition-all tw-font-bold tw-rounded-[6px] tw-w-[22px] tw-h-[22px] tw-text-[0.7rem] tw-bg-[rgba(var(--vital-color-rgb,0,0,0),0.08)] tw-border tw-border-solid tw-border-[rgba(var(--vital-color-rgb,0,0,0),0.2)] tw-text-[color:var(--vital-color,var(--wh40k-text-primary))]" data-action="decrement" data-field="system.fate.value" data-min="0" title="Spend"><i class="fas fa-minus tw-text-[0.65rem] tw-leading-none"></i></button>
                                        <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-gap-[var(--wh40k-space-xs)] tw-p-0 tw-m-0 tw-cursor-pointer tw-transition-all tw-font-bold tw-rounded-[6px] tw-w-[22px] tw-h-[22px] tw-text-[0.7rem] tw-bg-[rgba(var(--vital-color-rgb,0,0,0),0.08)] tw-border tw-border-solid tw-border-[rgba(var(--vital-color-rgb,0,0,0),0.2)] tw-text-[color:var(--vital-color,var(--wh40k-text-primary))]" data-action="increment" data-field="system.fate.value" title="Restore"><i class="fas fa-plus tw-text-[0.65rem] tw-leading-none"></i></button>
                                    </div>
                                </div>
                                <div class="tw-flex tw-flex-col tw-gap-[6px] tw-w-full">
                                    <div class="tw-flex tw-flex-wrap tw-items-center tw-justify-center tw-gap-1.5 tw-py-1.5">
                                        {{#each (range 1 system.fate.max) as |index|}}
                                            <button type="button" class="tw-w-7 tw-h-7 tw-p-0 tw-bg-transparent tw-border-none tw-cursor-pointer tw-inline-flex tw-items-center tw-justify-center {{#if (lte index ../system.fate.value)}}tw-animate-star-glow{{else}}tw-opacity-40{{/if}}" data-action="setFateStar" data-fate-index="{{index}}" title="Fate Point {{index}}{{#if (lte index ../system.fate.value)}} (Available — click to spend){{else}} (Spent — click to restore){{/if}}">
                                                <i class="fas fa-star {{#if (lte index ../system.fate.value)}}tw-text-[var(--wh40k-accent-gold)]{{else}}tw-text-[color:var(--wh40k-text-muted)]{{/if}}"></i>
                                            </button>
                                        {{/each}}
                                    </div>
                                </div>
                                <div class="combat_fate_details tw-py-[var(--wh40k-space-sm)] tw-px-[var(--wh40k-space-md)] tw-bg-[rgba(0,0,0,0.02)] tw-border-t tw-border-[var(--wh40k-border-color-light)]" {{hideIfNot (isExpanded 'combat_fate_details' actor)}}>
                                    <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)] tw-p-[var(--wh40k-space-sm)] tw-mt-[var(--wh40k-space-sm)] tw-bg-[rgba(0,0,0,0.02)] tw-border tw-border-solid tw-border-[rgba(0,0,0,0.08)] tw-rounded-[var(--wh40k-radius-md)]">
                                        <label class="tw-flex tw-flex-col tw-gap-1">
                                            <span class="tw-text-[0.65rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-secondary)]">Max Fate</span>
                                            <input type="number" data-dtype="Number" class="tw-w-full tw-px-2 tw-py-1.5 tw-bg-[var(--wh40k-bg-paper)] tw-border tw-border-solid tw-border-[var(--wh40k-border-light)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.85rem] tw-font-semibold tw-text-[color:var(--wh40k-text-primary)]" name="system.fate.max" value="{{system.fate.max}}" min="0" placeholder="Max" />
                                        </label>
                                        <label class="tw-flex tw-flex-col tw-gap-1">
                                            <span class="tw-text-[0.65rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-secondary)]">Current Fate</span>
                                            <input type="number" data-dtype="Number" class="tw-w-full tw-px-2 tw-py-1.5 tw-bg-[var(--wh40k-bg-paper)] tw-border tw-border-solid tw-border-[var(--wh40k-border-light)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.85rem] tw-font-semibold tw-text-[color:var(--wh40k-text-primary)]" name="system.fate.value" value="{{system.fate.value}}" min="0" max="{{system.fate.max}}" placeholder="Current" />
                                        </label>
                                    </div>
                                </div>
                            </div>
                            {{/unless}}
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
            <div class="tw-flex tw-flex-col tw-gap-2 tw-min-w-0">
                {{> systems/wh40k-rpg/templates/actor/panel/combat-actions-panel.hbs}}
            </div>
        </div>
        {{!-- Row 4: Psychic Powers (#412) --}}
        {{#if showPsychicPanel}}
        {{> systems/wh40k-rpg/templates/actor/panel/combat-psychic-panel.hbs psychicPowers=psychicPowers psyRating=psyRating}}
        {{/if}}
        </div>
</div>
