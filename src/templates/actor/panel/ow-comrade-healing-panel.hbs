{{!--
    Only War "Healing Comrades" panel (#157 — the OW rules, Healing Comrades
    and replacement on return to camp).

    Surfaces the wounded Comrade's seven-day recovery clock and the RAW ways
    to shorten or end it:

      • "Tick Day" — one day of in-fiction rest; the last day returns the
        Comrade to unharmed.
      • "Medicae Attempt" — the wound's single Difficult (-10) Medicae Test;
        its Degrees of Success come off the clock.
      • Camp refit toggle — the squad is back in camp for refitting.
      • "Replace at Camp" — replaces a dead Comrade while in camp.

    Sheet context: `buildComradeHealingPanel` (rules/ow-comrade-healing.ts),
    which the sheet's `_prepareOwComradeHealingPanel` passes through unchanged:

      comradeHealingPanel: {
        comradeState:      'unharmed' | 'wounded' | 'dead'
        recoveryDays:      number   // sys.comradeRecoveryDays
        autoRecoveryTotal: number   // OW_COMRADE_AUTO_RECOVERY_DAYS (7)
        refitAvailable:    boolean  // sys.refitAvailable
        medicaeUsed:       boolean  // sys.comradeMedicaeUsed
        medicaeDifficulty: number   // OW_COMRADE_MEDICAE_DIFFICULTY_MODIFIER (-10)
        status:            'recovering' | 'ready' | 'dead'
        statusKey:         string   // the status badge's label key
        isRecovering / isReady / isDead: boolean
        canTick:           boolean  // wounded with days still owed
        canMedicae:        boolean  // canTick and the attempt not yet made
        canReplace:        boolean  // dead and back in camp
      }

    Rendered only for OW actors; the include in tab-status.hbs gates on
    `isOW`.
--}}
{{#> systems/wh40k-rpg/templates/actor/partial/system-card.hbs rootClass="wh40k-ow-healing-panel" accentBorderClass="ow:tw-border-brass" accentIconClass="ow:tw-text-brass" icon="fa-staff-snake" label=(localize "WH40K.OW.ComradeHealing.Label") rootAttrs=(safeAttrs "data-ow-healing-state" comradeHealingPanel.comradeState "data-ow-healing-recovering" comradeHealingPanel.isRecovering) hasRightSlot=true}}
    {{!-- Header right slot: recovering / ready / dead badge --}}
    {{#*inline "rightSlot"}}
        <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded tw-border tw-border-solid tw-px-2 tw-py-0.5 tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em]
 {{#if comradeHealingPanel.isReady}}tw-border-success tw-text-success-l20 tw-bg-success/10{{/if}}
 {{#if comradeHealingPanel.isRecovering}}tw-border-gold tw-text-gold tw-bg-gold/10{{/if}}
 {{#if comradeHealingPanel.isDead}}tw-border-crimson tw-text-crimson-l40 tw-bg-crimson/10{{/if}}"
              data-recovery-status="{{comradeHealingPanel.status}}">
            {{localize comradeHealingPanel.statusKey}}
        </span>
    {{/inline}}

    {{!-- Recovery clock readout --}}
    <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded
 tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)]
 tw-text-[0.78rem]"
         data-field="recovery-days">
        <span class="tw-text-[color:var(--wh40k-text-muted)] tw-tabular-nums">
            {{localize "WH40K.OW.ComradeHealing.AutoRecoveryDays" days=comradeHealingPanel.autoRecoveryTotal}}
        </span>
        <span class="tw-text-[color:var(--wh40k-text-bright)] tw-font-semibold tw-tabular-nums"
              data-remaining-days="{{comradeHealingPanel.recoveryDays}}">
            {{#if comradeHealingPanel.isRecovering}}
                {{localize "WH40K.OW.ComradeHealing.RemainingDays" days=comradeHealingPanel.recoveryDays}}
            {{else if comradeHealingPanel.isReady}}
                <i class="fas fa-check tw-text-success-l20 tw-mr-1"></i>
                {{localize "WH40K.OW.ComradeHealing.Recovery.Complete"}}
            {{else}}
                &mdash;
            {{/if}}
        </span>
    </div>

    {{!-- Camp refit: a toggle, since replacing a dead Comrade waits on it --}}
    <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded
 tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)]
 tw-text-[0.78rem]"
         data-field="refit-available">
        <span class="tw-text-[color:var(--wh40k-text-muted)]">
            {{localize "WH40K.OW.ComradeHealing.Refit"}}
        </span>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-gap-1 tw-w-auto tw-h-auto tw-min-h-0 tw-m-0 tw-px-1.5 tw-py-0 tw-text-[0.78rem] tw-leading-tight tw-rounded tw-border tw-border-solid tw-border-transparent tw-bg-transparent tw-cursor-pointer tw-font-semibold hover:tw-border-[color:var(--wh40k-border-color-light)]
 {{#if comradeHealingPanel.refitAvailable}}tw-text-success-l20{{else}}tw-text-crimson-l40{{/if}}"
                data-action="owComradeToggleRefit"
                data-refit="{{#if comradeHealingPanel.refitAvailable}}available{{else}}unavailable{{/if}}"
                aria-pressed="{{#if comradeHealingPanel.refitAvailable}}true{{else}}false{{/if}}"
                title="{{localize 'WH40K.OW.ComradeHealing.Action.ToggleRefit'}}">
            <i class="fas {{#if comradeHealingPanel.refitAvailable}}fa-truck-medical{{else}}fa-ban{{/if}}"></i>
            {{#if comradeHealingPanel.refitAvailable}}
                {{localize "WH40K.OW.ComradeHealing.Status.RefitAvailable"}}
            {{else}}
                {{localize "WH40K.OW.ComradeHealing.Status.RefitUnavailable"}}
            {{/if}}
        </button>
    </div>

    {{!-- Action affordances --}}
    <div class="tw-flex tw-flex-wrap tw-gap-1.5">
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeTickDay"
                title="{{localize 'WH40K.OW.ComradeHealing.Action.TickDay'}}"
                {{#unless comradeHealingPanel.canTick}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-clock tw-mr-1"></i>
            {{localize "WH40K.OW.ComradeHealing.Action.TickDay"}}
        </button>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeMedicae"
                title="{{#if comradeHealingPanel.medicaeUsed}}{{localize 'WH40K.OW.ComradeHealing.Medicae.Used'}}{{else}}{{localize 'WH40K.OW.ComradeHealing.Medicae.Difficulty'}}{{/if}}"
                data-medicae-difficulty="{{comradeHealingPanel.medicaeDifficulty}}"
                {{#unless comradeHealingPanel.canMedicae}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-staff-snake tw-mr-1"></i>
            {{localize "WH40K.OW.ComradeHealing.Action.MedicaeAttempt"}}
        </button>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeReplace2"
                title="{{localize 'WH40K.OW.ComradeHealing.Action.Replace'}}"
                {{#unless comradeHealingPanel.canReplace}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-user-plus tw-mr-1"></i>
            {{localize "WH40K.OW.ComradeHealing.Action.Replace"}}
        </button>
    </div>
{{/systems/wh40k-rpg/templates/actor/partial/system-card.hbs}}
