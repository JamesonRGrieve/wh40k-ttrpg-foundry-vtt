{{!--
    Overview Vitals panel (#494) — the Wounds / Critical / Fatigue / Fate pip
    trackers plus Shock, Pinning and the mental (Corruption / Insanity) rows.

    Extracted from tab-overview.hbs so the Combat tab can render the SAME panel
    beneath its own Vitals card without duplicating ~130 lines of markup. Both
    tabs include this partial; it reads the standard actor sheet context
    (`system`, `isNPC`, the vital-pip-row / vital-inline-row partials).
--}}
            {{!-- Vitals --}}
            <div class="tw-flex tw-flex-col tw-overflow-hidden tw-bg-[var(--color-bg-secondary)] tw-rounded-[6px] tw-border tw-border-solid tw-border-[color:rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.4)] tw-border-l-[3px] tw-border-l-[var(--wh40k-accent-combat)]">
                <div class="tw-flex tw-items-center tw-gap-1.5 tw-py-1.5 tw-px-2.5 tw-bg-[linear-gradient(90deg,rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.12)_0%,var(--color-bg-tertiary)_100%)] tw-text-xs tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)] [&>i]:tw-text-[color:var(--wh40k-accent-combat)]">
                    <i class="fas fa-heartbeat"></i>
                    <span>{{localize "WH40K.Status.VitalsLabel"}}</span>
                </div>
                <div class="tw-p-2 tw-flex-1 tw-flex tw-flex-col tw-gap-1">
                    {{!-- Wounds — heart pip strip (#315), consistent with Fatigue/Fate.
                         Filled hearts = current wounds out of max; the value/max
                         readout stays for an at-a-glance number. --}}
                    {{#> systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs
                        icon="fa-heart" label=(localize "WH40K.Status.Wounds.Label")}}
                        {{> systems/wh40k-rpg/templates/actor/partial/pip-tracker-row
                            count=system.wounds.max
                            current=system.wounds.value
                            action="setWoundPip"
                            dataAttr="wound-index"
                            iconClass="fa-heart"
                            titlePrefix="Wounds"}}
                        <span class="tw-ml-auto tw-text-[0.7rem] tw-font-bold tw-font-alt tw-text-[color:var(--color-text-secondary)]">{{system.wounds.value}}/{{system.wounds.max}}</span>
                    {{/systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs}}

                    {{!-- Critical Wounds --}}
                    {{#if (or (gt system.wounds.critical 0) (eq system.wounds.value 0))}}
                    {{#> systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs
                        icon="fa-skull" label=(localize "WH40K.Status.CriticalLabel") rowClass="wh40k-vital-critical-row"}}
                        {{> systems/wh40k-rpg/templates/actor/partial/pip-tracker-row
                            count=10
                            current=system.wounds.critical
                            action="setCriticalPip"
                            dataAttr="crit-level"
                            pipClass="wh40k-crit-pip-mini"
                            titlePrefix="Critical Level"}}
                    {{/systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs}}
                    {{/if}}

                    {{#unless isNPC}}
                    {{!-- Fatigue (PC-only) --}}
                    {{#> systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs
                        icon="fa-zzz" label=(localize "WH40K.Status.Fatigue.Label")}}
                        {{> systems/wh40k-rpg/templates/actor/partial/pip-tracker-row
                            count=system.fatigue.max
                            current=system.fatigue.value
                            action="setFatigueBolt"
                            dataAttr="fatigue-index"
                            pipClass="wh40k-fatigue-pip"
                            filledClass=" tw-animate-bolt-glow"
                            iconClass="fa-zzz"
                            titlePrefix="Fatigue Level"}}
                        {{#if (gt system.fatigue.value 0)}}
                        <span class="tw-text-[0.7rem] tw-font-bold tw-text-[color:var(--wh40k-accent-combat)] tw-bg-[rgb(from_var(--wh40k-accent-combat)_r_g_b_/_0.1)] tw-px-1 tw-py-[1px] tw-rounded-[3px]">−10</span>
                        {{/if}}
                    {{/systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs}}

                    {{!-- Shock (#66) — DH2-only; rendered immediately under Fatigue in the
                         same vital-row style. Lift/Push moved to the Combat-tab Movement panel. --}}
                    {{#if isDH2}}
                        {{> systems/wh40k-rpg/templates/actor/panel/shock-panel.hbs}}
                        {{> systems/wh40k-rpg/templates/actor/panel/pinning-panel.hbs}}
                    {{/if}}

                    {{!-- Fate Points (PC-only) --}}
                    {{#if (gt system.fate.max 0)}}
                    {{#> systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs
                        icon="fa-star" label=(localize "WH40K.Status.FateLabel")}}
                        {{> systems/wh40k-rpg/templates/actor/partial/pip-tracker-row
                            count=system.fate.max
                            current=system.fate.value
                            action="setFateStar"
                            dataAttr="fate-index"
                            pipClass="wh40k-fate-pip"
                            iconClass="fa-star"
                            titlePrefix="Fate Point"}}
                        <button type="button" class="tw-w-[18px] tw-h-[18px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)] hover:tw-text-[color:var(--wh40k-text-medium)]"
                            data-action="viewFateUses"
                            title="{{localize 'WH40K.FateUses.DialogTitle'}}">
                            <i class="fas fa-circle-info"></i>
                        </button>
                        <button type="button" class="tw-w-[18px] tw-h-[18px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)]" data-action="restoreFate" title="{{localize 'WH40K.Status.RestoreFateTitle'}}">
                            <i class="fas fa-redo"></i>
                        </button>
                    {{/systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs}}
                    {{!-- Burn Threshold (#63) — surfaces system.fate.threshold; hidden when 0.
                         The dedicated fate-panel.hbs partial is unused; this overview tab is
                         what renders, so the threshold line lives here too. --}}
                    {{#if (gt system.fate.threshold 0)}}
                        <div class="wh40k-fate-threshold tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-mt-1 tw-text-[0.7rem] tw-text-[color:var(--wh40k-text-medium)] tw-uppercase tw-tracking-[0.05em]"
                             title="{{localize 'WH40K.VitalEditBody.FateThresholdLabel'}}">
                            <i class="fas fa-fire tw-text-[color:var(--wh40k-wounds-secondary)] tw-text-[0.65rem]"></i>
                            <span>{{localize "WH40K.VitalEditBody.FateThresholdLabel"}}: <strong class="tw-text-[color:var(--wh40k-text-bright)]">{{system.fate.threshold}}</strong></span>
                        </div>
                    {{/if}}
                    {{/if}}
                    {{/unless}}
                </div>

                {{#unless isNPC}}
                {{!-- Mental State (compact) — PC-only (NPC schema has no corruption/insanity) --}}
                <div class="tw-px-2 tw-py-1.5 tw-bg-[rgba(0,0,0,0.05)] tw-mt-auto">
                    {{> systems/wh40k-rpg/templates/actor/partial/vital-inline-row
                        icon="fa-skull"
                        label="Corruption"
                        field="system.corruption"
                        current=system.corruption
                        maxAttr=100
                        rowClass="wh40k-mental-row"
                        labelGroupClass="wh40k-mental-label-group"
                        iconClass="wh40k-mental-icon"
                        labelClass="wh40k-mental-label"
                        valueClass="wh40k-mental-value"
                        stateClass=(corruptionDegreeClass system.corruption)
                        degreeText=(corruptionDegree system.corruption)}}
                    {{> systems/wh40k-rpg/templates/actor/partial/vital-inline-row
                        icon="fa-brain"
                        label="Insanity"
                        field="system.insanity"
                        current=system.insanity
                        maxAttr=100
                        rowClass="wh40k-mental-row"
                        labelGroupClass="wh40k-mental-label-group"
                        iconClass="wh40k-mental-icon"
                        labelClass="wh40k-mental-label"
                        valueClass="wh40k-mental-value"
                        stateClass=(insanityDegreeClass system.insanity)
                        degreeText=(insanityDegree system.insanity)}}
                </div>
                {{/unless}}
            </div>
