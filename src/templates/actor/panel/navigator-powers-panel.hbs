{{!-- Navigator Powers Panel --}}
{{#> systems/wh40k-rpg/templates/actor/partial/collapsible-panel.hbs panelId="navigator-powers" label=(localize "WH40K.NavigatorPowers.Header") icon="fa-eye" count=navigatorPowersCount rootClass="wh40k-panel-powers wh40k-panel-navigator-powers" bodyClass="tw-p-0" titleClass=(concat "tw-text-gold " (themeClassFor 'accent')) accentBg="linear-gradient(135deg,rgb(from #0891b2 r g b / 0.15) 0%,rgb(from #0891b2 r g b / 0.05) 100%)" accentBorder="rgb(from #0891b2 r g b / 0.3)" accentIcon="#0891b2"}}
    {{!-- Powers List --}}
    <div class="tw-flex tw-flex-col tw-gap-2 tw-min-h-[60px] tw-p-[var(--wh40k-space-md)]" data-drop-zone="powers" data-accepts="navigatorPower">
        {{#each navigatorPowers as |power|}}
        {{#> systems/wh40k-rpg/templates/actor/partial/item-list-row.hbs
            item=power
            accentColor="#0891b2"
            dragType="navigatorPower"
            editTitleKey="WH40K.NavigatorPowers.EditPower"
            pills=power.system.pills
            stats=(array
                (hash labelKey="WH40K.NavigatorPowers.Test" value=power.system.testLabel)
                (hash labelKey="WH40K.Orders.Action" value=power.system.activationLabel))
            actions=(array
                (hash action="rollPower" icon="fa-dice-d20" titleKey="WH40K.NavigatorPowers.UsePower" hoverClass="hover:tw-text-[color:var(--wh40k-accent-powers)]")
                (hash action="vocalizePower" icon="fa-comment" titleKey="WH40K.Action.PostToChat" hoverClass="hover:tw-bg-[rgba(59,130,246,0.15)] hover:tw-border-[rgba(59,130,246,0.3)] hover:tw-text-[#3b82f6]")
                (hash action="togglePowerDetails" icon="fa-chevron-down" titleKey="WH40K.Common.ToggleDetails" hoverClass="hover:tw-text-[color:var(--wh40k-text-dark)]"))
        }}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Chat.Item.Novice") icon="fa-seedling" labelClass="tw-text-[#22c55e]" content=power.system.levels.novice.effect}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Chat.Item.Adept") icon="fa-star-half-alt" labelClass="tw-text-[#3b82f6]" content=power.system.levels.adept.effect}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Chat.Item.Master") icon="fa-crown" labelClass="tw-text-[#f59e0b]" content=power.system.levels.master.effect}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.NavigatorPowers.SideEffects") icon="fa-exclamation-triangle" labelClass="tw-text-[#ef4444]" content=power.system.sideEffects}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Description") content=power.system.description}}
        {{/systems/wh40k-rpg/templates/actor/partial/item-list-row.hbs}}
        {{else}}
        {{> systems/wh40k-rpg/templates/actor/partial/empty-state.hbs icon="fa-eye" textKey="WH40K.NavigatorPowers.NoPowers" padding="md"}}
        {{/each}}
    </div>

    {{!-- Add Power Dropzone --}}
    {{> systems/wh40k-rpg/templates/actor/partial/dropzone.hbs type="navigatorPower" hasItems=navigatorPowersCount labelKey="WH40K.NavigatorPowers.DropOrCreate" compactLabelKey="WH40K.DropZone.DropOrClickToAdd"}}
{{/systems/wh40k-rpg/templates/actor/partial/collapsible-panel.hbs}}
