{{!--
    Only War "Comrade in Combat" panel (#152).

    Renders the PC's Comrade abstraction:
      • Comrade name (or "Unnamed" fallback).
      • State badge — color-coded green (Unharmed) / yellow (Wounded) /
        red (Dead) — driven by the unharmed → wounded → dead track in
        `src/module/rules/ow-comrade.ts`.
      • Distance readout vs. the 5 m Cohesion radius, with an
        in-Cohesion / out-of-Cohesion indicator computed once on the
        context-build side (no Handlebars math here).
      • Action affordances:
          - "Wound" — manual mark the Comrade wounded (advances the
            track by one step). Disabled when already dead.
          - "Heal" — restore wounded → unharmed. Disabled when not
            wounded.
          - "Replace" — replace a dead Comrade with a fresh one;
            requires both `isDead === true` AND `inCamp === true`.

    Sheet context: `buildComradePanel` (rules/ow-comrade.ts), which the sheet's
    `_prepareOwComradePanel` passes through unchanged (#152):

      comradePanel: {
        name:            string  // sys.comrade.name (or '' → render fallback)
        state:           'unharmed' | 'wounded' | 'dead'
        stateLabelKey:   string   // WH40K.OW.Comrade.State.<Unharmed|Wounded|Dead>
        distanceM:       number   // sys.comrade.distanceM
        hasVisualLine:   boolean  // sys.comrade.hasVisualLine: no solid barrier between (RAW)
        cohesionRangeM:  number   // COMRADE_COHESION_RANGE_M (5)
        inCohesion:      boolean  // pre-resolved via inCohesion(...)
        isUnharmed:      boolean
        isWounded:       boolean
        isDead:          boolean
        canWound:        boolean  // !isDead
        canHeal:         boolean  // isWounded
        canReplace:      boolean  // isDead && inCamp
        inCamp:          boolean  // sys.refitAvailable: back in camp for refitting (RAW)
        fleeing, pinned: boolean  // failed Fear / Pinning with its PC (RAW)
        fearImmune, pinningImmune: boolean
        canRecover:      boolean  // fleeing or pinned: a recovery Order has something to clear
        actionsLeft, actionBudget: number  // Half Actions left this Turn (RAW)
        canSufferMental: boolean  // alive: Insanity / Corruption can be applied
      }

    Rendered only for OW actors; the include in the appropriate
    tab-*.hbs gates on `isOW` from context.
--}}
<section data-wh40k-hook="ow-comrade-panel" class="tw-flex tw-flex-col tw-gap-2 tw-p-3 tw-rounded tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] tw-bg-[color:var(--wh40k-panel-bg,rgba(0,0,0,0.18))] ow:tw-border-brass"
         data-ow-comrade-state="{{comradePanel.state}}"
         data-ow-comrade-cohesion="{{#if comradePanel.inCohesion}}in{{else}}out{{/if}}">

    {{!-- Header: Comrade name + state badge --}}
    <header class="tw-flex tw-items-center tw-justify-between tw-gap-2">
        <h3 class="tw-flex tw-items-center tw-gap-1.5 tw-m-0 tw-text-[0.85rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-bright)]">
            <i class="fas fa-user-shield ow:tw-text-brass"></i>
            <span>{{localize "WH40K.OW.Comrade.Label"}}</span>
            <span class="tw-text-[color:var(--wh40k-text-bright)] tw-font-semibold tw-normal-case"
                  data-field="name">
                {{#if comradePanel.name}}{{comradePanel.name}}{{else}}&mdash;{{/if}}
            </span>
        </h3>
        <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded tw-border tw-border-solid tw-px-2 tw-py-0.5 tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.05em]
                     {{#if comradePanel.isUnharmed}}tw-border-success tw-text-success-l20 tw-bg-success/10{{/if}}
                     {{#if comradePanel.isWounded}}tw-border-gold tw-text-gold tw-bg-gold/10{{/if}}
                     {{#if comradePanel.isDead}}tw-border-crimson tw-text-crimson-l40 tw-bg-crimson/10{{/if}}"
              data-state-badge="{{comradePanel.state}}">
            {{localize comradePanel.stateLabelKey}}
        </span>
    </header>

    {{!-- Distance + cohesion indicator. The distance and the barrier are what break
          Cohesion (OW core rules: "within 5 metres … not separated by a solid barrier"). --}}
    <div class="tw-flex tw-flex-wrap tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded
                tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)]
                tw-text-[0.78rem]">
        <label class="tw-flex tw-items-center tw-gap-1 tw-text-[color:var(--wh40k-text-muted)] tw-tabular-nums"
               data-field="distance-m">
            {{localize "WH40K.OW.Comrade.Cohesion.Range" meters=comradePanel.cohesionRangeM}}
            <input type="number" name="system.comrade.distanceM" value="{{comradePanel.distanceM}}" min="0" step="1"
                   class="tw-w-14 tw-text-center tw-text-[color:var(--wh40k-text-bright)] tw-font-semibold"
                   aria-label="{{localize 'WH40K.OW.Comrade.Cohesion.Distance'}}" />
            <span>m</span>
        </label>
        <label class="tw-flex tw-items-center tw-gap-1 tw-text-[color:var(--wh40k-text-muted)]" data-field="clear-line">
            <input type="checkbox" name="system.comrade.hasVisualLine" {{#if comradePanel.hasVisualLine}}checked{{/if}} />
            {{localize "WH40K.OW.Comrade.Cohesion.NoBarrier"}}
        </label>
        <span class="tw-inline-flex tw-items-center tw-gap-1 tw-font-semibold
                     {{#if comradePanel.inCohesion}}tw-text-success-l20{{else}}tw-text-crimson-l40{{/if}}"
              data-cohesion="{{#if comradePanel.inCohesion}}in{{else}}out{{/if}}">
            <i class="fas {{#if comradePanel.inCohesion}}fa-link{{else}}fa-link-slash{{/if}}"></i>
            {{#if comradePanel.inCohesion}}
                {{localize "WH40K.OW.Comrade.Cohesion.Maintained"}}
            {{else}}
                {{localize "WH40K.OW.Comrade.Cohesion.Broken"}}
            {{/if}}
        </span>
    </div>

    {{!-- Actions left this Turn ("two Half Actions or one Full Action per Turn"). --}}
    {{#unless comradePanel.isDead}}
    <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-text-[0.78rem] tw-text-[color:var(--wh40k-text-muted)]" data-field="actions-left">
        <span>{{localize "WH40K.OW.Comrade.Actions.Label"}}</span>
        <span class="tw-tabular-nums tw-font-semibold tw-text-[color:var(--wh40k-text-bright)]" data-comrade-actions-left="{{comradePanel.actionsLeft}}">
            {{localize "WH40K.OW.Comrade.Actions.Left" left=comradePanel.actionsLeft budget=comradePanel.actionBudget}}
        </span>
    </div>
    {{/unless}}

    {{!-- Fear and Pinning: the Comrade fails with its PC; a recovery Order clears it. --}}
    <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1.5 tw-px-2 tw-text-[0.75rem]" data-field="fear-pinning">
        {{#if comradePanel.fleeing}}
        <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded tw-border tw-border-solid tw-border-crimson tw-px-1.5 tw-py-0.5 tw-font-semibold tw-text-crimson-l40" data-comrade-status="fleeing">
            <i class="fas fa-person-running" aria-hidden="true"></i>{{localize "WH40K.OW.Comrade.Status.Fleeing"}}
        </span>
        {{/if}}
        {{#if comradePanel.pinned}}
        <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded tw-border tw-border-solid tw-border-gold tw-px-1.5 tw-py-0.5 tw-font-semibold tw-text-gold" data-comrade-status="pinned">
            <i class="fas fa-shield-halved" aria-hidden="true"></i>{{localize "WH40K.OW.Comrade.Status.Pinned"}}
        </span>
        {{/if}}
        <label class="tw-flex tw-items-center tw-gap-1 tw-text-[color:var(--wh40k-text-muted)]">
            <input type="checkbox" name="system.comrade.fearImmune" {{#if comradePanel.fearImmune}}checked{{/if}} />
            {{localize "WH40K.OW.Comrade.Status.FearImmune"}}
        </label>
        <label class="tw-flex tw-items-center tw-gap-1 tw-text-[color:var(--wh40k-text-muted)]">
            <input type="checkbox" name="system.comrade.pinningImmune" {{#if comradePanel.pinningImmune}}checked{{/if}} />
            {{localize "WH40K.OW.Comrade.Status.PinningImmune"}}
        </label>
    </div>

    {{!-- Insanity and Corruption: 10 of either in a single Round kills the Comrade. --}}
    {{#if comradePanel.canSufferMental}}
    <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1.5 tw-px-2 tw-text-[0.75rem]" data-field="mental">
        <label class="tw-flex tw-items-center tw-gap-1 tw-text-[color:var(--wh40k-text-muted)]">
            {{localize "WH40K.OW.Comrade.Mental.Amount"}}
            <input type="number" data-comrade-mental-amount value="1" min="0" step="1" class="tw-w-12 tw-text-center" />
        </label>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] hover:tw-bg-[color:var(--wh40k-border-color-light)]"
                data-action="owComradeMental" data-mental-kind="insanity">
            {{localize "WH40K.OW.Comrade.Mental.Insanity"}}
        </button>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] hover:tw-bg-[color:var(--wh40k-border-color-light)]"
                data-action="owComradeMental" data-mental-kind="corruption">
            {{localize "WH40K.OW.Comrade.Mental.Corruption"}}
        </button>
    </div>
    {{/if}}

    {{!-- Action affordances --}}
    <div class="tw-flex tw-flex-wrap tw-gap-1.5">
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeRecover"
                title="{{localize 'WH40K.OW.Comrade.Action.RecoverHint'}}"
                {{#unless comradePanel.canRecover}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-bullhorn tw-mr-1"></i>
            {{localize "WH40K.OW.Comrade.Action.Recover"}}
        </button>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeWound"
                title="{{localize 'WH40K.OW.Comrade.Action.Wound'}}"
                {{#unless comradePanel.canWound}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-heart-crack tw-mr-1"></i>
            {{localize "WH40K.OW.Comrade.Action.Wound"}}
        </button>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeHeal"
                title="{{localize 'WH40K.OW.Comrade.Action.Heal'}}"
                {{#unless comradePanel.canHeal}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-staff-snake tw-mr-1"></i>
            {{localize "WH40K.OW.Comrade.Action.Heal"}}
        </button>
        <button type="button"
                class="tw-inline-flex tw-items-center tw-justify-center tw-bg-transparent tw-border tw-border-solid tw-border-[color:var(--wh40k-border-color-light)] ow:tw-border-brass tw-rounded tw-px-2 tw-py-0.5 tw-cursor-pointer tw-text-[0.72rem] tw-text-[color:var(--wh40k-text-bright)] ow:tw-text-brass hover:tw-bg-[color:var(--wh40k-border-color-light)] hover:tw-text-white disabled:tw-cursor-not-allowed disabled:tw-opacity-50"
                data-action="owComradeReplace"
                title="{{localize 'WH40K.OW.Comrade.Action.Replace'}}"
                {{#unless comradePanel.canReplace}}disabled aria-disabled="true"{{/unless}}>
            <i class="fas fa-user-plus tw-mr-1"></i>
            {{localize "WH40K.OW.Comrade.Action.Replace"}}
        </button>
    </div>
</section>
