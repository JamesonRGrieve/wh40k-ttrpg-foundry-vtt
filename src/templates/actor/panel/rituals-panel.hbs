{{!-- Rituals Panel --}}
{{#> systems/wh40k-rpg/templates/actor/partial/collapsible-panel.hbs panelId="rituals" label=(localize "WH40K.Rituals.Header") icon="fa-pray" count=ritualsCount rootClass="wh40k-panel-powers wh40k-panel-rituals" bodyClass="tw-p-0" titleClass=(concat "tw-text-gold " (themeClassFor 'accent')) accentBg="linear-gradient(135deg,rgb(from #d97706 r g b / 0.15) 0%,rgb(from #d97706 r g b / 0.05) 100%)" accentBorder="rgb(from #d97706 r g b / 0.3)" accentIcon="#d97706"}}
    {{!-- Rituals List --}}
    <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)] tw-min-h-[60px] tw-p-[var(--wh40k-space-md)]" data-drop-zone="powers" data-accepts="ritual">
        {{#each rituals as |ritual|}}
        {{#> systems/wh40k-rpg/templates/actor/partial/item-list-row.hbs
            item=ritual
            accentColor="#d97706"
            dragType="ritual"
            extraAttrs=(concat 'data-ritual-type="' ritual.system.type '"')
            editTitleKey="WH40K.Rituals.EditRitual"
            pills=(array ritual.system.pill)
            stats=(iff ritual.system.test.threshold
                (array
                    (hash labelKey="WH40K.Rituals.Test" value=ritual.system.testLabel)
                    (hash labelKey="WH40K.Orders.Action" value=ritual.system.activationLabel)
                    (hash labelKey="WH40K.ExtendedTest.ThresholdLabel" value=(localize "WH40K.Rituals.ThresholdValue" value=ritual.system.test.threshold)))
                (array
                    (hash labelKey="WH40K.Rituals.Test" value=ritual.system.testLabel)
                    (hash labelKey="WH40K.Orders.Action" value=ritual.system.activationLabel)))
            actions=(array
                (hash action="rollRitual" icon="fa-dice-d20" titleKey="WH40K.BC.Ritual.PerformButton" hoverClass="hover:tw-text-[color:var(--wh40k-accent-powers)]")
                (hash action="vocalizeRitual" icon="fa-comment" titleKey="WH40K.Action.PostToChat" hoverClass="hover:tw-bg-[rgba(59,130,246,0.15)] hover:tw-border-[rgba(59,130,246,0.3)] hover:tw-text-[#3b82f6]")
                (hash action="togglePowerDetails" icon="fa-chevron-down" titleKey="WH40K.Common.ToggleDetails" hoverClass="hover:tw-text-[color:var(--wh40k-text-dark)]"))
        }}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Tabs.Requirements") icon="fa-list-check" content=ritual.system.requirements}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Rituals.Costs") icon="fa-coins" content=ritual.system.costs}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Tabs.Effect") icon="fa-check-circle" labelClass="tw-text-[#22c55e]" content=ritual.system.effect}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Roll.Failure") icon="fa-skull" labelClass="tw-text-[#ef4444]" content=ritual.system.failure}}
            {{> systems/wh40k-rpg/templates/actor/partial/labeled-rich-text-section.hbs label=(localize "WH40K.Description") content=ritual.system.description}}
        {{/systems/wh40k-rpg/templates/actor/partial/item-list-row.hbs}}
        {{else}}
        {{> systems/wh40k-rpg/templates/actor/partial/empty-state.hbs icon="fa-pray" textKey="WH40K.Rituals.NoRituals" padding="md"}}
        {{/each}}
    </div>

    {{!-- Add Ritual Dropzone --}}
    {{> systems/wh40k-rpg/templates/actor/partial/dropzone.hbs type="ritual" hasItems=ritualsCount labelKey="WH40K.Rituals.DropOrCreate" compactLabelKey="WH40K.DropZone.DropOrClickToAdd"}}
{{/systems/wh40k-rpg/templates/actor/partial/collapsible-panel.hbs}}
