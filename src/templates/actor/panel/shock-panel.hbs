{{!--
    Shock panel (DH2 — #66).

    Rendered as a compact vital ROW (the same `vital-pip-row` chrome Fatigue
    uses), so Shock sits immediately under Fatigue inside the Vitals card and
    reads as one of the vital rows rather than a separate panel. Shock has no
    derived max (it is an open accumulator), so it shows one greyed tile per
    accumulated point plus the "Snap Out of It" action and ± steppers.

    Surfaces `system.shock.{value,max}`. The brain button dispatches the
    `snapOutOfShock` action on CharacterSheet (Willpower test, Challenging +0;
    success → `actor.applyShock(-1)`, narrated via shock-snap-chat). The −/+
    steppers reuse the standard increment/decrement StatActions.

    Render gate (parent template): only DH2 actors include this row —
    `actor._gameSystemId === 'dh2'`. The `wh40k-shock-panel` row class and the
    `wh40k-shock-value` / `wh40k-shock-snap-btn` selectors are pinned for the
    e2e spec (`tests/e2e/shock-panel.spec.ts`).
--}}
{{#> systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs
        icon="fa-bolt" label=(localize "WH40K.Shock.Header") rowClass="wh40k-shock-panel"}}
    {{!-- Pip strip: one pip per accumulated Shock point, rendered through the shared
         `pip-tracker-row` so Shock matches the Wounds / Fatigue / Fate rows in pip
         size (20px), gap, trailing alignment and max width (#293). Shock is an open
         accumulator — `system.shock.max` is schema-initial 0, so it is NOT a ceiling:
         `count` is the current value and `current=0` renders every pip in the muted
         (unfilled) style, preserving the "no available vs spent distinction" the
         bespoke strip had. Clicking pip N lowers Shock to N via `setShockPip`;
         raising it stays the ± steppers' job (there is no pip above `value`).

         The tw-sr-only span inside wh40k-shock-value preserves the numeric text so the
         e2e spec's [data-wh40k-hook="shock-value"].textContent.trim() === String(value) assertion
         still holds — the pip buttons themselves contribute no text. --}}
    <div data-wh40k-hook="shock-value" class="tw-flex tw-items-center tw-ml-auto"
         data-shock-value="{{system.shock.value}}">
        <span class="tw-sr-only">{{system.shock.value}}</span>
        {{> systems/wh40k-rpg/templates/actor/partial/pip-tracker-row
            count=system.shock.value
            current=0
            action="setShockPip"
            dataAttr="shock-index"
            titlePrefix=(localize "WH40K.Shock.Header")
            wrapperClass="tw-flex tw-flex-wrap tw-items-center tw-justify-end tw-gap-1 tw-max-w-[14.75rem]"}}
    </div>

    {{!-- Snap Out of It — trailing affordance, matching the Fate row's info/restore
         buttons which sit after the pips (#293). Disabled at zero. --}}
    <button type="button"
            data-wh40k-hook="shock-snap-btn" class="tw-w-[18px] tw-h-[18px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)] hover:tw-text-[color:var(--wh40k-text-bright)] disabled:tw-opacity-40 disabled:tw-cursor-not-allowed"
            data-action="snapOutOfShock"
            title="{{localize 'WH40K.Shock.SnapOutTooltip'}}"
            {{#if (lte system.shock.value 0)}}disabled{{/if}}>
        <i class="fas fa-brain"></i>
    </button>

    {{!-- ± steppers — the canonical way to change the shock value. --}}
    <button type="button"
            class="tw-w-[18px] tw-h-[18px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)] hover:tw-text-[color:var(--wh40k-text-medium)]"
            data-action="decrement"
            data-field="system.shock.value"
            data-min="0"
            title="{{localize 'WH40K.Shock.Value'}} −1">
        <i class="fas fa-minus"></i>
    </button>
    <button type="button"
            class="tw-w-[18px] tw-h-[18px] tw-p-0 tw-flex tw-items-center tw-justify-center tw-bg-transparent tw-border-none tw-text-[0.7rem] tw-cursor-pointer tw-text-[color:var(--color-text-tertiary)] hover:tw-text-[color:var(--wh40k-text-medium)]"
            data-action="increment"
            data-field="system.shock.value"
            title="{{localize 'WH40K.Shock.Value'}} +1">
        <i class="fas fa-plus"></i>
    </button>
{{/systems/wh40k-rpg/templates/actor/partial/vital-pip-row.hbs}}
