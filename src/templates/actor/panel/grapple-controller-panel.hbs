{{!--
    Grapple panel (#120).

    Rendered on the Overview tab while the actor is in a grapple (the flag
    `flags['wh40k-rpg'].grapple.state`, read by `readGrappleState`, is
    'grappling' or 'controlled'). Shows the state badge and the options the
    actor's line prints for its role (`grappleRules` on the line's game-system
    config): the controller sees the controller's options, the grappled target
    the target's. The GM sees both groups; the other role's buttons act for the
    opponent. Each button names its test (Opposed Strength, a skill test, or no
    test).

    Context: grappleState, grappleSections (rules/grapple.ts grapplePanelSections).
--}}
<section data-wh40k-hook="grapple-panel" class="tw-flex tw-flex-col tw-gap-2 tw-p-3 tw-rounded tw-border tw-border-solid tw-border-slate-500 tw-bg-slate-700/20 dh2:tw-border-slate-400 rt:tw-border-slate-400 im:tw-border-slate-400"
         data-grapple-state="{{grappleState}}">

    {{!-- Header: title + state badge --}}
    <header class="tw-flex tw-items-center tw-justify-between tw-gap-2">
        <h3 class="tw-flex tw-items-center tw-gap-1.5 tw-m-0 tw-text-[0.85rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-slate-200">
            <i class="fas fa-hands-bound tw-text-slate-300" aria-hidden="true"></i>
            <span>{{localize "WH40K.Grapple.PanelTitle"}}</span>
        </h3>
        <span class="tw-px-2 tw-py-0.5 tw-rounded tw-text-[0.7rem] tw-font-bold tw-uppercase tw-tracking-[0.05em]
                     tw-bg-slate-600/40 tw-text-slate-100 tw-border tw-border-solid tw-border-slate-500">
            {{#if (eq grappleState 'grappling')}}{{localize "WH40K.Grapple.StateGrappling"}}{{else}}{{#if (eq grappleState 'controlled')}}{{localize "WH40K.Grapple.StateControlled"}}{{else}}{{localize "WH40K.Grapple.StateNone"}}{{/if}}{{/if}}
        </span>
    </header>

    {{#each grappleSections as |section|}}
    <div class="tw-flex tw-flex-col tw-gap-1.5" data-wh40k-hook="grapple-section" data-grapple-role="{{section.role}}" data-grapple-own="{{section.own}}">
        <h4 class="tw-m-0 tw-text-[0.72rem] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-text-slate-300">
            {{localize section.titleKey}}{{#unless section.own}} <span class="tw-font-normal tw-normal-case tw-tracking-normal tw-text-slate-400">({{localize "WH40K.Grapple.ForOpponent"}})</span>{{/unless}}
        </h4>
        <div class="tw-grid tw-grid-cols-2 tw-gap-2">
            {{#each section.options as |option|}}
            <button type="button"
                    class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-gap-0.5 tw-px-2 tw-py-1.5 tw-rounded tw-bg-slate-700/40 tw-border tw-border-solid tw-border-slate-500 tw-text-slate-100 tw-cursor-pointer tw-transition-colors hover:tw-bg-slate-600/60"
                    data-action="grappleOption"
                    data-grapple-option="{{option.id}}"
                    data-grapple-role="{{option.role}}"
                    data-grapple-test="{{option.testKind}}"
                    title="{{localize option.labelKey}}">
                <span class="tw-flex tw-items-center tw-gap-1.5 tw-text-[0.78rem] tw-font-bold tw-uppercase tw-tracking-[0.03em]">
                    <i class="fas {{option.icon}}" aria-hidden="true"></i>
                    <span>{{localize option.labelKey}}</span>
                </span>
                <span class="tw-text-[0.68rem] tw-text-slate-300" data-wh40k-hook="grapple-option-test">{{localize option.testHintKey skill=option.skillLabel}}</span>
            </button>
            {{/each}}
        </div>
    </div>
    {{/each}}
</section>
