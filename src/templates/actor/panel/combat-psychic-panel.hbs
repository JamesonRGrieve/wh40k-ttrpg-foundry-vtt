{{!--
    Combat-panel Psychic Powers list (#412).

    Mirrors the arsenal weapon-row pattern: one row per known psychic power,
    each surfacing its discipline, Focus Power test, and PR cost, with a roll
    control that invokes the existing per-line psychic roll path (the `rollPower`
    action → actor.rollItem → the unified roll dialog, which serves targeting,
    the Fettered / Unfettered / Push power level, and the effective Psy Rating).

    Rendered only when `showPsychicPanel` is true (the actor knows at least one
    power or has a Psy Rating). Homologates across all seven systems — the roll
    dispatch is per-system; this template only lists the owned power items.
    The footer holds the psyker controls (Psy Rating, sustained powers, type,
    focus, Phenomena / Perils rolls), read from `system.psy` (#194).

    Context:
        psychicPowers  — [{ id, name, img, disciplineLabel, focusTestLabel,
                            prCost, isAttack, identified }]
        psyRating      — effective Psy Rating for the header badge (optional).
        isGM           — GM sees concealed (unidentified) power stats.
--}}
<div class="wh40k-panel tw-flex-1 tw-min-h-0" data-drop-zone="general" data-accepts="psychicPower">
    <div class="wh40k-panel-header tw-order-[-1] tw-shrink-0 tw-flex tw-items-center">
        {{> systems/wh40k-rpg/templates/actor/partial/panel-header.hbs label=(localize "WH40K.Combat.PsychicPowers") icon="fa-brain"}}
        {{#if psyRating}}
        <span class="tw-ml-auto tw-shrink-0 tw-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-full tw-text-[0.65rem] tw-font-bold tw-uppercase tw-tracking-wide tw-bg-[rgb(from_var(--wh40k-accent-info)_r_g_b_/_0.12)] tw-text-[color:var(--wh40k-accent-info)] tw-border tw-border-solid tw-border-[rgb(from_var(--wh40k-accent-info)_r_g_b_/_0.3)]"
              title="{{localize "WH40K.Combat.PsyRating"}}">
            <i class="fas fa-bolt tw-text-[0.7rem]"></i>
            {{localize "WH40K.Combat.PsyRating"}} {{psyRating}}
        </span>
        {{/if}}
    </div>
    <div class="wh40k-panel-body tw-flex-1 tw-min-h-0 tw-overflow-y-auto tw-overflow-x-hidden">
        {{#if psychicPowers.length}}
        <div class="tw-flex tw-flex-col">
            {{!-- Four columns: name, Focus, PR, and the row's own action column (#412). The
                 invoke / delete buttons used to float over the last column, hiding the PR cost
                 while a row was hovered; now they have their own space and never cover a value. --}}
            <div class="tw-grid tw-grid-cols-[1fr_auto_auto_auto] tw-gap-x-2 tw-px-2 tw-py-1 tw-bg-[rgb(from_var(--wh40k-accent-info)_r_g_b_/_0.08)] tw-border-b-2 tw-border-b-[rgb(from_var(--wh40k-accent-info)_r_g_b_/_0.2)] tw-text-[color:var(--wh40k-text-secondary)]">
                <span class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide">{{localize "WH40K.Combat.PsychicPowers"}}</span>
                <span class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-center tw-min-w-12">{{localize "WH40K.Combat.FocusTest"}}</span>
                <span class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-center tw-min-w-12">{{localize "WH40K.Combat.PsyRatingShort"}}</span>
                <span class="tw-w-11" aria-hidden="true"></span>
            </div>
            {{#each psychicPowers as |power|}}
            <div class="tw-group tw-relative tw-grid tw-grid-cols-[1fr_auto_auto_auto] tw-gap-x-2 tw-items-center tw-px-2 tw-py-1 tw-cursor-pointer tw-border-b tw-border-b-[rgba(0,0,0,0.08)] tw-transition-[background] hover:tw-bg-[rgb(from_var(--wh40k-accent-info)_r_g_b_/_0.04)] item-drag" data-action="rollPower" data-item-id="{{power.id}}" data-item-type="psychicPower">
                <span class="tw-flex tw-items-center tw-gap-1 tw-overflow-hidden tw-text-ellipsis tw-whitespace-nowrap tw-text-sm">
                    {{#if power.isAttack}}<i class="fas fa-burst tw-text-[color:var(--wh40k-accent-combat)] tw-mr-[var(--wh40k-space-xs)] tw-text-[0.8em]" title="{{localize "WH40K.Combat.AttackPower"}}"></i>{{/if}}
                    {{power.name}}
                    {{#if power.disciplineLabel}}<span class="tw-ml-1 tw-text-[0.65rem] tw-text-[color:var(--wh40k-text-muted)] tw-uppercase tw-tracking-wide">{{power.disciplineLabel}}</span>{{/if}}
                </span>
                {{!-- Unidentified powers hide Focus/PR from players; GM always sees them. --}}
                <span class="tw-text-sm tw-text-center tw-min-w-12">{{#if (or power.identified @root.isGM)}}{{power.focusTestLabel}}{{else}}{{localize "WH40K.Weapon.ConcealedStat"}}{{/if}}</span>
                <span class="tw-text-sm tw-text-center tw-min-w-12" data-wh40k-hook="psychic-power-pr">{{#if (or power.identified @root.isGM)}}{{power.prCost}}{{else}}{{localize "WH40K.Weapon.ConcealedStat"}}{{/if}}</span>
                <span class="tw-flex tw-w-11 tw-items-center tw-justify-end tw-gap-1" data-wh40k-hook="psychic-power-actions">
                {{!-- Invoke: opens the per-line psychic roll (targeting + power level + effective PR). --}}
                <button type="button"
                        class="tw-w-5 tw-h-5 tw-p-0 tw-bg-[var(--wh40k-panel-bg-solid)] tw-border tw-border-solid tw-border-[color:var(--wh40k-accent-info)] tw-text-[color:var(--wh40k-accent-info)] tw-rounded tw-text-[0.7rem] tw-opacity-0 tw-pointer-events-none tw-cursor-pointer group-hover:tw-opacity-100 group-hover:tw-pointer-events-auto focus:tw-opacity-100 focus:tw-pointer-events-auto tw-transition-opacity"
                        data-action="rollPower"
                        data-item-id="{{power.id}}"
                        title="{{localize "WH40K.Combat.InvokePower"}}">
                    <i class="fas fa-dice-d20"></i>
                </button>
                <button type="button"
                        class="tw-w-5 tw-h-5 tw-p-0 tw-bg-[var(--wh40k-panel-bg-solid)] tw-border tw-border-solid tw-border-[var(--wh40k-border-medium)] tw-rounded tw-text-[0.7rem] tw-text-[color:var(--wh40k-text-muted)] tw-opacity-0 tw-pointer-events-none tw-cursor-pointer hover:tw-text-[color:var(--wh40k-accent-combat)] hover:tw-border-[color:var(--wh40k-accent-combat)] group-hover:tw-opacity-100 group-hover:tw-pointer-events-auto focus:tw-opacity-100 focus:tw-pointer-events-auto tw-transition-opacity"
                        data-action="itemDelete"
                        data-item-id="{{power.id}}"
                        title="{{localize "WH40K.Common.Delete"}}">
                    <i class="fas fa-trash"></i>
                </button>
                </span>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="tw-text-xs tw-text-[var(--wh40k-text-muted)] tw-px-2 tw-py-2">
            <span>{{localize "WH40K.Combat.NoPsychicPowers"}}</span>
        </div>
        {{/if}}
    </div>

    {{!-- Psyker controls (#194): Psy Rating, sustained powers, psyker type, focus,
         and the Psychic Phenomena / Perils of the Warp rolls. Psy Rating, type and
         focus are build config, editable only under the freeform bypass (#571);
         Sustained is live play state and always editable. --}}
    {{#with @root.system.psy as |psy|}}
    <div class="wh40k-combat-psyker-controls tw-shrink-0 tw-flex tw-flex-col tw-gap-2 tw-px-2 tw-py-2 tw-border-t tw-border-t-[rgb(from_var(--wh40k-accent-info)_r_g_b_/_0.2)]">
        <div class="tw-grid tw-grid-cols-2 tw-gap-2 tw-text-[0.8rem]">
            <label class="tw-flex tw-items-center tw-gap-2">
                <span class="tw-font-semibold tw-text-[var(--wh40k-text-secondary)]">{{localize "WH40K.PsyRatingPanel.Rating"}}</span>
                {{#if (and @root.inEditMode (isFreeformCharacters))}}
                <input type="number" name="system.psy.rating" value="{{psy.rating}}" min="0" max="10" class="tw-w-[52px] tw-text-center tw-rounded-md tw-font-semibold tw-px-1 tw-py-0.5 tw-border tw-border-[var(--wh40k-border-color)] tw-bg-[var(--wh40k-input-bg)] tw-text-[var(--wh40k-text-dark)]" data-dtype="Number" />
                {{else}}
                <span class="tw-font-semibold tw-text-[var(--wh40k-text-dark)]">{{psy.rating}}</span>
                {{/if}}
            </label>
            <label class="tw-flex tw-items-center tw-gap-2">
                <span class="tw-font-semibold tw-text-[var(--wh40k-text-secondary)]">{{localize "WH40K.Duration.Sustained"}}</span>
                <input type="number" name="system.psy.sustained" value="{{psy.sustained}}" min="0" class="tw-w-[52px] tw-text-center tw-rounded-md tw-font-semibold tw-px-1 tw-py-0.5 tw-border tw-border-[var(--wh40k-border-color)] tw-bg-[var(--wh40k-input-bg)] tw-text-[var(--wh40k-text-dark)]" data-dtype="Number" />
            </label>
            <label class="tw-flex tw-items-center tw-gap-2">
                <span class="tw-font-semibold tw-text-[var(--wh40k-text-secondary)]">{{localize "WH40K.PsyRatingPanel.PsykerType"}}</span>
                {{#if (and @root.inEditMode (isFreeformCharacters))}}
                <select name="system.psy.class" class="tw-flex-1 tw-rounded-md tw-px-1 tw-py-0.5 tw-border tw-border-[var(--wh40k-border-color)] tw-bg-[var(--wh40k-input-bg)] tw-text-[var(--wh40k-text-dark)]">
                    <option value="bound" {{#if (eq psy.class "bound")}}selected{{/if}}>{{localize "WH40K.PsyRatingPanel.Bound"}}</option>
                    <option value="unbound" {{#if (eq psy.class "unbound")}}selected{{/if}}>{{localize "WH40K.PsyRatingPanel.Unbound"}}</option>
                    <option value="ascended" {{#if (eq psy.class "ascended")}}selected{{/if}}>{{localize "WH40K.PsyRatingPanel.Ascended"}}</option>
                </select>
                {{else}}
                <span class="tw-capitalize tw-text-[var(--wh40k-text-dark)]">{{psy.class}}</span>
                {{/if}}
            </label>
            <label class="tw-flex tw-items-center tw-gap-1">
                <input type="checkbox" name="system.psy.hasFocus" {{checked psy.hasFocus}} data-dtype="Boolean" class="tw-w-[16px] tw-h-[16px]" {{#unless (and @root.inEditMode (isFreeformCharacters))}}disabled{{/unless}} />
                <span class="tw-text-[var(--wh40k-text-secondary)]">{{localize "WH40K.PsyRatingPanel.PsyFocus"}}</span>
            </label>
        </div>
        <div class="tw-flex tw-gap-2">
            <button type="button" class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-1 tw-px-3 tw-py-1.5 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-md tw-bg-[var(--wh40k-btn-bg)] tw-text-[var(--wh40k-text-secondary)] tw-text-[0.8rem] tw-font-semibold tw-cursor-pointer" data-action="rollPhenomena" title="{{localize 'WH40K.PsyRatingPanel.PhenomenaTooltip'}}">
                {{localize "WH40K.PsyRatingPanel.Phenomena"}}
            </button>
            <button type="button" class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-1 tw-px-3 tw-py-1.5 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-md tw-bg-[var(--wh40k-btn-bg)] tw-text-[var(--wh40k-text-secondary)] tw-text-[0.8rem] tw-font-semibold tw-cursor-pointer" data-action="rollPerils" title="{{localize 'WH40K.PsyRatingPanel.PerilsTooltip'}}">
                {{localize "WH40K.PsyRatingPanel.Perils"}}
            </button>
        </div>
    </div>
    {{/with}}
</div>
