{{!-- World-Time Counter Widget (#487, #536, #538) --}}
<div class="tw-flex tw-flex-col tw-gap-2 tw-p-3">

    {{!-- PRIMARY: Local planetary time (what the party experiences) --}}
    <div class="tw-bg-black/30 tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-rounded-[var(--wh40k-radius-md)] tw-p-2 tw-text-center">
        <div class="tw-text-[0.6rem] tw-uppercase tw-tracking-wider tw-opacity-50 tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-mb-1">{{localBodyName}} ({{localRotationHours}}h cycle)</div>
        <div class="tw-text-[1.6rem] tw-font-bold tw-leading-none tw-text-[color:var(--wh40k-gold,var(--wh40k-color-gold))]">{{localize "WH40K.WorldTime.DayCounter" day=localDay}}</div>
        <div class="tw-text-[1.1rem] tw-font-semibold tw-tabular-nums tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-mt-1">{{localTimeOfDay}}</div>
    </div>

    {{!-- Imperial date + Terran standard (secondary) --}}
    <div class="tw-bg-black/30 tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-rounded-[var(--wh40k-radius-md)] tw-p-2 tw-flex tw-flex-col tw-gap-1">
        <div class="tw-flex tw-items-baseline tw-justify-between tw-gap-2">
            <span class="tw-text-[0.65rem] tw-uppercase tw-tracking-wider tw-opacity-60 tw-text-[color:var(--wh40k-bone,#e8dcc8)]">{{localize "WH40K.WorldTime.DateLabel"}}</span>
            <span data-wh40k-hook="wt-date" class="tw-text-[0.8rem] tw-font-semibold tw-tabular-nums tw-text-[color:var(--wh40k-gold,var(--wh40k-color-gold))]">{{fullDate}}</span>
        </div>
        <div class="tw-flex tw-items-baseline tw-justify-between tw-gap-2">
            <span class="tw-text-[0.65rem] tw-uppercase tw-tracking-wider tw-opacity-60 tw-text-[color:var(--wh40k-bone,#e8dcc8)]">{{localize "WH40K.WorldTime.TimeLabel"}} (Terran)</span>
            <span class="tw-text-[0.75rem] tw-tabular-nums tw-opacity-70 tw-text-[color:var(--wh40k-bone,#e8dcc8)]">{{timeOfDay}}</span>
        </div>
        <div class="tw-flex tw-items-baseline tw-justify-between tw-gap-2">
            <span class="tw-text-[0.65rem] tw-uppercase tw-tracking-wider tw-opacity-60 tw-text-[color:var(--wh40k-bone,#e8dcc8)]">Terran {{localize "WH40K.WorldTime.DayCounter" day=dayNumber}}</span>
            <span data-wh40k-hook="wt-elapsed" class="tw-text-[0.75rem] tw-tabular-nums tw-opacity-70 tw-text-[color:var(--wh40k-bone,#e8dcc8)]">{{elapsed}}</span>
        </div>
    </div>

    {{!-- GM-only advance controls --}}
    {{#if isGM}}
        <div data-wh40k-hook="wt-gm-controls" class="tw-bg-black/30 tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-rounded-[var(--wh40k-radius-md)] tw-p-2 tw-flex tw-flex-col tw-gap-2">
            <div class="tw-text-[0.7rem] tw-uppercase tw-tracking-wider tw-opacity-70 tw-text-[color:var(--wh40k-gold,var(--wh40k-color-gold))]"><i class="fas fa-clock"></i> {{localize "WH40K.WorldTime.GmControls"}}</div>

            <div class="tw-flex tw-gap-2">
                <button type="button" class="tw-flex-1 tw-p-1 tw-bg-[var(--wh40k-iron,#3e3e3e)] tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-font-bold tw-cursor-pointer hover:tw-bg-[var(--wh40k-bronze,#cd7f32)] hover:tw-border-[color:var(--wh40k-gold,var(--wh40k-color-gold))]" data-action="advanceHour">{{localize "WH40K.WorldTime.AdvanceHour"}}</button>
                <button type="button" class="tw-flex-1 tw-p-1 tw-bg-[var(--wh40k-iron,#3e3e3e)] tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-font-bold tw-cursor-pointer hover:tw-bg-[var(--wh40k-bronze,#cd7f32)] hover:tw-border-[color:var(--wh40k-gold,var(--wh40k-color-gold))]" data-action="advanceDay">{{localize "WH40K.WorldTime.AdvanceDay"}}</button>
            </div>

            <div class="tw-flex tw-flex-wrap tw-gap-2 tw-items-center">
                <input type="number" name="wh40k-wt-amount" min="1" step="1" value="1" aria-label="{{localize "WH40K.WorldTime.AmountLabel"}}" data-wh40k-hook="wt-amount" class="tw-w-14 tw-shrink-0 tw-p-1 tw-bg-black/50 tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-rounded-[var(--wh40k-radius-sm)]" />
                <select name="wh40k-wt-unit" aria-label="{{localize "WH40K.WorldTime.UnitLabel"}}" data-wh40k-hook="wt-unit" class="tw-flex-1 tw-min-w-[6rem] tw-p-1 tw-bg-black/50 tw-border tw-border-[var(--wh40k-bronze,#cd7f32)] tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-rounded-[var(--wh40k-radius-sm)]">
                    <option value="hour">{{localize "WH40K.WorldTime.UnitHours"}}</option>
                    <option value="day">{{localize "WH40K.WorldTime.UnitDays"}}</option>
                </select>
                <button type="button" class="tw-p-1 tw-px-2 tw-shrink-0 tw-bg-[var(--wh40k-bronze,#cd7f32)] tw-border tw-border-[color:var(--wh40k-gold,var(--wh40k-color-gold))] tw-text-[color:var(--wh40k-bone,#e8dcc8)] tw-font-bold tw-cursor-pointer hover:tw-bg-[var(--wh40k-gold,var(--wh40k-color-gold))]" data-action="advanceCustom">{{localize "WH40K.WorldTime.Advance"}}</button>
            </div>

        </div>
    {{/if}}
</div>
