{{!-- RT ship assault dialog (#188) — ramming, boarding and Hit and Run share it. --}}
{{!-- Step 1 renders the flow's input groups; step 2 the preview card plus the winner's choices. --}}
<div data-wh40k-hook="ship-assault-dialog" class="tw-p-4 tw-flex tw-flex-col tw-gap-3 tw-font-ui tw-text-[#e8e4d9]" data-wh40k-system="rt">
    <header>
        <h2 class="tw-m-0 tw-text-[1.05rem] tw-font-display tw-uppercase tw-tracking-[0.1em] tw-text-amber-200">{{title}}</h2>
        <p class="tw-m-0 tw-mt-1 tw-text-[0.8rem] tw-italic tw-opacity-80">{{hint}}</p>
    </header>

    {{#if hasTargets}}
        {{#unless resolved}}
            <label class="tw-flex tw-flex-col tw-gap-1 tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-100">
                <span>{{localize "WH40K.Voidcraft.Assault.Field.Target"}}</span>
                <select name="defender" class="tw-px-2 tw-py-1 tw-rounded-sm tw-border tw-border-[rgba(251,191,36,0.35)] tw-bg-[rgba(0,0,0,0.3)] tw-text-[#e8e4d9]">
                    {{#each targets as |target|}}
                        <option value="{{target.value}}" {{#if target.selected}}selected{{/if}}>{{target.label}}</option>
                    {{/each}}
                </select>
            </label>
        {{/unless}}

        {{#if resolved}}
            <div class="tw-flex tw-flex-col tw-gap-1">{{{previewHtml}}}</div>
        {{/if}}

        {{#each groups as |group|}}
            <fieldset class="tw-m-0 tw-p-2 tw-rounded-sm tw-border tw-border-[rgba(251,191,36,0.25)]">
                <legend class="tw-px-1 tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{group.legend}}</legend>
                <div class="tw-grid tw-grid-cols-2 tw-gap-2">
                    {{#each group.fields as |field|}}
                        {{#if (eq field.kind "checkbox")}}
                            <label class="tw-col-span-2 tw-flex tw-items-center tw-gap-2 tw-text-[0.85rem]">
                                <input type="checkbox" name="{{field.name}}" {{#if field.value}}checked{{/if}} />
                                <span>{{field.label}}</span>
                            </label>
                        {{else if (eq field.kind "radio")}}
                            <div class="tw-col-span-2 tw-flex tw-flex-col tw-gap-1 tw-text-[0.85rem]" role="radiogroup" aria-label="{{field.label}}">
                                <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-100">{{field.label}}</span>
                                {{#each field.options as |option|}}
                                    <label class="tw-flex tw-items-center tw-gap-2">
                                        <input type="radio" name="{{field.name}}" value="{{option.value}}" {{#if (eq option.value field.value)}}checked{{/if}} />
                                        <span>{{option.label}}</span>
                                    </label>
                                {{/each}}
                            </div>
                        {{else}}
                            <label class="tw-flex tw-flex-col tw-gap-1 tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-100">
                                <span>{{field.label}}</span>
                                <input type="{{#if (eq field.kind "number")}}number{{else}}text{{/if}}" name="{{field.name}}" value="{{field.value}}"
                                       {{#if (eq field.kind "number")}}step="1"{{/if}}
                                       {{#if field.min includeZero=true}}min="{{field.min}}"{{/if}} {{#if field.max includeZero=true}}max="{{field.max}}"{{/if}}
                                       class="tw-px-2 tw-py-1 tw-rounded-sm tw-border tw-border-[rgba(251,191,36,0.35)] tw-bg-[rgba(0,0,0,0.3)] tw-text-[#e8e4d9] tw-normal-case" />
                            </label>
                        {{/if}}
                    {{/each}}
                </div>
            </fieldset>
        {{/each}}

        <footer class="tw-flex tw-justify-end tw-gap-2">
            {{#if resolved}}
                <button type="button" data-action="backAssault" class="tw-px-3 tw-py-1 tw-rounded-sm tw-border tw-border-[rgba(251,191,36,0.35)] tw-bg-transparent tw-text-[#e8e4d9]">
                    {{localize "WH40K.Voidcraft.Assault.Back"}}
                </button>
                <button type="button" data-action="applyAssault" class="tw-px-3 tw-py-1 tw-rounded-sm tw-border tw-border-amber-400 tw-bg-amber-700 tw-text-white tw-font-semibold">
                    {{localize "WH40K.Voidcraft.Assault.Apply"}}
                </button>
            {{else}}
                <button type="button" data-action="rollAssault" class="tw-px-3 tw-py-1 tw-rounded-sm tw-border tw-border-amber-400 tw-bg-amber-700 tw-text-white tw-font-semibold">
                    {{localize "WH40K.Voidcraft.Assault.Roll"}}
                </button>
            {{/if}}
        </footer>
    {{else}}
        <p class="tw-m-0 tw-text-[0.85rem] tw-italic tw-text-amber-200">{{localize "WH40K.Voidcraft.Assault.NoTargets"}}</p>
    {{/if}}
</div>
