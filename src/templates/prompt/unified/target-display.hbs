{{!-- Unified Roll Dialog: Hero Target Number with Difficulty Picker --}}
<div class="tw-flex tw-flex-col tw-items-center tw-p-5 tw-bg-[linear-gradient(180deg,rgba(0,0,0,0.2)_0%,rgba(0,0,0,0.1)_100%)]">
    <div class="tw-flex tw-items-center tw-gap-5">
        <div class="tw-flex tw-items-baseline tw-gap-1">
            <div class="urd-target__number tw-font-display tw-text-[4rem] tw-font-bold tw-leading-none tw-[font-variant-numeric:tabular-nums] tw-transition-[color,text-shadow] tw-duration-500 tw-ease-in-out {{targetColorClass}}" data-value="{{finalTarget}}" data-tooltip="{{localize "WH40K.Roll.TargetLabel"}}" data-wh40k-tooltip="modifier" data-wh40k-tooltip-data="{{targetTooltipData}}">{{finalTarget}}</div>
            <div class="tw-text-lg tw-text-[rgba(201,162,39,0.5)] tw-font-normal">%</div>
        </div>

        {{!-- Difficulty picker beside the target --}}
        {{#if isForceField}}
            <div class="tw-font-display tw-text-sm tw-font-semibold tw-text-[rgba(232,228,217,0.7)] tw-uppercase tw-tracking-[0.15em]">{{localize "WH40K.Chat.ForceField.ProtectionRating"}}</div>
        {{else}}
            <div class="urd-difficulty-picker tw-relative tw-mt-2">
                <button type="button" class="tw-inline-flex tw-items-center tw-gap-1.5 tw-py-1 tw-px-[14px] tw-bg-[rgba(0,0,0,0.2)] tw-border tw-border-[rgba(201,162,39,0.25)] tw-rounded-[20px] tw-cursor-pointer tw-transition-all hover:tw-bg-[rgba(201,162,39,0.1)] hover:tw-border-[rgba(201,162,39,0.5)]" data-action="toggleDifficultyPicker">
                    <span class="tw-font-display tw-text-sm tw-font-semibold tw-text-[rgba(232,228,217,0.85)] tw-uppercase tw-tracking-[0.12em]">{{difficulty.label}}</span>
                    <span class="tw-text-xs tw-text-[rgba(201,162,39,0.7)] tw-font-semibold">({{#if (gt difficulty.modifier 0)}}+{{/if}}{{difficulty.modifier}})</span>
                    <i class="fas fa-caret-down tw-text-[0.7rem] tw-text-[rgba(201,162,39,0.6)] tw-transition-transform tw-duration-[0.25s] {{#if difficultyPickerOpen}}tw-rotate-180{{/if}}"></i>
                </button>
                {{#if difficultyPickerOpen}}
                <ul class="tw-absolute tw-right-0 tw-top-[calc(100%+6px)] tw-min-w-[220px] tw-list-none tw-m-0 tw-py-1.5 tw-px-0 tw-bg-[rgba(18,18,24,0.97)] tw-border tw-border-[rgba(201,162,39,0.3)] tw-rounded-lg tw-shadow-[0_12px_40px_rgba(0,0,0,0.6),0_0_20px_rgba(201,162,39,0.1)] tw-z-[100] tw-backdrop-blur-md">
                    {{#each difficultyPicker}}
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-2 tw-px-4 tw-cursor-pointer tw-transition-all hover:tw-bg-[rgba(201,162,39,0.12)] {{#if isCurrent}}tw-bg-[rgba(201,162,39,0.15)] tw-border-l-[3px] tw-border-l-gold-raw bc:tw-border-l-crimson-light dh1:tw-border-l-gold-raw-l5 dh2:tw-border-l-gold-raw dw:tw-border-l-accent-combat ow:tw-border-l-brass-l20 rt:tw-border-l-void-l20 im:tw-border-l-failure [&_.urd-difficulty-picker__item-label]:tw-text-gold-raw [&_.urd-difficulty-picker__item-label]:tw-font-bold{{/if}}"
                        data-action="selectDifficulty" data-difficulty-index="{{index}}">
                        <span class="urd-difficulty-picker__item-label tw-text-sm tw-font-medium tw-text-[#b8b8a8]">{{label}}</span>
                        <span class="tw-text-[0.8rem] tw-font-bold tw-py-px tw-px-2 tw-rounded-[10px] {{#if (gt modifier 0)}}tw-text-[#4ade80] tw-bg-[rgba(74,222,128,0.1)]{{else if (lt modifier 0)}}tw-text-[#f87171] tw-bg-[rgba(248,113,113,0.1)]{{/if}}">
                            {{#if (gt modifier 0)}}+{{/if}}{{modifier}}
                        </span>
                    </li>
                    {{/each}}
                </ul>
                {{/if}}
            </div>
        {{/if}}
    </div>

    {{!-- Breakdown line (#489): the base, then one hoverable row per component of
          the target — the rows the chat card will print, from the same builder. --}}
    {{#unless isForceField}}
    <div class="tw-flex tw-flex-wrap tw-items-center tw-justify-center tw-gap-x-1.5 tw-gap-y-0.5 tw-mt-2.5 tw-max-w-full tw-text-xs tw-text-[#8a8a7a]" data-wh40k-hook="target-breakdown">
        {{!-- The base names where it comes from when the roll says (the characteristic and skill of a vehicle test, #677). --}}
        <span data-wh40k-hook="target-base">{{#if rollData.baseLabel}}{{rollData.baseLabel}}{{else}}{{localize "WH40K.CharacteristicSetup.Base"}}{{/if}} {{baseTarget}}</span>
        {{#each targetComponents as |component|}}
            <span class="tw-text-[rgba(201,162,39,0.3)]" aria-hidden="true">|</span>
            <span class="tw-cursor-help tw-whitespace-nowrap {{#if (gt component.value 0)}}tw-text-[#4ade80]{{else}}tw-text-[#f87171]{{/if}}"
                  data-wh40k-hook="target-component" data-component-key="{{component.key}}"
                  data-tooltip="{{component.source}}" data-wh40k-tooltip="modifier" data-wh40k-tooltip-data="{{component.tooltipData}}">
                {{component.label}} {{#if (gt component.value 0)}}+{{/if}}{{component.value}}
            </span>
        {{/each}}
        {{#if targetCapFired}}
            <span class="tw-text-[rgba(201,162,39,0.3)]" aria-hidden="true">|</span>
            <span class="tw-italic tw-text-[#f87171]" data-wh40k-hook="target-cap" data-tooltip="{{localize "WH40K.Roll.ModifierCap.Tooltip"}}">{{localize "WH40K.Roll.ModifierCap.Value" raw=targetRawModifierTotal capped=targetModifierTotal}}</span>
        {{/if}}
    </div>
    {{/unless}}
</div>
