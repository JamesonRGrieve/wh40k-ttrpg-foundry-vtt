{{! Assign Damage Prompt }}
{{! Divs, not forms: the dialog root is already the form element (#612). }}
<div class="standard-form framed">
<div class="dialog-content">
    <div autocomplete="off">
        {{! Character Info }}
        <div class="tw-relative tw-p-4 tw-mb-4 tw-border tw-border-solid tw-border-gold/30 tw-rounded-md tw-bg-gradient-to-br tw-from-black/20 tw-to-black/10 tw-shadow-md">
            <div class="tw-flex tw-items-center tw-gap-3 tw-mb-4 tw-pb-3 tw-border-b tw-border-solid tw-border-white/10">
                <img class="tw-w-12 tw-h-12 tw-border-2 tw-border-solid {{themeClassFor 'border'}} tw-rounded-md tw-object-cover tw-flex-shrink-0" alt="{{this.actor.name}}" src="{{this.actor.img}}" />
                <div class="tw-flex-1 tw-min-w-0">
                    <h2 class="tw-m-0 tw-font-display tw-text-lg tw-font-semibold {{themeClassFor 'accent'}} tw-uppercase tw-tracking-wide tw-truncate">{{this.actor.name}}</h2>
                    <div class="tw-text-sm tw-text-gray-400 tw-mt-1">{{localize "WH40K.Combat.AssignDamage"}}</div>
                </div>
            </div>

            {{#if vehicle}}
            {{!-- A vehicle (content#28) takes damage off Structural Integrity and keeps a running Critical total. --}}
            <div class="tw-grid tw-grid-cols-2 tw-gap-2" data-assign-vehicle>
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-font-display tw-font-bold tw-text-lg {{themeClassFor 'accent'}}">{{vehicle.integrity.value}}/{{vehicle.integrity.max}}</span>
                    <span class="tw-text-xs tw-text-gray-400 tw-uppercase tw-tracking-wide">{{localize "WH40K.Vehicle.Integrity"}}</span>
                </div>
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-font-display tw-font-bold tw-text-lg {{themeClassFor 'accent'}}">{{vehicle.integrity.critical}}</span>
                    <span class="tw-text-xs tw-text-gray-400 tw-uppercase tw-tracking-wide">{{localize "WH40K.Prompt.AssignDamage.Critical"}}</span>
                </div>
            </div>
            {{else}}
            <div class="tw-grid tw-grid-cols-3 tw-gap-2">
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-font-display tw-font-bold tw-text-lg {{themeClassFor 'accent'}}">{{this.actor.system.wounds.value}}/{{this.actor.system.wounds.max}}</span>
                    <span class="tw-text-xs tw-text-gray-400 tw-uppercase tw-tracking-wide">{{localize "WH40K.Wounds"}}</span>
                </div>
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-font-display tw-font-bold tw-text-lg {{themeClassFor 'accent'}}">{{this.actor.system.wounds.critical}}</span>
                    <span class="tw-text-xs tw-text-gray-400 tw-uppercase tw-tracking-wide">{{localize "WH40K.Prompt.AssignDamage.Critical"}}</span>
                </div>
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-font-display tw-font-bold tw-text-lg {{themeClassFor 'accent'}}">{{this.actor.system.fatigue.value}}/{{this.actor.system.fatigue.max}}</span>
                    <span class="tw-text-xs tw-text-gray-400 tw-uppercase tw-tracking-wide">{{localize "WH40K.Combat.Fatigue"}}</span>
                </div>
            </div>
            {{/if}}
        </div>

        {{! Damage Details }}
        {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-panel.hbs titleKey="WH40K.Prompt.AssignDamage.IncomingDamage" marginClass=""}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Prompt.AssignDamage.HitLocation"}}
                <select class="tw-min-w-[140px] tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm" name="hit.location" id="location">
                    {{selectOptions locations selected=this.hit.location}}
                </select>
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.DamageType.Label"}}
                <select class="tw-min-w-[140px] tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm" name="hit.damageType" id="damageType">
                    {{selectOptions damageType selected=this.hit.damageType}}
                </select>
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}

            <div class="tw-my-3 tw-border-t tw-border-solid tw-border-white/10"></div>

            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Prompt.AssignDamage.TotalDamage"}}
                <input class="tw-w-20 tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm tw-text-center" type="number" data-dtype="Number" name="hit.totalDamage" value="{{this.hit.totalDamage}}" />
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Combat.Penetration"}}
                <input class="tw-w-20 tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm tw-text-center" type="number" data-dtype="Number" name="hit.totalPenetration" value="{{this.hit.totalPenetration}}" />
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Combat.Fatigue"}}
                <input class="tw-w-20 tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm tw-text-center" type="number" data-dtype="Number" name="hit.totalFatigue" value="{{this.hit.totalFatigue}}" />
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}

            <div class="tw-my-3 tw-border-t tw-border-solid tw-border-white/10"></div>

            {{#if vehicle}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Prompt.AssignDamage.FacingArmour" last=true}}
                <input class="tw-w-20 tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm tw-text-center" type="number" data-dtype="Number" name="armour" value="{{this.armour}}" />
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}
            {{else}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Prompt.AssignDamage.LocationArmour"}}
                <input class="tw-w-20 tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm tw-text-center" type="number" data-dtype="Number" name="armour" value="{{this.armour}}" />
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}
            {{#> systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs labelKey="WH40K.Prompt.AssignDamage.ToughnessBonus" last=true}}
                <input class="tw-w-20 tw-px-3 tw-py-2 tw-bg-black/30 tw-border tw-border-solid tw-border-white/10 tw-rounded-md tw-text-gray-200 tw-text-sm tw-text-center" type="number" data-dtype="Number" name="tb" value="{{this.tb}}" />
            {{/systems/wh40k-rpg/templates/prompt/partial/prompt-row.hbs}}
            {{/if}}
        {{/systems/wh40k-rpg/templates/prompt/partial/prompt-panel.hbs}}
    </div>
</div>
{{! Apply / Cancel are the dialog's footer part (#698). }}
</div>
