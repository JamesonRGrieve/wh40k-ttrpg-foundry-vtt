{{!--
  Base Roll Prompt
  Default template for BaseRollDialog. Concrete roll dialogs (SimpleRoll,
  CharacteristicCheck, etc.) typically override PARTS with their own
  template, but the base needs something renderable so an unspecialised
  instantiation (e.g. integration test) does not throw.

  A div, not a form: the dialog root is already the form element (#612).
  The Roll and Cancel buttons are the dialog's own footer part (#698).
--}}
<div class="standard-form framed" autocomplete="off">
    {{#if rollData}}
        {{#with rollData}}
            <h3 class="divider">{{name}}</h3>
            <p>{{localize "WH40K.Prompt.BaseRoll.Target"}} <strong>{{baseTarget}}</strong></p>
        {{/with}}
    {{else}}
        <p>{{localize "WH40K.Prompt.BaseRoll.Configure"}}</p>
    {{/if}}
</div>
