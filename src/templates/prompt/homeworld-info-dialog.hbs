{{!-- Home-world reference dialog: every home-world the line's packs carry, grouped by pack. --}}
<div class="homeworld-info-dialog__scroll tw-p-5 tw-bg-transparent tw-font-ui tw-text-[#e8e4d9] tw-max-h-[70vh] tw-overflow-y-auto">

    <div class="tw-mb-4 tw-text-center tw-text-[0.85rem] tw-text-[#9a9a8a] tw-italic">
        {{localize "WH40K.HomeworldInfo.Description"}}
    </div>

    {{#each groups as |group|}}
        <section class="tw-mb-5" data-homeworld-group="{{group.label}}">
            <h2 class="tw-text-[0.8rem] tw-font-semibold tw-uppercase tw-tracking-[0.1em] tw-text-[#9a9a8a] tw-border-b tw-border-[rgba(255,255,255,0.08)] tw-pb-1 tw-mb-3">
                {{group.label}}
            </h2>

            {{!-- Card grid; collapses to one column on narrow popouts. --}}
            <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-3 tw-gap-3">
                {{#each group.cards as |card|}}
                    <article class="tw-rounded-md tw-border-2 tw-bg-[rgba(0,0,0,0.35)] {{card.accent.border}} tw-p-3 tw-flex tw-flex-col tw-gap-3"
                             data-homeworld="{{card.id}}">

                        <header class="tw-flex tw-items-baseline tw-justify-between tw-gap-2 tw-border-b tw-border-[rgba(255,255,255,0.08)] tw-pb-2">
                            <h3 class="tw-text-[1.05rem] tw-font-bold tw-uppercase tw-tracking-[0.08em] tw-m-0 {{card.accent.accentText}}">
                                {{card.label}}
                            </h3>
                            <span class="tw-text-[0.7rem] tw-uppercase tw-tracking-[0.1em] tw-text-[#9a9a8a]">{{localize "WH40K.HomeworldInfo.HomeworldTag"}}</span>
                        </header>

                        <div class="tw-flex tw-flex-col tw-gap-1">
                            <div class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] {{card.accent.accentText}}">
                                {{localize "WH40K.HomeworldInfo.Characteristics"}}
                            </div>
                            <div class="tw-text-[0.85rem] tw-text-[#e8e4d9] tw-tabular-nums" data-testid="hw-chars">{{card.characteristicModsLabel}}</div>
                        </div>

                        {{#if card.fateLabel}}
                            <div class="tw-flex tw-flex-col tw-gap-1">
                                <div class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] {{card.accent.accentText}}">
                                    {{localize "WH40K.HomeworldInfo.Fate"}}
                                </div>
                                <div class="tw-text-[0.85rem] tw-text-[#e8e4d9] tw-tabular-nums" data-testid="hw-fate">{{card.fateLabel}}</div>
                            </div>
                        {{/if}}

                        <div class="tw-flex tw-flex-col tw-gap-1">
                            <div class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] {{card.accent.accentText}}">
                                {{localize "WH40K.HomeworldInfo.Wounds"}}
                            </div>
                            <div class="tw-text-[0.85rem] tw-text-[#e8e4d9] tw-tabular-nums" data-testid="hw-wounds">{{card.woundsLabel}}</div>
                        </div>

                        {{#each card.abilities as |ability|}}
                            <div class="tw-flex tw-flex-col tw-gap-1 tw-p-2 tw-rounded {{card.accent.accentBg}}" data-testid="hw-ability">
                                <div class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] {{card.accent.accentText}}">
                                    {{localize "WH40K.HomeworldInfo.Bonus"}}
                                </div>
                                <div class="tw-text-[0.85rem] tw-font-semibold tw-text-[#e8e4d9]">{{ability.name}}</div>
                                <div class="tw-text-[0.8rem] tw-text-[#cfcab8] tw-leading-snug">{{ability.description}}</div>
                            </div>
                        {{/each}}

                        {{#if card.aptitudes.length}}
                            <div class="tw-flex tw-flex-col tw-gap-1">
                                <div class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] {{card.accent.accentText}}">
                                    {{localize "WH40K.HomeworldInfo.Aptitudes"}}
                                </div>
                                <div class="tw-text-[0.85rem] tw-text-[#e8e4d9]" data-testid="hw-aptitudes">
                                    {{#each card.aptitudes as |apt|}}<span class="tw-inline-block tw-mr-2">{{apt}}</span>{{/each}}
                                </div>
                            </div>
                        {{/if}}
                    </article>
                {{/each}}
            </div>
        </section>
    {{else}}
        <p class="tw-text-center tw-text-[0.9rem] tw-text-[#9a9a8a]" data-testid="hw-empty">{{localize "WH40K.HomeworldInfo.Empty"}}</p>
    {{/each}}

    <div class="tw-flex tw-flex-wrap tw-gap-2.5 tw-mt-5 tw-pt-5 tw-border-t tw-border-[rgba(255,255,255,0.08)]">
        <button type="button"
                data-action="close"
                class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-2 tw-whitespace-nowrap tw-px-4 tw-py-3 tw-border tw-border-[rgba(255,255,255,0.15)] tw-rounded-md tw-font-ui tw-text-[0.9rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] tw-cursor-pointer tw-bg-[rgba(255,255,255,0.05)] tw-text-[rgba(255,255,255,0.7)]">
            <i class="fas fa-check"></i> {{localize "WH40K.HomeworldInfo.CloseButton"}}
        </button>
    </div>

</div>
