{{! Clip Builder Dialog — compose an ordered mixed magazine (#ammo-system) }}
<div data-wh40k-hook="clip-builder-content" class="tw-p-2 tw-flex tw-flex-col tw-gap-3">
    <p class="tw-m-0 tw-text-base {{themeClassFor 'accent'}}">
        {{localize "WH40K.ClipBuilder.Prompt" weaponName=weaponName clipMax=clipMax}}
    </p>

    <div class="tw-flex tw-flex-col tw-gap-2 tw-max-h-[400px] tw-overflow-y-auto">
        {{#each ammoItems as |ammo|}}
        <label class="tw-flex tw-items-center tw-gap-2 tw-p-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-solid tw-border-[var(--color-border-light-tertiary)] tw-rounded-md" data-uuid="{{ammo.uuid}}">
            <img class="tw-w-8 tw-h-8 tw-rounded-sm tw-border tw-border-solid tw-border-[var(--color-border-light-tertiary)] tw-shrink-0" src="{{ammo.img}}" alt="{{ammo.name}}" width="32" height="32" />
            <div class="tw-flex tw-flex-col tw-flex-1 tw-min-w-0 tw-gap-0.5">
                <span class="tw-font-semibold tw-text-base">{{ammo.name}}</span>
                <span class="tw-flex tw-items-center tw-gap-2 tw-text-xs tw-text-[var(--color-text-light-6,#aaa)]">
                    <span>{{ammo.quantity}} {{localize "WH40K.ClipBuilder.Available"}}</span>
                    {{#if ammo.modifierSummary}}<span class="tw-italic">{{ammo.modifierSummary}}</span>{{/if}}
                </span>
            </div>
            <input type="number" data-wh40k-hook="clip-builder-count" class="tw-w-16 tw-text-center" min="0" max="{{ammo.quantity}}" value="0"
                   data-ammo-uuid="{{ammo.uuid}}" aria-label="{{localize "WH40K.ClipBuilder.Rounds"}}: {{ammo.name}}" />
        </label>
        {{/each}}
    </div>

    <p class="tw-m-0 tw-text-xs tw-italic tw-text-[var(--color-text-light-6,#aaa)]">{{localize "WH40K.ClipBuilder.OrderHint"}}</p>

    {{> systems/wh40k-rpg/templates/dialogs/partial/dialog-footer.hbs
        confirmAction="confirm"
        confirmIcon="fa-layer-group"
        confirmLabel=(localize "WH40K.ClipBuilder.Load")}}
</div>
