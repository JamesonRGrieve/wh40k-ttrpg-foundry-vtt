{{!-- Celestial Bodies editor (#588) — the campaign's planets/moons and their current weather. --}}
<div class="tw-flex tw-flex-col tw-gap-3 tw-p-3">
    <p class="tw-m-0 tw-text-[0.8rem] tw-opacity-80">{{localize "WH40K.CelestialBodies.Intro"}}</p>

    {{#if rows.length}}
        <div class="tw-grid tw-grid-cols-[minmax(8rem,2fr)_5rem_5rem_4.5rem_minmax(7rem,1.5fr)_2rem] tw-gap-2 tw-items-center tw-text-[0.7rem] tw-uppercase tw-tracking-wider tw-opacity-70">
            <span>{{localize "WH40K.CelestialBodies.Name"}}</span>
            <span>{{localize "WH40K.CelestialBodies.Rotation"}}</span>
            <span>{{localize "WH40K.CelestialBodies.Orbit"}}</span>
            <span>{{localize "WH40K.CelestialBodies.Tilt"}}</span>
            <span>{{localize "WH40K.CelestialBodies.Weather"}}</span>
            <span class="tw-sr-only">{{localize "WH40K.CelestialBodies.Remove"}}</span>
        </div>
        {{#each rows as |row|}}
            <div data-wh40k-hook="cb-row" class="tw-grid tw-grid-cols-[minmax(8rem,2fr)_5rem_5rem_4.5rem_minmax(7rem,1.5fr)_2rem] tw-gap-2 tw-items-center">
                <input type="hidden" data-field="key" value="{{row.key}}" />
                <input type="text" data-field="name" value="{{row.name}}" aria-label="{{localize "WH40K.CelestialBodies.Name"}}" />
                <input type="number" data-field="rotationHours" value="{{row.rotationHours}}" min="0.1" step="0.1" aria-label="{{localize "WH40K.CelestialBodies.Rotation"}}" />
                <input type="number" data-field="orbitalDays" value="{{row.orbitalDays}}" min="0" step="1" aria-label="{{localize "WH40K.CelestialBodies.Orbit"}}" />
                <input type="number" data-field="axialTilt" value="{{row.axialTilt}}" min="0" max="90" step="0.1" aria-label="{{localize "WH40K.CelestialBodies.Tilt"}}" />
                <select data-field="weather" aria-label="{{localize "WH40K.CelestialBodies.Weather"}}">
                    {{#each @root.weatherOptions as |option|}}
                        <option value="{{option.value}}" {{#if (eq option.value row.weather)}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                </select>
                <button type="button" data-action="removeBody" data-index="{{row.index}}" class="tw-p-1" aria-label="{{localize "WH40K.CelestialBodies.Remove"}}" data-tooltip="{{localize "WH40K.CelestialBodies.Remove"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
            </div>
        {{/each}}
    {{else}}
        <p data-wh40k-hook="cb-empty" class="tw-m-0 tw-text-[0.8rem] tw-italic tw-opacity-70">{{localize "WH40K.CelestialBodies.Empty"}}</p>
    {{/if}}

    <div class="tw-flex tw-gap-2 tw-justify-between">
        <button type="button" data-action="addBody"><i class="fas fa-plus" aria-hidden="true"></i> {{localize "WH40K.CelestialBodies.Add"}}</button>
        <button type="button" data-action="save"><i class="fas fa-save" aria-hidden="true"></i> {{localize "WH40K.CelestialBodies.Save"}}</button>
    </div>
</div>
