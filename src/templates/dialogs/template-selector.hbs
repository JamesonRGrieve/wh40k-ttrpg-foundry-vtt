{{!-- NPC Template Selector Dialog. Context: TemplateSelector._prepareContext. --}}
<div data-tsel="root" class="tw-flex tw-flex-col tw-h-full tw-min-h-0">
    {{!-- Filters --}}
    <div data-tsel="filters" class="tw-flex tw-flex-wrap tw-items-end tw-gap-4 tw-p-4 tw-bg-[var(--wh40k-bg-secondary,#1a1a1a)] tw-border-b tw-border-solid tw-border-[var(--wh40k-border-color,#444)]">
        <label class="tw-flex tw-flex-col tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase">
            {{localize "WH40K.NPC.Category"}}
            <select name="filterCategory" class="tw-p-2 tw-normal-case tw-font-normal">
                <option value="">{{localize "WH40K.All"}}</option>
                {{#each categories as |cat|}}
                <option value="{{cat.key}}" {{#if cat.selected}}selected{{/if}}>{{cat.label}}</option>
                {{/each}}
            </select>
        </label>

        <label class="tw-flex tw-flex-col tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase">
            {{localize "WH40K.NPC.Faction"}}
            <select name="filterFaction" class="tw-p-2 tw-normal-case tw-font-normal">
                <option value="">{{localize "WH40K.All"}}</option>
                {{#each factions as |faction|}}
                <option value="{{faction.key}}" {{#if faction.selected}}selected{{/if}}>{{faction.label}}</option>
                {{/each}}
            </select>
        </label>

        <label class="tw-flex tw-flex-col tw-gap-1 tw-flex-1 tw-min-w-[200px] tw-text-xs tw-font-semibold tw-uppercase">
            {{localize "WH40K.Common.Search"}}
            <input type="text" name="filterSearch" class="tw-p-2 tw-normal-case tw-font-normal" value="{{filters.search}}"
                   placeholder="{{localize 'WH40K.NPC.Template.SearchPlaceholder'}}" />
        </label>

        <button type="button" class="tw-w-auto tw-px-3 tw-py-2" data-action="clearFilter">
            <i class="fa-solid fa-filter-circle-xmark" aria-hidden="true"></i>
            {{localize "WH40K.CompendiumBrowser.ClearFilters"}}
        </button>
    </div>

    {{!-- Template list --}}
    <div data-tsel="list" class="tw-flex-1 tw-min-h-0 tw-p-4 tw-overflow-y-auto" role="listbox" aria-label="{{localize 'WH40K.NPC.Template.SelectTemplate'}}">
        {{#if hasTemplates}}
        <div class="tw-flex tw-flex-col tw-gap-2">
            {{#each templates as |template|}}
            <div data-tsel="row" class="tw-flex tw-items-center tw-gap-4 tw-p-3 tw-bg-[var(--wh40k-bg-primary,#0d0d12)] tw-border-2 tw-border-solid tw-rounded-md tw-cursor-pointer tw-transition-all hover:tw-bg-[var(--wh40k-bg-secondary,#1a1a1a)] {{#if template.selected}}tw-border-gold tw-bg-[rgba(212,175,55,0.1)]{{else}}tw-border-transparent{{/if}}"
                 role="option" tabindex="0" aria-selected="{{#if template.selected}}true{{else}}false{{/if}}"
                 data-uuid="{{template.uuid}}" data-action="selectTemplate">
                <img src="{{template.img}}" alt="" class="tw-w-12 tw-h-12 tw-object-cover tw-rounded-md tw-border-none" />
                <div class="tw-flex-1 tw-min-w-0">
                    <h4 data-tsel="name" class="tw-m-0 tw-mb-1 tw-text-base tw-border-none">{{template.name}}</h4>
                    <div class="tw-flex tw-flex-wrap tw-gap-2 tw-text-xs">
                        <span class="tw-px-1.5 tw-py-0.5 tw-bg-[var(--wh40k-bg-tertiary,#252525)] tw-rounded-sm">{{template.categoryLabel}}</span>
                        {{#if template.faction}}
                        <span class="tw-px-1.5 tw-py-0.5 tw-bg-[var(--wh40k-bg-tertiary,#252525)] tw-rounded-sm">{{template.faction}}</span>
                        {{/if}}
                        <span data-tsel="threat" class="tw-px-1.5 tw-py-0.5 tw-bg-[rgba(139,105,20,0.4)] tw-rounded-sm">{{localize "WH40K.NPC.ThreatLevel"}} {{template.baseThreat}}</span>
                    </div>
                    {{#if template.summary}}
                    <p class="tw-mt-1 tw-mb-0 tw-text-sm tw-text-[var(--wh40k-text-muted,#888)]">{{truncate template.summary 80}}</p>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div data-tsel="empty" class="tw-text-center tw-p-12 tw-text-[var(--wh40k-text-muted,#888)]">
            <i class="fa-solid fa-magnifying-glass tw-text-5xl tw-mb-4 tw-opacity-50" aria-hidden="true"></i>
            <p>{{localize "WH40K.NPC.Template.NoTemplatesFound"}}</p>
        </div>
        {{/if}}
    </div>

    {{!-- Selected template: threat, horde and a preview at that threat --}}
    {{#if hasSelection}}
    <div data-tsel="selection" class="tw-p-4 tw-bg-[var(--wh40k-bg-secondary,#1a1a1a)] tw-border-t tw-border-solid tw-border-[var(--wh40k-border-color,#444)]">
        <h3 class="tw-m-0 tw-mb-3 tw-text-base tw-border-none">{{localize "WH40K.NPC.Template.SelectedTemplate"}}: {{selectedTemplate.name}}</h3>
        <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-6">
            <label class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-medium">
                {{localize "WH40K.NPC.Template.PreviewAtThreat"}}
                <input type="range" name="threatLevel" class="tw-w-[150px]" min="1" max="30" value="{{threatLevel}}" />
                <span data-tsel="threat-value" class="tw-font-bold tw-min-w-[30px] tw-text-center">{{threatLevel}}</span>
            </label>
            <label class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-cursor-pointer">
                <input type="checkbox" name="isHorde" {{#if isHorde}}checked{{/if}} />
                {{localize "WH40K.NPC.EnableHordeMode"}}
            </label>
        </div>
        {{#if preview}}
        <div data-tsel="preview" class="tw-mt-3 tw-flex tw-flex-wrap tw-gap-2 tw-text-sm">
            {{#each preview.characteristics as |char|}}
            <span class="tw-flex tw-flex-col tw-items-center tw-min-w-[2.75rem] tw-px-1.5 tw-py-1 tw-bg-[var(--wh40k-bg-tertiary,#252525)] tw-rounded-sm" data-characteristic="{{char.key}}">
                <span class="tw-text-[0.65rem] tw-uppercase tw-opacity-80">{{char.label}}</span>
                <span class="tw-font-bold">{{char.value}}</span>
            </span>
            {{/each}}
        </div>
        <div data-tsel="vitals" class="tw-mt-2 tw-flex tw-flex-wrap tw-gap-4 tw-text-sm">
            <span>{{localize "WH40K.Wounds"}}: <strong data-preview="wounds">{{preview.wounds}}</strong></span>
            <span>{{localize "WH40K.NPC.Armour"}}: <strong data-preview="armour">{{preview.armour}}</strong></span>
            <span>{{localize "WH40K.NPC.Template.Weapons"}}: <strong data-preview="weapons">{{preview.weaponCount}}</strong></span>
            <span>{{localize "WH40K.NPC.Template.TrainedSkills"}}: <strong data-preview="skills">{{preview.skillCount}}</strong></span>
        </div>
        {{/if}}
    </div>
    {{/if}}

    <footer data-tsel="footer" class="tw-flex tw-justify-end tw-gap-2 tw-p-4 tw-border-t tw-border-solid tw-border-[var(--wh40k-border-color,#444)]">
        {{#each buttons as |button|}}
        <button type="button" class="tw-w-auto tw-px-3 tw-py-1.5" data-action="{{button.action}}" {{#if button.disabled}}disabled{{/if}}>
            <i class="{{button.icon}}" aria-hidden="true"></i>
            {{localize button.label}}
        </button>
        {{/each}}
    </footer>
</div>
