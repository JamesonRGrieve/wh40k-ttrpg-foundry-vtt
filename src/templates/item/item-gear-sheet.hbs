{{!-- 
  Rogue Trader Gear Item Sheet - V2 Redesign
  Compact 2-column layout with consumable emphasis
--}}
<div class="tw-flex tw-flex-col tw-h-full" autocomplete="off">
    
    {{!-- ═══════════════════════════════════════════════════════════════════
         HEADER: Compact gear identity with category icon overlay
    ═══════════════════════════════════════════════════════════════════ --}}
    <header class="tw-flex tw-items-center tw-gap-3 tw-p-3 tw-shrink-0 tw-border-b tw-border-[var(--wh40k-border-color)]">
      {{> systems/wh40k-rpg/templates/shared/editable-portrait.hbs src=item.img alt=item.name sizeClass="tw-w-14 tw-h-14" frameClass="" overlayIcon=categoryIcon overlayTextClass="" overlayIconClass="" extraClass="tw-shrink-0"}}
      
      <div class="tw-flex tw-flex-col tw-gap-1 tw-min-w-0 tw-flex-1">
        {{> systems/wh40k-rpg/templates/item/partial/item-name-input.hbs placeholderKey="WH40K.ItemSheet.NamePlaceholder.Gear"}}
        
        <div class="tw-flex tw-flex-wrap tw-gap-1">
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-px-2 tw-py-0.5 tw-text-xs" title="{{localize 'WH40K.Gear.Category'}}">
            <i class="fas {{categoryIcon}}"></i>
            {{categoryLabel}}
          </span>
          {{#if (ne system.craftsmanship "common")}}
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-px-2 tw-py-0.5 tw-text-xs" title="{{localize 'WH40K.Craftsmanship.Label'}}">
            <i class="fas fa-hammer"></i>
            {{system.craftsmanshipLabel}}
          </span>
          {{/if}}
          {{#if (gt system.quantity 1)}}
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-px-2 tw-py-0.5 tw-text-xs" title="{{localize 'WH40K.Quantity'}}">
            <i class="fas fa-layer-group"></i>
            ×{{system.quantity}}
          </span>
          {{/if}}
          {{#if profaneObject}}
          {{!-- An outlined chip in the themed danger red: red text on a red fill was unreadable (#660). --}}
          <span data-wh40k-hook="gear-profane-badge" class="tw-inline-flex tw-items-center tw-gap-1 tw-rounded-full tw-border tw-border-solid tw-border-crimson/60 tw-bg-crimson/10 tw-text-[color:var(--wh40k-danger-text)] tw-px-2 tw-py-0.5 tw-text-xs tw-font-display" title="{{localize 'WH40K.ProfaneObject.Badge'}}">
            <i class="fas fa-skull"></i>
            {{profaneObject.label}}
          </span>
          {{/if}}
        </div>
      </div>
    </header>

    {{#if profaneObject}}
    {{!-- ═══════════════════════════════════════════════════════════════════
         PROFANE OBJECT PANEL: aura + per-action hook (within.md p. 52)
    ═══════════════════════════════════════════════════════════════════ --}}
    {{!-- Theme text on a light crimson wash: the strip's red-on-maroon text read at ~2:1 (#660). --}}
    <section data-wh40k-hook="gear-profane-panel" class="tw-flex tw-flex-col tw-gap-2 tw-px-3 tw-py-2 tw-border-b tw-border-crimson/60 tw-bg-crimson/10 tw-text-[color:var(--wh40k-text-dark)]">
      <div class="tw-flex tw-items-center tw-gap-2 tw-text-xs tw-font-display tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-danger-text)]">
        <i class="fas fa-skull"></i>
        <span>{{localize "WH40K.ProfaneObject.Badge"}}</span>
      </div>
      {{#if profaneObject.aura}}
      <div data-wh40k-hook="gear-profane-aura" class="tw-flex tw-items-start tw-gap-2 tw-text-xs">
        <i class="fas fa-circle-dot tw-mt-0.5 tw-text-[color:var(--wh40k-danger-text)]"></i>
        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-flex-1">
          <span class="tw-font-medium tw-text-[color:var(--wh40k-danger-text)]">
            {{localize "WH40K.ProfaneObject.AuraLabel"}}
            <span class="tw-text-[color:var(--wh40k-text-muted)]">— {{localize "WH40K.ProfaneObject.AuraRadius"}}: {{profaneObject.aura.radiusMetres}}m</span>
          </span>
          <span>{{profaneObject.aura.label}}</span>
        </div>
      </div>
      {{/if}}
      <div data-wh40k-hook="gear-profane-hook" class="tw-flex tw-items-start tw-gap-2 tw-text-xs">
        <i class="fas fa-bolt tw-mt-0.5 tw-text-[color:var(--wh40k-danger-text)]"></i>
        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-flex-1">
          <span class="tw-font-medium tw-text-[color:var(--wh40k-danger-text)]">{{localize "WH40K.ProfaneObject.HookLabel"}}</span>
          {{#if profaneObject.hook}}
          <span>
            {{localize "WH40K.ProfaneObject.HookTrigger"}}: <strong>{{profaneObject.hook.trigger}}</strong>
            · {{localize "WH40K.ProfaneObject.Corruption"}} +{{profaneObject.hook.corruptionPerTrigger}}
            · {{localize "WH40K.ProfaneObject.Insanity"}} +{{profaneObject.hook.insanityPerTrigger}}
          </span>
          {{else}}
          <span class="tw-italic tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.ProfaneObject.EmptyHookText"}}</span>
          {{/if}}
        </div>
      </div>
    </section>
    {{/if}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         STAT BAR: Key gear statistics with quick adjusters
    ═══════════════════════════════════════════════════════════════════ --}}
    <div class="tw-flex tw-items-center tw-gap-2 tw-px-3 tw-py-2 tw-border-b tw-border-[var(--wh40k-border-color)] tw-bg-[var(--wh40k-panel-bg-translucent)]">
      <div class="tw-flex tw-items-center tw-gap-1.5 tw-flex-1 tw-justify-center">
        <div class="tw-opacity-60">
          <i class="fas {{categoryIcon}}"></i>
        </div>
        <div>
          <span class="tw-text-xs tw-uppercase tw-tracking-wider tw-opacity-70">{{localize "WH40K.Gear.Category"}}</span>
          <span class="tw-font-medium">{{categoryLabel}}</span>
        </div>
      </div>
      
      <div class="tw-flex tw-items-center tw-gap-1.5 tw-flex-1 tw-justify-center">
        <div class="tw-opacity-60">
          <i class="fas fa-cubes"></i>
        </div>
        <div>
          <span class="tw-text-xs tw-uppercase tw-tracking-wider tw-opacity-70">{{localize "WH40K.Quantity"}}</span>
          <span class="tw-font-medium">×{{system.quantity}}</span>
        </div>
      </div>
      
      <div class="tw-flex tw-items-center tw-gap-1.5 tw-flex-1 tw-justify-center">
        <div class="tw-opacity-60">
          <i class="fas fa-weight-hanging"></i>
        </div>
        <div>
          <span class="tw-text-xs tw-uppercase tw-tracking-wider tw-opacity-70">{{localize "WH40K.Weight"}}</span>
          <span class="tw-font-medium">{{system.effectiveTotalWeight}}{{localize "WH40K.Common.Kilograms"}}</span>
        </div>
      </div>
      
      <div class="tw-flex tw-items-center tw-gap-1.5 tw-flex-1 tw-justify-center">
        <div class="tw-opacity-60">
          <i class="fas fa-shop"></i>
        </div>
        <div>
          <span class="tw-text-xs tw-uppercase tw-tracking-wider tw-opacity-70">{{localize "WH40K.Availability.Label"}}</span>
          <span class="tw-font-medium">{{system.availabilityLabel}}</span>
        </div>
      </div>
      
      {{#unless hideThroneGelt}}
      <div class="tw-flex tw-items-center tw-gap-1.5 tw-flex-1 tw-justify-center">
        <div class="tw-opacity-60">
          <i class="fas fa-coins"></i>
        </div>
        <div>
          <span class="tw-text-xs tw-uppercase tw-tracking-wider tw-opacity-70">{{localize "WH40K.Cost"}}</span>
          <span class="tw-font-medium">{{system.cost.dh2.homebrew.throneGelt}}₮</span>
        </div>
      </div>
      {{/unless}}
    </div>

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB NAVIGATION
    ═══════════════════════════════════════════════════════════════════ --}}
    {{#if hasLimitedUses}}
    {{> systems/wh40k-rpg/templates/item/partial/item-tab-strip.hbs tabs=(array
        (object tab="overview"    label=(localize "WH40K.Tabs.Overview")    icon="fa-info-circle"   active=true)
        (object tab="usage"       label=(localize "WH40K.Tabs.Usage")       icon="fa-hourglass-half")
        (object tab="description" label=(localize "WH40K.Tabs.Description") icon="fa-book")
        (object tab="effects"     label=(localize "WH40K.Tabs.Effects")     icon="fa-sparkles"))}}
    {{else}}
    {{> systems/wh40k-rpg/templates/item/partial/item-tab-strip.hbs tabs=(array
        (object tab="overview"    label=(localize "WH40K.Tabs.Overview")    icon="fa-info-circle"   active=true)
        (object tab="description" label=(localize "WH40K.Tabs.Description") icon="fa-book")
        (object tab="effects"     label=(localize "WH40K.Tabs.Effects")     icon="fa-sparkles"))}}
    {{/if}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB CONTENT
    ═══════════════════════════════════════════════════════════════════ --}}
    <section class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-3">
      
      {{!-- OVERVIEW TAB --}}
      <div class="tab active" data-tab="overview" data-group="primary">
        
        {{!-- 2-Column Layout --}}
        <div class="tw-grid tw-grid-cols-2 tw-gap-3">
          
          {{!-- LEFT COLUMN --}}
          <div class="tw-flex tw-flex-col tw-gap-4">
            
            {{!-- Category & Classification --}}
            <div class="tw-mb-4">
              <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-display tw-mb-2">
                <i class="fas fa-tags"></i>
                <h3 class="tw-text-gold {{themeClassFor 'accent'}}">{{localize "WH40K.ItemSheet.Gear.Classification"}}</h3>
              </div>
              <div class="tw-flex tw-flex-col tw-gap-2">
                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Gear.Category"}}</label>
                  <select name="system.category" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]">
                    <option value="general" {{#if (eq system.category "general")}}selected{{/if}}>{{localize "WH40K.GearCategory.General"}}</option>
                    <option value="tools" {{#if (eq system.category "tools")}}selected{{/if}}>{{localize "WH40K.GearCategory.Tools"}}</option>
                    <option value="drugs" {{#if (eq system.category "drugs")}}selected{{/if}}>{{localize "WH40K.GearCategory.Drugs"}}</option>
                    <option value="consumable" {{#if (eq system.category "consumable")}}selected{{/if}}>{{localize "WH40K.GearCategory.Consumable"}}</option>
                    <option value="medical" {{#if (eq system.category "medical")}}selected{{/if}}>{{localize "WH40K.GearCategory.Medical"}}</option>
                    <option value="tech" {{#if (eq system.category "tech")}}selected{{/if}}>{{localize "WH40K.GearCategory.Tech"}}</option>
                    <option value="clothing" {{#if (eq system.category "clothing")}}selected{{/if}}>{{localize "WH40K.GearCategory.Clothing"}}</option>
                    <option value="survival" {{#if (eq system.category "survival")}}selected{{/if}}>{{localize "WH40K.GearCategory.Survival"}}</option>
                    <option value="communications" {{#if (eq system.category "communications")}}selected{{/if}}>{{localize "WH40K.GearCategory.Communications"}}</option>
                    <option value="detection" {{#if (eq system.category "detection")}}selected{{/if}}>{{localize "WH40K.GearCategory.Detection"}}</option>
                    <option value="religious" {{#if (eq system.category "religious")}}selected{{/if}}>{{localize "WH40K.GearCategory.Religious"}}</option>
                    <option value="luxury" {{#if (eq system.category "luxury")}}selected{{/if}}>{{localize "WH40K.GearCategory.Luxury"}}</option>
                    <option value="contraband" {{#if (eq system.category "contraband")}}selected{{/if}}>{{localize "WH40K.GearCategory.Contraband"}}</option>
                  </select>
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Craftsmanship.Label"}}</label>
                  <select name="system.craftsmanship" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]">
                    <option value="poor" {{#if (eq system.craftsmanship "poor")}}selected{{/if}}>{{localize "WH40K.Craftsmanship.Poor"}}</option>
                    <option value="common" {{#if (eq system.craftsmanship "common")}}selected{{/if}}>{{localize "WH40K.Craftsmanship.Common"}}</option>
                    <option value="good" {{#if (eq system.craftsmanship "good")}}selected{{/if}}>{{localize "WH40K.Craftsmanship.Good"}}</option>
                    <option value="best" {{#if (eq system.craftsmanship "best")}}selected{{/if}}>{{localize "WH40K.Craftsmanship.Best"}}</option>
                  </select>
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Availability.Label"}}</label>
                  <select name="system.availability" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]">
                    <option value="ubiquitous" {{#if (eq system.availability "ubiquitous")}}selected{{/if}}>{{localize "WH40K.Availability.Ubiquitous"}}</option>
                    <option value="abundant" {{#if (eq system.availability "abundant")}}selected{{/if}}>{{localize "WH40K.Availability.Abundant"}}</option>
                    <option value="plentiful" {{#if (eq system.availability "plentiful")}}selected{{/if}}>{{localize "WH40K.Availability.Plentiful"}}</option>
                    <option value="common" {{#if (eq system.availability "common")}}selected{{/if}}>{{localize "WH40K.Availability.Common"}}</option>
                    <option value="average" {{#if (eq system.availability "average")}}selected{{/if}}>{{localize "WH40K.Availability.Average"}}</option>
                    <option value="scarce" {{#if (eq system.availability "scarce")}}selected{{/if}}>{{localize "WH40K.Availability.Scarce"}}</option>
                    <option value="rare" {{#if (eq system.availability "rare")}}selected{{/if}}>{{localize "WH40K.Availability.Rare"}}</option>
                    <option value="very-rare" {{#if (eq system.availability "very-rare")}}selected{{/if}}>{{localize "WH40K.Availability.VeryRare"}}</option>
                    <option value="extremely-rare" {{#if (eq system.availability "extremely-rare")}}selected{{/if}}>{{localize "WH40K.Availability.ExtremelyRare"}}</option>
                    <option value="near-unique" {{#if (eq system.availability "near-unique")}}selected{{/if}}>{{localize "WH40K.Availability.NearUnique"}}</option>
                    <option value="unique" {{#if (eq system.availability "unique")}}selected{{/if}}>{{localize "WH40K.Availability.Unique"}}</option>
                  </select>
                </div>
              </div>
            </div>
            
            {{!-- Storage --}}
            <div class="tw-mb-4">
              <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-display tw-mb-2">
                <i class="fas fa-box"></i>
                <h3>{{localize "WH40K.ItemSheet.Gear.Storage"}}</h3>
              </div>
              <div class="tw-mb-3">
                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-flex tw-items-center tw-gap-1.5 tw-cursor-pointer">
                    <input type="checkbox" name="system.state.equipped" {{checked system.state.equipped}} class="tw-w-3.5 tw-h-3.5 [accent-color:var(--wh40k-gold)]" />
                    <i class="fas {{#if system.state.equipped}}fa-check-square{{else}}fa-square{{/if}}"></i>
                    <span class="tw-text-[0.8rem] tw-text-[color:var(--wh40k-text-medium)]">{{localize "WH40K.Weapon.Equipped"}}</span>
                  </label>
                  <label class="tw-flex tw-items-center tw-gap-1.5 tw-cursor-pointer">
                    <input type="checkbox" name="system.state.inBackpack" {{checked system.state.inBackpack}} class="tw-w-3.5 tw-h-3.5 [accent-color:var(--wh40k-gold)]" />
                    <i class="fas {{#if system.state.inBackpack}}fa-check-square{{else}}fa-square{{/if}}"></i>
                    <span class="tw-text-[0.8rem] tw-text-[color:var(--wh40k-text-medium)]">{{localize "WH40K.ItemSheet.Gear.InBackpack"}}</span>
                  </label>
                  {{!-- #390: Bound toggle — GM only, only visible in edit mode --}}
                  {{#if inEditMode}}
                  <label class="tw-flex tw-items-center tw-gap-1.5 tw-cursor-pointer" title="{{localize "WH40K.Item.BoundHint"}}">
                    <input type="checkbox" name="system.bound" {{checked system.bound}} class="tw-w-3.5 tw-h-3.5 [accent-color:var(--wh40k-gold)]" />
                    <i class="fas fa-lock"></i>
                    <span class="tw-text-[0.8rem] tw-text-[color:var(--wh40k-text-medium)]">{{localize "WH40K.Item.Bound"}}</span>
                  </label>
                  {{/if}}
                </div>
              </div>
            </div>

          </div>
          
          {{!-- RIGHT COLUMN --}}
          <div class="tw-flex tw-flex-col tw-gap-4">
            
            {{!-- Physical Properties --}}
            <div class="tw-mb-4">
              <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-display tw-mb-2">
                <i class="fas fa-cubes"></i>
                <h3>{{localize "WH40K.Ammunition.PhysicalProperties"}}</h3>
              </div>
              <div class="tw-flex tw-flex-col tw-gap-2">
                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Quantity"}}</label>
                  <input type="number" name="system.quantity" value="{{source.quantity}}"
                         data-dtype="Number" min="1" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.ItemSheet.Gear.WeightPerUnit"}}</label>
                  <input type="number" name="system.weight" value="{{source.weight}}"
                         data-dtype="Number" min="0" step="0.1" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.TotalWeight"}}</label>
                  <input type="text" value="{{source.effectiveTotalWeight}} {{localize 'WH40K.Common.Kilograms'}}" disabled class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-muted)] tw-opacity-60" />
                </div>
              </div>
            </div>
            
            {{!-- Economic --}}
            {{#unless hideThroneGelt}}
            <div class="tw-mb-4">
              <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-display tw-mb-2">
                <i class="fas fa-coins"></i>
                <h3>{{localize "WH40K.ItemSheet.Gear.Economic"}}</h3>
              </div>
              <div class="tw-mb-3">
                <div class="tw-flex tw-flex-col tw-gap-1">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Ammunition.CostThrones"}}</label>
                  <input type="number" name="system.cost.dh2.homebrew.throneGelt" value="{{source.cost.dh2.homebrew.throneGelt}}"
                         data-dtype="Number" min="0" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
                </div>
              </div>
            </div>
            {{/unless}}
            
            {{!-- Consumable Toggle --}}
            <div class="tw-mb-4">
              <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-display tw-mb-2">
                <i class="fas fa-flask"></i>
                <h3>{{localize "WH40K.Gear.Consumable"}}</h3>
              </div>
              <div class="tw-mb-3">
                <label class="tw-flex tw-items-center tw-gap-1.5 tw-cursor-pointer">
                  <input type="checkbox" name="system.consumable" {{checked system.consumable}} class="tw-w-3.5 tw-h-3.5 [accent-color:var(--wh40k-gold)]" />
                  <i class="fas {{#if system.consumable}}fa-check-square{{else}}fa-square{{/if}}"></i>
                  <span class="tw-text-[0.8rem] tw-text-[color:var(--wh40k-text-medium)]">{{localize "WH40K.ItemSheet.Gear.HasLimitedUses"}}</span>
                </label>
                
                {{#if system.consumable}}
                <div class="tw-flex tw-flex-col tw-gap-1 tw-mt-2">
                  <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Gear.MaxUses"}}</label>
                  <input type="number" name="system.uses.max" value="{{source.uses.max}}"
                         data-dtype="Number" min="0" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
                </div>
                {{/if}}
              </div>
            </div>
            
          </div>
          
        </div>
        
      </div>

      {{!-- USAGE TAB (if consumable) --}}
      {{#if hasLimitedUses}}
      <div class="tab" data-tab="usage" data-group="primary">
        
        <div class="tw-mb-4">
          <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-display tw-mb-2">
            <i class="fas fa-hourglass-half"></i>
            <h3>{{localize "WH40K.ItemSheet.Gear.ConsumableProperties"}}</h3>
            <span class="tw-ml-auto tw-text-xs {{#if usesExhausted}}tw-text-red-400{{/if}}">
              {{usesDisplay}}
            </span>
          </div>
          <div class="tw-mb-3">
            
            {{!-- Uses Bar --}}
            <div class="tw-mb-3">
              <div class="tw-relative tw-h-2 tw-rounded-full tw-overflow-hidden tw-mb-1">
                <div class="tw-h-full tw-rounded-full tw-transition-all" {{#if usesExhausted}}data-exhausted="true"{{/if}}
                     style="width: {{multiply (divide system.uses.value system.uses.max) 100}}%"></div>
              </div>
              <div class="tw-text-xs tw-opacity-70">
                {{localize "WH40K.ItemSheet.Gear.UsesRemaining" value=system.uses.value max=system.uses.max}}
              </div>
            </div>
            
            <div class="tw-flex tw-flex-col tw-gap-1">
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Gear.CurrentUses"}}</label>
                <input type="number" name="system.uses.value" value="{{source.uses.value}}"
                       data-dtype="Number" min="0" max="{{system.uses.max}}" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.Gear.MaxUses"}}</label>
                <input type="number" name="system.uses.max" value="{{source.uses.max}}"
                       data-dtype="Number" min="0" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
              </div>
            </div>

            <div class="tw-flex tw-flex-col tw-gap-1">
              <label class="tw-text-xs tw-uppercase tw-tracking-wider tw-text-[color:var(--wh40k-text-muted)]">{{localize "WH40K.ItemSheet.Gear.DurationRecovery"}}</label>
              <input type="text" name="system.duration" value="{{source.duration}}"
                     placeholder="{{localize 'WH40K.ItemSheet.Gear.DurationPlaceholder'}}" class="tw-bg-[var(--wh40k-input-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-sm tw-px-2 tw-py-1 tw-text-[color:var(--wh40k-text-dark)]" />
            </div>

            {{!-- Quick Actions --}}
            <div class="tw-flex tw-gap-2 tw-mt-3">
              <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-px-3 tw-py-2 tw-bg-[var(--wh40k-btn-bg)] tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-md tw-text-[color:var(--wh40k-text-dark)] tw-text-sm tw-cursor-pointer hover:tw-border-[var(--wh40k-gold)] hover:tw-text-gold" data-action="consumeUse" {{#if usesExhausted}}disabled{{/if}}>
                <i class="fas fa-minus"></i>
                {{localize "WH40K.ItemSheet.Gear.UseOne"}}
              </button>
              <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-px-3 tw-py-2 tw-bg-gradient-to-br tw-from-[var(--wh40k-gold-dark)] tw-to-[var(--wh40k-gold)] tw-border tw-border-[var(--wh40k-gold)] tw-rounded-md tw-text-[#1a1a1a] tw-text-sm tw-cursor-pointer" data-action="resetUses">
                <i class="fas fa-redo"></i>
                {{localize "WH40K.Gear.ResetUses"}}
              </button>
            </div>
            
          </div>
        </div>
        
      </div>
      {{/if}}

      {{!-- DESCRIPTION TAB --}}
      <div class="tab" data-tab="description" data-group="primary">
        
        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-bolt" labelKey="WH40K.ItemSheet.Gear.MechanicalEffect" bodyClass="tw-p-2"}}
          {{editor system.effect target="system.effect" button=true editable=editable engine="prosemirror"}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book" labelKey="WH40K.Tabs.Description" bodyClass="tw-p-2"}}
          {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sticky-note" labelKey="WH40K.ItemSheet.Common.GmNotes"}}
          <textarea name="system.notes" rows="4" placeholder="{{localize 'WH40K.ItemSheet.Gear.NotesPlaceholder'}}" class="tw-w-full tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-resize-y">{{system.notes}}</textarea>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book-open" labelKey="WH40K.Common.Source"}}
          {{> systems/wh40k-rpg/templates/item/partial/source-reference-field.hbs source=source.source editable=editable}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

      </div>

      {{!-- EFFECTS TAB --}}
      <div class="tab" data-tab="effects" data-group="primary">
        {{> systems/wh40k-rpg/templates/item/panel/active-effects-panel.hbs}}
      </div>

    </section>

</div>
