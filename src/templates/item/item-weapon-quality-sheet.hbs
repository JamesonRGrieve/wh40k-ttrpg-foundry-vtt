{{!
  Rogue Trader Weapon Quality Item Sheet - V2 Redesign
  Clean reference-card style for weapon quality definitions
}}
<div class="tw-flex tw-flex-col tw-h-full">
    <div autocomplete="off">

        {{! ═══════════════════════════════════════════════════════════════════
         HEADER: Simple quality identity
    ═══════════════════════════════════════════════════════════════════ }}
        <header class="tw-flex tw-items-center tw-gap-2 tw-p-3 tw-bg-gradient-to-br tw-from-orange-500/15 tw-to-transparent tw-border-b-2 tw-border-solid {{themeClassFor 'border'}}">
            {{> systems/wh40k-rpg/templates/shared/editable-portrait.hbs src=item.img alt=item.name sizeClass="tw-w-14 tw-h-14" frameClass="tw-border-2 tw-border-solid tw-border-bronze tw-transition-transform hover:tw-scale-105" overlayIcon="fa-star" overlayBgClass="tw-bg-orange-500/70" overlayTextClass="tw-text-white" overlayIconClass="tw-text-xl" extraClass="tw-flex-shrink-0"}}

            <div class="tw-flex-1 tw-min-w-0">
                <input type="text" class="tw-w-full tw-min-w-0 tw-px-2 tw-py-1 tw-bg-transparent tw-border-0 tw-border-b tw-border-solid tw-border-transparent tw-font-display {{nameFitClass item.name 'itemHeader'}} tw-text-ellipsis tw-font-semibold hover:tw-border-orange-500/60 focus:tw-border-orange-500/60 focus:tw-outline-none tw-transition-colors"
                       name="name" value="{{item.name}}" data-tooltip="{{item.name}}" placeholder="{{localize 'WH40K.ItemSheet.WeaponQuality.NamePlaceholder'}}" />

                <div class="tw-flex tw-flex-wrap tw-gap-1.5 tw-mt-1.5 tw-pl-2">
                    <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-md tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-bg-orange-500/15 tw-border tw-border-solid tw-border-orange-500/40 tw-text-orange-500" title="{{localize 'WH40K.ItemSheet.WeaponQuality.ItemTypeTooltip'}}">
                        <i class="fas fa-star"></i>
                        {{localize "WH40K.ItemSheet.WeaponQuality.ItemType"}}
                    </span>
                    {{#if system.hasLevel}}
                        <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-md tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-bg-blue-500/15 tw-border tw-border-solid tw-border-blue-500/40 tw-text-blue-500" title="{{localize 'WH40K.ItemSheet.WeaponQuality.HasLevel'}}">
                            <i class="fas fa-sort-numeric-up"></i>
                            {{localize "WH40K.Common.Level"}}
                            {{system.level}}
                        </span>
                    {{/if}}
                </div>
            </div>
        </header>

        {{! ═══════════════════════════════════════════════════════════════════
         STAT BAR: Quick reference stats
    ═══════════════════════════════════════════════════════════════════ }}
        <div class="tw-flex tw-flex-wrap tw-gap-0.5 tw-p-2 tw-bg-black/5 tw-border-b tw-border-solid tw-border-black/10">
            <div class="tw-flex tw-flex-col tw-items-center tw-flex-1 tw-min-w-[80px] tw-p-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md tw-border tw-border-solid tw-border-black/10">
                <div class="tw-text-base tw-text-orange-500/80 tw-mb-1">
                    <i class="fas fa-fingerprint"></i>
                </div>
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-text-2xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.Identifier"}}</span>
                    <span class="tw-font-display tw-text-sm tw-font-semibold">{{system.identifier}}</span>
                </div>
            </div>

            <div class="tw-flex tw-flex-col tw-items-center tw-flex-1 tw-min-w-[80px] tw-p-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md tw-border tw-border-solid tw-border-black/10">
                <div class="tw-text-base tw-text-orange-500/80 tw-mb-1">
                    <i class="fas fa-sort-numeric-up"></i>
                </div>
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                    <span class="tw-text-2xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.HasLevel"}}</span>
                    <span class="tw-font-display tw-text-sm tw-font-semibold">{{#if system.hasLevel}}{{localize "WH40K.Yes"}}{{else}}{{localize "WH40K.No"}}{{/if}}</span>
                </div>
            </div>

            {{#if system.hasLevel}}
                <div class="tw-flex tw-flex-col tw-items-center tw-flex-1 tw-min-w-[80px] tw-p-2 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-rounded-md tw-border tw-border-solid tw-border-black/10">
                    <div class="tw-text-base tw-text-orange-500/80 tw-mb-1">
                        <i class="fas fa-hashtag"></i>
                    </div>
                    <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
                        <span class="tw-text-2xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-gray-500">{{localize "WH40K.Common.Level"}}</span>
                        <span class="tw-font-display tw-text-sm tw-font-semibold">{{system.level}}</span>
                    </div>
                </div>
            {{/if}}
        </div>

        {{! ═══════════════════════════════════════════════════════════════════
         TAB NAVIGATION
    ═══════════════════════════════════════════════════════════════════ }}
        <nav class="tabs wh40k-tabs tw-flex tw-gap-0.5 tw-px-3 tw-bg-black/5 tw-border-b tw-border-solid tw-border-black/10" data-group="primary">
            <button type="button" class="wh40k-tab active tw-flex tw-items-center tw-gap-1.5 tw-px-4 tw-py-2.5 tw-bg-transparent tw-border-0 tw-border-b-2 tw-border-solid tw-border-transparent tw-text-sm tw-font-medium tw-text-gray-500 tw-cursor-pointer tw-transition-all [&.active]:tw-text-orange-500 [&.active]:tw-border-orange-500 [&.active]:tw-bg-orange-500/8" data-tab="effect" data-group="primary">
                <i class="fas fa-bolt"></i>
                <span>{{localize "WH40K.Tabs.Effect"}}</span>
            </button>
            <button type="button" class="wh40k-tab tw-flex tw-items-center tw-gap-1.5 tw-px-4 tw-py-2.5 tw-bg-transparent tw-border-0 tw-border-b-2 tw-border-solid tw-border-transparent tw-text-sm tw-font-medium tw-text-gray-500 tw-cursor-pointer tw-transition-all [&.active]:tw-text-orange-500 [&.active]:tw-border-orange-500 [&.active]:tw-bg-orange-500/8" data-tab="details" data-group="primary">
                <i class="fas fa-cog"></i>
                <span>{{localize "WH40K.Tabs.Details"}}</span>
            </button>
            <button type="button" class="wh40k-tab tw-flex tw-items-center tw-gap-1.5 tw-px-4 tw-py-2.5 tw-bg-transparent tw-border-0 tw-border-b-2 tw-border-solid tw-border-transparent tw-text-sm tw-font-medium tw-text-gray-500 tw-cursor-pointer tw-transition-all [&.active]:tw-text-orange-500 [&.active]:tw-border-orange-500 [&.active]:tw-bg-orange-500/8" data-tab="description" data-group="primary">
                <i class="fas fa-book"></i>
                <span>{{localize "WH40K.Tabs.Description"}}</span>
            </button>
        </nav>

        {{! ═══════════════════════════════════════════════════════════════════
         TAB CONTENT
    ═══════════════════════════════════════════════════════════════════ }}
        <section class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-p-3">

            {{! EFFECT TAB (Primary) }}
            <div class="tab active" data-tab="effect" data-group="primary">

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-bolt" labelKey="WH40K.ItemSheet.WeaponQuality.MechanicalEffect"}}
                        {{editor system.effect target="system.effect" button=true editable=editable engine="prosemirror"}}
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                {{#if system.hasLevel}}
                    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-info-circle" labelKey="WH40K.ItemSheet.WeaponQuality.LevelExplanation"}}
                            <p class="tw-m-0 tw-p-2.5 tw-bg-blue-500/8 tw-border-l-4 tw-border-solid tw-border-blue-500/50 tw-rounded-md tw-text-sm tw-leading-relaxed">
                                {{localize "WH40K.ItemSheet.WeaponQuality.LevelExplanationBefore"}}
                                <strong class="tw-font-semibold">{{item.name}} ({{system.level}})</strong>
                                {{localize "WH40K.ItemSheet.WeaponQuality.LevelExplanationAfter"}}
                            </p>
                    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
                {{/if}}

            </div>

            {{! DETAILS TAB }}
            <div class="tab" data-tab="details" data-group="primary">

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-cog" labelKey="WH40K.ItemSheet.WeaponQuality.QualityProperties"}}
                    <div>

                        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-mb-3">
                            <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.Identifier"}}</label>
                            <input type="text" class="tw-w-full tw-px-2 tw-py-1.5 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-text-sm tw-font-body" name="system.identifier" value="{{source.identifier}}" placeholder="{{localize 'WH40K.ItemSheet.WeaponQuality.IdentifierPlaceholder'}}" />
                            <p class="tw-m-0 tw-mt-0.5 tw-text-xs tw-italic tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.IdentifierHint"}}</p>
                        </div>

                        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-mb-3">
                            <label class="tw-flex tw-items-center tw-gap-2 tw-cursor-pointer tw-rounded-md tw-p-1.5 hover:tw-bg-[var(--wh40k-panel-bg-translucent)] tw-transition-colors">
                                <input type="checkbox" class="tw-w-4 tw-h-4 tw-cursor-pointer" name="system.hasLevel" {{checked system.hasLevel}} />
                                <span class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.WeaponQuality.HasNumericLevel"}}</span>
                            </label>
                            <p class="tw-m-0 tw-ml-7 tw-text-xs tw-italic tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.NumericLevelHint"}}</p>
                        </div>

                        {{#if system.hasLevel}}
                            <div class="tw-flex tw-flex-col tw-gap-0.5 tw-mb-3">
                                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.DefaultLevel"}}</label>
                                <input type="number" class="tw-w-full tw-px-2 tw-py-1.5 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-text-sm" name="system.level" value="{{source.level}}" data-dtype="Number" min="0" />
                                <p class="tw-m-0 tw-mt-0.5 tw-text-xs tw-italic tw-text-gray-500">{{localize "WH40K.ItemSheet.WeaponQuality.DefaultLevelHint"}}</p>
                            </div>
                        {{/if}}

                    </div>
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sticky-note" labelKey="WH40K.ItemSheet.Common.GmNotes"}}
                        <textarea class="tw-w-full tw-px-2 tw-py-1.5 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-text-sm tw-font-body tw-resize-y" name="system.notes" rows="4" placeholder="{{localize 'WH40K.ItemSheet.WeaponQuality.NotesPlaceholder'}}">{{system.notes}}</textarea>
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

            </div>

            {{! DESCRIPTION TAB }}
            <div class="tab" data-tab="description" data-group="primary">

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book" labelKey="WH40K.ItemSheet.WeaponQuality.FullDescription"}}
                        {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book-open" labelKey="WH40K.Common.Source"}}
                        {{> systems/wh40k-rpg/templates/item/partial/source-reference-field.hbs source=source.source editable=editable}}
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

            </div>

        </section>

    </div>
</div>
