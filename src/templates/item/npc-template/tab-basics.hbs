{{! NPC Template - Basics Tab }}
<section class="tab {{tab.cssClass}}" data-tab="basics" data-group="primary">
    {{! Description Section }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-scroll" labelKey="WH40K.NPC.Template.Description"}}
            <div>
                {{formInput fields.description value=system.description enriched=enrichedDescription}}
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{! Tags Section }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-tags" labelKey="WH40K.NPC.Tags"}}
            <div class="tw-flex tw-flex-wrap tw-gap-2">
                {{#each system.tags as |tag idx|}}
                    <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-1 tw-rounded-full tw-text-sm" style="background: var(--wh40k-accent-color-light)" data-index="{{idx}}">
                        {{tag}}
                        <button type="button" class="tw-border-0 tw-bg-transparent tw-cursor-pointer tw-p-0 tw-text-[var(--wh40k-text-muted)] hover:tw-text-[var(--wh40k-danger)]" data-action="removeTag" data-index="{{idx}}" aria-label="{{localize 'WH40K.NPC.Template.RemoveTag' tag=tag}}">
                            <i class="fas fa-times"></i>
                        </button>
                    </span>
                {{/each}}
                {{!-- Unnamed, so the form never submits it: Add (or Enter) appends its text to system.tags. --}}
                <div class="tw-flex tw-gap-1">
                    <input class="tw-px-2 tw-py-1 tw-border {{themeClassFor 'border'}} tw-rounded-sm tw-w-[120px]" type="text" placeholder="{{localize 'WH40K.NPC.AddTag'}}" aria-label="{{localize 'WH40K.NPC.AddTag'}}" data-wh40k-hook="npc-template-tag-input" />
                    <button type="button" class="tw-px-2 tw-py-1" data-action="addTag" aria-label="{{localize 'WH40K.NPC.AddTag'}}">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{! Scaling Rules Section }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-chart-line" labelKey="WH40K.NPC.Template.ScalingRules"}}
            <div class="tw-grid tw-grid-cols-2 tw-gap-4">
                <div class="tw-flex tw-flex-col tw-gap-1">
                    <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.Template.CharacteristicScale"}}</label>
                    <div class="tw-flex tw-items-center tw-gap-1">
                        <input
                            class="tw-w-[60px]"
                            type="number"
                            name="system.scaling.characteristicScale"
                            value="{{source.scaling.characteristicScale}}"
                            min="0"
                            max="50"
                            step="0.1"
                        />
                        <span class="tw-text-[var(--wh40k-text-muted)]">%</span>
                    </div>
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                    <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.Template.WoundsScale"}}</label>
                    <div class="tw-flex tw-items-center tw-gap-1">
                        <input class="tw-w-[60px]" type="number" name="system.scaling.woundsScale" value="{{source.scaling.woundsScale}}" min="0" max="50" step="0.1" />
                        <span class="tw-text-[var(--wh40k-text-muted)]">%</span>
                    </div>
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                    <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.Template.ArmourScale"}}</label>
                    <div class="tw-flex tw-items-center tw-gap-1">
                        <input class="tw-w-[60px]" type="number" name="system.scaling.armourScale" value="{{source.scaling.armourScale}}" min="0" max="30" step="0.1" />
                        <span class="tw-text-[var(--wh40k-text-muted)]">%</span>
                    </div>
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1">
                    <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.Template.WeaponScale"}}</label>
                    <div class="tw-flex tw-items-center tw-gap-1">
                        <input class="tw-w-[60px]" type="number" name="system.scaling.weaponScale" value="{{source.scaling.weaponScale}}" min="0" max="30" step="0.1" />
                        <span class="tw-text-[var(--wh40k-text-muted)]">%</span>
                    </div>
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1 tw-col-span-full">
                    <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.Template.MinMultiplier"}}</label>
                    <input type="number" name="system.scaling.minMultiplier" value="{{source.scaling.minMultiplier}}" min="0.1" max="1" step="0.1" />
                </div>

                <div class="tw-flex tw-flex-col tw-gap-1 tw-col-span-full">
                    <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.Template.MaxMultiplier"}}</label>
                    <input type="number" name="system.scaling.maxMultiplier" value="{{source.scaling.maxMultiplier}}" min="1" max="5" step="0.1" />
                </div>
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{! Source Reference }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book" labelKey="WH40K.NPC.Source"}}
            <div class="tw-flex tw-items-center tw-gap-4">
                <label class="tw-font-medium tw-min-w-[120px]">{{localize "WH40K.NPC.SourceBook"}}</label>
                <input class="tw-flex-1 tw-px-2 tw-py-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm" type="text" name="system.source" value="{{sourceLabel source.source}}" placeholder="{{localize 'WH40K.NPC.SourcePlaceholder'}}" />
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
</section>