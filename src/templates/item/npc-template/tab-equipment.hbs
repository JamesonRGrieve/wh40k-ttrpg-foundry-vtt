{{! NPC Template - Equipment Tab }}
<section class="tab {{tab.cssClass}}" data-tab="equipment" data-group="primary">
    {{! Weapons Section }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sword" labelKey="WH40K.NPC.Template.Weapons" addAction="addWeapon"}}
            {{#if (gt system.customWeapons.length 0)}}
                <div>
                    <div class="tw-grid tw-grid-cols-[2fr_1fr_0.5fr_1fr_1fr_1.5fr_0.5fr] tw-gap-2 tw-items-center tw-p-2 tw-font-semibold tw-text-xs tw-uppercase" style="background: var(--wh40k-bg-tertiary)">
                        <span>{{localize "WH40K.Name"}}</span>
                        <span>{{localize "WH40K.Weapon.Damage"}}</span>
                        <span>{{localize "WH40K.Weapon.Pen"}}</span>
                        <span>{{localize "WH40K.Weapon.Range"}}</span>
                        <span>{{localize "WH40K.Weapon.RoF"}}</span>
                        <span>{{localize "WH40K.Weapon.Special"}}</span>
                        <span></span>
                    </div>
                    {{#each system.customWeapons as |weapon idx|}}
                        <div class="tw-grid tw-grid-cols-[2fr_1fr_0.5fr_1fr_1fr_1.5fr_0.5fr] tw-gap-2 tw-items-center tw-p-2 tw-border-b tw-border-[var(--wh40k-border-color)]" data-index="{{idx}}">
                            <input
                                class="tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm tw-w-full"
                                type="text"
                                name="system.customWeapons.{{idx}}.name"
                                value="{{weapon.name}}"
                                placeholder="{{localize 'WH40K.Weapon.Name'}}"
                            />
                            <input class="tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm tw-w-full" type="text" name="system.customWeapons.{{idx}}.damage" value="{{weapon.damage}}" placeholder="1d10+3" />
                            <input class="tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm tw-w-full" type="number" name="system.customWeapons.{{idx}}.pen" value="{{weapon.pen}}" min="0" />
                            <input class="tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm tw-w-full" type="text" name="system.customWeapons.{{idx}}.range" value="{{weapon.range}}" placeholder="30m" />
                            <input class="tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm tw-w-full" type="text" name="system.customWeapons.{{idx}}.rof" value="{{weapon.rof}}" placeholder="S/-/-" />
                            <input
                                class="tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm tw-w-full"
                                type="text"
                                name="system.customWeapons.{{idx}}.special"
                                value="{{weapon.special}}"
                                placeholder="{{localize 'WH40K.Weapon.SpecialPlaceholder'}}"
                            />
                            <div>
                                <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-m-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-rounded-[var(--wh40k-radius-sm)] tw-cursor-pointer tw-transition-all hover:tw-bg-[rgba(0,0,0,0.2)]" data-action="removeWeapon" data-index="{{idx}}">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="tw-text-center tw-italic tw-p-4 tw-text-[var(--wh40k-text-muted)]">{{localize "WH40K.NPC.Template.NoWeapons"}}</p>
            {{/if}}
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{! Armour Section }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-shield-alt" labelKey="WH40K.NPC.Template.Armour"}}
            <div class="tw-flex tw-items-center tw-gap-4 tw-mb-4">
                <label class="tw-font-medium tw-min-w-[120px]">{{localize "WH40K.NPC.Template.BaseArmour"}}</label>
                <input class="tw-w-[60px] tw-p-2 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm" type="number" name="system.baseArmour" value="{{source.baseArmour}}" min="0" />
            </div>

            <div class="tw-flex tw-items-center tw-gap-4 tw-mb-4">
                <label class="tw-font-medium tw-min-w-[120px]">{{localize "WH40K.NPC.Template.ArmourNotes"}}</label>
                <input
                    class="tw-flex-1 tw-p-2 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm"
                    type="text"
                    name="system.armourNotes"
                    value="{{source.armourNotes}}"
                    placeholder="{{localize 'WH40K.NPC.Template.ArmourNotesPlaceholder'}}"
                />
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{! Equipment Section }}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-backpack" labelKey="WH40K.NPC.Template.Equipment" addAction="addEquipment" addLabelKey="WH40K.NPC.Template.AddEquipment"}}
            {{#if (gt system.equipment.length 0)}}
                <div class="tw-flex tw-flex-col tw-gap-2">
                    {{#each system.equipment as |item idx|}}
                        <div class="tw-flex tw-gap-2 tw-items-center" data-index="{{idx}}">
                            <input class="tw-flex-1 tw-px-2 tw-py-1" type="text" name="system.equipment.{{idx}}.name" value="{{item.name}}" placeholder="{{localize 'WH40K.Item.Name'}}" aria-label="{{localize 'WH40K.Item.Name'}}" />
                            <input class="tw-w-[50px] tw-text-center" type="number" name="system.equipment.{{idx}}.quantity" value="{{item.quantity}}" min="1" aria-label="{{localize 'WH40K.NPC.Template.EquipmentQuantity'}}" />
                            <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-m-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-rounded-[var(--wh40k-radius-sm)] tw-cursor-pointer tw-transition-all hover:tw-bg-[rgba(0,0,0,0.2)]" data-action="removeEquipment" data-index="{{idx}}" aria-label="{{localize 'WH40K.NPC.Template.RemoveEquipment'}}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="tw-text-center tw-italic tw-p-4 tw-text-[var(--wh40k-text-muted)]">{{localize "WH40K.NPC.Template.NoEquipment"}}</p>
            {{/if}}
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
</section>
