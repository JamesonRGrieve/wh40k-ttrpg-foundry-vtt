{{!-- NPC Template - Characteristics Tab --}}
<section class="tab {{tab.cssClass}}" data-tab="characteristics" data-group="primary">
    {{!-- Base Characteristics --}}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-dice-d20" labelKey="WH40K.NPC.Template.BaseCharacteristics"}}
            {{!-- The note sits under the title bar, on its own line; beside the heading it collided (#656). --}}
            <p class="tw-m-0 tw-mb-2 tw-text-xs tw-text-[var(--wh40k-text-muted)]" data-field="base-characteristics-note">{{localize "WH40K.NPC.Template.CharacteristicsNote"}}</p>
            <div class="tw-grid tw-grid-cols-5 tw-gap-3">
                {{!-- `characteristics` is a list of { key, label, short, value, unnatural }: name
                      each input by the characteristic's key, not the list index. --}}
                {{#each characteristics as |char|}}
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-1">
                    <label class="tw-text-xs tw-font-semibold tw-uppercase">{{char.label}}</label>
                    <input class="tw-w-[50px] tw-text-center tw-p-1 tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm" type="number" name="system.baseCharacteristics.{{char.key}}"
                           value="{{char.value}}" min="0" max="100" />
                </div>
                {{/each}}
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{!-- Unnatural Characteristics --}}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-bolt" labelKey="WH40K.NPC.Template.UnnaturalCharacteristics"}}
            <div class="tw-grid tw-grid-cols-[repeat(10,1fr)] tw-gap-3">
                {{#each characteristics as |char|}}
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-1">
                    <label class="tw-text-[0.625rem] tw-font-semibold tw-uppercase">{{char.short}}</label>
                    <input class="tw-w-[35px] tw-text-center tw-p-1 tw-text-sm tw-border tw-border-[var(--wh40k-border-color)] tw-rounded-sm" type="number" name="system.unnaturals.{{char.key}}"
                           value="{{char.unnatural}}" min="0" max="10" />
                </div>
                {{/each}}
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{!-- Wounds & Movement --}}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-heart" labelKey="WH40K.NPC.Template.VitalStats"}}
            <div class="tw-flex tw-gap-8 tw-justify-center">
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-1">
                    <label class="tw-font-semibold">{{localize "WH40K.Wounds"}}</label>
                    <input class="tw-w-[60px] tw-text-center tw-p-2 tw-text-xl tw-border-2 tw-border-[var(--wh40k-border-color)] tw-rounded-md" type="number" name="system.baseWounds" value="{{source.baseWounds}}" min="1" />
                </div>

                {{!-- No movement input: a generated NPC derives its movement from its Agility
                      Bonus and size, so a template value would never reach it (#656). --}}
                {{!-- Shown here, edited on the Equipment tab beside its notes. A second
                      `system.baseArmour` input made the form submit an array for it, which
                      failed validation and dropped every edit on the sheet (#656). --}}
                <div class="tw-flex tw-flex-col tw-items-center tw-gap-1">
                    <span class="tw-font-semibold">{{localize "WH40K.NPC.Armour"}}</span>
                    <span class="tw-w-[60px] tw-text-center tw-p-2 tw-text-xl tw-border-2 tw-border-[var(--wh40k-border-color)] tw-rounded-md" data-field="vital-armour">{{source.baseArmour}}</span>
                </div>
            </div>
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

    {{!-- Trained Skills: the add button sits at the title bar's right edge, clear of the heading (#656). --}}
    {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-graduation-cap" labelKey="WH40K.NPC.Template.TrainedSkills" addAction="addSkill"}}
            {{#if (gt skills.length 0)}}
            <div class="tw-flex tw-flex-col tw-gap-2">
                {{#each skills as |skill idx|}}
                <div class="tw-flex tw-items-center tw-gap-2 tw-p-2 tw-rounded-md" style="background: var(--wh40k-bg-secondary)" data-index="{{idx}}">
                    <span class="tw-flex-[2] tw-font-medium">{{skill.name}}</span>
                    <span class="tw-w-10 tw-text-center tw-text-xs tw-text-[var(--wh40k-text-muted)]" title="{{skill.characteristicLabel}}" data-field="skill-characteristic">{{skill.characteristicShort}}</span>
                    <div>
                        <select class="tw-p-1" name="system.trainedSkills.{{idx}}.level">
                            <option value="trained" {{#if (eq skill.level "trained")}}selected{{/if}}>{{localize "WH40K.Skills.Trained"}}</option>
                            <option value="plus10" {{#if (eq skill.level "plus10")}}selected{{/if}}>+10</option>
                            <option value="plus20" {{#if (eq skill.level "plus20")}}selected{{/if}}>+20</option>
                        </select>
                    </div>
                    <input class="tw-w-[50px] tw-text-center" type="number" name="system.trainedSkills.{{idx}}.bonus"
                           value="{{skill.bonus}}" placeholder="+0" aria-label="{{localize 'WH40K.NPC.Template.SkillBonus'}}" />
                    <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-m-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-rounded-[var(--wh40k-radius-sm)] tw-cursor-pointer tw-transition-all hover:tw-bg-[rgba(0,0,0,0.2)]"
                            data-action="removeSkill" data-index="{{idx}}">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                {{/each}}
            </div>
            {{else}}
            <p class="tw-text-center tw-italic tw-p-4 tw-text-[var(--wh40k-text-muted)]">{{localize "WH40K.NPC.Template.NoSkills"}}</p>
            {{/if}}
    {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
</section>
