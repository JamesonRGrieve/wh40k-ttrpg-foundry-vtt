<div class="wh40k-item-sheet tw-flex tw-flex-col tw-h-full tw-overflow-hidden tw-bg-[var(--wh40k-sheet-bg)] tw-text-[var(--wh40k-text-dark)]" autocomplete="off">
    {{! Header }}
    {{#> systems/wh40k-rpg/templates/item/panel/item-header.hbs namePlaceholderKey="WH40K.ItemSheet.NamePlaceholder.WeaponMod" hideTypeBadge=true }}
        <div class="tw-flex tw-items-center tw-gap-1 tw-text-sm tw-text-gold {{themeClassFor 'accent'}}">
            <span class="material-icons tw-text-lg">build</span>
            <span>{{localize "WH40K.ItemSheet.WeaponMod.Title"}}</span>
        </div>
    {{/systems/wh40k-rpg/templates/item/panel/item-header.hbs}}

    <div class="tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-2">
        {{! Properties Panel }}
        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sliders-h" labelKey="WH40K.Tabs.Properties"}}
        <div class="tw-grid tw-grid-cols-3 tw-gap-2 tw-mb-2">
            <div class="tw-flex tw-flex-col tw-gap-0.5">
                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide">{{localize "WH40K.Weight"}}</label>
                <input class="tw-w-full tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-px-2 tw-py-1 tw-text-sm" name="system.weight" type="number" data-dtype="Number" value="{{item.system.weight}}" />
            </div>
            <div class="tw-flex tw-flex-col tw-gap-0.5">
                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide">{{localize "WH40K.Availability.Label"}}</label>
                <select class="tw-w-full tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-px-2 tw-py-1 tw-text-sm" name="system.availability">
                    {{!-- Keyed by the schema's choice keys (#612: label values failed validation, so no edit on this sheet saved). --}}
                    {{selectOptions dh.availabilities selected=item.system.availability labelAttr="label" localize=true}}
                </select>
            </div>
            <div class="tw-flex tw-flex-col tw-gap-0.5">
                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide">{{localize "WH40K.Craftsmanship.Label"}}</label>
                <select class="tw-w-full tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-px-2 tw-py-1 tw-text-sm" name="system.craftsmanship">
                    {{selectOptions dh.craftsmanships selected=item.system.craftsmanship labelAttr="label" localize=true}}
                </select>
            </div>
        </div>
        <div class="tw-grid tw-grid-cols-2 tw-gap-2 tw-mb-2">
            <label class="tw-flex tw-items-center tw-gap-2 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-cursor-pointer">
                <input type="checkbox" name="system.state.equipped" data-dtype="Boolean" {{checked item.system.state.equipped}} />
                {{localize "WH40K.ItemSheet.WeaponMod.Installed"}}
            </label>
            <label class="tw-flex tw-items-center tw-gap-2 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide tw-cursor-pointer">
                <input type="checkbox" name="system.backpack.inBackpack" data-dtype="Boolean" {{checked item.system.backpack.inBackpack}} />
                {{localize "WH40K.ItemSheet.WeaponMod.InBackpack"}}
            </label>
        </div>
        <div class="tw-flex tw-flex-col tw-gap-0.5">
            <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-wide">{{localize "WH40K.Common.Source"}}</label>
            {{> systems/wh40k-rpg/templates/item/partial/source-reference-field.hbs source=item.system.source editable=editable}}
        </div>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{! Description Panel }}
        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-align-left" labelKey="WH40K.Tabs.Description"}}
        <textarea
            class="tw-w-full tw-border tw-border-solid tw-border-black/20 tw-rounded-md tw-p-2 tw-text-sm tw-font-body tw-resize-y tw-min-h-[80px]"
            name="system.description.value"
            placeholder="{{localize 'WH40K.ItemSheet.WeaponMod.DescriptionPlaceholder'}}"
        >{{item.system.description.value}}</textarea>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
    </div>
</div>