<div class="wh40k-item-sheet ship-upgrade tw-flex tw-flex-col tw-h-full tw-overflow-hidden tw-bg-[var(--wh40k-sheet-bg)] tw-text-[var(--wh40k-text-dark)]">
    <div autocomplete="off" class="tw-flex tw-flex-col tw-flex-1 tw-min-h-0 tw-overflow-hidden">
        {{!-- Item Header (canonical partial) --}}
        {{> systems/wh40k-rpg/templates/item/panel/item-header.hbs
            namePlaceholderKey="WH40K.ItemSheet.NamePlaceholder.ShipUpgrade"
            typeLabelKey="TYPES.Item.shipUpgrade"
            typeIcon="fa-level-up-alt"}}

        {{> systems/wh40k-rpg/templates/item/partial/item-tab-strip.hbs tabs=(array
            (object tab="details" label=(localize "WH40K.Item.Tabs.Details") icon="fa-info-circle" active=true)
            (object tab="effects" label=(localize "WH40K.Item.Tabs.Effects") icon="fa-magic"))}}

        <!-- Tab Content -->
        {{!-- `wh40k-tab-content` is what the item sheet's tab binder looks for: without it
              the tab buttons were never bound and Effects could not be opened. --}}
        <section class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-[var(--wh40k-space-md)]">
            <!-- Details Tab -->
            <div class="tab active" data-tab="details" data-group="primary">
                <!-- Basic Properties -->
                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-level-up-alt" labelKey="WH40K.ItemSheet.Ship.UpgradeProperties"}}
                        <label class="tw-flex tw-w-[12rem] tw-max-w-full tw-flex-col tw-gap-1">
                            <span class="tw-text-[0.7rem] tw-font-semibold tw-uppercase tw-tracking-[0.03em] {{themeClassFor 'accent'}}">{{localize "WH40K.Availability.Label"}}</span>
                            <select name="system.availability">
                                {{selectOptions availabilities selected=source.availability}}
                            </select>
                        </label>
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                <!-- Resource Requirements -->
                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-battery-half" labelKey="WH40K.ItemSheet.Ship.ResourceRequirements"}}
                        {{> systems/wh40k-rpg/templates/item/partial/number-tile-grid.hbs fields=(array
                            (object label=(localize "WH40K.ShipComponent.Power") name="system.power" value=source.power)
                            (object label=(localize "WH40K.ShipComponent.Space") name="system.space" value=source.space)
                            (object label=(localize "WH40K.ItemSheet.Ship.ShipPoints") name="system.shipPoints" value=source.shipPoints))}}
                        <p class="hint">{{localize "WH40K.ItemSheet.Ship.NegativePower"}}</p>
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                <!-- Stat Modifiers -->
                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-chart-line" labelKey="WH40K.ItemSheet.Ship.StatModifiers"}}
                        {{> systems/wh40k-rpg/templates/item/partial/ship-stat-modifier-tiles.hbs}}
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-magic" labelKey="WH40K.Tabs.Effect"}}
                        {{#if inEditMode}}
                          {{editor system.effect target="system.effect" button=true editable=editable engine="prosemirror"}}
                        {{else}}
                          <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.effect}}}</div>
                        {{/if}}
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sticky-note" labelKey="WH40K.ItemSheet.Common.GmNotes"}}
                        <textarea name="system.notes" rows="3" class="tw-w-full tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-resize-y">{{system.notes}}</textarea>
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

                {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-scroll" labelKey="WH40K.Tabs.Description"}}
                        {{#if inEditMode}}
                          {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
                        {{else}}
                          <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.description.value}}}</div>
                        {{/if}}
                {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
              {{> systems/wh40k-rpg/templates/item/partial/schema-sections.hbs sections=schemaSections}}
            </div>

            <!-- Effects Tab -->
            <div class="tab" data-tab="effects" data-group="primary">
                {{> systems/wh40k-rpg/templates/item/panel/active-effects-panel.hbs}}
            </div>
        </section>
    </div>
</div>
