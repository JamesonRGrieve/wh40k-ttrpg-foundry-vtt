{{! Journal Entry Item Sheet }}
<div class="tw-flex tw-flex-col tw-h-full tw-overflow-hidden tw-bg-[var(--wh40k-sheet-bg)] tw-text-[var(--wh40k-text-dark)]" autocomplete="off">
    {{! Header }}
    <header class="tw-flex tw-items-center tw-gap-3 tw-p-3 tw-shrink-0">
        <div class="tw-flex tw-items-center tw-justify-center tw-w-12 tw-h-12 tw-shrink-0 tw-rounded-md">
            <span class="material-icons tw-text-gold {{themeClassFor 'accent'}} tw-text-2xl">auto_stories</span>
        </div>
        <div class="tw-flex tw-flex-col tw-gap-1 tw-min-w-0 tw-flex-1">
            {{> systems/wh40k-rpg/templates/item/partial/item-name-input.hbs placeholderKey="WH40K.ItemSheet.NamePlaceholder.JournalEntry"}}
            <div class="tw-inline-flex tw-items-center tw-gap-1 tw-text-xs tw-uppercase tw-tracking-wide tw-opacity-70">
                <span class="material-icons tw-text-sm">menu_book</span>
                <span>{{localize "WH40K.ItemSheet.JournalEntry.Title"}}</span>
            </div>
        </div>
    </header>

    <div class="tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-3">
        {{! Entry Details Panel }}
        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-calendar-day" labelKey="WH40K.ItemSheet.JournalEntry.EntryDetails"}}
        <div class="tw-grid tw-grid-cols-2 tw-gap-3">
            <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-xs tw-uppercase tw-tracking-wide tw-opacity-70">{{localize "WH40K.ItemSheet.JournalEntry.Date"}}</label>
                <input class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" name="system.time" type="date" value="{{item.system.time}}" />
            </div>
            <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-xs tw-uppercase tw-tracking-wide tw-opacity-70">{{localize "WH40K.ItemSheet.JournalEntry.Location"}}</label>
                <input class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" name="system.place" type="text" value="{{item.system.place}}" placeholder="{{localize 'WH40K.ItemSheet.JournalEntry.PlacePlaceholder'}}" />
            </div>
        </div>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{! Entry Content Panel }}
        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-pen-to-square" labelKey="WH40K.ItemSheet.JournalEntry.Entry"}}
        <textarea
            class="tw-w-full tw-min-h-[240px] tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-resize-y"
            name="system.description.value"
            placeholder="{{localize 'WH40K.ItemSheet.JournalEntry.EntryPlaceholder'}}"
        >{{item.system.description.value}}</textarea>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
    </div>
</div>
