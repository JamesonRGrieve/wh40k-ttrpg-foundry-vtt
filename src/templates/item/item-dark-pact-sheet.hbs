{{!--
  Dark Pact item sheet (Enemies Beyond pp. 72–76, #84).

  Context (DarkPactSheet → darkPactSheetView):
    - pact.terms  : { corruptionFormula, dispositionBase, addsCorruption, testModifier }
    - pact.boons  : PactEntryView[]  — { identifier, name, description, mechanics[], narrative }
    - pact.banes  : PactEntryView[]
  The content is authored in the compendium; the sheet shows it. Name and
  description edit through the shared freeform gate.
--}}
<div class="tw-flex tw-flex-col tw-h-full">
  <div class="tw-flex tw-flex-col tw-flex-1 tw-min-h-0">

    <header class="tw-flex tw-items-center tw-gap-3 tw-p-3 tw-shrink-0">
      {{> systems/wh40k-rpg/templates/shared/editable-portrait.hbs src=item.img alt=item.name sizeClass="tw-w-16 tw-h-16" extraClass="tw-shrink-0"}}
      <div class="tw-flex tw-flex-col tw-gap-1 tw-min-w-0 tw-flex-1">
        {{#if inEditMode}}
        {{> systems/wh40k-rpg/templates/item/partial/item-name-input.hbs placeholderKey="WH40K.DarkPact.NamePlaceholder"}}
        {{else}}
        <h1 class="tw-font-display tw-text-xl tw-m-0 tw-text-gold {{themeClassFor 'accent'}} tw-p-1">{{item.name}}</h1>
        {{/if}}
        <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-opacity-70">{{localize "TYPES.Item.darkPact"}}</span>
      </div>
      {{#if canEdit}}
      <div class="tw-flex tw-gap-1 tw-shrink-0">
        {{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-pen-to-square" activeIcon="fa-lock-open" isActive=inEditMode titleKey="WH40K.OriginPath.ToggleEditMode"}}
      </div>
      {{/if}}
    </header>

    <section class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-2">

      {{!-- The terms of striking the pact --}}
      {{#> systems/wh40k-rpg/templates/item/partial/content-block-section.hbs icon="fa-handshake" labelKey="WH40K.DarkPact.Terms" show=true}}
        <dl data-dark-pact-terms class="tw-grid tw-grid-cols-[auto_1fr] tw-gap-x-3 tw-gap-y-1 tw-m-0 tw-text-sm">
          <dt class="tw-font-semibold">{{localize "WH40K.DarkPact.CorruptionGained"}}</dt>
          <dd class="tw-m-0" data-dark-pact-term="corruption">{{pact.terms.corruptionFormula}}</dd>
          <dt class="tw-font-semibold">{{localize "WH40K.DarkPact.StartingDisposition"}}</dt>
          <dd class="tw-m-0" data-dark-pact-term="disposition">
            {{#if pact.terms.addsCorruption}}{{localize "WH40K.DarkPact.DispositionPlusCorruption" base=pact.terms.dispositionBase}}{{else}}{{pact.terms.dispositionBase}}{{/if}}
          </dd>
          <dt class="tw-font-semibold">{{localize "WH40K.DarkPact.BargainingTests"}}</dt>
          <dd class="tw-m-0" data-dark-pact-term="test">{{pact.terms.testModifier}}</dd>
        </dl>
      {{/systems/wh40k-rpg/templates/item/partial/content-block-section.hbs}}

      {{#> systems/wh40k-rpg/templates/item/partial/content-block-section.hbs icon="fa-book" labelKey="WH40K.Item.Tabs.Description" show=(or inEditMode (hasText system.description.value))}}
        {{#if inEditMode}}
        {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
        {{else}}
        <div class="tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2">{{{system.description.value}}}</div>
        {{/if}}
      {{/systems/wh40k-rpg/templates/item/partial/content-block-section.hbs}}

      {{#> systems/wh40k-rpg/templates/item/partial/content-block-section.hbs icon="fa-gift" labelKey="WH40K.DarkPact.Boons" show=true}}
        {{> systems/wh40k-rpg/templates/item/partial/dark-pact-entries.hbs entries=pact.boons kind="boons"}}
      {{/systems/wh40k-rpg/templates/item/partial/content-block-section.hbs}}

      {{#> systems/wh40k-rpg/templates/item/partial/content-block-section.hbs icon="fa-skull" labelKey="WH40K.DarkPact.Banes" show=true}}
        {{> systems/wh40k-rpg/templates/item/partial/dark-pact-entries.hbs entries=pact.banes kind="banes"}}
      {{/systems/wh40k-rpg/templates/item/partial/content-block-section.hbs}}

    </section>
  </div>
</div>
