{{!--
  Rogue Trader Condition Item Sheet - V2 Redesign
  Matches weapon/armour sheet patterns with modern ApplicationV2 structure
--}}
<div class="tw-flex tw-flex-col tw-h-full">
  <div autocomplete="off" class="tw-flex tw-flex-col tw-flex-1 tw-min-h-0">

    {{!-- ═══════════════════════════════════════════════════════════════════
         HEADER: Compact condition identity with inline stats
    ═══════════════════════════════════════════════════════════════════ --}}
    <header class="tw-flex tw-items-center tw-gap-3 tw-p-3 tw-shrink-0">
      {{> systems/wh40k-rpg/templates/shared/editable-portrait.hbs src=item.img alt=item.name sizeClass="tw-w-16 tw-h-16" frameClass="" overlayIcon=item.system.natureIcon overlayBgClass="tw-bg-black/60" overlayTextClass="" overlayIconClass="" extraClass="tw-shrink-0"}}

      <div class="tw-flex tw-flex-col tw-gap-1 tw-min-w-0 tw-flex-1">
        {{> systems/wh40k-rpg/templates/item/partial/item-name-input.hbs placeholderKey="WH40K.ItemSheet.Condition.NamePlaceholder"}}

        <div class="tw-flex tw-flex-wrap tw-gap-1 tw-items-center">
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs" title="{{localize 'WH40K.ItemSheet.Condition.NatureTooltip'}}">
            <i class="fas {{item.system.natureIcon}}"></i>
            {{item.system.natureLabel}}
          </span>
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs" title="{{localize 'WH40K.ItemSheet.Condition.AppliesToTooltip'}}">
            <i class="fas {{item.system.appliesToIcon}}"></i>
            {{item.system.appliesToLabel}}
          </span>
          {{#if item.system.stackable}}
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs" title="{{localize 'WH40K.ItemSheet.Condition.StackableTooltip'}}">
            <i class="fas fa-layer-group"></i>
            ×{{item.system.stacks}}
          </span>
          {{/if}}
          {{#if item.system.isTemporary}}
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs" title="{{localize 'WH40K.Gear.Duration'}}">
            <i class="fas fa-clock"></i>
            {{item.system.durationDisplay}}
          </span>
          {{/if}}
        </div>
      </div>
    </header>


    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB NAVIGATION
    ═══════════════════════════════════════════════════════════════════ --}}
    {{> systems/wh40k-rpg/templates/item/partial/item-tab-strip.hbs tabs=(array
        (object tab="details"     label=(localize "WH40K.Tabs.Details")     icon="fa-info-circle" active=true)
        (object tab="description" label=(localize "WH40K.Tabs.Description") icon="fa-book")
        (object tab="effects"     label=(localize "WH40K.Tabs.Effects")     icon="fa-magic"))}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB CONTENT
    ═══════════════════════════════════════════════════════════════════ --}}
    <div class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-2">

      {{!-- DETAILS TAB --}}
      <div class="tab active" data-tab="details" data-group="primary">

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-cog" labelKey="WH40K.ItemSheet.Condition.Properties"}}
            <div class="tw-grid tw-grid-cols-2 tw-gap-3">
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.Condition.Nature"}}</label>
                <select name="system.nature" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
                  <option value="beneficial" {{#if (eq item.system.nature "beneficial")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Beneficial"}}</option>
                  <option value="harmful" {{#if (eq item.system.nature "harmful")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Harmful"}}</option>
                  <option value="neutral" {{#if (eq item.system.nature "neutral")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Neutral"}}</option>
                </select>
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.Condition.AppliesTo"}}</label>
                <select name="system.appliesTo" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
                  <option value="self" {{#if (eq item.system.appliesTo "self")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Self"}}</option>
                  <option value="target" {{#if (eq item.system.appliesTo "target")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Target"}}</option>
                  <option value="both" {{#if (eq item.system.appliesTo "both")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Both"}}</option>
                  <option value="area" {{#if (eq item.system.appliesTo "area")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Area"}}</option>
                </select>
              </div>
            </div>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-layer-group" labelKey="WH40K.ItemSheet.Condition.Stacking"}}
            <div class="tw-flex tw-flex-col tw-gap-1">
              <label class="tw-flex tw-items-center tw-gap-2 tw-cursor-pointer tw-text-sm">
                <input type="checkbox" name="system.stackable" {{checked item.system.stackable}} />
                <span>{{localize "WH40K.ItemSheet.Condition.IsStackable"}}</span>
              </label>
            </div>
            {{#if item.system.stackable}}
            <div class="tw-flex tw-flex-col tw-gap-1 tw-mt-2">
              <label class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.Condition.CurrentStacks"}}</label>
              <input type="number" name="system.stacks" value="{{item.system.stacks}}"
                     data-dtype="Number" min="1" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
            </div>
            {{/if}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-clock" labelKey="WH40K.Gear.Duration"}}
            <div class="tw-grid tw-grid-cols-2 tw-gap-3">
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.Condition.DurationValue"}}</label>
                <input type="number" name="system.duration.value" value="{{item.system.duration.value}}"
                       data-dtype="Number" min="0" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.Condition.DurationUnits"}}</label>
                <select name="system.duration.units" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
                  <option value="permanent" {{#if (eq item.system.duration.units "permanent")}}selected{{/if}}>{{localize "WH40K.CriticalInjury.Permanent"}}</option>
                  <option value="rounds" {{#if (eq item.system.duration.units "rounds")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Rounds"}}</option>
                  <option value="minutes" {{#if (eq item.system.duration.units "minutes")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Minutes"}}</option>
                  <option value="hours" {{#if (eq item.system.duration.units "hours")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Hours"}}</option>
                  <option value="days" {{#if (eq item.system.duration.units "days")}}selected{{/if}}>{{localize "WH40K.ItemSheet.Condition.Days"}}</option>
                </select>
              </div>
            </div>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-bolt" labelKey="WH40K.ItemSheet.Condition.Effect"}}
            {{#if inEditMode}}
            {{editor system.effect target="system.effect" button=true editable=editable engine="prosemirror"}}
            {{else}}
            <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.effect}}}</div>
            {{/if}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-eraser" labelKey="WH40K.ItemSheet.Condition.RemovalConditions"}}
            {{#if inEditMode}}
            {{editor system.removal target="system.removal" button=true editable=editable engine="prosemirror"}}
            {{else}}
            <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.removal}}}</div>
            {{/if}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sticky-note" labelKey="WH40K.ItemSheet.Common.GmNotes"}}
            <textarea name="system.notes" rows="3" placeholder="{{localize 'WH40K.ItemSheet.Condition.NotesPlaceholder'}}" class="tw-w-full tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-resize-y">{{item.system.notes}}</textarea>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

      </div>

      {{!-- DESCRIPTION TAB --}}
      <div class="tab" data-tab="description" data-group="primary">

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book" labelKey="WH40K.Tabs.Description"}}
            {{#if inEditMode}}
            {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
            {{else}}
            <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.description.value}}}</div>
            {{/if}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-book-open" labelKey="WH40K.Common.Source"}}
            <div class="tw-grid tw-grid-cols-3 tw-gap-3">
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.NPC.SourceBook"}}</label>
                <input type="text" name="system.source.book" value="{{source.source.book}}"
                       placeholder="{{localize 'WH40K.ItemSheet.Common.SourceBookPlaceholder'}}" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.Source.Page"}}</label>
                <input type="text" name="system.source.page" value="{{source.source.page}}"
                       placeholder="249" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1">
                <label class="tw-text-sm tw-font-medium">{{localize "WH40K.ItemSheet.Common.CustomReference"}}</label>
                <input type="text" name="system.source.url" value="{{source.source.url}}"
                       placeholder="{{localize 'WH40K.ItemSheet.Common.CustomReferencePlaceholder'}}" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              </div>
            </div>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

      </div>

      {{!-- EFFECTS TAB --}}
      <div class="tab" data-tab="effects" data-group="primary">
        {{> systems/wh40k-rpg/templates/item/panel/active-effects-panel.hbs}}
      </div>

    </div>

  </div>
</div>
