{{!--
  Rogue Trader Origin Path Item Sheet - Modern Tabbed Redesign
  Character creation lifepath configuration with tabbed interface
--}}
<div class="tw-flex tw-flex-col tw-h-full">
  <form autocomplete="off" class="tw-flex tw-flex-col tw-flex-1 tw-min-h-0">

    {{!-- ═══════════════════════════════════════════════════════════════════
         HEADER: Compact identity with step badge
    ═══════════════════════════════════════════════════════════════════ --}}
    {{#> systems/wh40k-rpg/templates/item/panel/item-header.hbs namePlaceholderKey="WH40K.ItemSheet.NamePlaceholder.OriginPath" hideTypeBadge=true }}
      <div class="tw-flex tw-flex-col tw-gap-1">
        <div class="tw-flex tw-flex-wrap tw-gap-1 tw-items-center">
          {{!-- Step Badge --}}
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs" title="{{item.system.stepLabel}}">
            <i class="fas fa-map-signs"></i>
            {{item.system.stepLabel}}
          </span>

          {{!-- Step Index Badge --}}
          <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs" title="{{localize 'WH40K.ItemSheet.OriginPath.OrderTooltip'}}">
            <i class="fas fa-sort-numeric-up"></i>
            {{localize "WH40K.ItemSheet.OriginPath.StepNumber" number=(add item.system.stepIndex 1)}}
          </span>
        </div>

        {{!-- Step Configuration --}}
        <div class="tw-flex tw-gap-2 tw-mt-1">
          <div class="tw-flex tw-flex-col tw-gap-1 tw-flex-1">
            <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.ItemSheet.OriginPath.StepType"}}</label>
            <select name="system.step" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
              <option value="homeWorld" {{#if (eq item.system.step "homeWorld")}}selected{{/if}}>{{localize "WH40K.OriginPath.StepHomeWorld"}}</option>
              <option value="birthright" {{#if (eq item.system.step "birthright")}}selected{{/if}}>{{localize "WH40K.OriginPath.StepBirthright"}}</option>
              <option value="lureOfTheVoid" {{#if (eq item.system.step "lureOfTheVoid")}}selected{{/if}}>{{localize "WH40K.OriginPath.StepLureOfTheVoid"}}</option>
              <option value="trialsAndTravails" {{#if (eq item.system.step "trialsAndTravails")}}selected{{/if}}>{{localize "WH40K.OriginPath.StepTrialsAndTravails"}}</option>
              <option value="motivation" {{#if (eq item.system.step "motivation")}}selected{{/if}}>{{localize "WH40K.OriginPath.StepMotivation"}}</option>
              <option value="career" {{#if (eq item.system.step "career")}}selected{{/if}}>{{localize "WH40K.OriginPath.StepCareer"}}</option>
              <option value="lineage" {{#if (eq item.system.step "lineage")}}selected{{/if}}>{{localize "WH40K.OriginPath.Lineage"}}</option>
              <option value="eliteAdvance" {{#if (eq item.system.step "eliteAdvance")}}selected{{/if}}>{{localize "WH40K.OriginPath.Elite"}}</option>
            </select>
          </div>

          <div class="tw-flex tw-flex-col tw-gap-1 tw-w-20">
            <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.ItemSheet.OriginPath.StepIndex"}}</label>
            <input type="number" name="system.stepIndex" value="{{item.system.stepIndex}}" min="0" max="8" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
          </div>
        </div>
      </div>
    {{/systems/wh40k-rpg/templates/item/panel/item-header.hbs}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         EDIT-MODE TOGGLE
    ═══════════════════════════════════════════════════════════════════ --}}
    <div class="tw-flex tw-shrink-0 tw-items-center tw-justify-end tw-gap-2 tw-px-3 tw-py-1">
      {{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs
          action="toggleEditMode"
          icon="fa-pen-to-square"
          activeIcon="fa-lock-open"
          isActive=inEditMode
          titleKey="WH40K.OriginPath.ToggleEditMode"}}
    </div>

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB NAVIGATION
    ═══════════════════════════════════════════════════════════════════ --}}
    {{> systems/wh40k-rpg/templates/item/partial/item-accent-tab-strip.hbs category="dynasty" tabs=(array
        (object tab="grants"       label=(localize "WH40K.Talent.Grants")       icon="fa-gift"            active=true)
        (object tab="requirements" label=(localize "WH40K.Tabs.Requirements") icon="fa-lock"            active=false)
        (object tab="choices"      label=(localize "WH40K.ItemSheet.OriginPath.Choices")      icon="fa-question-circle" active=false)
        (object tab="description"  label=(localize "WH40K.Tabs.Description")  icon="fa-book"            active=false))}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB CONTENT
    ═══════════════════════════════════════════════════════════════════ --}}
    <section class="tw-flex-1 tw-overflow-y-auto tw-overflow-x-hidden tw-min-h-0 tw-p-2">

      {{!-- GRANTS TAB --}}
      <div class="active tw-block" data-tab="grants" data-group="primary">

        {{!-- Characteristic Modifiers --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-dumbbell tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.CharacteristicModifiers"}}
          </h3>

          <div class="tw-grid tw-grid-cols-[repeat(9,1fr)] tw-gap-1">
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.WeaponSkill"}}</label>
              <input type="number" name="system.modifiers.characteristics.weaponSkill" value="{{item.system.modifiers.characteristics.weaponSkill}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.BallisticSkill"}}</label>
              <input type="number" name="system.modifiers.characteristics.ballisticSkill" value="{{item.system.modifiers.characteristics.ballisticSkill}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Strength"}}</label>
              <input type="number" name="system.modifiers.characteristics.strength" value="{{item.system.modifiers.characteristics.strength}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Toughness"}}</label>
              <input type="number" name="system.modifiers.characteristics.toughness" value="{{item.system.modifiers.characteristics.toughness}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Agility"}}</label>
              <input type="number" name="system.modifiers.characteristics.agility" value="{{item.system.modifiers.characteristics.agility}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Intelligence"}}</label>
              <input type="number" name="system.modifiers.characteristics.intelligence" value="{{item.system.modifiers.characteristics.intelligence}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Perception"}}</label>
              <input type="number" name="system.modifiers.characteristics.perception" value="{{item.system.modifiers.characteristics.perception}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Willpower"}}</label>
              <input type="number" name="system.modifiers.characteristics.willpower" value="{{item.system.modifiers.characteristics.willpower}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
            <div class="tw-flex tw-flex-col tw-items-center tw-gap-0.5">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Characteristic.Abbr.Fellowship"}}</label>
              <input type="number" name="system.modifiers.characteristics.fellowship" value="{{item.system.modifiers.characteristics.fellowship}}" class="tw-w-full tw-px-1 tw-py-0.5 tw-rounded-sm tw-text-xs tw-text-center" placeholder="0" />
            </div>
          </div>
        </div>

        {{!-- Other Bonuses --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-heart tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.OtherBonuses"}}
          </h3>

          <div class="tw-flex tw-flex-wrap tw-gap-3">
            <div class="tw-flex tw-flex-col tw-gap-1">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Wounds"}}</label>
              <input type="number" name="system.grants.wounds" value="{{item.system.grants.wounds}}" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-w-20" placeholder="0" />
            </div>

            <div class="tw-flex tw-flex-col tw-gap-1">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.ItemSheet.OriginPath.FateThreshold"}}</label>
              <input type="number" name="system.grants.fateThreshold" value="{{item.system.grants.fateThreshold}}" min="0" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-w-20" placeholder="0" />
            </div>

            <div class="tw-flex tw-flex-col tw-justify-end">
              <label class="tw-flex tw-items-center tw-gap-2 tw-cursor-pointer tw-text-sm">
                <input type="checkbox" name="system.grants.blessedByEmperor" {{checked item.system.grants.blessedByEmperor}} />
                <span>{{localize "WH40K.ItemSheet.OriginPath.BlessedByEmperor"}}</span>
              </label>
            </div>
          </div>
        </div>

        {{!-- Skills Granted --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-graduation-cap tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.SkillsGranted"}}
          </h3>

          {{#if inEditMode}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.skills as |skill index|}}
            <div class="tw-flex tw-items-center tw-gap-2" data-index="{{index}}">
              <input type="text" name="system.grants.skills.{{index}}.name" value="{{skill.name}}" placeholder="{{localize 'WH40K.OriginPath.NamePlaceholder'}}" class="tw-flex-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <input type="text" name="system.grants.skills.{{index}}.specialization" value="{{skill.specialization}}" placeholder="{{localize 'WH40K.OriginPath.SpecializationPlaceholder'}}" class="tw-flex-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <select name="system.grants.skills.{{index}}.level" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
                <option value="known" {{#if (eq skill.level "known")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.known"}}</option>
                <option value="trained" {{#if (eq skill.level "trained")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.trained"}}</option>
                <option value="plus10" {{#if (eq skill.level "plus10")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.plus10"}}</option>
                <option value="experienced" {{#if (eq skill.level "experienced")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.experienced"}}</option>
                <option value="plus20" {{#if (eq skill.level "plus20")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.plus20"}}</option>
                <option value="veteran" {{#if (eq skill.level "veteran")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.veteran"}}</option>
                <option value="plus30" {{#if (eq skill.level "plus30")}}selected{{/if}}>{{localize "WH40K.OriginPath.SkillLevel.plus30"}}</option>
              </select>
              <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-cursor-pointer" data-action="removeGrant" data-grant="skills" data-index="{{index}}" title="{{localize 'WH40K.OriginPath.Remove'}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-mt-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-self-start" data-action="addGrant" data-grant="skills"><i class="fas fa-plus"></i> {{localize "WH40K.OriginPath.AddSkill"}}</button>
          </div>
          {{else if item.system.grants.skills.length}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.skills as |skill index|}}
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
              <div class="tw-flex tw-items-center tw-gap-1 tw-flex-1">
                <span class="tw-font-medium">{{skill.name}}</span>
                {{#if skill.specialization}}
                <span class="tw-opacity-70">({{skill.specialization}})</span>
                {{/if}}
              </div>
              <span class="tw-inline-flex tw-items-center tw-px-1.5 tw-py-0.5 tw-rounded-sm tw-text-xs tw-font-semibold">
                {{#if (eq skill.level "trained")}}T{{/if}}
                {{#if (eq skill.level "plus10")}}+10{{/if}}
                {{#if (eq skill.level "plus20")}}+20{{/if}}
              </span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="tw-flex tw-items-center tw-gap-2 tw-p-3 tw-text-sm tw-italic tw-rounded-md">
            <i class="fas fa-graduation-cap tw-opacity-40"></i>
            <p class="tw-m-0">{{localize "WH40K.ItemSheet.OriginPath.NoSkills"}}</p>
          </div>
          {{/if}}
        </div>

        {{!-- Talents Granted --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-star tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.TalentsGranted"}}
          </h3>

          {{#if inEditMode}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.talents as |talent index|}}
            <div class="tw-flex tw-items-center tw-gap-2" data-index="{{index}}">
              <input type="text" name="system.grants.talents.{{index}}.name" value="{{talent.name}}" placeholder="{{localize 'WH40K.OriginPath.NamePlaceholder'}}" class="tw-flex-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <input type="text" name="system.grants.talents.{{index}}.specialization" value="{{talent.specialization}}" placeholder="{{localize 'WH40K.OriginPath.SpecializationPlaceholder'}}" class="tw-flex-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-cursor-pointer" data-action="removeGrant" data-grant="talents" data-index="{{index}}" title="{{localize 'WH40K.OriginPath.Remove'}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-mt-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-self-start" data-action="addGrant" data-grant="talents"><i class="fas fa-plus"></i> {{localize "WH40K.OriginPath.AddTalent"}}</button>
          </div>
          {{else if item.system.grants.talents.length}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.talents as |talent index|}}
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
              <div class="tw-flex tw-items-center tw-gap-1 tw-flex-1">
                <span class="tw-font-medium">{{talent.name}}</span>
                {{#if talent.specialization}}
                <span class="tw-opacity-70">({{talent.specialization}})</span>
                {{/if}}
              </div>
              <i class="fas fa-star tw-text-gold {{themeClassFor 'accent'}} tw-opacity-70"></i>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="tw-flex tw-items-center tw-gap-2 tw-p-3 tw-text-sm tw-italic tw-rounded-md">
            <i class="fas fa-star tw-opacity-40"></i>
            <p class="tw-m-0">{{localize "WH40K.ItemSheet.OriginPath.NoTalents"}}</p>
          </div>
          {{/if}}
        </div>

        {{!-- Traits Granted --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-shield-alt tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.TraitsGranted"}}
          </h3>

          {{#if inEditMode}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.traits as |trait index|}}
            <div class="tw-flex tw-items-center tw-gap-2" data-index="{{index}}">
              <input type="text" name="system.grants.traits.{{index}}.name" value="{{trait.name}}" placeholder="{{localize 'WH40K.OriginPath.NamePlaceholder'}}" class="tw-flex-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <input type="number" name="system.grants.traits.{{index}}.level" value="{{trait.level}}" placeholder="{{localize 'WH40K.OriginPath.TraitLevelPlaceholder'}}" class="tw-w-20 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-cursor-pointer" data-action="removeGrant" data-grant="traits" data-index="{{index}}" title="{{localize 'WH40K.OriginPath.Remove'}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-mt-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-self-start" data-action="addGrant" data-grant="traits"><i class="fas fa-plus"></i> {{localize "WH40K.OriginPath.AddTrait"}}</button>
          </div>
          {{else if item.system.grants.traits.length}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.traits as |trait index|}}
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
              <div class="tw-flex tw-items-center tw-gap-1 tw-flex-1">
                <span class="tw-font-medium">{{trait.name}}</span>
                {{#if trait.level}}
                <span class="tw-opacity-70">({{trait.level}})</span>
                {{/if}}
              </div>
              <i class="fas fa-shield-alt tw-text-gold {{themeClassFor 'accent'}} tw-opacity-70"></i>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="tw-flex tw-items-center tw-gap-2 tw-p-3 tw-text-sm tw-italic tw-rounded-md">
            <i class="fas fa-shield-alt tw-opacity-40"></i>
            <p class="tw-m-0">{{localize "WH40K.ItemSheet.OriginPath.NoTraits"}}</p>
          </div>
          {{/if}}
        </div>

        {{!-- Aptitudes Granted --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-brain tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.AptitudesGranted"}}
          </h3>

          {{#if item.system.grants.aptitudes.length}}
          <div class="tw-flex tw-flex-wrap tw-gap-1">
            {{#each item.system.grants.aptitudes as |apt|}}
            <span class="tw-inline-flex tw-items-center tw-px-2.5 tw-py-1 tw-bg-[linear-gradient(135deg,rgba(212,175,55,0.15),rgba(212,175,55,0.05))] tw-border tw-border-[rgba(212,175,55,0.3)] tw-rounded-sm tw-text-xs tw-font-semibold tw-text-gold">{{apt}}</span>
            {{/each}}
          </div>
          {{else}}
          <div class="tw-flex tw-items-center tw-gap-2 tw-p-3 tw-text-sm tw-italic tw-rounded-md">
            <i class="fas fa-brain tw-opacity-40"></i>
            <p class="tw-m-0">{{localize "WH40K.ItemSheet.OriginPath.NoAptitudes"}}</p>
          </div>
          {{/if}}
        </div>

        {{!-- Equipment Granted --}}
        {{#if (or inEditMode item.system.grants.equipment.length)}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-toolbox tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.EquipmentGranted"}}
          </h3>

          {{#if inEditMode}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.equipment as |equip index|}}
            <div class="tw-flex tw-items-center tw-gap-2" data-index="{{index}}">
              <input type="text" name="system.grants.equipment.{{index}}.name" value="{{equip.name}}" placeholder="{{localize 'WH40K.OriginPath.NamePlaceholder'}}" class="tw-flex-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <input type="number" name="system.grants.equipment.{{index}}.quantity" value="{{equip.quantity}}" min="1" placeholder="{{localize 'WH40K.OriginPath.QuantityPlaceholder'}}" class="tw-w-20 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" />
              <button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-bg-transparent tw-border-0 tw-text-[color:var(--wh40k-accent-combat)] tw-cursor-pointer" data-action="removeGrant" data-grant="equipment" data-index="{{index}}" title="{{localize 'WH40K.OriginPath.Remove'}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-mt-1 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-self-start" data-action="addGrant" data-grant="equipment"><i class="fas fa-plus"></i> {{localize "WH40K.OriginPath.AddEquipment"}}</button>
          </div>
          {{else}}
          <div class="tw-flex tw-flex-col tw-gap-1">
            {{#each item.system.grants.equipment as |equip index|}}
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm">
              <div class="tw-flex tw-items-center tw-gap-1 tw-flex-1">
                <span class="tw-font-medium">{{equip.name}}</span>
                {{#if (gt equip.quantity 1)}}
                <span class="tw-opacity-70">×{{equip.quantity}}</span>
                {{/if}}
              </div>
              <i class="fas fa-toolbox tw-text-gold {{themeClassFor 'accent'}} tw-opacity-70"></i>
            </div>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}

        {{!-- Special Abilities --}}
        {{#if item.system.grants.specialAbilities.length}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-bolt tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.SpecialAbilities"}}
          </h3>

          {{#each item.system.grants.specialAbilities as |ability index|}}
          <div class="tw-mb-2 tw-p-2 tw-rounded-md">
            <h4 class="tw-m-0 tw-mb-1 tw-text-sm tw-font-semibold tw-text-gold {{themeClassFor 'accent'}}">{{ability.name}}</h4>
            <div class="tw-text-sm tw-opacity-80">
              {{{ability.description}}}
            </div>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

      {{!-- REQUIREMENTS TAB --}}
      <div class="tw-hidden" data-tab="requirements" data-group="primary">
        {{#if item.system.hasRequirements}}
          {{!-- Text Requirements --}}
          {{#if item.system.requirements.text}}
          <div class="tw-mb-3">
            <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
              <i class="fas fa-file-alt tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.ItemSheet.OriginPath.TextDescription"}}
            </h3>

            <div class="tw-flex tw-flex-col tw-gap-1">
              <label class="tw-text-xs tw-opacity-70">{{localize "WH40K.Tabs.Requirements"}}</label>
              <textarea name="system.requirements.text" rows="3" class="tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-resize-y" placeholder="{{localize 'WH40K.ItemSheet.OriginPath.RequirementsPlaceholder'}}">{{item.system.requirements.text}}</textarea>
            </div>

            <div class="tw-mt-2 tw-text-sm tw-p-2 tw-rounded-sm">
              <p class="tw-m-0">{{item.system.requirements.text}}</p>
            </div>
          </div>
          {{/if}}

          {{!-- Previous Steps Required --}}
          {{#if item.system.requirements.previousSteps.length}}
          <div class="tw-mb-3">
            <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
              <i class="fas fa-check-circle tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.ItemSheet.OriginPath.RequiredPreviousSteps"}}
            </h3>

            <div class="tw-flex tw-flex-col tw-gap-1">
              <p class="tw-m-0 tw-mb-1 tw-text-xs tw-italic tw-opacity-70">{{localize "WH40K.ItemSheet.OriginPath.MustHaveOne"}}</p>
              {{#each item.system.requirements.previousSteps as |step|}}
              <div class="tw-inline-flex tw-items-center tw-gap-2 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-text-success">
                <i class="fas fa-check"></i>
                {{step}}
              </div>
              {{/each}}
            </div>
          </div>
          {{/if}}

          {{!-- Excluded Steps --}}
          {{#if item.system.requirements.excludedSteps.length}}
          <div class="tw-mb-3">
            <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
              <i class="fas fa-ban tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.ItemSheet.OriginPath.ExcludedSteps"}}
            </h3>

            <div class="tw-flex tw-flex-col tw-gap-1">
              <p class="tw-m-0 tw-mb-1 tw-text-xs tw-italic tw-opacity-70">{{localize "WH40K.ItemSheet.OriginPath.CannotHaveAny"}}</p>
              {{#each item.system.requirements.excludedSteps as |step|}}
              <div class="tw-inline-flex tw-items-center tw-gap-2 tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-text-crimson">
                <i class="fas fa-times"></i>
                {{step}}
              </div>
              {{/each}}
            </div>
          </div>
          {{/if}}
        {{else}}
        <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-p-6 tw-text-center tw-italic tw-rounded-md">
          <i class="fas fa-unlock tw-opacity-40 tw-text-3xl tw-mb-2"></i>
          <p class="tw-m-0 tw-text-sm">{{localize "WH40K.ItemSheet.OriginPath.NoRequirements"}}</p>
          <p class="tw-m-0 tw-text-xs tw-opacity-70 tw-mt-1">{{localize "WH40K.ItemSheet.OriginPath.AvailableToAll"}}</p>
        </div>
        {{/if}}
      </div>

      {{!-- CHOICES TAB --}}
      <div class="tw-hidden" data-tab="choices" data-group="primary">
        {{#if item.system.grants.choices.length}}
          {{#each item.system.grants.choices as |choice index|}}
          <div class="tw-mb-3">
            <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
              <i class="fas fa-random tw-text-gold {{themeClassFor 'accent'}}"></i> {{choice.label}}
            </h3>

            <div class="tw-flex tw-items-center tw-gap-2 tw-mb-2">
              <span class="tw-inline-flex tw-items-center tw-gap-1 tw-px-2 tw-py-0.5 tw-rounded-sm tw-text-xs">
                <i class="fas {{#if (eq choice.type "skill")}}fa-graduation-cap{{else if (eq choice.type "talent")}}fa-star{{else if (eq choice.type "characteristic")}}fa-dumbbell{{else}}fa-toolbox{{/if}}"></i>
                {{capitalize choice.type}}
              </span>
              <span class="tw-text-xs tw-opacity-70">{{localize "WH40K.ItemSheet.OriginPath.ChooseCount" count=choice.count}}</span>
            </div>

            <div class="tw-flex tw-flex-col tw-gap-1">
              {{#each choice.options as |option|}}
              <div class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-px-2 tw-py-0.5">
                <i class="fas fa-circle tw-text-xs tw-opacity-50"></i>
                {{option}}
              </div>
              {{/each}}
            </div>
          </div>
          {{/each}}
        {{else}}
        <div class="tw-flex tw-flex-col tw-items-center tw-justify-center tw-p-6 tw-text-center tw-italic tw-rounded-md">
          <i class="fas fa-question-circle tw-opacity-40 tw-text-3xl tw-mb-2"></i>
          <p class="tw-m-0 tw-text-sm">{{localize "WH40K.ItemSheet.OriginPath.NoChoices"}}</p>
          <p class="tw-m-0 tw-text-xs tw-opacity-70 tw-mt-1">{{localize "WH40K.ItemSheet.OriginPath.AutomaticGrants"}}</p>
        </div>
        {{/if}}
      </div>

      {{!-- DESCRIPTION TAB --}}
      <div class="tw-hidden" data-tab="description" data-group="primary">
        {{!-- Effect Text --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-magic tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.ItemSheet.OriginPath.EffectText"}}
          </h3>

          <p class="tw-m-0 tw-mb-3 tw-text-xs tw-italic tw-opacity-70">
            <i class="fas fa-info-circle"></i> {{localize "WH40K.ItemSheet.OriginPath.EffectTextHint"}}
          </p>

          <div class="tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-md tw-p-2 [&_.editor]:tw-min-h-[150px]">
            {{#if inEditMode}}
            {{editor system.effectText target="system.effectText" button=true editable=editable engine="prosemirror"}}
            {{else}}
            <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.effectText}}}</div>
            {{/if}}
          </div>
        </div>

        {{!-- Description --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-book tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.Tabs.Description"}}
          </h3>

          <p class="tw-m-0 tw-mb-3 tw-text-xs tw-italic tw-opacity-70">
            <i class="fas fa-info-circle"></i> {{localize "WH40K.ItemSheet.OriginPath.DescriptionHint"}}
          </p>

          <div class="tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-md tw-p-2 [&_.editor]:tw-min-h-[150px]">
            {{#if inEditMode}}
            {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
            {{else}}
            <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.description.value}}}</div>
            {{/if}}
          </div>
        </div>

        {{!-- Notes --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-sticky-note tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.Tabs.Notes"}}
          </h3>

          <div class="tw-flex tw-flex-col tw-gap-1.5">
            <textarea name="system.notes" rows="4" class="tw-w-full tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm tw-resize-y" placeholder="{{localize 'WH40K.ItemSheet.OriginPath.NotesPlaceholder'}}">{{item.system.notes}}</textarea>
          </div>
        </div>

        {{!-- Source --}}
        <div class="tw-mb-3">
          <h3 class="tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wide tw-mb-2">
            <i class="fas fa-book-bookmark tw-text-gold {{themeClassFor 'accent'}}"></i> {{localize "WH40K.Common.Source"}}
          </h3>

          <div class="tw-flex tw-flex-col tw-gap-1.5">
            <input type="text" name="system.source" value="{{item.system.source}}" class="tw-w-full tw-px-2 tw-py-1 tw-rounded-sm tw-text-sm" placeholder="{{localize 'WH40K.ItemSheet.OriginPath.SourcePlaceholder'}}" />
          </div>
        </div>
      </div>

    </section>

    {{!-- ═══════════════════════════════════════════════════════════════════
         PERSISTENCE FOOTNOTE
    ═══════════════════════════════════════════════════════════════════ --}}
    {{#if inEditMode}}
    <footer class="tw-flex tw-shrink-0 tw-items-start tw-gap-2 tw-px-3 tw-py-2 tw-text-xs tw-italic tw-opacity-80 tw-border-t tw-border-[var(--wh40k-border-color)]">
      <i class="fas fa-circle-info tw-mt-0.5"></i>
      <span>{{localize "WH40K.OriginPath.PersistenceFootnote"}}</span>
    </footer>
    {{/if}}
  </form>
</div>
