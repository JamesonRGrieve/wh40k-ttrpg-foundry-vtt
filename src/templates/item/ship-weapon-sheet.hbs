<div class="wh40k-item-sheet tw-flex tw-flex-col tw-h-full tw-overflow-hidden tw-bg-[var(--wh40k-sheet-bg)] tw-text-[var(--wh40k-text-dark)]">
    <form autocomplete="off" class="tw-flex tw-flex-col tw-flex-1 tw-min-h-0 tw-overflow-hidden">
        {{!-- Item Header (canonical partial) --}}
        {{> systems/wh40k-rpg/templates/item/panel/item-header.hbs
            namePlaceholderKey="WH40K.ItemSheet.NamePlaceholder.ShipWeapon"
            typeLabelKey="TYPES.Item.shipWeapon"
            typeIcon="fa-crosshairs"}}

        <!-- Tab Navigation -->
        {{> systems/wh40k-rpg/templates/item/partial/item-tab-strip.hbs tabs=(array
            (object tab="details" label=(localize "WH40K.Item.Tabs.Details") icon="fa-info-circle" active=true)
            (object tab="effects" label=(localize "WH40K.Item.Tabs.Effects") icon="fa-magic"))}}

        <!-- Tab Content -->
        <section class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-min-h-0">
            <!-- Details Tab -->
            <div class="tab active" data-tab="details" data-group="primary">
                <!-- Weapon Properties -->
                <div class="wh40k-panel tw-mb-3 tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-lg tw-overflow-hidden">
                    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-2 tw-bg-gradient-to-r tw-from-[rgba(212,175,55,0.15)] tw-to-transparent tw-border-b tw-border-[var(--wh40k-border-color-light)]">
                        <h3><i class="fas fa-crosshairs"></i> {{localize "WH40K.ItemSheet.Ship.WeaponProperties"}}</h3>
                    </div>
                    <div class="tw-p-3">
                        <div class="form-group">
                            <label>{{localize "WH40K.ShipWeapon.Type"}}</label>
                            <select name="system.weaponType">
                                {{selectOptions weaponTypes selected=source.weaponType}}
                            </select>
                        </div>

                        <div class="form-group">
                            <label>{{localize "WH40K.ShipLocation"}}</label>
                            <select name="system.location">
                                {{selectOptions locations selected=source.location}}
                            </select>
                        </div>

                        <div class="form-group">
                            <label>{{localize "WH40K.HullType"}}</label>
                            <select name="system.hullType" multiple>
                                {{selectOptions hullTypes selected=source.hullType}}
                            </select>
                            <p class="hint">{{localize "WH40K.ItemSheet.Ship.HullTypeHint"}}</p>
                        </div>

                        <div class="form-group">
                            <label>{{localize "WH40K.Availability.Label"}}</label>
                            <select name="system.availability">
                                {{selectOptions availabilities selected=source.availability}}
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Weapon Stats -->
                <div class="wh40k-panel tw-mb-3 tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-lg tw-overflow-hidden">
                    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-2 tw-bg-gradient-to-r tw-from-[rgba(212,175,55,0.15)] tw-to-transparent tw-border-b tw-border-[var(--wh40k-border-color-light)]">
                        <h3><i class="fas fa-dice-d20"></i> {{localize "WH40K.ItemSheet.Ship.WeaponStatistics"}}</h3>
                    </div>
                    <div class="tw-p-3">
                        <div class="form-row tw-flex tw-gap-2">
                            <div class="form-group">
                                <label>{{localize "WH40K.Characteristic.Strength"}}</label>
                                <input type="number" name="system.strength" value="{{source.strength}}" />
                            </div>
                            <div class="form-group">
                                <label>{{localize "WH40K.Weapon.Damage"}}</label>
                                <input type="text" name="system.damage" value="{{source.damage}}" placeholder="1d10+2" />
                            </div>
                        </div>

                        <div class="form-row tw-flex tw-gap-2">
                            <div class="form-group">
                                <label>{{localize "WH40K.ItemSheet.Ship.CritRating"}}</label>
                                <input type="number" name="system.crit" value="{{source.crit}}" />
                            </div>
                            <div class="form-group">
                                <label>{{localize "WH40K.ItemSheet.Ship.RangeVU"}}</label>
                                <input type="number" name="system.range" value="{{source.range}}" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resource Requirements -->
                <div class="wh40k-panel tw-mb-3 tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-lg tw-overflow-hidden">
                    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-2 tw-bg-gradient-to-r tw-from-[rgba(212,175,55,0.15)] tw-to-transparent tw-border-b tw-border-[var(--wh40k-border-color-light)]">
                        <h3><i class="fas fa-battery-half"></i> {{localize "WH40K.ItemSheet.Ship.ResourceRequirements"}}</h3>
                    </div>
                    <div class="tw-p-3">
                        <div class="form-row tw-flex tw-gap-2">
                            <div class="form-group">
                                <label>{{localize "WH40K.ShipComponent.Power"}}</label>
                                <input type="number" name="system.power" value="{{source.power}}" />
                            </div>
                            <div class="form-group">
                                <label>{{localize "WH40K.ShipComponent.Space"}}</label>
                                <input type="number" name="system.space" value="{{source.space}}" />
                            </div>
                            <div class="form-group">
                                <label>{{localize "WH40K.ItemSheet.Ship.ShipPoints"}}</label>
                                <input type="number" name="system.shipPoints" value="{{source.shipPoints}}" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Special Qualities -->
                <div class="wh40k-panel tw-mb-3 tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-lg tw-overflow-hidden">
                    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-2 tw-bg-gradient-to-r tw-from-[rgba(212,175,55,0.15)] tw-to-transparent tw-border-b tw-border-[var(--wh40k-border-color-light)]">
                        <h3><i class="fas fa-star"></i> {{localize "WH40K.ItemSheet.Ship.SpecialQualities"}}</h3>
                    </div>
                    <div class="tw-p-3">
                        <p class="hint">{{localize "WH40K.ItemSheet.Ship.SpecialQualitiesHint"}}</p>
                        <input type="text" name="system.special" value="{{join system.special ','}}" placeholder="{{localize 'WH40K.ItemSheet.Ship.SpecialPlaceholder'}}" />
                    </div>
                </div>

                <!-- Notes -->
                <div class="wh40k-panel tw-mb-3 tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-lg tw-overflow-hidden">
                    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-2 tw-bg-gradient-to-r tw-from-[rgba(212,175,55,0.15)] tw-to-transparent tw-border-b tw-border-[var(--wh40k-border-color-light)]">
                        <h3><i class="fas fa-sticky-note"></i> {{localize "WH40K.Tabs.Notes"}}</h3>
                    </div>
                    <div class="tw-p-3">
                        <textarea name="system.notes" rows="4">{{system.notes}}</textarea>
                    </div>
                </div>

                <!-- Description -->
                <div class="wh40k-panel tw-mb-3 tw-bg-[var(--wh40k-panel-bg)] tw-border tw-border-[var(--wh40k-border-color-light)] tw-rounded-lg tw-overflow-hidden">
                    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-2 tw-bg-gradient-to-r tw-from-[rgba(212,175,55,0.15)] tw-to-transparent tw-border-b tw-border-[var(--wh40k-border-color-light)]">
                        <h3><i class="fas fa-scroll"></i> {{localize "WH40K.Tabs.Description"}}</h3>
                    </div>
                    <div class="tw-p-3">
                        {{#if inEditMode}}
                          {{editor system.description.value target="system.description.value" button=true editable=editable engine="prosemirror"}}
                        {{else}}
                          <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">{{{system.description.value}}}</div>
                        {{/if}}
                    </div>
                </div>
            </div>

            <!-- Effects Tab -->
            <div class="tab" data-tab="effects" data-group="primary">
                {{> systems/wh40k-rpg/templates/item/panel/active-effects-panel.hbs}}
            </div>
        </section>
    </form>
</div>
