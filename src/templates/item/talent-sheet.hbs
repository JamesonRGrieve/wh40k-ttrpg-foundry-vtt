{{!--
  Rogue Trader Talent Item Sheet V2 - Complete Redesign
  Modern tabbed interface with translucent gothic styling
  Font Awesome 6 Pro icons throughout
--}}
{{!-- Every tab section is the shared item-detail-section panel (#471, #695).
     These fill its title-bar `actions` slot: the Benefit edit toggle, and the
     talent-editor button whose section and label come from the panel call's
     `editorSection` / `editorTitleKey` hash. --}}
{{#*inline "talentBenefitAction"}}
{{#if canEdit}}
{{#unless inEditMode}}
{{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-pen-to-square" titleKey="WH40K.ItemSheet.Talent.EditBenefit"}}
{{else}}
{{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-check" titleKey="WH40K.ItemSheet.Talent.DoneEditing"}}
{{/unless}}
{{/if}}
{{/inline}}
{{#*inline "talentEditorAction"}}
{{#if inEditMode}}
<button type="button" class="tw-inline-flex tw-items-center tw-justify-center tw-w-[22px] tw-h-[22px] tw-p-0 tw-m-0 tw-cursor-pointer tw-rounded-[var(--wh40k-radius-sm)] tw-bg-[rgb(from_var(--wh40k-accent-gold)_r_g_b_/_0.2)] tw-border tw-border-solid tw-border-[rgb(from_var(--wh40k-accent-gold)_r_g_b_/_0.4)] tw-text-[color:var(--wh40k-accent-gold)] hover:tw-bg-[rgb(from_var(--wh40k-accent-gold)_r_g_b_/_0.3)] hover:tw-border-[color:var(--wh40k-accent-gold)] hover:tw-scale-110 active:tw-scale-95" data-action="openTalentEditor" data-section="{{editorSection}}" title="{{localize editorTitleKey}}" aria-label="{{localize editorTitleKey}}">
  <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
</button>
{{/if}}
{{/inline}}
<div class="tw-flex tw-flex-col tw-h-full">

    {{!-- ═══════════════════════════════════════════════════════════════════
         HEADER: Portrait, name, key badges, and quick actions
    ═══════════════════════════════════════════════════════════════════ --}}
    <header class="tw-flex tw-items-start tw-flex-shrink-0 tw-gap-3 tw-p-3 tw-bg-gradient-to-b tw-from-[var(--color-bg-secondary)] tw-to-[var(--color-bg-primary)] tw-border-b-2 tw-border-b-[var(--color-border-secondary)]">
      {{!-- Portrait --}}
      {{> systems/wh40k-rpg/templates/shared/editable-portrait.hbs
          src=item.img
          alt=item.name
          extraClass="tw-flex-shrink-0"
          overlayIcon="fa-camera"}}

      {{!-- Title & Meta --}}
      <div class="tw-flex-1 tw-flex tw-flex-col tw-min-w-0">
        {{#if inEditMode}}
        <input type="text" class="tw-w-full" name="name" value="{{item.name}}" placeholder="{{localize 'WH40K.ItemSheet.NamePlaceholder.Talent'}}" />
        {{else}}
        <h1 class="tw-w-full tw-m-0">{{item.name}}</h1>
        {{/if}}

        {{!-- Quick Badges --}}
        <div class="tw-flex tw-flex-wrap tw-gap-1">
          {{!-- Type Badge --}}
          <span class="wh40k-badge wh40k-badge--type tw-inline-flex tw-items-center tw-gap-1 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-medium tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-border tw-border-transparent tw-whitespace-nowrap">
            <i class="fa-solid {{#if talentData.isPassive}}fa-circle-check{{else}}fa-bolt{{/if}}"></i>
            {{#if talentData.isPassive}}{{localize "WH40K.ItemSheet.Talent.Passive"}}{{else}}{{localize "WH40K.ItemSheet.Talent.Active"}}{{/if}}
          </span>

          {{!-- Tier Badge --}}
          {{#if (gt talentData.tier 0)}}
          <span class="wh40k-badge wh40k-badge--tier wh40k-badge--tier-{{talentData.tier}} tw-inline-flex tw-items-center tw-gap-1 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-medium tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-border tw-border-transparent tw-whitespace-nowrap">
            <i class="fa-solid fa-layer-group"></i>
            {{localize "WH40K.Dialog.Advancement.Tier" tier=talentData.tier}}
          </span>
          {{/if}}

          {{!-- Category Badge --}}
          <span class="wh40k-badge wh40k-badge--category tw-inline-flex tw-items-center tw-gap-1 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-medium tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-border tw-border-transparent tw-whitespace-nowrap">
            <i class="fa-solid fa-tag"></i>
            {{talentData.categoryLabel}}
          </span>

          {{!-- XP Cost Badge --}}
          {{#if (gt talentData.cost 0)}}
          <span class="wh40k-badge tw-inline-flex tw-items-center tw-gap-1 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-medium tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-border tw-border-transparent tw-whitespace-nowrap">
            <i class="fa-solid fa-coins"></i>
            {{talentData.cost}} {{localize "WH40K.Common.XP"}}
          </span>
          {{/if}}

          {{!-- Stackable Badge --}}
          {{#if talentData.stackable}}
          <span class="wh40k-badge tw-inline-flex tw-items-center tw-gap-1 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-medium tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-border tw-border-transparent tw-whitespace-nowrap">
            <i class="fa-solid fa-layer-group"></i>
            {{localize "WH40K.ItemSheet.Talent.RankValue" rank=talentData.rank}}
          </span>
          {{/if}}

          {{!-- Rollable Badge --}}
          {{#if talentData.isRollable}}
          <span class="wh40k-badge tw-inline-flex tw-items-center tw-gap-1 tw-px-2.5 tw-py-0.5 tw-text-xs tw-font-medium tw-rounded-full tw-bg-[rgba(100,100,120,0.3)] tw-border tw-border-transparent tw-whitespace-nowrap">
            <i class="fa-solid fa-dice-d20"></i>
            {{localize "WH40K.ItemSheet.Talent.Rollable"}}
          </span>
          {{/if}}
        </div>
      </div>

      {{!-- Action Buttons --}}
      <div class="tw-flex tw-gap-[6px] tw-flex-shrink-0">
        {{!-- Edit Mode Toggle (only for actor-owned items) --}}
        {{#if isOwnedByActor}}
        {{#if canEdit}}
        <button type="button" class="tw-flex tw-items-center tw-justify-center tw-cursor-pointer {{#if inEditMode}}active{{/if}}"
                data-action="toggleEditMode" title="{{#if inEditMode}}{{localize 'WH40K.Common.ExitEditMode'}}{{else}}{{localize 'WH40K.Common.EnterEditMode'}}{{/if}}">
          <i class="fa-solid {{#if inEditMode}}fa-lock-open{{else}}fa-pen-to-square{{/if}}"></i>
        </button>
        {{/if}}
        {{/if}}

        {{!-- Roll Button --}}
        {{#if talentData.isRollable}}
        <button type="button" class="tw-flex tw-items-center tw-justify-center tw-cursor-pointer" data-action="rollTalent" title="{{localize 'WH40K.ItemSheet.Talent.RollTalent'}}">
          <i class="fa-solid fa-dice-d20"></i>
        </button>
        {{/if}}

        {{!-- Chat Button --}}
        <button type="button" class="tw-flex tw-items-center tw-justify-center tw-cursor-pointer" data-action="postToChat" title="{{localize 'WH40K.ItemSheet.Talent.PostToChat'}}">
          <i class="fa-solid fa-comment"></i>
        </button>
      </div>
    </header>

    {{!-- ═══════════════════════════════════════════════════════════════════
         QUICK STATS BAR: Key info at a glance
    ═══════════════════════════════════════════════════════════════════ --}}
    <div class="tw-flex tw-flex-wrap tw-gap-2">
      {{!-- Prerequisites Summary --}}
      {{#if prerequisitesData.hasAny}}
      <div class="tw-flex tw-items-center tw-gap-1">
        <i class="fa-solid fa-lock"></i>
        <span >{{localize "WH40K.Dialog.TalentEditor.Prerequisites"}}</span>
        <span >{{prerequisitesData.label}}</span>
      </div>
      {{/if}}

      {{!-- Aptitudes --}}
      {{#if talentData.hasAptitudes}}
      <div class="tw-flex tw-items-center tw-gap-1">
        <i class="fa-solid fa-brain"></i>
        <span >{{localize "WH40K.Aptitudes"}}</span>
        <div class="tw-flex tw-flex-wrap tw-gap-1">
          {{#each talentData.aptitudes}}
          <span class="tw-inline-flex tw-items-center tw-px-2.5 tw-py-1 tw-bg-[linear-gradient(135deg,rgba(212,175,55,0.15),rgba(212,175,55,0.05))] tw-border tw-border-[rgba(212,175,55,0.3)] tw-rounded-sm tw-text-xs tw-font-semibold tw-text-gold">{{this}}</span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{!-- Specialization --}}
      {{#if talentData.specialization}}
      <div class="tw-flex tw-items-center tw-gap-1">
        <i class="fa-solid fa-bullseye"></i>
        <span >{{localize "WH40K.Prompt.AddSpecialist.Specialisation"}}</span>
        <span >{{talentData.specialization}}</span>
      </div>
      {{/if}}
    </div>

    {{!-- ═══════════════════════════════════════════════════════════════════
         EFFECTS BANNER: Quick summary of talent effects (visible on all tabs)
    ═══════════════════════════════════════════════════════════════════ --}}
    {{#if (or modifiersData.hasAny situationalData.hasAny grantsData.hasAny)}}
    <div class="tw-flex tw-items-center tw-gap-2">
      <div class="tw-flex tw-items-center tw-gap-1">
        <i class="fa-solid fa-sparkles"></i>
        <span>{{localize "WH40K.Tabs.Effects"}}</span>
      </div>
      <div class="tw-flex tw-flex-wrap tw-gap-1">
        {{!-- Permanent Modifiers Pill --}}
        {{#if modifiersData.hasAny}}
        <div class="tw-flex tw-items-center tw-gap-1" title="{{localize 'WH40K.ItemSheet.Talent.ModifiersTooltip'}}">
          <i class="fa-solid fa-chart-line"></i>
          <span >{{localize "WH40K.Tabs.Modifiers"}}</span>
          <span >{{#if modifiersData.hasCharacteristics}}{{modifiersData.characteristics.length}}{{/if}}{{#if (and modifiersData.hasCharacteristics modifiersData.hasSkills)}}+{{/if}}{{#if modifiersData.hasSkills}}{{modifiersData.skills.length}}{{/if}}{{#if (and (or modifiersData.hasCharacteristics modifiersData.hasSkills) modifiersData.hasCombat)}}+{{/if}}{{#if modifiersData.hasCombat}}{{modifiersData.combat.length}}{{/if}}{{#if (and (or modifiersData.hasCharacteristics modifiersData.hasSkills modifiersData.hasCombat) modifiersData.hasResources)}}+{{/if}}{{#if modifiersData.hasResources}}{{modifiersData.resources.length}}{{/if}}</span>
        </div>
        {{/if}}

        {{!-- Situational Modifiers Pill --}}
        {{#if situationalData.hasAny}}
        <div class="tw-flex tw-items-center tw-gap-1" title="{{localize 'WH40K.ItemSheet.Talent.SituationalTooltip'}}">
          <i class="fa-solid fa-clock-rotate-left"></i>
          <span >{{localize "WH40K.Roll.ModifierSource.Situational"}}</span>
          <span >{{#if situationalData.hasCharacteristics}}{{situationalData.characteristics.length}}{{/if}}{{#if (and situationalData.hasCharacteristics situationalData.hasSkills)}}+{{/if}}{{#if situationalData.hasSkills}}{{situationalData.skills.length}}{{/if}}{{#if (and (or situationalData.hasCharacteristics situationalData.hasSkills) situationalData.hasCombat)}}+{{/if}}{{#if situationalData.hasCombat}}{{situationalData.combat.length}}{{/if}}</span>
        </div>
        {{/if}}

        {{!-- Grants Pill --}}
        {{#if grantsData.hasAny}}
        <div class="tw-flex tw-items-center tw-gap-1" title="{{localize 'WH40K.ItemSheet.Talent.GrantsTooltip'}}">
          <i class="fa-solid fa-gift"></i>
          <span >{{localize "WH40K.Talent.Grants"}}</span>
          <span >{{#if grantsData.hasSkills}}{{grantsData.skills.length}}{{/if}}{{#if (and grantsData.hasSkills grantsData.hasTalents)}}+{{/if}}{{#if grantsData.hasTalents}}{{grantsData.talents.length}}{{/if}}{{#if (and (or grantsData.hasSkills grantsData.hasTalents) grantsData.hasTraits)}}+{{/if}}{{#if grantsData.hasTraits}}{{grantsData.traits.length}}{{/if}}</span>
        </div>
        {{/if}}
      </div>
      <a class="tw-flex tw-items-center tw-gap-1 tw-cursor-pointer" data-action="switchTab" data-tab="effects" data-group="primary">
        <span>{{localize "WH40K.Common.ViewDetails"}}</span>
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
    {{/if}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB NAVIGATION
    ═══════════════════════════════════════════════════════════════════ --}}
    {{> systems/wh40k-rpg/templates/item/partial/item-accent-tab-strip.hbs category="talents" tabs=(array
        (object tab="overview"    label=(localize "WH40K.Tabs.Overview")    icon="fa-eye"                 active=(eq activeTab "overview"))
        (object tab="effects"     label=(localize "WH40K.Tabs.Effects")     icon="fa-wand-magic-sparkles" active=(eq activeTab "effects"))
        (object tab="properties"  label=(localize "WH40K.Tabs.Properties")  icon="fa-sliders"             active=(eq activeTab "properties"))
        (object tab="description" label=(localize "WH40K.Tabs.Description")  icon="fa-book"                active=(eq activeTab "description")))}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         TAB CONTENT
    ═══════════════════════════════════════════════════════════════════ --}}
    <section class="wh40k-tab-content tw-flex-1 tw-overflow-y-auto tw-min-h-0 tw-p-3 [&::-webkit-scrollbar]:tw-w-2 [&::-webkit-scrollbar-track]:tw-bg-[var(--wh40k-panel-bg)] [&::-webkit-scrollbar-thumb]:tw-bg-[var(--wh40k-border-color)] [&::-webkit-scrollbar-thumb]:tw-rounded-md">

      {{!-- ─────────────────────────────────────────────────────────────────
           OVERVIEW TAB: Benefit and effects summary
      ───────────────────────────────────────────────────────────────── --}}
      <div class="wh40k-talent-panel{{#if (eq activeTab "overview")}} active{{/if}}" data-tab="overview" data-group="primary">

        {{!-- Benefit Section (Editable with hover button) --}}
        <div class="{{#if inEditMode}}tw-ring-1 tw-ring-[color:var(--wh40k-accent-gold)]{{/if}}">
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-star" labelKey="WH40K.SpecialAbility.Benefit" actions="talentBenefitAction"}}
            {{#if inEditMode}}
            <div class="tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-md tw-p-2 [&_.editor]:tw-min-h-[150px]">
              {{editor system.benefit target="system.benefit" button=true editable=canEdit engine="prosemirror"}}
            </div>
            {{else}}
              {{#if talentData.hasBenefit}}
              <div >
                {{{talentData.benefit}}}
              </div>
              {{else}}
              <div class="tw-flex tw-flex-col tw-items-center tw-cursor-pointer" data-action="toggleEditMode">
                <i class="fa-solid fa-file-lines"></i>
                <p>{{localize "WH40K.ItemSheet.Talent.ClickToAddBenefit"}}</p>
              </div>
              {{/if}}
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

        {{!-- Special Abilities Section --}}
        <div >
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-bolt-lightning" labelKey="WH40K.Dialog.TalentEditor.SpecialAbilities" actions="talentEditorAction" editorSection="grants" editorTitleKey="WH40K.ItemSheet.Talent.EditGrantsAbilities"}}
            {{#if grantsData.hasSpecialAbilities}}
            <div class="tw-flex tw-flex-col tw-gap-2">
              {{#each grantsData.specialAbilities}}
              <div >
                <h4 class="tw-flex tw-items-center tw-gap-1">
                  <i class="fa-solid fa-circle-dot"></i>
                  {{this.name}}
                </h4>
                <div >
                  {{{this.description}}}
                </div>
              </div>
              {{/each}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-bolt-lightning"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoSpecialAbilities"}}</p>
              {{#if inEditMode}}
              <button type="button" class="tw-cursor-pointer" data-action="openTalentEditor" data-section="grants">
                <i class="fa-solid fa-plus"></i> {{localize "WH40K.ItemSheet.Talent.AddAbilitiesGrants"}}
              </button>
              {{/if}}
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

      </div>

      {{!-- ─────────────────────────────────────────────────────────────────
           PROPERTIES TAB: Configuration and details
      ───────────────────────────────────────────────────────────────── --}}
      <div class="wh40k-talent-panel{{#if (eq activeTab "properties")}} active{{/if}}" data-tab="properties" data-group="primary">

        {{!-- Basic Properties --}}
        <div >
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-cog" labelKey="WH40K.ItemSheet.Talent.BasicProperties"}}
            <div class="tw-grid tw-grid-cols-2 tw-gap-3">
              {{!-- Category --}}
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">
                  <i class="fa-solid fa-tag"></i>
                  {{localize "WH40K.Gear.Category"}}
                </label>
                {{#if inEditMode}}
                <select name="system.category" >
                  {{#each categoryOptions}}
                  <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
                {{else}}
                <div >{{talentData.categoryLabel}}</div>
                {{/if}}
              </div>

              {{!-- Tier --}}
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">
                  <i class="fa-solid fa-layer-group"></i>
                  {{localize "WH40K.ItemSheet.Talent.TierLabel"}}
                </label>
                {{#if inEditMode}}
                <select name="system.tier" >
                  {{#each tierOptions}}
                  <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
                {{else}}
                <div >{{talentData.tierLabel}}</div>
                {{/if}}
              </div>

              {{!-- XP Cost --}}
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">
                  <i class="fa-solid fa-coins"></i>
                  {{localize "WH40K.ItemSheet.Talent.XpCost"}}
                </label>
                {{#if inEditMode}}
                <input type="number" name="system.cost" value="{{talentData.cost}}" min="0" class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" />
                {{else}}
                <div >{{talentData.cost}}</div>
                {{/if}}
              </div>

              {{!-- Type (Passive/Active) - Radio Buttons --}}
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">
                  <i class="fa-solid fa-circle-check"></i>
                  {{localize "WH40K.Common.Type"}}
                </label>
                {{#if inEditMode}}
                <div class="tw-flex tw-gap-2">
                  <label class="tw-flex tw-items-center tw-gap-1 tw-cursor-pointer">
                    <input type="radio" name="system.isPassive" value="true" {{#if talentData.isPassive}}checked{{/if}} />
                    <span ></span>
                    <i class="fa-solid fa-circle-check"></i>
                    <span>{{localize "WH40K.ItemSheet.Talent.Passive"}}</span>
                  </label>
                  <label class="tw-flex tw-items-center tw-gap-1 tw-cursor-pointer">
                    <input type="radio" name="system.isPassive" value="false" {{#unless talentData.isPassive}}checked{{/unless}} />
                    <span ></span>
                    <i class="fa-solid fa-bolt"></i>
                    <span>{{localize "WH40K.ItemSheet.Talent.Active"}}</span>
                  </label>
                </div>
                {{else}}
                <div class="tw-flex tw-items-center tw-gap-1">
                  <i class="fa-solid {{#if talentData.isPassive}}fa-circle-check{{else}}fa-bolt{{/if}}"></i>
                  {{#if talentData.isPassive}}{{localize "WH40K.ItemSheet.Talent.Passive"}}{{else}}{{localize "WH40K.ItemSheet.Talent.Active"}}{{/if}}
                </div>
                {{/if}}
              </div>

              {{!-- Stackable --}}
              <div class="tw-flex tw-flex-col tw-gap-1.5 tw-justify-center">
                <label class="tw-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">
                  <i class="fa-solid fa-layer-group"></i>
                  {{localize "WH40K.ItemSheet.Talent.Stackable"}}
                </label>
                {{#if inEditMode}}
                <label class="tw-flex tw-items-center tw-gap-1 tw-cursor-pointer tw-text-[0.85rem] tw-font-semibold tw-text-[var(--color-text-primary)] tw-select-none">
                  <input type="checkbox" name="system.stackable" {{checked talentData.stackable}} />
                  <span>{{localize "WH40K.ItemSheet.Talent.CanTakeMultiple"}}</span>
                </label>
                {{else}}
                <div >{{#if talentData.stackable}}{{localize "WH40K.Yes"}}{{else}}{{localize "WH40K.No"}}{{/if}}</div>
                {{/if}}
              </div>

              {{!-- Rank (if stackable) --}}
              {{#if talentData.stackable}}
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">
                  <i class="fa-solid fa-hashtag"></i>
                  {{localize "WH40K.ItemSheet.Talent.CurrentRank"}}
                </label>
                {{#if inEditMode}}
                <div class="tw-flex tw-items-center tw-gap-1">
                  <button type="button" class="tw-cursor-pointer" data-action="adjustRank" data-delta="-1">
                    <i class="fa-solid fa-minus"></i>
                  </button>
                  <input type="number" name="system.rank" value="{{talentData.rank}}" min="1" class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" />
                  <button type="button" class="tw-cursor-pointer" data-action="adjustRank" data-delta="1">
                    <i class="fa-solid fa-plus"></i>
                  </button>
                </div>
                {{else}}
                <div >{{talentData.rank}}</div>
                {{/if}}
              </div>
              {{/if}}
            </div>
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

        {{!-- Specialization (with Has Specialization checkbox) --}}
        <div >
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-bullseye" labelKey="WH40K.ItemSheet.Talent.SpecialisationX"}}
            {{#if inEditMode}}
            <div class="tw-flex tw-flex-col tw-gap-2">
              <label class="tw-flex tw-items-center tw-gap-1 tw-cursor-pointer">
                <input type="checkbox" name="system.hasSpecialization" {{checked talentData.hasSpecialization}} />
                <span>{{localize "WH40K.ItemSheet.Talent.SpecialisationHint"}}</span>
              </label>
              {{#if talentData.hasSpecialization}}
              <div >
                <input type="text" name="system.specialization" value="{{talentData.specialization}}"
                       class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" placeholder="{{localize 'WH40K.ItemSheet.Talent.SpecialisationPlaceholder'}}" />
              </div>
              {{/if}}
            </div>
            {{else if talentData.hasSpecialization}}
            <div >
              <span class="tw-flex tw-items-center tw-gap-1">
                <i class="fa-solid fa-bullseye"></i>
                {{talentData.specialization}}
              </span>
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-bullseye"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NotSpecialisation"}}</p>
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

        {{!-- Prerequisites --}}
        <div >
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-lock" labelKey="WH40K.Dialog.TalentEditor.Prerequisites" actions="talentEditorAction" editorSection="prerequisites" editorTitleKey="WH40K.ItemSheet.Talent.EditPrerequisites"}}
            {{#if prerequisitesData.hasAny}}
            <div class="tw-flex tw-flex-col tw-gap-2 tw-p-3 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-md">
              {{#if prerequisitesData.hasText}}
              <div >{{prerequisitesData.text}}</div>
              {{/if}}

              {{#if prerequisitesData.hasCharacteristics}}
              <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
                <span >{{localize "WH40K.ItemSheet.Talent.CharacteristicsColon"}}</span>
                {{#each prerequisitesData.characteristics}}
                <span >{{this.short}} {{this.value}}+</span>
                {{/each}}
              </div>
              {{/if}}

              {{#if prerequisitesData.hasSkills}}
              <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
                <span >{{localize "WH40K.ItemSheet.Talent.SkillsColon"}}</span>
                {{#each prerequisitesData.skills}}
                <span >{{this}}</span>
                {{/each}}
              </div>
              {{/if}}

              {{#if prerequisitesData.hasTalents}}
              <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1">
                <span >{{localize "WH40K.ItemSheet.Talent.TalentsColon"}}</span>
                {{#each prerequisitesData.talents}}
                <span >{{this}}</span>
                {{/each}}
              </div>
              {{/if}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-unlock"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoPrerequisites"}}</p>
              {{#if inEditMode}}
              <button type="button" class="tw-cursor-pointer" data-action="openTalentEditor" data-section="prerequisites">
                <i class="fa-solid fa-plus"></i> {{localize "WH40K.ItemSheet.Talent.AddPrerequisites"}}
              </button>
              {{/if}}
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

        {{!-- Roll Configuration (if active talent) --}}
        {{#unless talentData.isPassive}}
        <div >
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-dice-d20" labelKey="WH40K.ItemSheet.Talent.RollConfiguration"}}
            {{#if inEditMode}}
            <div class="tw-grid tw-grid-cols-2 tw-gap-3">
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">{{localize "WH40K.Characteristic.SelectLabel"}}</label>
                <input type="text" name="system.rollConfig.characteristic"
                       value="{{rollConfigData.characteristic}}"
                       class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" placeholder="{{localize 'WH40K.ItemSheet.Talent.CharacteristicPlaceholder'}}" />
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">{{localize "WH40K.Skills.Skill"}}</label>
                <input type="text" name="system.rollConfig.skill"
                       value="{{rollConfigData.skill}}"
                       class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" placeholder="{{localize 'WH40K.ItemSheet.Talent.SkillPlaceholder'}}" />
              </div>
              <div class="tw-flex tw-flex-col tw-gap-1.5">
                <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">{{localize "WH40K.Roll.Modifier"}}</label>
                <input type="number" name="system.rollConfig.modifier"
                       value="{{rollConfigData.modifier}}"
                       class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" />
              </div>
            </div>
            <div class="tw-flex tw-flex-col tw-gap-1.5 tw-mt-3">
              <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">{{localize "WH40K.ItemSheet.Talent.RollDescription"}}</label>
              <input type="text" name="system.rollConfig.description"
                     value="{{rollConfigData.description}}"
                     class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" placeholder="{{localize 'WH40K.ItemSheet.Talent.RollDescriptionPlaceholder'}}" />
            </div>
            {{else if rollConfigData.isConfigured}}
            <div class="tw-flex tw-flex-col tw-gap-1">
              {{#if rollConfigData.characteristic}}
              <div class="tw-flex tw-items-center tw-gap-1">
                <i class="fa-solid fa-dumbbell"></i>
                <span>{{localize "WH40K.ItemSheet.Talent.TestSuffix" label=rollConfigData.characteristicLabel}}</span>
                {{#if (ne rollConfigData.modifier 0)}}
                <span class="{{#if (gt rollConfigData.modifier 0)}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                  {{#if (gt rollConfigData.modifier 0)}}+{{/if}}{{rollConfigData.modifier}}
                </span>
                {{/if}}
              </div>
              {{/if}}
              {{#if rollConfigData.skill}}
              <div class="tw-flex tw-items-center tw-gap-1">
                <i class="fa-solid fa-graduation-cap"></i>
                <span>{{localize "WH40K.ItemSheet.Talent.TestSuffix" label=rollConfigData.skillLabel}}</span>
                {{#if (ne rollConfigData.modifier 0)}}
                <span class="{{#if (gt rollConfigData.modifier 0)}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                  {{#if (gt rollConfigData.modifier 0)}}+{{/if}}{{rollConfigData.modifier}}
                </span>
                {{/if}}
              </div>
              {{/if}}
              {{#if rollConfigData.description}}
              <p >{{rollConfigData.description}}</p>
              {{/if}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-dice-d20"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoRollConfiguration"}}</p>
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>
        {{/unless}}

      </div>

      {{!-- ─────────────────────────────────────────────────────────────────
           EFFECTS TAB: Modifiers and mechanical effects
      ───────────────────────────────────────────────────────────────── --}}
      <div class="wh40k-talent-panel{{#if (eq activeTab "effects")}} active{{/if}}" data-tab="effects" data-group="primary">

        {{!-- Permanent Modifiers --}}
        <div  data-section-id="modifiers" data-has-data="{{modifiersData.hasAny}}" style="order: {{#each effectsSectionOrder}}{{#if (eq this "modifiers")}}{{@index}}{{/if}}{{/each}}">
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-chart-line" labelKey="WH40K.ItemSheet.Talent.PermanentModifiers" actions="talentEditorAction" editorSection="modifiers" editorTitleKey="WH40K.ItemSheet.Talent.EditModifiers"}}
            {{#if modifiersData.hasAny}}
            <p class="tw-flex tw-items-center tw-gap-1">
              <i class="fa-solid fa-info-circle"></i>
              {{localize "WH40K.ItemSheet.Talent.PermanentHint"}}
            </p>
            <div class="tw-grid">
              {{!-- Characteristic Modifiers --}}
              {{#if modifiersData.hasCharacteristics}}
              <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)]">
                <h4 class="tw-flex tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-px-2 tw-py-[6px] tw-bg-[rgba(0,0,0,0.2)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.9em] tw-font-semibold tw-text-[color:var(--wh40k-text-secondary,rgba(255,255,255,0.8))] tw-uppercase tw-tracking-[0.5px]">
                  <i class="fa-solid fa-dumbbell"></i>
                  {{localize "WH40K.Characteristics"}}
                </h4>
                <div class="tw-flex tw-flex-col tw-gap-1">
                  {{#each modifiersData.characteristics}}
                  <div class="tw-flex tw-items-center tw-justify-between tw-gap-[var(--wh40k-space-md)] tw-p-[10px] tw-bg-[rgba(0,0,0,0.2)] tw-border-l-[3px] tw-border-l-transparent tw-rounded-[var(--wh40k-radius-md)] tw-transition-all">
                    <span class="tw-text-[color:var(--color-text-secondary)] tw-font-semibold">{{this.label}}</span>
                    <span class="tw-font-display tw-font-bold tw-text-[0.95rem] {{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                      {{#if this.positive}}+{{/if}}{{this.value}}
                    </span>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- Skill Modifiers --}}
              {{#if modifiersData.hasSkills}}
              <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)]">
                <h4 class="tw-flex tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-px-2 tw-py-[6px] tw-bg-[rgba(0,0,0,0.2)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.9em] tw-font-semibold tw-text-[color:var(--wh40k-text-secondary,rgba(255,255,255,0.8))] tw-uppercase tw-tracking-[0.5px]">
                  <i class="fa-solid fa-graduation-cap"></i>
                  {{localize "WH40K.Tabs.Skills"}}
                </h4>
                <div class="tw-flex tw-flex-col tw-gap-1">
                  {{#each modifiersData.skills}}
                  <div class="tw-flex tw-items-center tw-justify-between tw-gap-[var(--wh40k-space-md)] tw-p-[10px] tw-bg-[rgba(0,0,0,0.2)] tw-border-l-[3px] tw-border-l-transparent tw-rounded-[var(--wh40k-radius-md)] tw-transition-all">
                    <span class="tw-text-[color:var(--color-text-secondary)] tw-font-semibold">{{this.label}}</span>
                    <span class="tw-font-display tw-font-bold tw-text-[0.95rem] {{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                      {{#if this.positive}}+{{/if}}{{this.value}}
                    </span>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- Combat Modifiers --}}
              {{#if modifiersData.hasCombat}}
              <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)]">
                <h4 class="tw-flex tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-px-2 tw-py-[6px] tw-bg-[rgba(0,0,0,0.2)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.9em] tw-font-semibold tw-text-[color:var(--wh40k-text-secondary,rgba(255,255,255,0.8))] tw-uppercase tw-tracking-[0.5px]">
                  <i class="fa-solid fa-swords"></i>
                  {{localize "WH40K.Tabs.Combat"}}
                </h4>
                <div class="tw-flex tw-flex-col tw-gap-1">
                  {{#each modifiersData.combat}}
                  <div class="tw-flex tw-items-center tw-justify-between tw-gap-[var(--wh40k-space-md)] tw-p-[10px] tw-bg-[rgba(0,0,0,0.2)] tw-border-l-[3px] tw-border-l-transparent tw-rounded-[var(--wh40k-radius-md)] tw-transition-all">
                    <span class="tw-text-[color:var(--color-text-secondary)] tw-font-semibold">{{this.label}}</span>
                    <span class="tw-font-display tw-font-bold tw-text-[0.95rem] {{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                      {{#if this.positive}}+{{/if}}{{this.value}}
                    </span>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- Resource Modifiers --}}
              {{#if modifiersData.hasResources}}
              <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)]">
                <h4 class="tw-flex tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-px-2 tw-py-[6px] tw-bg-[rgba(0,0,0,0.2)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.9em] tw-font-semibold tw-text-[color:var(--wh40k-text-secondary,rgba(255,255,255,0.8))] tw-uppercase tw-tracking-[0.5px]">
                  <i class="fa-solid fa-heart"></i>
                  {{localize "WH40K.ItemSheet.Modifiers.Resources"}}
                </h4>
                <div class="tw-flex tw-flex-col tw-gap-1">
                  {{#each modifiersData.resources}}
                  <div class="tw-flex tw-items-center tw-justify-between tw-gap-[var(--wh40k-space-md)] tw-p-[10px] tw-bg-[rgba(0,0,0,0.2)] tw-border-l-[3px] tw-border-l-transparent tw-rounded-[var(--wh40k-radius-md)] tw-transition-all">
                    <span class="tw-text-[color:var(--color-text-secondary)] tw-font-semibold">{{this.label}}</span>
                    <span class="tw-font-display tw-font-bold tw-text-[0.95rem] {{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                      {{#if this.positive}}+{{/if}}{{this.value}}
                    </span>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- Other Modifiers --}}
              {{#if modifiersData.hasOther}}
              <div class="tw-flex tw-flex-col tw-gap-[var(--wh40k-space-sm)]">
                <h4 class="tw-flex tw-items-center tw-gap-[var(--wh40k-space-sm)] tw-px-2 tw-py-[6px] tw-bg-[rgba(0,0,0,0.2)] tw-rounded-[var(--wh40k-radius-md)] tw-text-[0.9em] tw-font-semibold tw-text-[color:var(--wh40k-text-secondary,rgba(255,255,255,0.8))] tw-uppercase tw-tracking-[0.5px]">
                  <i class="fa-solid fa-ellipsis"></i>
                  {{localize "WH40K.ItemSheet.Modifiers.Other"}}
                </h4>
                <div class="tw-flex tw-flex-col tw-gap-1">
                  {{#each modifiersData.other}}
                  <div class="tw-flex tw-items-center tw-justify-between tw-gap-[var(--wh40k-space-md)] tw-p-[10px] tw-bg-[rgba(0,0,0,0.2)] tw-border-l-[3px] tw-border-l-transparent tw-rounded-[var(--wh40k-radius-md)] tw-transition-all">
                    <span class="tw-text-[color:var(--color-text-secondary)] tw-font-semibold">{{this.label}}</span>
                    <span class="tw-font-display tw-font-bold tw-text-[0.95rem] {{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                      {{#if this.positive}}+{{/if}}{{this.value}}
                    </span>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-chart-line"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoPermanentModifiers"}}</p>
              {{#if inEditMode}}
              <button type="button" class="tw-cursor-pointer" data-action="openTalentEditor" data-section="modifiers">
                <i class="fa-solid fa-plus"></i> {{localize "WH40K.ItemSheet.Talent.AddModifiers"}}
              </button>
              {{else}}
              <p >{{localize "WH40K.ItemSheet.Talent.SpecialRulesOnly"}}</p>
              {{/if}}
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

        {{!-- Situational Modifiers --}}
        <div  data-section-id="situational" data-has-data="{{situationalData.hasAny}}" style="order: {{#each effectsSectionOrder}}{{#if (eq this "situational")}}{{@index}}{{/if}}{{/each}}">
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-clock-rotate-left" labelKey="WH40K.ItemSheet.Talent.SituationalModifiers" actions="talentEditorAction" editorSection="situational" editorTitleKey="WH40K.ItemSheet.Talent.EditSituational"}}
            {{#if situationalData.hasAny}}
            <p class="tw-flex tw-items-center tw-gap-1">
              <i class="fa-solid fa-info-circle"></i>
              {{localize "WH40K.ItemSheet.Talent.SituationalHint"}}
            </p>
            <div class="tw-flex tw-flex-col tw-gap-2">
              {{#each situationalData.characteristics}}
              <div >
                <div class="tw-flex tw-items-center tw-gap-1">
                  <i class="{{this.icon}}"></i>
                  <span >{{this.label}}</span>
                  <span class="{{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                    {{#if this.positive}}+{{/if}}{{this.value}}
                  </span>
                </div>
                <p >{{this.condition}}</p>
              </div>
              {{/each}}
              {{#each situationalData.skills}}
              <div >
                <div class="tw-flex tw-items-center tw-gap-1">
                  <i class="{{this.icon}}"></i>
                  <span >{{this.label}}</span>
                  <span class="{{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                    {{#if this.positive}}+{{/if}}{{this.value}}
                  </span>
                </div>
                <p >{{this.condition}}</p>
              </div>
              {{/each}}
              {{#each situationalData.combat}}
              <div >
                <div class="tw-flex tw-items-center tw-gap-1">
                  <i class="{{this.icon}}"></i>
                  <span >{{this.label}}</span>
                  <span class="{{#if this.positive}}tw-text-[color:var(--wh40k-accent-green-bright)]{{else}}tw-text-[color:var(--wh40k-accent-combat)]{{/if}}">
                    {{#if this.positive}}+{{/if}}{{this.value}}
                  </span>
                </div>
                <p >{{this.condition}}</p>
              </div>
              {{/each}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-clock-rotate-left"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoSituational"}}</p>
              {{#if inEditMode}}
              <button type="button" class="tw-cursor-pointer" data-action="openTalentEditor" data-section="situational">
                <i class="fa-solid fa-plus"></i> {{localize "WH40K.ItemSheet.Talent.AddSituational"}}
              </button>
              {{else}}
              <p >{{localize "WH40K.ItemSheet.Talent.ConsistentBonuses"}}</p>
              {{/if}}
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

        {{!-- Grants Section --}}
        <div  data-section-id="grants" data-has-data="{{grantsData.hasAny}}" style="order: {{#each effectsSectionOrder}}{{#if (eq this "grants")}}{{@index}}{{/if}}{{/each}}">
          {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-gift" labelKey="WH40K.Talent.Grants" actions="talentEditorAction" editorSection="grants" editorTitleKey="WH40K.ItemSheet.Talent.EditGrants"}}
            {{#if grantsData.hasAny}}
            <p class="tw-flex tw-items-center tw-gap-1">
              <i class="fa-solid fa-info-circle"></i>
              {{localize "WH40K.ItemSheet.Talent.GrantsHint"}}
            </p>
            <div class="tw-grid tw-gap-2">
              {{!-- Skills Granted --}}
              {{#if grantsData.hasSkills}}
              <div >
                <h4 class="tw-flex tw-items-center tw-gap-1">
                  <i class="fa-solid fa-graduation-cap"></i>
                  {{localize "WH40K.Tabs.Skills"}}
                </h4>
                <div class="tw-flex tw-flex-wrap tw-gap-1">
                  {{#each grantsData.skills}}
                  <div class="tw-flex tw-items-center tw-gap-1">
                    <span >{{this.displayName}}</span>
                    <span class="wh40k-grant-level--{{this.level}}">{{this.levelLabel}}</span>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- Talents Granted --}}
              {{#if grantsData.hasTalents}}
              <div >
                <h4 class="tw-flex tw-items-center tw-gap-1">
                  <i class="fa-solid fa-star"></i>
                  {{localize "WH40K.Tabs.Talents"}}
                </h4>
                <div class="tw-flex tw-flex-wrap tw-gap-1">
                  {{#each grantsData.talents}}
                  <div class="tw-flex tw-items-center tw-gap-1 {{#if this.hasLink}}tw-cursor-pointer{{/if}}"
                       {{#if this.hasLink}}data-action="viewGrantedItem" data-uuid="{{this.uuid}}"{{/if}}>
                    <span >{{this.name}}</span>
                    {{#if this.specialization}}
                    <span >({{this.specialization}})</span>
                    {{/if}}
                    {{#if this.hasLink}}
                    <i class="fa-solid fa-external-link"></i>
                    {{/if}}
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- Traits Granted --}}
              {{#if grantsData.hasTraits}}
              <div >
                <h4 class="tw-flex tw-items-center tw-gap-1">
                  <i class="fa-solid fa-dna"></i>
                  {{localize "WH40K.Traits"}}
                </h4>
                <div class="tw-flex tw-flex-wrap tw-gap-1">
                  {{#each grantsData.traits}}
                  <div class="tw-flex tw-items-center tw-gap-1 {{#if this.hasLink}}tw-cursor-pointer{{/if}}"
                       {{#if this.hasLink}}data-action="viewGrantedItem" data-uuid="{{this.uuid}}"{{/if}}>
                    <span >{{this.name}}</span>
                    {{#if this.level}}
                    <span >({{this.level}})</span>
                    {{/if}}
                    {{#if this.hasLink}}
                    <i class="fa-solid fa-external-link"></i>
                    {{/if}}
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-gift"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoGrants"}}</p>
              {{#if inEditMode}}
              <button type="button" class="tw-cursor-pointer" data-action="openTalentEditor" data-section="grants">
                <i class="fa-solid fa-plus"></i> {{localize "WH40K.ItemSheet.Talent.AddGrants"}}
              </button>
              {{else}}
              <p >{{localize "WH40K.ItemSheet.Talent.NoAutoGrants"}}</p>
              {{/if}}
            </div>
            {{/if}}
          {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        </div>

      </div>

      {{!-- ─────────────────────────────────────────────────────────────────
           DESCRIPTION TAB: Benefit, notes, technical
      ───────────────────────────────────────────────────────────────── --}}
      <div class="wh40k-talent-panel{{#if (eq activeTab "description")}} active{{/if}}" data-tab="description" data-group="primary">

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-star" labelKey="WH40K.SpecialAbility.Benefit"}}
            {{#if canEdit}}
            <div class="tw-flex tw-justify-end tw-mb-1">
              {{#unless inEditMode}}
              {{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-pen-to-square" titleKey="WH40K.ItemSheet.Talent.EditBenefit"}}
              {{else}}
              {{> systems/wh40k-rpg/templates/shared/sheet-action-button.hbs action="toggleEditMode" icon="fa-check" titleKey="WH40K.ItemSheet.Talent.DoneEditing"}}
              {{/unless}}
            </div>
            {{/if}}
            {{#if inEditMode}}
              {{editor system.benefit target="system.benefit" button=true editable=canEdit engine="prosemirror"}}
            {{else}}
              {{#if talentData.hasBenefit}}
              <div class="tw-text-[color:var(--wh40k-text-dark)] tw-leading-[1.5] tw-text-sm [&_p]:tw-mb-2 [&_strong]:tw-font-bold [&_strong]:tw-text-[color:var(--wh40k-text-dark)]">
                {{{talentData.benefit}}}
              </div>
              {{else}}
              <div class="tw-flex tw-flex-col tw-items-center tw-cursor-pointer" data-action="toggleEditMode">
                <i class="fa-solid fa-file-lines"></i>
                <p>{{localize "WH40K.ItemSheet.Talent.ClickToAddBenefit"}}</p>
              </div>
              {{/if}}
            {{/if}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-sticky-note" labelKey="WH40K.ItemSheet.Common.GmNotes"}}
            {{#if inEditMode}}
            <textarea name="system.notes" rows="4" class="tw-w-full tw-px-3 tw-py-2 tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm tw-min-h-[80px] tw-resize-y focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]"
                      placeholder="{{localize 'WH40K.ItemSheet.Talent.NotesPlaceholder'}}">{{talentData.notes}}</textarea>
            {{else if talentData.notes}}
            <div >
              {{talentData.notes}}
            </div>
            {{else}}
            <div class="tw-flex tw-flex-col tw-items-center">
              <i class="fa-solid fa-sticky-note"></i>
              <p>{{localize "WH40K.ItemSheet.Talent.NoNotes"}}</p>
            </div>
            {{/if}}
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}

        {{!-- Identifier (for developers) --}}
        {{#if inEditMode}}
        {{#> systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs icon="fa-code" labelKey="WH40K.ItemSheet.Talent.Technical"}}
            <div class="tw-flex tw-flex-col tw-gap-1.5">
              <label class="tw-text-xs tw-font-semibold tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--color-text-secondary)]">{{localize "WH40K.ItemSheet.WeaponQuality.Identifier"}} <span >{{localize "WH40K.ItemSheet.Talent.IdentifierHint"}}</span></label>
              <input type="text" name="system.identifier" value="{{talentData.identifier}}"
                     class="tw-w-full tw-px-3 tw-py-2 tw-font-mono tw-bg-[var(--color-bg-option)] tw-border tw-border-[var(--color-border-secondary)] tw-rounded-sm tw-text-[color:var(--color-text-primary)] tw-text-sm focus:tw-outline-none focus:tw-border-[var(--wh40k-color-gold)]" placeholder="camelCaseIdentifier" />
            </div>
        {{/systems/wh40k-rpg/templates/item/partial/item-detail-section.hbs}}
        {{/if}}

      </div>

    </section>{{!-- .wh40k-talent-content --}}

    {{!-- ═══════════════════════════════════════════════════════════════════
         FOOTER: Source Reference
    ═══════════════════════════════════════════════════════════════════ --}}
    <footer class="tw-flex-shrink-0 tw-flex tw-items-center tw-gap-1">
      <i class="fa-solid fa-book-open" title="{{localize 'WH40K.Common.Source'}}"></i>
      {{> systems/wh40k-rpg/templates/item/partial/source-reference-field.hbs source=source.source editable=inEditMode}}
    </footer>

</div>{{!-- .wh40k-talent-sheet-v2 --}}
