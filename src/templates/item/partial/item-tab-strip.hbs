{{!--
    Horizontal button-style tab navigation for item sheets.

    Hash params:
        tabs          — array of { tab, label, icon (FA class), active? }
        dataAction    — optional `data-action` emitted on each button (e.g.
                        "changeTab" for sheets that drive tabs via a Foundry
                        action rather than the native nav binding). Omitted when
                        falsy.
        iconClassFull — when true, the `icon` value is treated as a complete
                        Font Awesome class string (e.g. "fa-solid fa-user") and
                        emitted verbatim; otherwise it is prefixed with `fas`.

    The nav carries `tabs` (Foundry's ApplicationV2#changeTab finds a tab by
    `.tabs [data-group][data-tab]`) and `wh40k-tabs` (BaseItemSheet's tab config
    binds the buttons through that selector). Without them no item sheet using
    this strip could switch tab: a click was never bound and `changeTab()` threw
    "No matching tab element".

    The strip wraps rather than overflowing: at the NPC Template sheet's default
    width its fifth tab was cut off (#656). Each tab keeps its label on one line.
--}}
<nav class="tabs wh40k-tabs tw-flex tw-flex-wrap tw-border-b-2 tw-border-gold/30 bc:tw-border-crimson/30 dh1:tw-border-gold-raw/30 dh2:tw-border-gold/30 dw:tw-border-accent-combat/30 ow:tw-border-brass-l20/30 rt:tw-border-void-l20/30 im:tw-border-failure/30 tw-bg-[var(--wh40k-panel-bg-translucent)] tw-flex-shrink-0" data-group="primary">
    {{#each tabs}}
    <button type="button" class="{{#if active}}active {{/if}}tw-whitespace-nowrap tw-px-[var(--wh40k-space-md)] tw-py-[var(--wh40k-space-sm)] tw-font-[var(--wh40k-font-display)] tw-text-[var(--wh40k-font-size-sm)] tw-uppercase tw-tracking-[0.05em] tw-text-[color:var(--wh40k-text-muted)] tw-bg-transparent tw-border-0 tw-border-b-2 tw-border-transparent tw-mb-[-2px] tw-cursor-pointer tw-no-underline hover:tw-text-gold bc:hover:tw-text-crimson-light dh1:hover:tw-text-gold-raw-l5 dh2:hover:tw-text-gold-raw dw:hover:tw-text-accent-combat ow:hover:tw-text-brass-l20 rt:hover:tw-text-gold im:hover:tw-text-failure hover:tw-bg-[rgba(212,175,55,0.08)]" data-tab="{{tab}}" data-group="primary"{{#if ../dataAction}} data-action="{{../dataAction}}"{{/if}}>
        <i class="{{#unless ../iconClassFull}}fas {{/unless}}{{icon}} tw-mr-[var(--wh40k-space-xs)]"></i>
        <span>{{label}}</span>
    </button>
    {{/each}}
</nav>
